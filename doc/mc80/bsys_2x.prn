; ============================================================================
; ANHANG: Original-Listing ab 05B6H -- Fassung 'MB-BSY' (KMBG), KEIN ABZUG vorhanden
; Marken und Kommentare wie im Original; [...] = E/A-Befehle der Zeile, abgeschrieben.
; Diese Fassung kennt KEIN Register EFH: das Laufwerk wird nur ueber die MBI-PIO B (FEH)
; geschaltet und auf die Taste 'LAUF' am Geraet gewartet (KOM, PIO B Bit 2).  Zellen:
;   0DF5 BLN, 0DF7 BLZ (1 Byte), 0DF8 RAM, 0DFA SPH-1, 0DFB SPH, 0DFC SPH+1 Pufferzeiger,
;   0DFE SPH+3 CRC; Puffer 0E00 (SPH+5)=00, 0E01 BLN, 0E03 Daten, 0E83 CRC, 0E85 AAH
;   (Blatt 29 'LEGENDE ZUM MB-BSY').  Blockformat und CRC-Routine wie in ver2.
; ============================================================================
;  05B6  MEN:   MB-BSY BILDSCHIRM LOESCHEN
;  05BB  ME1:
;  05BE         MB-MENUE AUSSCHREIBEN
;  05C3  ME3:   D=ZEILE KURSOR
;  05C6         KURSOR AUF ZEILE 2...5
;  05C9         UND SPALTE 14
;  05CB         "*" SCHREIBEN
;  05D3  ME2:   TASTATURABFRAGE
;  05D9         "*" WEG
;  05DF         "OFF" ?
;  05E1         JA
;  05E4         KURSOR NACH UNTEN ?
;  05E6         JA
;  05EA         KURSOR NACH OBEN ?
;  05EC         JA
;  05EF         "ENTER" ?
;  05F1         NEIN
;  05F4         BS LOESCHEN
;  05FB         MB SCHREIBEN
;  0601         MB LESEN
;  0607         MB SPULEN
;  060A         MB LOESCHEN
;  060D  MSZ:   UP: PARAMETERABFRAGE
;  0613         BLOCKNUMMER EINGEBEN UND AUF BLN=0DF5 SPEICHERN
;  061B         BLOCKANZAHL EINGEBEN
;  061E         UND AUF BLZ=0DF7 ABSPEICHERN
;  0622         RAM ANFANGSADRESSE EINGEBEN
;  0625         UND AUF RAM=0DF8 ABSPEICHERN
;  062B         RAM ENDADRESSE BERECHNEN
;  0631         MB SCHREIBEN ?
;  0633         JA
;  0636  MRD:   MB-LESEN ; UP:INITIALIS.
;  0639  MR2:   UP:1 BLOCK EINLESEN
;  063C  MR1:
;  0640         UP:TEST ZU LESENDE BLN ERREICHT
;  0643         NEIN
;  0648         "RD" AUSSCHREIBEN
;  064B         CRC-ZELLE
;  0650         CRC-FEHLER !
;  0653         PUFFERANFANG
;  0656         RAM-ANFANG
;  065A         PUFFER IN RAM
;  065D         UMLAGERN
;  0660         RAM-STAND PROTOKOLLIEREN
;  066E         BLN:=BLN+1
;  0676         BLZ:=BLZ-1 UND PROTOKOLLIEREN
;  067D         WEITER LESEN BLZ > 0
;  067F  AUS:   UP: ENDABSCHALTUNG KMBG  [LD A,001H / OUT 0FEH / LD A,003H / OUT 0FAH]
;  0687         MB-MENUE
;  068A  MSP:   UP:SPULEN
;  068C         AUSSCHREIBEN
;  0691  MCL:   UP:MB-LOESCHEN
;  0693         AUSSCHREIBEN
;  0696  MC1:
;  0699         [LD A,0FFH / OUT 0FFH / LD A,034H / OUT 0FFH / LD A,B / OUT 0FEH]
;  069D         MOTOR EIN
;  06A1         SPULEN / LOESCHEN
;  06A4  MC2:
;  06A7         TASTATURABFRAGE
;  06A9         "OFF" ?
;  06AB         JA
;  06AF  RME:   UP:RAM-ENDADRESSE BERECHNEN
;  06B2         128 BYTES PRO BLOCK
;  06B4  RM1:
;  06BF         PROTOKOLLIEREN
;  06C3  MLE:   UP:INITIALISIERUNG LESEN
;  06C6         STARTINTERRUPT LADEN  [LD (0D0EH),HL]
;  06C9         PIO A : EINGABE  [LD A,04FH / OUT 0FDH]
;  06CD         [LD A,0FFH / OUT 0FFH]
;  06D1         PIO B : AAEEEAEA  [LD A,034H / OUT 0FFH]
;  06D5         MOTOR EIN, LESEN  [LD A,003H / OUT 0FEH]
;  06D9         INT.-VEKTOR CTC  [LD A,008H / OUT 0F8H]
;  06DD         [LD A,047H / OUT 0F9H / OUT 0FAH]
;  06E3         [LD A,04BH / OUT 0F9H]
;  06E7         ZEITBASIS CTC  [OUT 0FAH]
;  06E9         [IN 0FEH / BIT 2,A]
;  06ED         WARTEN AUF TASTE 'LAUF'  [CAZ KOM]
;  06F3  ML1:
;  06F6         WARTEN AUF MOTORGLEICHLAUF
;  06F8         [LD A,0F7H / OUT 0FBH / LD A,001H]
;  06FE         CTC 3: INTERRUPT FREI  [OUT 0FBH]
;  0701  ML4:   1 BLOCK LESEN/UP:CLEAR PUFFER
;  0704  ML2:   TEST ZUSTANDSSEMAPHORE
;  070B         BLOCK FEHLERHAFT  [LD A,003H / OUT 0F8H]
;  070D         CTC PASSIV
;  070F         NEU INITIALISIEREN
;  0712         RUECKSPRUNG
;  0714  ML3:
;  0716         BANDMARKE GELESEN
;  071B         BYTEMELDER
;  071D         1 BYTE GELESEN
;  0720         BYTEZAEHLER(SPH-1) +1
;  0722         BLOCK VOLL ?
;  0724         NEIN
;  0726         GELESENE BLN
;  072F         = 0FFFFH
;  0730         JA: NAMENSBLOCK
;  0738         GELESENE BLN AUSSCHREIBEN
;  073C  MXV:   UP:VERGLEICH GELESENE/ZU LESENDE
;  0740         =0
;  0741         ">"
;  0746         "<"
;  0748  MV1:
;  074A         SPACE
;  074C         PROTOKOLLIEREN
;  0751  FE1:   UP:FEHLER 3 (CRC)
;  0754  FE3:
;  0759         MOTOR AUS  [LD A,001H / OUT 0FEH]
;  075B         BEENDEN MIT "OFF"
;  075E  MRS:   STARTINTERRUPT LESEN
;  0764         LESEINTERRUPT LADEN  [LD (0D08H),HL]
;  0767         [IN 0FEH]
;  0769         PAUSENPEGEL ABFRAGEN  [BIT 4,A]
;  076B         [LD A,0C7H / OUT 0F8H]
;  076F         16 BIT
;  0773         15 BIT
;  0775  MS1:   CTC 1 ; ZAEHLER 15/16  [OUT 0F8H]
;  0777         INHALT PUFFERZEIGER
;  077B         =00H ?
;  077D         JA,GRUNDZUSTAND,
;  077F         =AAH ?
;  0784         NEIN,D.H.KEINE POSTAMBEL
;  0789         BLOCK VOLLZAEHLIG ?
;  078B         JA
;  078D         =03H, BANDMARKE ?
;  078F         NEIN
;  0791         BANDMARKE BIT 2=1
;  0795  MS2:   BLOCK UNVOLLSTAENDIG
;  0797  MS3:
;  079B  KOM:   UP:WARTEN AUF TASTE 'LAUF'
;  07A1         TEXT
;  07A7  KM1:   [IN 0FEH / BIT 2,A]
;  07AB         WEITER WARTEN
;  07AF         BS-ZEILE LOESCHEN
;  07B3  MRG:   UP: GRUNDZUSTAND PUFFER
;  07B4         BYTEZAEHLER LESEN = 0
;  07B9         SEMAPHORE = 0
;  07BA  MG1:
;  07BD         (PUFFERZEIGER)=(SPH+1)=0E00
;  07C2  MG2:
;  07C4         (0E00)...(0EFF)=00H
;  07C9         CRC-WORT=(SPH+3)=0000H
;  07CD  MRB:   UP: BANDMARKE LESEN
;  07D2         FALSCHE BANDMARKE
;  07DA         FALSCHE BANDMARKE
