; ---- S0.2/S0.3: Magnetbandprogramm (Programmversion 12.01.84) --------------
BAND:
0600  CD 00 20    	CALL MBM		; Menuepunkt BAND: Untermenue S0.4 (MBM) fragt Betriebsart und Parameter ab
0603  DA 00 00    	JP C,BSY		; Cy=1 (OFF) -> Neustart
0606  3A FF 0D    	LD A,(0DFFH)		; MBB (0DFFH): 00 Schreiben, 01 Lesen, 02 Loeschen
0609  E6 FF       	AND FFH
060B  20 0D       	JR NZ,L061A
060D  F5          	PUSH AF
060E  CD 6F 06    	CALL MWR0		; MWR: Datei schreiben
0611  30 06       	JR NC,L0619		; Cy=0: gut
0613  CC 69 07    	CALL Z,BFEHL		; Cy=1,Z=1: vorhergehender Block fehlt -> 'BLOCK xxxx FEHLT'
0616  C4 56 07    	CALL NZ,FDATM		; Cy=1,Z=0: Schreibversuch innerhalb einer Datei -> 'FDAT'
L0619:
0619  F1          	POP AF
L061A:
061A  FE 01       	CP 01H
061C  20 08       	JR NZ,L0626
061E  F5          	PUSH AF
061F  CD 5D 06    	CALL MRD0		; MRD: Datei lesen; Cy=1 -> 'BLOCK xxxx FEHLT'
0622  DC 69 07    	CALL C,BFEHL
0625  F1          	POP AF
L0626:
0626  FE 02       	CP 02H
0628  CC 23 07    	CALL Z,MCL0		; MCL: Kassette loeschen
062B  18 D3       	JR BAND		; zurueck ins Magnetband-Menue
BLE:
062D  C3 2A 09    	JP BLE0		; Sprungleiste des Handbuchs (4.3.2.2/4.3.2.3): BLE = eine Blockstruktur lesen
MRD:
0630  C3 5D 06    	JP MRD0		; MRD Magnetband lesen (RAM,BLZ,BLN,MBB,NAZ,BYE)
MWR:
0633  C3 6F 06    	JP MWR0		; MWR Magnetband schreiben
MCL:
0636  C3 23 07    	JP MCL0		; MCL Magnetband loeschen (mit Bildschirmdialog)
RCK:
0639  C3 4F 0B    	JP RCK0		; RCK Rueckspulen bis Bandanfang, danach 'Lauf'
AUS:
063C  C3 8F 08    	JP AUS0		; AUS Endabschaltung Laufwerk
LIN:
063F  C3 A0 07    	JP LIN0		; LIN Initialisierung Lesen
WIN:
0642  C3 60 0A    	JP WIN0		; WIN Initialisierung Schreiben
WVO:
0645  C3 97 0A    	JP WVO0		; WVO Vorbereitung Schreiben (Art in SPH)
GRZ:
0648  C3 84 07    	JP GRZ0		; GRZ Grundzustand Pufferspeicher
R1S:
064B  C3 CE 07    	JP R1S0		; R1S Ruecksetzen um ca. 1 s
LES:
064E  C3 ED 07    	JP LES0		; LES Leseprogramm nach BLN,BLZ,RAM,BYE,MBB,NAZ
LWK:
0651  C3 9F 08    	JP LWK0		; LWK Laufwerk einschalten (Register E = Steuerdaten fuer PIO B)
PIN:
0654  C3 DA 08    	JP PIN0		; PIN Initialisierung Steuerport (MBI-PIO Kanal B)
VGL:
0657  C3 AC 09    	JP VGL0		; VGL Blocknummernvergleich und Suchlauf (BC = gesuchte BLN)
ZEI:
065A  C3 1F 09    	JP ZEI0		; ZEI Zeitschleife (A aussen, C mitte, B=256 innen)
MRD0:
065D  CD 84 07    	CALL GRZ0		; MRD0: Grundzustand, LIN, 1 s zurueck, LES, AUS
0660  CD A0 07    	CALL LIN0
0663  CD CE 07    	CALL R1S0
0666  CD ED 07    	CALL LES0
0669  F5          	PUSH AF
066A  CD 8F 08    	CALL AUS0
066D  F1          	POP AF
066E  C9          	RET
MWR0:
066F  E5          	PUSH HL		; MWR0: Schreiben einer Datei
0670  CD A0 07    	CALL LIN0
0673  2A FD 0D    	LD HL,(0DFDH)		; BLN = 0001 ?
0676  2B          	DEC HL
0677  7D          	LD A,L
0678  B4          	OR H
0679  20 69       	JR NZ,L06E4		; nein: Bandstelle suchen
067B  CD 4F 0B    	CALL RCK0		; ja: zum Bandanfang
067E  21 00 14    	LD HL,1400H		; Vorluecke: 1400H Byte-Interrupts (ca. 27 s bei 192 Byte/s [?]; Handbuch 'ca. 30 s')
0681  22 F9 0D    	LD (0DF9H),HL
