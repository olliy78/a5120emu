; ============================================================================
; bsys_2x.prn -- Betriebssystem MC80.21/22 (VEB Elektronik Gera), kommentiert
; ERZEUGT von tools/gen_mc8020_bsys_prn.py -- nicht von Hand aendern (AP M10, 2026-10-14)
; ============================================================================
;
; Fassung: "Programmversion 12.01.84" (Nutzerhandbuch 12/86, Abschnitt 4.3.2) =
;   MAME mc8020 BIOS "ver2": s01 (0000H) + s02_v2 (0400H) + s03_v2 (0800H) + mo01 (2000H).
;   Nur diese Fassung passt zu den Arbeitszellen des Handbuchs (BLZ 0DF5H, BYE 0DF7H 2 Byte,
;   PAZ 0DE8H, SPH 0DF2H).  Andere Abzuege:
;   s02.rom      gegen s02_v2.rom :   51 Byte verschieden, 062EH-07FFH
;   s02_v3.rom   gegen s02_v2.rom :  127 Byte verschieden, 05A0H-07FFH
;   s03.rom      gegen s03_v2.rom :  968 Byte verschieden, 0802H-0BFBH
;   mo01_v2.rom  gegen mo01.rom   :  404 Byte verschieden, 200AH-2202H
;   ver1 (s02+s03+mo01_v2) ist dasselbe Programm mit anders gelegten Zellen (CRC 0DEFH,
;   FEZ 0DEEH, PAZ 0DECH, BYZ 0DF1H, SPH 0DF3H, PUZ 0DF4H, BLZ 0DF6H, BYE nur 1 Byte bei 0DF8H)
;   und passt damit NICHT zum Handbuch.  s02_v3 (MAME ver3) enthaelt bei 05B6H-05FFH das Menue
;   MEN der KMBG-Fassung des Original-Listings (bytegleich), ab 0600H aber den Bandteil von s02:
;   MEN springt nach 060DH/068AH/0691H, wo in s02_v3 anderer Code steht -> unstimmiger Satz,
;   vermutlich Mischabzug [?].
;
; Kommentare: GROSSSCHRIFT = Abschrift des Original-Listings "MC 80 - Betriebssystem -"
;   (Module S0.1-S0.3, Z-Nr. 50001:4100.00, 29 Blatt, doc/original_docs/mc80/
;   mc80_22-bsys-doku.pdf; Abschrift tools/mc80/bsys_2x_abschrift.txt).  Das Listing stimmt
;   mit den Abzuegen von 0000H bis 05B5H ueberein (bis auf 05A0H, s. dort); ab 05B6H gehoert
;   es zu einer ANDEREN Fassung ohne Abzug -> Anhang am Ende.  Marken bis 05B5H = Original.
;   normale Schrift = eigene Deutung (statisch, kein Emulator), [?] = Vermutung.
;   Mnemonics in Zilog-Schreibweise (das Original schreibt JMP/CMP/JRNZ/CAZ ...).
;
; ---- Speicher (Handbuch 3.2.1) ----------------------------------------------------------
;   0000-0BFF  ROM S0.1-S0.3 auf der ZRE K2521      0C00-0CFF  BWS 8 x 32 (ZRE-RAM)
;   0D00-0D2B  Systemzellen, IM-2-Tabelle (I=0DH)   0D2C-0DEF  Vektoren Anwender (0D2C MBI-PIO B)
;   0DE5-0DFF  Zellen Magnetband                    0E00-0EFF  Magnetbandpuffer
;   0F00-0FFF  Stapel (SP = 1000H)                  2000-23FF  S0.4 (PFS K3820, mo01)
;   2400-27FF  frei (Copy-Modus, Drucker/Lochband)  2800-2BFF  EPROM-Programmierung S2 (mo03)
;   2C00-3FFF  Objektcodeeditor S1 (mo04-mo08)      4000-5FFF  EPAS/BASIC (mo09-mo16)
;   6000-7FFF  Prozesssteuerprogramm (6000=00, 6001=JP: Start nach RESET)
;   C000-FFFF  OPS K3525 16 KB (F020: Markentabelle des Editors)
;
; ---- Systemzellen 0D00H-0D2BH (aus TII kopiert) -------------------------------------------
;   0D00 DPI (DPL-CTC 0)  0D02 TI1 (DPL-CTC 1)  0D04 TSI (DPL-CTC 2)  0D06 BREAK (DPL-CTC 3)
;   0D08-0D0F MBI-CTC 0-3  0D10-0D17 Analog-BWS-Adressen  0D18-0D1C Tabulatoren
;   0D1D KPS (Kursorposition, Low = BWS-Zeiger)  0D1E Zeichen unter dem Kursor
;   0D1F Kursorblinkzaehler  0D20 Repetierzaehler  0D21-0D27 Tastenspeicher (7 Zeilen)
;
; ---- Arbeitszellen Magnetband (Handbuch 4.3.2.1) --------------------------------------------
;   0DE5 CRC   0DE7 FEZ   0DE8 PAZ   0DEA NAZ   0DF0 BYZ   0DF2 SPH   0DF3 PUZ   0DF5 BLZ
;   0DF7 BYE   0DF9 END   0DFB RAM   0DFD BLN   0DFF MBB
;   SPH Bit 0 Bandmarke, 1 Kennzeichnungsblock, 2 Datei fertig, 5 Block gelesen,
;       6 Bandmarke gelesen, 7 Blockende erkannt (eigene Deutung aus dem Code)
;
; ---- E/A (Handbuch 3.2.2, 4.3.2.1; Original-Listing) ------------------------------------
;   01H/02H  Schreibfreigabe/-sperre RAM, 1-KB-Bereich auf A10-A15 (OUT (n),A: A auf A8-A15)
;   80H-83H  ZRE-CTC, 84H-87H ZRE-PIO (A Daten, B Daten, A Steuer, B Steuer) -- Anwender
;   EFH      MBI: Register Laufwerksteuerung (nur schreiben)
;   F0H-F3H  DPL-CTC 0-3;  F4H/F5H DPL-PIO A Daten/Steuer;  F6H/F7H DPL-PIO B Daten/Steuer
;   F8H-FBH  MBI-CTC 0-3;  FCH/FDH MBI-PIO A Daten/Steuer;  FEH/FFH MBI-PIO B Daten/Steuer
;   E0H-E8H  EPROM-Programmiereinheit (nur S2/mo03, hier nicht benutzt)
; ============================================================================

	ORG	0000H

; ---- S0.1: Neustart, RST-Leiste, Systemzellen (TII), Initialisierung -------
BSY:
0000  31 00 10    	LD SP,1000H		; STACK IM ZVE-RAM
0003  ED 5E       	IM 2		; INTERRUPTMODUS 2
0005  C3 69 00    	JP INI		; UP:INITIALISIERUNG
RS1:
0008  C3 07 60    	JP 6007H		; RST-Aussprung RST 08H -> 6007H (Handbuch 6.2: RST1..RST6 -> 6007H..6016H, Anwender)
L000B:
000B  C3 5B 01    	JP BSN		; UP:ZEICHEN AUF KURSORPOSITION (KPS) SCHREIBEN
000E  FF FF       	DB	0FFH,0FFH
RS2:
0010  C3 0A 60    	JP 600AH
L0013:
0013  C3 81 02    	JP TST		; UP:TASTATURABFRAGE
0016  FF FF       	DB	0FFH,0FFH
RS3:
0018  C3 0D 60    	JP 600DH
L001B:
001B  C3 13 02    	JP BSS		; UP:ZEICHEN SCHREIBEN
001E  FF FF       	DB	0FFH,0FFH
RS4:
0020  C3 10 60    	JP 6010H
0023  C3 2C 02    	JP BSL		; UP:ZEICHEN LESEN
0026  FF FF       	DB	0FFH,0FFH
RS5:
0028  C3 13 60    	JP 6013H
L002B:
002B  C3 3E 02    	JP BKS		; UP:KURSOR SETZEN
002E  FF FF       	DB	0FFH,0FFH
RS6:
0030  C3 16 60    	JP 6016H
0033  C3 5E 02    	JP BKL		; UP:KPS LESEN
0036  FF FF       	DB	0FFH,0FFH
RS7:
0038  C3 00 2C    	JP 2C00H		; RST 38H -> 2C00H (Testmodus des Objektcodeeditors, Handbuch 6.2)
TII:
003B  C4 00       	DW	00C4H		; DISPLAYINTERRUPT
003D  CA 00       	DW	00CAH		; RETI-INTERRUPT
003F  CD 00       	DW	00CDH		; ZEILENENDEINT.
0041  00 00       	DW	0000H		; FREI FUER BREAK-INT.
0043  00 00 00 00 00 00 00 00	DB	00H,00H,00H,00H,00H,00H,00H,00H		; INT.STARTADR. MBI  -- 0D08-0D0F: IM-2-Vektoren der MBI-CTC (Kanal 0..3), vom Bandprogramm besetzt
004B  00 00 00 00 00 00 00 00	DB	00H,00H,00H,00H,00H,00H,00H,00H		; ANALOG-BWS-ADRESSEN  -- 0D10-0D17: Adressen der Analog-BWS fuer Zeile 2/4/6/8 (0000 = Textzeile)
0053  08 10 18 1C 	DB	08H,10H,18H,1CH		; 0D18:TAB-POSITIONEN
0057  20          	DB	20H		; LETZTE TAB-POS.= 32
0058  00          	DB	00H		; 0D1D:KPS
0059  3F          	DB	3FH		; 0D1E:ZEICHEN AUF KPS
005A  20          	DB	20H		; 0D1F:KURSORBLINKZEITZAEHLER
005B  80          	DB	80H		; 0D20:REPITIERZAEHLER
005C  00          	DB	00H		; CTC0:INT.VEKTOR (DPL)
005D  C7          	DB	0C7H		; C7H=ZAEHLER
005E  01          	DB	01H		; 01 =ZEITKONSTANTE
005F  07 07       	DB	07H,07H		; CTC2:IMPULS F. STRAHLRUECKL. TASTATUR FREIGEBEN
0061  C7 21       	DB	0C7H,21H		; CTC2:C7H=ZAEHL.,LOEST TSI AUS 21H=ZEITKONSTANTE
0063  47 D0       	DB	47H,0D0H		; CTC1:AUSZAEHLEN DER STRAHL-RUECKLAUFZEIT
0065  FF          	DB	0FFH
0066  C3 04 60    	JP 6004H		; NMI  -- NMI-Einsprung -> 6004H (Handbuch 6.2)
INI:
0069  3E 0D       	LD A,0DH		; INITIALISIERUNG
006B  ED 47       	LD I,A		; I=0DH
006D  21 00 0C    	LD HL,0C00H		; BILDWIEDERHOLSPEICHER
0070  01 F4 21    	LD BC,21F4H		; C=PIO A (DPL), B=ZAEHLER
0073  D9          	EXX		; ZWEITREG. FUER DPI LADEN
0074  3E 0F       	LD A,0FH		; PIO A (DPL) AUF AUSGABE
0076  D3 F5       	OUT (F5H),A
0078  3E 01       	LD A,01H		; WAHL ZEILE 1 IN TASTENMATRIX
007A  D3 F4       	OUT (F4H),A
007C  3E FF       	LD A,FFH		; PIO B (DPL):EINZELBITSTEUER. ALLES EINGAENGE
007E  D3 F7       	OUT (F7H),A
0080  D3 F7       	OUT (F7H),A
0082  21 3B 00    	LD HL,TII		; UMLADUNG 21H BYTE AB TII AUF BETR.SYSTEM RAM AB 0D00
0085  11 00 0D    	LD DE,0D00H
0088  01 21 00    	LD BC,0021H		; HL:=TII+21H
008B  ED B0       	LDIR
008D  01 F0 03    	LD BC,03F0H		; CTC 0 INIT., 3 STEUERWORTE VON TII UEBERTRAGEN
0090  ED B3       	OTIR
0092  01 F2 02    	LD BC,02F2H		; CTC 2 INIT., 2 STEUERWORTE
0095  ED B3       	OTIR
0097  3E 0C       	LD A,0CH		; BILDSCHIRM (BS) LOESCHEN
0099  CD 5B 01    	CALL BSN
009C  DB F6       	IN A,(F6H)		; LESEN ANGEWAEHLTER ZEILE IN D DATENWORT VON PIO B
009E  57          	LD D,A
009F  3E 0F       	LD A,0FH		; PIO B (DPL):BYTEAUSGABE
00A1  D3 F7       	OUT (F7H),A
00A3  01 F2 02    	LD BC,02F2H		; CTC 2 NEU INIT.
00A6  ED B3       	OTIR
00A8  01 F1 02    	LD BC,02F1H		; CTC 1 INIT.  -- CTC 1 (DPL): 47H/D0H Zaehler ohne Interrupt
00AB  ED B3       	OTIR
00AD  FB          	EI
00AE  7A          	LD A,D
00AF  FE 84       	CP 84H		; UC UND OFF GEDRUECKT? JA,KEIN START PROZESSPROGR.
00B1  28 0E       	JR Z,IN1
00B3  2A 00 60    	LD HL,(6000H)		; NEIN, STECKT PROZESSPR.? -(6000)=00 ,(NOP-BEF.) -(6001)=C3H,(JMP-BEF.)?
00B6  7D          	LD A,L
00B7  FE 00       	CP 00H
00B9  20 06       	JR NZ,IN1		; NEIN:SPRUNG ZU IN1
00BB  7C          	LD A,H
00BC  FE C3       	CP C3H
00BE  CC 01 60    	CALL Z,6001H		; JA:AUFRUF VON 6001
IN1:
00C1  C3 AC 04    	JP BSK		; BETR.SYSTEM-KOMMANDOABFRAGE
DPI:
00C4  D9          	EXX		; DISPLAYINT. VON CTC 0
00C5  08          	EX AF,AF'
00C6  ED A3       	OUTI
00C8  08          	EX AF,AF'
00C9  D9          	EXX
TI1:
00CA  FB          	EI
00CB  ED 4D       	RETI		; INTERRUPTENDE
TSI:
00CD  08          	EX AF,AF'		; ZEILENENDEINTERRUPT
00CE  D9          	EXX
00CF  EB          	EX DE,HL
TI2:
00D0  7B          	LD A,E
00D1  FE 01       	CP 01H		; OBERSTE ZEILE ALS NAECHSTES?
00D3  20 2F       	JR NZ,TI3		; NEIN
00D5  3E FF       	LD A,FFH		; JA:TASTATUR EINLESEN
00D7  D3 F7       	OUT (F7H),A		; PIO B (DPL):EINGABE
00D9  D3 F7       	OUT (F7H),A
00DB  3E 40       	LD A,40H		; LETZTE ZEILE ANWAEHLEN:
00DD  01 F6 07    	LD BC,07F6H		; C=PIO B, B=ZAEHLER
00E0  21 21 0D    	LD HL,0D21H		; TASTENSPEICHER AB 0D21
TI4:
00E3  D3 F4       	OUT (F4H),A		; ZEILE ANWAEHLEN
00E5  0F          	RRCA		; NAECHSTE ZEILE VORBEREITEN
00E6  ED A2       	INI		; ZEILENBELEG. LESEN U.SPEICHERN
00E8  20 F9       	JR NZ,TI4		; SCHLEIFENDURCHLAUF 7 MAL
00EA  3E 0F       	LD A,0FH
00EC  D3 F7       	OUT (F7H),A		; PIO B:AUSGABE
TI9:
00EE  EB          	EX DE,HL
TI0:
00EF  01 F4 21    	LD BC,21F4H		; B-REG. AUFFRISCHEN
00F2  26 0C       	LD H,0CH		; H-REG. AUFFRISCHEN
00F4  7D          	LD A,L
00F5  E6 E0       	AND E0H		; ZEILENANFANG IM BWS FIXIEREN
00F7  6F          	LD L,A
00F8  2F          	CPL		; ZEILENPOS. AUF PIO B AUSGEBEN (BIT 7,6,5)
00F9  D3 F6       	OUT (F6H),A
00FB  3E 20       	LD A,20H		; LEERZEICHEN ALS ERSTES ZEICHEN BEI STRAHLVORLAUF
00FD  D3 F4       	OUT (F4H),A
00FF  D9          	EXX
0100  08          	EX AF,AF'		; RUECKSCHALTEN AUF HAUPTREG.
0101  FB          	EI
0102  ED 4D       	RETI		; INTERRUPTENDE
TI3:
0104  CB 6F       	BIT 5,A
0106  20 1A       	JR NZ,ANL		; ZEILEN 2,4,6,8 ANALOG?
0108  FE 81       	CP 81H
010A  20 E2       	JR NZ,TI9
010C  21 1F 0D    	LD HL,0D1FH		; KURSORZAEHLER
010F  CB 7E       	BIT 7,(HL)		; KEINE TASTE?
0111  20 04       	JR NZ,TI5		; JA
0113  35          	DEC (HL)		; NEIN:KURSORZAEHLER AUF 1 ABZAEHLEN
0114  20 01       	JR NZ,TI5
0116  34          	INC (HL)
TI5:
0117  23          	INC HL		; REPITIERZAEHLER
0118  CB 7E       	BIT 7,(HL)		; KURSOR ABGESCHALTET?
011A  20 D2       	JR NZ,TI9		; JA
011C  35          	DEC (HL)		; NEIN:ZAEHLER AUF 1 ABZAEHLEN FREQUENZ CA. 50 HERTZ
011D  20 CF       	JR NZ,TI9
011F  34          	INC (HL)
0120  18 CC       	JR TI9
ANL:
0122  26 0D       	LD H,0DH		; ANALOGDARSTELLUNG
0124  E6 C0       	AND C0H		; IN A ZEILENPOS.
0126  07          	RLCA		; ZEILEN 2,4,6,8 WANDELN IN ADRESSEN 0D10,0D12,0D14,0D16
0127  07          	RLCA
0128  07          	RLCA
0129  C6 10       	ADD A,10H
012B  6F          	LD L,A
012C  7E          	LD A,(HL)		; INHALT VON 0D10 ... LESEN
012D  23          	INC HL
012E  66          	LD H,(HL)		; ADR. DES ANALOG-BWS UND
012F  6F          	LD L,A		; NACHFOLGENDE ZELLE = 0 ?
0130  B4          	OR H
0131  28 BB       	JR Z,TI9		; JA: KEINE ANALOGDARSTELLUNG
0133  3E 80       	LD A,80H		; PIO A: UMSCHALTEN Z-SIGNAL ANALOG (BIT 7 = 1)
0135  D3 F4       	OUT (F4H),A
0137  01 F6 FE    	LD BC,FEF6H		; C=PIO B, B=ZAEHLER
013A  ED A3       	OUTI		; ERSTE ANALOGPOS. EINNEHMEN
013C  3E 41       	LD A,41H		; INT. CTC 0 (DPI) SPERREN
013E  D3 F0       	OUT (F0H),A
0140  3E C1       	LD A,C1H		; INT. CTC 1 (TI1) FREIGEBEN
0142  D3 F1       	OUT (F1H),A
0144  FB          	EI
0145  76          	HALT		; SYNCHRON.MIT TI1, ZEILENANFANG
0146  ED B3       	OTIR		; ANALOGWERTEAUSGABE
0148  3E C1       	LD A,C1H
014A  D3 F0       	OUT (F0H),A		; CTC 0: INT. FREIGEBEN
014C  3E 41       	LD A,41H
014E  D3 F1       	OUT (F1H),A		; CTC 1: INT. SPERREN
0150  7B          	LD A,E
0151  C6 20       	ADD A,20H		; NAECHSTE ZEILE
0153  5F          	LD E,A
0154  C3 D0 00    	JP TI2
TNI:
0157  08          	EX AF,AF'		; Ende der Analogzeile: Zweitregister zurueck, weiter bei TI0
0158  D9          	EXX
0159  18 94       	JR TI0
BSN:
015B  F5          	PUSH AF		; ZEICHEN AUF KPS SCHREIBEN
015C  E5          	PUSH HL
015D  D5          	PUSH DE
015E  2A 1D 0D    	LD HL,(0D1DH)		; KPS, L=ZEIGER BWS
0161  5C          	LD E,H
0162  26 0C       	LD H,0CH
0164  A7          	AND A		; AKKU = 0 ?
0165  28 1E       	JR Z,BN9
0167  FE 7F       	CP 7FH		; NEIN:A>7FH -->KEIN ZEICH.IN A
0169  30 1A       	JR NC,BN9
016B  FE 20       	CP 20H		; A<20H -->STEUERZEICHEN
016D  38 1A       	JR C,BN3
016F  FE 60       	CP 60H		; 60H<A<7FH -->KLEINBUCHSTABEN
0171  38 02       	JR C,BN1
0173  D6 20       	SUB 20H		; KLEINBUCHST. IN GROSSBUCHST.
BN1:
0175  D6 40       	SUB 40H
0177  E6 3F       	AND 3FH
0179  77          	LD (HL),A		; ZU SCHREIB. ZEICHEN AUF KPS
BN4:
017A  2C          	INC L		; KPS+1 BILDENDE ?
017B  20 01       	JR NZ,BN2		; NEIN
017D  2D          	DEC L		; JA: KPS:=KPS-1
BN2:
017E  7E          	LD A,(HL)		; ZEICHEN NACH A
017F  36 1F       	LD (HL),1FH
0181  67          	LD H,A		; IN H NEUES ZEICHEN
0182  22 1D 0D    	LD (0D1DH),HL		; KPS SPEICHERN
BN9:
0185  D1          	POP DE
0186  E1          	POP HL
0187  F1          	POP AF
0188  C9          	RET
BN3:
0189  73          	LD (HL),E		; IN A STEUERZEICHEN
018A  FE 09       	CP 09H		; KURSOR NACH RECHTS ?
018C  28 EC       	JR Z,BN4
018E  11 7E 01    	LD DE,017EH
0191  D5          	PUSH DE
0192  FE 08       	CP 08H		; KURSOR NACH LINKS ?
0194  20 05       	JR NZ,BN8
0196  7D          	LD A,L
0197  A7          	AND A
0198  C8          	RET Z
0199  2D          	DEC L
019A  C9          	RET
BN8:
019B  FE 0A       	CP 0AH		; KURSOR NACH UNTEN ?
019D  20 06       	JR NZ,BN5
019F  7D          	LD A,L
01A0  C6 20       	ADD A,20H
01A2  D8          	RET C
01A3  6F          	LD L,A
01A4  C9          	RET
BN5:
01A5  FE 0B       	CP 0BH		; KURSOR NACH OBEN ?
01A7  20 06       	JR NZ,BN6
01A9  7D          	LD A,L
01AA  D6 20       	SUB 20H
01AC  D8          	RET C
01AD  6F          	LD L,A
01AE  C9          	RET
BN6:
01AF  FE 0C       	CP 0CH		; DISPLAY LOESCHEN ?
01B1  20 05       	JR NZ,BN7
01B3  2E 00       	LD L,00H
01B5  5D          	LD E,L
01B6  18 1E       	JR BM4
BN7:
01B8  FE 0D       	CP 0DH		; KURSOR AN ZEILENANFANG ?
01BA  20 05       	JR NZ,BM1
01BC  7D          	LD A,L
01BD  E6 E0       	AND E0H
01BF  6F          	LD L,A
01C0  C9          	RET
BM1:
01C1  FE 1A       	CP 1AH		; ZEICHEN LOESCHEN ?
01C3  20 07       	JR NZ,BM2
01C5  7D          	LD A,L
01C6  A7          	AND A
01C7  C8          	RET Z
01C8  2D          	DEC L
01C9  36 20       	LD (HL),20H
01CB  C9          	RET
BM2:
01CC  FE 18       	CP 18H		; ZEILE LOESCHEN ?
01CE  20 0F       	JR NZ,BM3
01D0  7D          	LD A,L
01D1  E6 E0       	AND E0H
01D3  6F          	LD L,A
01D4  1E 20       	LD E,20H
BM4:
01D6  E5          	PUSH HL
BM5:
01D7  36 20       	LD (HL),20H
01D9  2C          	INC L
01DA  1D          	DEC E
01DB  20 FA       	JR NZ,BM5
01DD  E1          	POP HL
01DE  C9          	RET
BM3:
01DF  FE 02       	CP 02H		; KURSOR AN DISPLAYANFANG ?
01E1  20 03       	JR NZ,BM6
01E3  2E 00       	LD L,00H
01E5  C9          	RET
BM6:
01E6  FE 03       	CP 03H		; TABULATOR ?
01E8  C0          	RET NZ
01E9  7D          	LD A,L
01EA  F5          	PUSH AF
01EB  E6 E0       	AND E0H
01ED  6F          	LD L,A
01EE  F1          	POP AF
01EF  E6 1F       	AND 1FH
01F1  E5          	PUSH HL
01F2  21 18 0D    	LD HL,0D18H
01F5  06 04       	LD B,04H
BT1:
01F7  BE          	CP (HL)		; TABULATORPOS.
01F8  38 03       	JR C,BT2
01FA  23          	INC HL
01FB  10 FA       	DJNZ BT1
