069B  7D          	LD A,L
069C  B4          	OR H
069D  20 F9       	JR NZ,L0698
069F  3E 0A       	LD A,0AH		; PIO B: Daten schreiben (0AH)
06A1  D3 FE       	OUT (FEH),A
06A3  3E AA       	LD A,AAH		; Praeambel AAH in das Schieberegister
06A5  D3 FC       	OUT (FCH),A
