0702  37          	SCF
0703  18 DD       	JR L06E2
L0705:
0705  3E 03       	LD A,03H		; MBI-CTC 3 ruecksetzen
0707  D3 FB       	OUT (FBH),A
0709  CD 84 07    	CALL GRZ0
070C  3E 51       	LD A,51H		; Pausenzaehler PAZ (0DE8H) = 51H Byte-Zeiten
070E  32 E8 0D    	LD (0DE8H),A
0711  21 02 21    	LD HL,2102H		; Vektor CTC3 = IPA (Pause), dann wie beim Bandanfang weiter
0714  22 0E 0D    	LD (0D0EH),HL
0717  CD 60 0A    	CALL WIN0
071A  2A FD 0D    	LD HL,(0DFDH)
071D  23          	INC HL
071E  22 FD 0D    	LD (0DFDH),HL
0721  18 8D       	JR L06B0
MCL0:
