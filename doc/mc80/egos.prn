; ============================================================================================
; egos.prn  -  MC80.3x Betriebssystem EGOS 30.1 ('mc 80.30. microcomputer Version 3.0/1,2')
;              ZVE-EPROMs 0000H-1FFFH (4 x 2716) + SPE-2-EPROMs 2000H-27FFH (2 x 2708), 10 KB
;
; Quelle : doc/EPROMS/MC80/mc8030_mame/ (MAME-Satz mc8030):
;          zve_1.rom  0000H  MD5 ccb6a95a333f01b68dc87ca02047c667
;          zve_2.rom  0800H  MD5 0675cd564ae3c8f29e43d4db50145adc
;          zve_3.rom  1000H  MD5 2868208bc3eb19872bd0e82e35cb2cfd
;          zve_4.rom  1800H  MD5 5d631a93788dc655da6aa2411f714d1d
;          spe_1.rom  2000H  MD5 b889d5c848849b4dd1203d6adc333ac0
;          spe_2.rom  2400H  MD5 637a0184a0c970d0cd3aab1e0cab7d7a
; Erzeugt: tools/gen_mc80_egos_prn.py (rohes Disassemblat tools/z80_disasm2.py + Handkommentare)
; Doku   : doc/mc80/egos.md (Auswertung, Fassungsvergleich), doc/mc80/hardware_3x.md (Hardware),
;          [EGOS S.n] = mc80.3x-egos.pdf Teil 1, [EGOS2 S.n] = Teil 2 (Magnetband), gedruckte Seite
;
; STATISCHE Analyse -- es gibt noch keinen MC80-Emulator.  [?] = Deutung nach Unterlage oder
; Vermutung; [Befund] = steht so im Code, weicht aber von einer Unterlage ab oder ist neu.
;
; ---- Speicher ------------------------------------------------------------------------------
;   0000-0FFF Kern, VIS-Treiber, Tastatur, Zeichengenerator   1000-1FFF Magnetband
;   2000-27FF SPE-2-ROM (Segmentprogramme, Kommandos)          2800-3FFF Erweiterungs-ROM (leer)
;   4000-BFFF Segmentfenster (OUT 85H, Einsernummer)            C000-FFFF ZVE-RAM
;   RAM-Zellen: F5F1 IY-Grundzustand, F800 Stapel, F880 BASIC-Puffer, F8DC Segmentausfuehrung,
;   F900-FB3F Magnetband (F900 -> IX-Vektor FA30, F910 Blockpuffer), FB40-FB7F VIS/Tastatur,
;   FB80-FBDF Eingabepuffer, FBFB SEGC, FBFC/FBFD Zusatzsegmente, FBFE SEGD, FBFF SEGE,
;   FC00 ADT, FED0-FEE7 Sondertasten, FEE8-FEFF NMI/RST-Aussprung, FF00-FFFF Vektoren (I = FFH)
;
; ---- Die ROM-Kette (Objekte mit Kennbyte, Distanz, Name, Endebyte >= 7FH [EGOS S.6-8]) --------
; Jede Kommando-, Treiber- und RESET-Suche beginnt bei 0AFEH im Segment 1.  Im ROM:
;   0AFE  KB 02  CON        Code ab 0B05
;   0B08  KB 01  INIT       Code ab 0B10
;   0B13  KB 03  (ohne Namen) Code ab 0B17
;   1000  KB 02  KLOG       Code ab 1008
;   1421  KB 01  KINIT      Code ab 142A
;   1455  KB 01  READ       Code ab 145D
;   1464  KB 01  WRITE      Code ab 146D
;   1FF3  KB 03  (ohne Namen) Code ab 1FF7
;   2000  KB 1B  (ohne Namen) Code ab 2004
;   2200  KB 01  RELAD      Code ab 2209
;   2330  KB 01  DIR        Code ab 2337
;   2400  KB 01  LADT       Code ab 2408
;   2487  KB 01  DEFINE     Code ab 2491
;   2506  KB 01  ACT        Code ab 250D
;   254F  KB 01  DEACT      Code ab 2558
;   25B9  KB 03  (ohne Namen) Code ab 25BD
;   260A  KB 01  CAT        Code ab 2611
;   261E  KB 01  CATA       Code ab 2626
;   26CF  KB 01  RKET       Code ab 26D7
;   danach Objekt bei 2800H (Erweiterungs-ROM); dort FFH = Ende der Kette
;
; ---- E/A, wie EGOS sie benutzt ------------------------------------------------------------
;   30H-37H K5020 (AKB): 30 Daten aus, 31 Daten ein, 32/33 deren Steuerworte, 34/35 Steuer-PIO
;           A/B (Bitbelegung doc/kassette/k5020.md 3), 36/37 deren Steuerworte; NUR Laufwerk 1
;   85H/87H ZVE-PIO Tor B = Segmentregister;  8CH 256-mal im RESET (Schreibschutz, s. 0780H)
;   C0H-CFH VIS 2a: OUT (C),E mit B = Y (unten 0), E = X, C = C0/C1 dunkel/hell, Bit 3 = rechte
;           Haelfte, C4/C5 + B = Bildkommando (00 loeschen, 1A/2A rollen)
;   D0H-D3H ASP-SIO (A Tastatur 9600 7O2), D4H-D7H ASP-CTC (K0 SIO-Takt, K1 Magnetband-
;           Zeitgeber 10 ms, K2 /2 [?], K3 nachgeordneter Tastaturinterrupt)
;   NICHT benutzt: 80H-84H, 86H, 8DH, B0H-B3H (SPE 2), D8H-DBH (ASP-PIO), E0H-EFH (EPR)
;
; ---- Tastaturprotokoll (SIO A, 044BH/046FH) ------------------------------------------------
;   Tastatur -> Rechner: Zeichen 00H-1BH und 20H-7FH; 1CH-1FH sind PRAEFIXE, die fuer die
;   folgenden Zeichen gelten: 1CH normal (Gross/Klein-Tausch nach FB7FH Bit 4), 1DH 2. Ebene [?],
;   1EH Sondertaste (Folgebyte = Bitmaske 40H..01H,00H -> Taste 0..7 -> JP FED0H+3n),
;   1FH Zeichen | 80H.  Rechner -> Tastatur: 07H Piep, 12H/14H (FB7FH Bit 6 aus/ein, Anzeige [?])
; ============================================================================================


; ---- Restart-Vektoren: RESET, RST 08H..38H und NMI springen in die RAM-Aussprungleiste FEE8H-FEFFH [EGOS S.5] 
KALTSTART:
0000  C3 76 07      	JP RESET		;[RESET] Kaltstart -> RESET 0776H
0003  00 00 00 00 00	DB	00H,00H,00H,00H,00H		;Luecke bis RST 08H
RST08:
0008  C3 EB FE      	JP FEEBH		;RST 08H -> Aussprung FEEBH (RAM, schreibgeschuetzt; INIT fuellt FFH)
000B  00 00 00 00 00	DB	00H,00H,00H,00H,00H
0010  C3 EE FE      	JP FEEEH		;RST 10H -> FEEEH
0013  00 00 00 00 00	DB	00H,00H,00H,00H,00H
RST18:
0018  C3 F1 FE      	JP FEF1H		;RST 18H -> FEF1H
001B  00 00 00 00 00	DB	00H,00H,00H,00H,00H
0020  C3 F4 FE      	JP FEF4H		;RST 20H -> FEF4H
0023  00 00 00 00 FF	DB	00H,00H,00H,00H,0FFH		;(0027H = FFH)
RST28:
0028  C3 F7 FE      	JP FEF7H		;RST 28H -> FEF7H
002B  00 00 00 00 00	DB	00H,00H,00H,00H,00H
0030  C3 FA FE      	JP FEFAH		;RST 30H -> FEFAH
0033  00 00 00 00 00	DB	00H,00H,00H,00H,00H		;in den ycdt-Fassungen 30E steht hier 'LD (HL),0 / JP 0C42H' (NMI-Ziel, s. egos.md)
RST38:
0038  C3 FD FE      	JP FEFDH		;RST 38H -> FEFDH; INIT legt dort 18H,FEH = 'JR $' ab (Halteschleife, 0C53H)

; ---- VIS-Grundfunktionen CLB/ROL/ROU (Bildkommandos der VIS 2a), BFE -------------------------
CLB:
003B  F5            	PUSH AF		;[CLB 0BD9H] Bild dunkel loeschen [EGOS S.14]
003C  E5            	PUSH HL
003D  C5            	PUSH BC
003E  06 00         	LD B,00H		;B = Opcode 00H: 'Bild loeschen, Rollzaehler zuruecksetzen' (C0 aus FB4BH: 0 = dunkel, 1 = hell) [BDA S.20]
0040  CD 26 02      	CALL VIS_KOMMANDO
0043  21 00 F8      	LD HL,F800H		;Bildfenster-Anfang = F800H (D = F8H = oberste Textzeile, E = 0)
0046  22 58 FB      	LD (FB58H),HL
0049  21 4A FB      	LD HL,FB4AH		;Rollzaehler FB4AH = 0
004C  36 00         	LD (HL),00H
004E  18 0F         	JR L005F
ROL:
0050  F5            	PUSH AF		;[ROL 0BDCH] Bild um eine Textzeile nach oben rollen
0051  E5            	PUSH HL
0052  C5            	PUSH BC
0053  06 1A         	LD B,1AH		;B = 1AH: Opcode 1/n = 'n Zeilen nach oben rollen', n = 0AH = 10 Bildzeilen
0055  CD 26 02      	CALL VIS_KOMMANDO
0058  3E F6         	LD A,F6H		;Rollzaehler -= 10 (F6H)
L005A:
005A  21 4A FB      	LD HL,FB4AH		;Rollzaehler FB4AH += A -- verschiebt alle Bildpunkt-Y um den Rollweg (ZEILE_ZU_PIXEL 01E7H)
005D  86            	ADD A,(HL)
005E  77            	LD (HL),A
L005F:
005F  C1            	POP BC
0060  E1            	POP HL
0061  F1            	POP AF
0062  C9            	RET
0063  00 00 00      	DB	00H,00H,00H
0066  C3 E8 FE      	JP FEE8H		;[NMI] -> FEE8H; INIT legt dort EDH,45H = RETN ab (0C59H): die NMI (Netzausfall, MST 2) wird im Grundzustand uebergangen
ROU:
0069  F5            	PUSH AF		;[ROU 0BDFH] Bild um eine Textzeile nach unten rollen
006A  E5            	PUSH HL
006B  C5            	PUSH BC
006C  06 2A         	LD B,2AH		;B = 2AH: Opcode 2/n = n Zeilen nach unten, n = 10
006E  CD 26 02      	CALL VIS_KOMMANDO
0071  3E 0A         	LD A,0AH		;Rollzaehler += 10
0073  18 E5         	JR L005A
0075  FF FF FF FF FF FF FF FF FF FF FF FF FF	DB	0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH		;unbelegt; ycdt-30E: NMI-Routine 'LD HL,0AAFDH / LD (4001H),HL / LD HL,4000H / JP 0033H'
BFE:
0082  D5            	PUSH DE		;[BFE 0BD6H] Bildfenster festlegen: DE = Zeile/Spalte -> Bildpunkte -> FB58H
0083  CD BB 01      	CALL ZEILE_ZU_PIXEL
0086  ED 53 58 FB   	LD (FB58H),DE
008A  D1            	POP DE
008B  C9            	RET

; ---- Zeichenausgabe auf die Vollgrafik: Zeichenbreite, Steuerzeichen, Zeichen zeichnen -------
ZEICHENBREITE:
008C  FE 0D         	CP 0DH		;[ZEICHENBREITE] A = Zeichen, DE = Position (D = Y, Bit 0 von D = rechte Bildhaelfte, E = X 0..255).  Rueckgabe A = Breite, CY = 1: passt nicht in die Zeile
008E  20 03         	JR NZ,L0093
0090  AF            	XOR A		;CR: Breite 0, Zeilenwechsel (00D6H)
0091  18 43         	JR L00D6
L0093:
0093  FE 09         	CP 09H		;TAB (09H): Abstand bis zum naechsten Tabulator FB65H.. (Pixel/2)
0095  20 16         	JR NZ,L00AD
0097  D5            	PUSH DE
0098  CD A3 06      	CALL ED_TAB_SUCHEN
009B  6F            	LD L,A
009C  D1            	POP DE
009D  62            	LD H,D
009E  CB 3C         	SRL H
00A0  29            	ADD HL,HL
00A1  23            	INC HL
00A2  B7            	OR A
00A3  ED 52         	SBC HL,DE
00A5  7D            	LD A,L
00A6  06 00         	LD B,00H
00A8  C9            	RET
L00A9:
00A9  3E 00         	LD A,00H		;nicht darstellbar: A = 0, CY
00AB  37            	SCF
00AC  C9            	RET
L00AD:
00AD  D6 20         	SUB 20H		;druckbares Zeichen: Zeiger in ZG_ZEIGER ((FB40H) + 2*(Zeichen-20H))
00AF  38 F8         	JR C,L00A9
00B1  6F            	LD L,A
00B2  26 00         	LD H,00H
00B4  29            	ADD HL,HL
00B5  ED 4B 40 FB   	LD BC,(FB40H)
00B9  09            	ADD HL,BC
00BA  4E            	LD C,(HL)		;C/B = Zeiger auf die Spaltenmuster, A = naechster Zeiger (low) -> Breite = A - C
00BB  23            	INC HL
00BC  46            	LD B,(HL)
00BD  23            	INC HL
00BE  7E            	LD A,(HL)
00BF  91            	SUB C
00C0  67            	LD H,A
00C1  83            	ADD A,E		;passt die Breite noch in die aktuelle Haelfte (E + Breite < 256)?
00C2  7C            	LD A,H
00C3  D0            	RET NC
00C4  B7            	OR A
00C5  CB 42         	BIT 0,D		;schon in der rechten Haelfte (D Bit 0)?  Nein: Uebertrag in die rechte Haelfte erlaubt
00C7  C8            	RET Z
00C8  21 60 FB      	LD HL,FB60H		;rechter Rand erreicht: FB60H Bit 1 = automatischer Zeilenumbruch erlaubt?
00CB  CB 4E         	BIT 1,(HL)
00CD  28 DA         	JR Z,L00A9
00CF  C5            	PUSH BC
00D0  06 FF         	LD B,FFH		;Rest der Zeile loeschen (B = FFH Spalten)
00D2  CD 25 03      	CALL ZEICHEN_LOESCHEN
00D5  C1            	POP BC
L00D6:
00D6  5F            	LD E,A		;[Zeilenwechsel] neues Y = Y - Zeilenhoehe, Pruefung gegen den Rollzaehler
00D7  21 4A FB      	LD HL,FB4AH
00DA  7A            	LD A,D
00DB  96            	SUB (HL)
00DC  21 43 FB      	LD HL,FB43H		;Y -= Zeilenhoehe (FB43H): Y zaehlt nach OBEN, die naechste Zeile liegt tiefer
00DF  96            	SUB (HL)
00E0  21 4A FB      	LD HL,FB4AH
00E3  38 08         	JR C,L00ED		;unter der untersten Zeile?
00E5  86            	ADD A,(HL)
L00E6:
00E6  57            	LD D,A
00E7  CB 82         	RES 0,D
00E9  7B            	LD A,E
00EA  1E 00         	LD E,00H
00EC  C9            	RET
L00ED:
00ED  86            	ADD A,(HL)		;ja: FB60H Bit 0 = Rollen gesperrt?  Sonst ROL (Bild rollt, Kursor bleibt unten)
00EE  21 60 FB      	LD HL,FB60H
00F1  CB 46         	BIT 0,(HL)
00F3  20 B4         	JR NZ,L00A9
00F5  CD 50 00      	CALL ROL
00F8  B7            	OR A
00F9  18 EB         	JR L00E6
L00FB:
00FB  4F            	LD C,A
L00FC:
00FC  CD 25 03      	CALL ZEICHEN_LOESCHEN
00FF  18 66         	JR L0167
ZEICHEN_AUS:
0101  F5            	PUSH AF		;[ZEICHEN_AUS 0BB8H] A = Zeichen an Position DE zeichnen (Vordergrund FB46H, Hintergrund FB47H); DE danach hinter dem Zeichen.  19H = Rest der Zeile loeschen
0102  E5            	PUSH HL
0103  C5            	PUSH BC
0104  01 FF FF      	LD BC,FFFFH
0107  FE 19         	CP 19H
0109  28 F1         	JR Z,L00FC
010B  CD 8C 00      	CALL ZEICHENBREITE		;Breite holen; CY -> nicht darstellbar
010E  38 57         	JR C,L0167
0110  A7            	AND A
0111  28 54         	JR Z,L0167
0113  04            	INC B
0114  05            	DEC B
0115  28 E4         	JR Z,L00FB
0117  DD E5         	PUSH IX		;IX = Zeiger auf die Spaltenmuster (aus ZEICHENBREITE in BC)
0119  C5            	PUSH BC
011A  DD E1         	POP IX
011C  2A 46 FB      	LD HL,(FB46H)		;H/L = Portadresse dunkel/hell (FB47H/FB46H, Vorgabe C0H/C1H = VIS 'Punkt dunkel'/'Punkt hell'); rechte Haelfte: Bit 3 der Portadresse setzen [BDA S.19]
011F  CB 42         	BIT 0,D
0121  CB 82         	RES 0,D
0123  28 04         	JR Z,L0129
0125  CB DD         	SET 3,L
0127  CB DC         	SET 3,H
L0129:
0129  42            	LD B,D		;B = Y (geht bei OUT (C),r auf A8-A15)
012A  E5            	PUSH HL
012B  21 42 FB      	LD HL,FB42H		;FB42H Bit 4: doppelte Zeichenhoehe?
012E  CB 66         	BIT 4,(HL)
0130  E1            	POP HL
0131  20 3D         	JR NZ,ZEICHEN_DOPPELT
ZEICHEN_NORMAL:
0133  DD 56 00      	LD D,(IX+0)		;[ZEICHEN_NORMAL] je Spalte ein Musterbyte; Bit 0 zuerst = UNTERSTE Bildzeile, Y waechst je Bit -> die Y-Achse zeigt nach OBEN (Y = 0 unten) [Befund]
0136  DD 23         	INC IX
0138  37            	SCF
L0139:
0139  CB 1A         	RR D		;Bit herausschieben; Z nach 8 Bit (Endemarke 1 von SCF)
013B  28 0A         	JR Z,L0147
013D  4D            	LD C,L		;Bit = 1 -> L-Port (hell), 0 -> H-Port (dunkel): jede Spalte wird ganz geschrieben
013E  38 01         	JR C,L0141
0140  4C            	LD C,H
L0141:
0141  ED 59         	OUT (C),E		;VIS 2a: OUT (C),E mit C = Funktion/Haelfte, B = Y, E = X [BDA S.19]
0143  04            	INC B
0144  B7            	OR A
0145  18 F2         	JR L0139
L0147:
0147  4F            	LD C,A		;naechste Spalte: Y zurueck (B -= 8), X += 1
0148  78            	LD A,B
0149  D6 08         	SUB 08H
014B  47            	LD B,A
014C  1C            	INC E		;X-Ueberlauf 255 -> 0: weiter in der rechten Haelfte (Bit 3 der Ports)
014D  20 0A         	JR NZ,L0159
014F  1D            	DEC E
0150  CB 5D         	BIT 3,L
0152  20 05         	JR NZ,L0159
0154  1C            	INC E
0155  CB DD         	SET 3,L
0157  CB DC         	SET 3,H
L0159:
0159  79            	LD A,C
015A  3D            	DEC A
015B  20 D6         	JR NZ,ZEICHEN_NORMAL
L015D:
015D  B7            	OR A		;Rueckgabe D = Y, Bit 0 = rechte Haelfte
015E  DD E1         	POP IX
0160  50            	LD D,B
0161  CB 5D         	BIT 3,L
0163  28 02         	JR Z,L0167
0165  CB C2         	SET 0,D
L0167:
0167  C1            	POP BC
0168  E1            	POP HL
0169  38 02         	JR C,L016D
016B  F1            	POP AF
016C  C9            	RET
L016D:
016D  F1            	POP AF
016E  37            	SCF
016F  C9            	RET
ZEICHEN_DOPPELT:
0170  DD 56 00      	LD D,(IX+0)		;[ZEICHEN_DOPPELT] wie oben, jeder Bildpunkt 2 x 2
0173  DD 23         	INC IX
0175  37            	SCF
L0176:
0176  CB 1A         	RR D
0178  28 15         	JR Z,L018F
017A  4D            	LD C,L
017B  38 01         	JR C,L017E
017D  4C            	LD C,H
L017E:
017E  ED 59         	OUT (C),E
0180  04            	INC B
0181  ED 59         	OUT (C),E
0183  05            	DEC B
0184  1C            	INC E
0185  ED 59         	OUT (C),E
0187  04            	INC B
0188  ED 59         	OUT (C),E
018A  1D            	DEC E
018B  04            	INC B
018C  B7            	OR A
018D  18 E7         	JR L0176
L018F:
018F  4C            	LD C,H		;Leerspalte doppelt breit
0190  ED 59         	OUT (C),E
0192  04            	INC B
0193  ED 59         	OUT (C),E
0195  05            	DEC B
0196  1C            	INC E
0197  ED 59         	OUT (C),E
0199  04            	INC B
019A  ED 59         	OUT (C),E
019C  1D            	DEC E
019D  04            	INC B
019E  4F            	LD C,A
019F  78            	LD A,B
01A0  D6 12         	SUB 12H
01A2  47            	LD B,A
01A3  7B            	LD A,E
01A4  C6 02         	ADD A,02H
01A6  5F            	LD E,A
01A7  30 0C         	JR NC,L01B5
01A9  1D            	DEC E
01AA  1D            	DEC E
01AB  CB 5D         	BIT 3,L
01AD  20 06         	JR NZ,L01B5
01AF  1C            	INC E
01B0  1C            	INC E
01B1  CB DD         	SET 3,L
01B3  CB DC         	SET 3,H
L01B5:
01B5  79            	LD A,C
01B6  3D            	DEC A
01B7  20 B7         	JR NZ,ZEICHEN_DOPPELT
01B9  18 A2         	JR L015D

; ---- Zeile/Spalte -> Bildpunkt, Kursor, VIS-Bildkommando, Multiplikation ---------------------
ZEILE_ZU_PIXEL:
01BB  F5            	PUSH AF		;[ZEILE_ZU_PIXEL] DE = Textzeile/-spalte -> D = Y-Bildpunkt, E = X: Spalte * Breite des Zeichens 20H (ZG), Zeile * 10, Y = F8H - 10*Zeile + Rollzaehler
01BC  C5            	PUSH BC
01BD  E5            	PUSH HL
01BE  D5            	PUSH DE
01BF  2A 40 FB      	LD HL,(FB40H)
01C2  4E            	LD C,(HL)
01C3  23            	INC HL
01C4  23            	INC HL
01C5  7E            	LD A,(HL)
01C6  91            	SUB C
01C7  6B            	LD L,E
01C8  26 00         	LD H,00H
01CA  CD 37 02      	CALL MUL8
01CD  7C            	LD A,H
01CE  FE 02         	CP 02H
01D0  38 03         	JR C,L01D5
01D2  21 FF 01      	LD HL,01FFH
L01D5:
01D5  E3            	EX (SP),HL
01D6  3E 0A         	LD A,0AH
01D8  2E 00         	LD L,00H
01DA  CD 37 02      	CALL MUL8
01DD  A7            	AND A
01DE  28 02         	JR Z,L01E2
01E0  26 FF         	LD H,FFH
L01E2:
01E2  7C            	LD A,H
01E3  2F            	CPL
01E4  D6 07         	SUB 07H
01E6  67            	LD H,A
01E7  3A 4A FB      	LD A,(FB4AH)
01EA  84            	ADD A,H
01EB  E6 FE         	AND FEH
01ED  67            	LD H,A
01EE  D1            	POP DE
01EF  19            	ADD HL,DE
01F0  EB            	EX DE,HL
01F1  E1            	POP HL
01F2  C1            	POP BC
01F3  F1            	POP AF
01F4  C9            	RET
KURSOR_EIN:
01F5  F5            	PUSH AF		;[KURSOR_EIN] Kursorstrich unter der Kursorposition FB5CH in Vordergrundfarbe
01F6  3A 46 FB      	LD A,(FB46H)
01F9  18 04         	JR L01FF
KURSOR_AUS:
01FB  F5            	PUSH AF		;[KURSOR_AUS] ebenso in Hintergrundfarbe
01FC  3A 4B FB      	LD A,(FB4BH)
L01FF:
01FF  D5            	PUSH DE
0200  C5            	PUSH BC
0201  ED 5B 5C FB   	LD DE,(FB5CH)		;DE = Kursor in Bildpunkten (FB5CH)
0205  4F            	LD C,A
0206  CB 42         	BIT 0,D
0208  CB 82         	RES 0,D
020A  28 02         	JR Z,L020E
020C  CB D9         	SET 3,C
L020E:
020E  42            	LD B,D
020F  05            	DEC B
0210  3E 06         	LD A,06H		;6 Bildpunkte breiter waagerechter Strich in der Zeile Y-1
L0212:
0212  1C            	INC E
0213  20 08         	JR NZ,L021D
0215  1D            	DEC E
0216  CB 59         	BIT 3,C
0218  20 03         	JR NZ,L021D
021A  1C            	INC E
021B  CB D9         	SET 3,C
L021D:
021D  ED 59         	OUT (C),E
021F  3D            	DEC A
0220  20 F0         	JR NZ,L0212
0222  C1            	POP BC
0223  D1            	POP DE
0224  F1            	POP AF
0225  C9            	RET
VIS_KOMMANDO:
0226  3A 4B FB      	LD A,(FB4BH)		;[VIS_KOMMANDO] B = Opcode an C = FB4BH | 04H (Funktion 1xx = Bildkommando) [BDA S.20]
0229  CB D7         	SET 2,A
022B  4F            	LD C,A
022C  ED 41         	OUT (C),B
022E  01 20 00      	LD BC,0020H		;Wartezeit 32*256 DJNZ (ca. 43 ms): die VIS 2a fuehrt Loeschen/Rollen selbst aus; im Emulator genuegt sofortige Ausfuehrung [?]
L0231:
0231  10 FE         	DJNZ L0231
0233  0D            	DEC C
0234  20 FB         	JR NZ,L0231
0236  C9            	RET
MUL8:
0237  06 08         	LD B,08H		;[MUL8] HL = HL * A (8 Bit), Ergebnis in H:L:A
0239  EB            	EX DE,HL
023A  21 00 00      	LD HL,0000H
L023D:
023D  1F            	RRA
023E  30 01         	JR NC,L0241
0240  19            	ADD HL,DE
L0241:
0241  CB 1C         	RR H
0243  CB 1D         	RR L
0245  10 F6         	DJNZ L023D
0247  1F            	RRA
0248  44            	LD B,H
0249  65            	LD H,L
024A  6F            	LD L,A
024B  78            	LD A,B
024C  C9            	RET

; ---- CON: Zeileneingabe einrichten, Textausgabe WBN/OUT/WLN ----------------------------------
CON_LESEN:
024D  36 00         	LD (HL),00H		;[CON_LESEN] READ BINARY / READ LINE: Zeile ab leerem Puffer
CON_EINGABE:
024F  E5            	PUSH HL		;[CON_EINGABE] INPUT (48H): Puffer HL, Laenge C; Eingabe laeuft im Tastaturinterrupt
0250  21 42 FB      	LD HL,FB42H
0253  F3            	DI		;FB42H Bit 7 = Zeileneingabe aktiv; war es schon gesetzt: Fehler C2H (Geraet belegt)
0254  CB 7E         	BIT 7,(HL)
0256  CB FE         	SET 7,(HL)
0258  FB            	EI
0259  E1            	POP HL
025A  28 05         	JR Z,L0261
025C  FD 36 0A C2   	LD (IY+10),C2H
0260  C9            	RET
L0261:
0261  FD 22 4E FB   	LD (FB4EH),IY		;IY des Auftraggebers merken (FB4EH); die Interruptroutine meldet ueber (IY+10)
0265  FD 36 0A 00   	LD (IY+10),00H
0269  22 50 FB      	LD (FB50H),HL		;Textpuffer: Anfang FB50H, Kursor FB54H, max. Ende FB52H = Anfang + Laenge
026C  22 54 FB      	LD (FB54H),HL
026F  3E FF         	LD A,FFH		;FB7DH = FFH: kein Zeichen fuer TST anstehend
0271  32 7D FB      	LD (FB7DH),A
0274  E5            	PUSH HL
0275  06 00         	LD B,00H
0277  09            	ADD HL,BC
0278  22 52 FB      	LD (FB52H),HL
027B  2A 58 FB      	LD HL,(FB58H)		;Bildfenster-Anfang FB58H -> Fensterende/Kursor/aktuelles Ende
027E  E5            	PUSH HL
027F  22 5A FB      	LD (FB5AH),HL
0282  22 5C FB      	LD (FB5CH),HL
0285  22 5E FB      	LD (FB5EH),HL
0288  21 60 FB      	LD HL,FB60H		;FB60H Bit 0/1 (Rollen/Umbruch gesperrt) loeschen
028B  CB 8E         	RES 1,(HL)
028D  CB 86         	RES 0,(HL)
028F  41            	LD B,C
0290  FD 4E 0B      	LD C,(IY+11)		;C = (IY+11) = Spalte, auf die der Kursor nach der Vorgabe gestellt wird
0293  D1            	POP DE
0294  E1            	POP HL
L0295:
0295  7E            	LD A,(HL)		;Vorgabetext des Puffers anzeigen (bis zum ersten Steuerzeichen)
0296  E6 7F         	AND 7FH
0298  FE 09         	CP 09H
029A  28 04         	JR Z,L02A0
029C  FE 20         	CP 20H
029E  38 14         	JR C,L02B4
L02A0:
02A0  23            	INC HL
02A1  CD 01 01      	CALL ZEICHEN_AUS
02A4  0C            	INC C
02A5  0D            	DEC C
02A6  28 0A         	JR Z,L02B2
02A8  0D            	DEC C
02A9  20 07         	JR NZ,L02B2
02AB  ED 53 5C FB   	LD (FB5CH),DE
02AF  22 54 FB      	LD (FB54H),HL
L02B2:
02B2  10 E1         	DJNZ L0295
L02B4:
02B4  0C            	INC C
02B5  0D            	DEC C
02B6  28 07         	JR Z,L02BF
02B8  ED 53 5C FB   	LD (FB5CH),DE
02BC  22 54 FB      	LD (FB54H),HL
L02BF:
02BF  22 56 FB      	LD (FB56H),HL
02C2  FE 19         	CP 19H
02C4  01 FF FF      	LD BC,FFFFH
02C7  CC 25 03      	CALL Z,ZEICHEN_LOESCHEN
02CA  CD F5 01      	CALL KURSOR_EIN		;Kursor zeigen, FB42H Bit 0 setzen
02CD  21 42 FB      	LD HL,FB42H
02D0  CB C6         	SET 0,(HL)
02D2  FD CB 01 46   	BIT 0,(IY+1)		;(IY+1) Bit 0 = 1: Interruptbetrieb, sofort zurueck; sonst warten auf (IY+10) Bit 7
02D6  C0            	RET NZ
L02D7:
02D7  FD CB 0A 7E   	BIT 7,(IY+10)
02DB  28 FA         	JR Z,L02D7
02DD  C9            	RET
02DE  CD 82 00      	CALL BFE		;(nicht angesprungen [Befund]) BFE + WBN
WBN:
02E1  D5            	PUSH DE		;[WBN 0BC1H] Text HL, max. BC Zeichen ab Kursor, Steuerzeichen werden ausgefuehrt (07H Piep, 0CH Bild loeschen, 0DH CR, 19H Zeilenrest loeschen); Ende FFH
02E2  16 FF         	LD D,FFH
02E4  18 06         	JR L02EC
OUT_ZS:
02E6  CD 82 00      	CALL BFE		;[OUT 0BBEH] wie WLN, aber Position DE = Zeile/Spalte vorgeben [EGOS S.12]
WLN:
02E9  D5            	PUSH DE		;[WLN 0BD3H] wie WBN, endet zusaetzlich an 0DH
02EA  16 0D         	LD D,0DH
L02EC:
02EC  C5            	PUSH BC
02ED  D5            	PUSH DE
02EE  ED 5B 58 FB   	LD DE,(FB58H)		;DE = aktuelle Ausgabeposition FB58H (Bildpunkte)
L02F2:
02F2  78            	LD A,B
02F3  B1            	OR C
02F4  28 20         	JR Z,L0316
02F6  0B            	DEC BC
02F7  7E            	LD A,(HL)
02F8  23            	INC HL
02F9  FE FF         	CP FFH
02FB  28 19         	JR Z,L0316
02FD  E6 7F         	AND 7FH
02FF  FE 0C         	CP 0CH		;0CH = Bild loeschen (CLB)
0301  CC 3B 00      	CALL Z,CLB
0304  FE 07         	CP 07H		;07H -> OUT (D0H): Piep der Tastatur (SIO A Senden)
0306  20 04         	JR NZ,L030C
0308  D3 D0         	OUT (D0H),A
030A  18 E6         	JR L02F2
L030C:
030C  E3            	EX (SP),HL		;Endezeichen (D vom Aufrufer: FFH oder 0DH) erreicht?
030D  BC            	CP H
030E  E3            	EX (SP),HL
030F  28 05         	JR Z,L0316
0311  CD 01 01      	CALL ZEICHEN_AUS
0314  18 DC         	JR L02F2
L0316:
0316  ED 53 58 FB   	LD (FB58H),DE		;Position merken; BC = geschriebene Zeichen
031A  33            	INC SP
031B  33            	INC SP
031C  E3            	EX (SP),HL
031D  B7            	OR A
031E  ED 42         	SBC HL,BC
0320  44            	LD B,H
0321  4D            	LD C,L
0322  E1            	POP HL
0323  D1            	POP DE
0324  C9            	RET
ZEICHEN_LOESCHEN:
0325  69            	LD L,C		;[ZEICHEN_LOESCHEN] BC Bildpunktspalten ab DE in Hintergrundfarbe (8 Bildzeilen)
0326  60            	LD H,B
0327  3A 4B FB      	LD A,(FB4BH)
032A  4F            	LD C,A
L032B:
032B  7D            	LD A,L
032C  B4            	OR H
032D  C8            	RET Z
032E  2B            	DEC HL
032F  3E 08         	LD A,08H
0331  42            	LD B,D
0332  CB 40         	BIT 0,B
0334  CB 80         	RES 0,B
0336  28 02         	JR Z,L033A
0338  CB D9         	SET 3,C
L033A:
033A  ED 59         	OUT (C),E
033C  04            	INC B
033D  3D            	DEC A
033E  20 FA         	JR NZ,L033A
0340  78            	LD A,B
0341  D6 08         	SUB 08H
0343  47            	LD B,A
0344  B7            	OR A
0345  1C            	INC E
0346  20 E3         	JR NZ,L032B
0348  1D            	DEC E
0349  CB 42         	BIT 0,D
034B  CB C2         	SET 0,D
034D  C0            	RET NZ
034E  1C            	INC E
034F  18 DA         	JR L032B

; ---- CON -- Konsolentreiber mit RIO-Schnittstelle (IY-Vektor) [EGOS S.14-16] -----------------
CON:
0351  FD E5         	PUSH IY		;[CON 0BEEH] Konsolentreiber; IY = RIO-Vektor, (IY+1) = Anforderung (Bit 0 = Interruptbetrieb wird ausgeblendet)
0353  E1            	POP HL
0354  23            	INC HL
0355  7E            	LD A,(HL)
0356  E6 FE         	AND FEH
0358  23            	INC HL
0359  5E            	LD E,(HL)		;DE = (IY+2/3) Datenadresse, BC = (IY+4/5) Laenge -> HL = Daten
035A  23            	INC HL
035B  56            	LD D,(HL)
035C  23            	INC HL
035D  4E            	LD C,(HL)
035E  23            	INC HL
035F  46            	LD B,(HL)
0360  EB            	EX DE,HL
0361  FE 02         	CP 02H		;00 INITIALIZE
0363  38 2B         	JR C,L0390
0365  FE 08         	CP 08H		;02..07: nichts zu tun (80H); 08: ungueltig
0367  38 38         	JR C,L03A1
0369  28 20         	JR Z,L038B
036B  FE 0A         	CP 0AH		;0AH READ BINARY / 0CH READ LINE
036D  28 02         	JR Z,L0371
036F  FE 0C         	CP 0CH
L0371:
0371  CA 4D 02      	JP Z,CON_LESEN
0374  FE 0E         	CP 0EH		;0EH WRITE BINARY
0376  28 20         	JR Z,L0398
0378  FE 10         	CP 10H		;10H WRITE LINE
037A  28 2A         	JR Z,L03A6
037C  FE 40         	CP 40H		;40H READ STATUS, 42H WRITE STATUS, 48H INPUT; Rest ungueltig (C1H)
037E  38 0B         	JR C,L038B
0380  28 29         	JR Z,L03AB
0382  FE 42         	CP 42H
0384  28 32         	JR Z,L03B8
0386  FE 48         	CP 48H
0388  CA 4F 02      	JP Z,CON_EINGABE
L038B:
038B  FD 36 0A C1   	LD (IY+10),C1H		;Fertigstellungscode C1H 'Operation ungueltig'
038F  C9            	RET
L0390:
0390  CD D3 03      	CALL CON_INIT		;INITIALIZE: Zellen + ASP neu einrichten, Bild loeschen
0393  CD 3B 00      	CALL CLB
0396  18 09         	JR L03A1
L0398:
0398  CD E1 02      	CALL WBN		;WRITE BINARY = WBN; Laenge zurueck nach (IY+4/5)
L039B:
039B  FD 71 04      	LD (IY+4),C
039E  FD 70 05      	LD (IY+5),B
L03A1:
03A1  FD 36 0A 80   	LD (IY+10),80H		;Fertigstellungscode 80H 'fehlerfrei'
03A5  C9            	RET
L03A6:
03A6  CD E9 02      	CALL WLN		;WRITE LINE = WLN
03A9  18 F0         	JR L039B
L03AB:
03AB  EB            	EX DE,HL		;READ STATUS: (IY+4) Byte ab FB60H (Tastatur- und VIS-Zellen) in den Puffer
03AC  21 60 FB      	LD HL,FB60H
03AF  AF            	XOR A
03B0  47            	LD B,A
03B1  B1            	OR C
03B2  28 ED         	JR Z,L03A1
03B4  ED B0         	LDIR
03B6  18 E9         	JR L03A1
L03B8:
03B8  11 60 FB      	LD DE,FB60H		;WRITE STATUS: Puffer -> FB60H.., hoechstens 55H Byte; danach Kursor aus FB63H/64H neu
03BB  AF            	XOR A
03BC  47            	LD B,A
03BD  B1            	OR C
03BE  28 E1         	JR Z,L03A1
03C0  FE 85         	CP 85H
03C2  38 02         	JR C,L03C6
03C4  0E 55         	LD C,55H
L03C6:
03C6  ED B0         	LDIR
03C8  21 63 FB      	LD HL,FB63H
03CB  5E            	LD E,(HL)
03CC  23            	INC HL
03CD  56            	LD D,(HL)
03CE  CD 82 00      	CALL BFE
03D1  18 CE         	JR L03A1
CON_INIT:
03D3  21 4B 04      	LD HL,SIO_A_ISR		;[CON_INIT] Vektor SIO-A-Empfang FFFCH = 044BH (FFF0H + 0CH, Status beeinflusst Vektor)
03D6  22 FC FF      	LD (FFFCH),HL
03D9  21 1B 04      	LD HL,TAB_VIS		;TAB_VIS -> FB40H.., TAB_TAST -> FB60H..
03DC  11 40 FB      	LD DE,FB40H
03DF  01 10 00      	LD BC,0010H
03E2  C5            	PUSH BC
03E3  ED B0         	LDIR
03E5  11 60 FB      	LD DE,FB60H
03E8  C1            	POP BC
03E9  ED B0         	LDIR
03EB  06 02         	LD B,02H		;CTC ASP K0 (D4H): Zaehler /4 -> SIO-A-Takt
03ED  0E D4         	LD C,D4H
03EF  ED B3         	OTIR
03F1  06 05         	LD B,05H		;SIO ASP Kanal B (D3H)
03F3  0E D3         	LD C,D3H
03F5  ED B3         	OTIR
03F7  06 09         	LD B,09H		;SIO ASP Kanal A (D1H) = Tastatur 9600 Bd, 7 Bit, ungerade, 2 Stoppbit
03F9  0E D1         	LD C,D1H
03FB  ED B3         	OTIR
03FD  21 90 90      	LD HL,9090H		;FB7EH/FB7FH = 90H: Tastaturzustand (gemeldet/gewuenscht), s. TASTE_ISR
0400  22 7E FB      	LD (FB7EH),HL
0403  0E D4         	LD C,D4H
0405  21 6F 04      	LD HL,TASTE_ISR		;Vektor CTC ASP K3 FFEEH = 046FH
0408  22 EE FF      	LD (FFEEH),HL
040B  3E E8         	LD A,E8H		;CTC ASP Vektorbasis E8H (FFE8H-FFEFH)
040D  ED 79         	OUT (C),A
040F  0C            	INC C
0410  0C            	INC C
0411  0C            	INC C
0412  3E 07         	LD A,07H		;CTC ASP K3 (D7H): 07H Zeitgeber, Vorteiler 16, Interrupt AUS, ZK = 01H
0414  ED 79         	OUT (C),A
0416  3E 01         	LD A,01H
0418  ED 79         	OUT (C),A
041A  C9            	RET

; ---- Initialisierungstabellen (VIS-/Tastaturzellen, ASP-CTC, ASP-SIO) ------------------------
TAB_VIS:
041B  A4 0C 00 0A D7 FF C1 C0 FF FF 00 C0 00 F6 FF 00	DB	0A4H,0CH,00H,0AH,0D7H,0FFH,0C1H,0C0H,0FFH,0FFH,00H,0C0H,00H,0F6H,0FFH,00H		;TAB_VIS: 16 Byte -> FB40H..FB4FH (CON-Init 03D9H): FB40/41 = 0CA4H Zeichengenerator, FB42 = 00 Status, FB43 = 0AH Zeilenhoehe, FB44/45 = D7H (CTC-ASP K3) / FFH Zeichen, FB46/47 = C1H/C0H Port 'hell'/'dunkel' (Vorder-/Hintergrund), FB48/49 = FFFFH, FB4A = 00 Rollzaehler, FB4B = C0H Bildhintergrund (VIS-Grundadresse), FB4C/4D = F600H lok. Stack, FB4E/4F = 00FFH
042B  87 00 00 00 00 20 40 60 80 A0 C0 E0 00 00 00 00	DB	87H,00H,00H,00H,00H,20H,40H,60H,80H,0A0H,0C0H,0E0H,00H,00H,00H,00H		;TAB_TAST: 16 Byte -> FB60H..FB6FH: FB60 = 87H Tastaturstatus, FB61..64 = 0, FB65.. = Tabulatoren 20H,40H,..,E0H (Pixel/2), Rest 0
043B  47 04         	DB	47H,04H		;TAB_CTC: -> D4H (CTC-ASP K0): 47H Zaehler, ZK folgt; 04H Zeitkonstante (SIO-A-Takt -> 9600 Bd, hardware_3x.md 6.2)
043D  18 02 F0 01 04	DB	18H,02H,0F0H,01H,04H		;TAB_SIO_B: -> D3H: 18H Kanalreset, WR2 = F0H (Vektorbasis FFF0H), WR1 = 04H (Status beeinflusst Vektor)
0442  18 14 4D 03 61 05 AA 01 18	DB	18H,14H,4DH,03H,61H,05H,0AAH,01H,18H		;TAB_SIO_A: -> D1H: 18H Reset, 14H/4DH WR4 (x16, 2 Stoppbit, Paritaet ungerade), 03H/61H WR3 (Rx 7 Bit, Auto-Enables, Rx ein), 05H/AAH WR5 (Tx 7 Bit, DTR, RTS, Tx ein), 01H/18H WR1 (Rx-Interrupt je Zeichen)

; ---- Tastatur: SIO-A-Empfangsinterrupt + nachgeordneter CTC-K3-Interrupt (Protokoll) ---------
SIO_A_ISR:
044B  FB            	EI		;[SIO_A_ISR] Zeichen von der Tastatur (Vektor FFFCH)
044C  F5            	PUSH AF
044D  DB D0         	IN A,(D0H)		;IN (D0H), 7 Bit
044F  E6 7F         	AND 7FH
0451  FE 20         	CP 20H		;>= 20H: Zeichen; 1CH..1FH: PRAEFIX -> FB7CH (gilt fuer alle folgenden Zeichen bis zum naechsten Praefix); 00H..1BH: Zeichen
0453  30 0A         	JR NC,L045F
0455  FE 1C         	CP 1CH
0457  38 06         	JR C,L045F
0459  32 7C FB      	LD (FB7CH),A
045C  F1            	POP AF
045D  ED 4D         	RETI
L045F:
045F  32 45 FB      	LD (FB45H),A		;Zeichen -> FB45H; CTC ASP K3 mit 91H (Interrupt ein, Zeitgeber, ohne neue ZK) anstossen: die eigentliche Verarbeitung laeuft im niedriger priorisierten CTC-Interrupt [EGOS S.21]
0462  C5            	PUSH BC
0463  ED 4B 44 FB   	LD BC,(FB44H)
0467  3E 91         	LD A,91H
0469  ED 79         	OUT (C),A
046B  C1            	POP BC
046C  F1            	POP AF
046D  ED 4D         	RETI
TASTE_ISR:
046F  FB            	EI		;[TASTE_ISR] CTC ASP K3 (Vektor FFEEH): Zeichen auswerten.  B = Zeichen (FB45H), FB7CH = Praefix, FB7FH = Tastaturzustand
0470  F5            	PUSH AF
0471  E5            	PUSH HL
0472  C5            	PUSH BC
0473  ED 4B 44 FB   	LD BC,(FB44H)		;CTC K3: Interrupt wieder aus (01H)
0477  3E 01         	LD A,01H
0479  ED 79         	OUT (C),A
047B  3A 7C FB      	LD A,(FB7CH)
047E  FE 1F         	CP 1FH		;Praefix 1FH: Zeichen | 80H (Funktions-/Kursortasten [?]); FB7FH Bit 3 sperrt (-> 1BH)
0480  20 0F         	JR NZ,L0491
0482  3A 7F FB      	LD A,(FB7FH)
0485  CB 5F         	BIT 3,A
0487  28 5B         	JR Z,L04E4
L0489:
0489  3E 1B         	LD A,1BH		;gesperrt: statt des Zeichens 1BH liefern [?]
048B  32 7D FB      	LD (FB7DH),A
048E  C3 1E 05      	JP L051E
L0491:
0491  E6 03         	AND 03H		;Praefix 1CH..1EH: Nummer 0..2
0493  F5            	PUSH AF
0494  3A 7F FB      	LD A,(FB7FH)
0497  4F            	LD C,A
0498  F1            	POP AF
0499  28 22         	JR Z,L04BD
049B  CB 4F         	BIT 1,A		;Praefix 1EH = SONDERTASTE: B ist eine Bitmaske; n = 40H -> 0, 20H -> 1, .. 01H -> 6, 00H -> 7; FB7FH Bit 1 sperrt
049D  28 3F         	JR Z,L04DE
049F  CB 49         	BIT 1,C
04A1  20 E6         	JR NZ,L0489
04A3  78            	LD A,B
04A4  06 FE         	LD B,FEH
04A6  37            	SCF
L04A7:
04A7  17            	RLA
04A8  04            	INC B
04A9  30 FC         	JR NC,L04A7
04AB  78            	LD A,B
04AC  21 1E 05      	LD HL,051EH		;Aussprung FED0H + 3n nur, wenn dort C3H (JP) steht [EGOS S.21-22]; RET kehrt nach 051EH zurueck
04AF  E5            	PUSH HL
04B0  6F            	LD L,A
04B1  87            	ADD A,A
04B2  85            	ADD A,L
04B3  21 D0 FE      	LD HL,FED0H
04B6  85            	ADD A,L
04B7  6F            	LD L,A
04B8  3E C3         	LD A,C3H
04BA  BE            	CP (HL)
04BB  C0            	RET NZ
04BC  E9            	JP (HL)
L04BD:
04BD  CB 51         	BIT 2,C		;Praefix 1CH (1. Ebene [?]): FB7FH Bit 2 sperrt; Bit 4 = Gross/Klein tauschen (Vorgabe an, FB7FH = 90H)
04BF  20 C8         	JR NZ,L0489
04C1  CB 61         	BIT 4,C
04C3  28 24         	JR Z,L04E9
04C5  78            	LD A,B
04C6  FE 5B         	CP 5BH
04C8  30 08         	JR NC,L04D2
04CA  FE 41         	CP 41H
04CC  38 1C         	JR C,L04EA
04CE  CB EF         	SET 5,A
04D0  18 18         	JR L04EA
L04D2:
04D2  FE 61         	CP 61H
04D4  38 14         	JR C,L04EA
04D6  FE 7B         	CP 7BH
04D8  30 10         	JR NC,L04EA
04DA  CB AF         	RES 5,A
04DC  18 0C         	JR L04EA
L04DE:
04DE  CB 41         	BIT 0,C		;Praefix 1DH (2. Ebene [?]): FB7FH Bit 0 sperrt
