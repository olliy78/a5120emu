1F8D  21 D1 1F      	LD HL,MB_TABELLE		;CTC ASP K2 (D6H) Zaehler /2 [?], K5020: 37H, 36H, 35H, 34H, 33H, 32H
1F90  06 02         	LD B,02H
1F92  0E D6         	LD C,D6H
1F94  ED B3         	OTIR
