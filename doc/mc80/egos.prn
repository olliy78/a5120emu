1FAD  ED B3         	OTIR
1FAF  0D            	DEC C
1FB0  06 03         	LD B,03H
1FB2  ED B3         	OTIR
1FB4  FB            	EI
1FB5  11 E8 FF      	LD DE,FFE8H		;Vektoren: FFEAH (CTC ASP K1) und FFB0H-FFBBH
1FB8  3E 01         	LD A,01H
1FBA  87            	ADD A,A
1FBB  83            	ADD A,E
1FBC  5F            	LD E,A
1FBD  21 E5 1F      	LD HL,MB_VEKTOREN
