0C18  0B            	DEC BC
0C19  11 04 40      	LD DE,4004H
0C1C  ED B0         	LDIR
0C1E  23            	INC HL		;... BFFCH = 'FE 00 40 seg*2': Weiterkettung auf 4000H des naechsten Segments
0C1F  36 FE         	LD (HL),FEH
0C21  23            	INC HL
0C22  36 00         	LD (HL),00H
0C24  23            	INC HL
0C25  36 40         	LD (HL),40H
0C27  23            	INC HL
0C28  07            	RLCA
0C29  77            	LD (HL),A
0C2A  E1            	POP HL
0C2B  CB 3D         	SRL L		;naechstes Segment, bis L leer
0C2D  20 D8         	JR NZ,L0C07
0C2F  21 FE BF      	LD HL,BFFEH		;letztes Segment: BFFCH-Kettung auf C000H (Segment 01) [EGOS S.6-7]
0C32  36 C0         	LD (HL),C0H
0C34  23            	INC HL
0C35  3E 01         	LD A,01H
0C37  77            	LD (HL),A
0C38  23            	INC HL
0C39  D3 85         	OUT (85H),A
L0C3B:
0C3B  36 FF         	LD (HL),FFH		;C000H-FFFFH mit FFH fuellen -- auch Stapel und FC00H-FFFFH (Schreibschutz muss aus sein)
0C3D  23            	INC HL
0C3E  7D            	LD A,L
0C3F  B4            	OR H
0C40  20 F9         	JR NZ,L0C3B
INIT_KETTE:
0C42  21 F5 7A      	LD HL,7AF5H		;[INIT_KETTE] Segment 1: 4000H frei bis BAF8H (Distanz 7AF5H)
0C45  22 01 40      	LD (4001H),HL
0C48  21 01 05      	LD HL,0501H		;BAF8H: Directory (Kennbyte 04, Distanz 0501H -> BFFCH) [EGOS S.11]
0C4B  22 F9 BA      	LD (BAF9H),HL
0C4E  3E 04         	LD A,04H
0C50  32 F8 BA      	LD (BAF8H),A
0C53  21 18 FE      	LD HL,FE18H		;FEFDH = 18H,FEH (JR $) fuer RST 38H
0C56  22 FD FE      	LD (FEFDH),HL
0C59  21 ED 45      	LD HL,45EDH		;FEE8H = EDH,45H (RETN) fuer NMI
0C5C  22 E8 FE      	LD (FEE8H),HL
0C5F  21 00 F0      	LD HL,F000H		;FBF6H = F000H [?] (BASIC-Systemzelle)
0C62  22 F6 FB      	LD (FBF6H),HL
0C65  21 71 0C      	LD HL,ADT_VORGABE		;ADT -> FC00H
0C68  11 00 FC      	LD DE,FC00H
0C6B  01 11 00      	LD BC,0011H
0C6E  ED B0         	LDIR
0C70  C7            	RST 00H		;RST 0: Neustart wie RESET [EGOS S.9]
ADT_VORGABE:
0C71  81 01 FE 0A 82 01 FE 0A 83 01 FE 0A 84 01 00 10	DB	81H,01H,0FEH,0AH,82H,01H,0FEH,0AH,83H,01H,0FEH,0AH,84H,01H,00H,10H		;ADT_VORGABE (17 Byte -> FC00H, INIT): 81 01 0AFE / 82 01 0AFE / 83 01 0AFE = CON als log. Geraet 1, 2, 3 (Segment 1); 84 01 1000 = KLOG log. Geraet 4; 00 = Tabellenende [EGOS S.10, S.17]
0C81  00            	DB	00H
0C82  FF FF FF FF   	DB	0FFH,0FFH,0FFH,0FFH

