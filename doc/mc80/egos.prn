; ---- Magnetband: Initialisierung (RESET-Routine, Kennbyte 03) und Sprungleiste 1FF7H ---------
MB_INIT:
1F76  E5            	PUSH HL		;[MB_INIT] F900H = FA30H (IX-Vektor), Status 0, Basis 30H
1F77  21 30 FA      	LD HL,FA30H
