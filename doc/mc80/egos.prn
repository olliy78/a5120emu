; ---- INIT -- RAM loeschen und ketten, Directory, ADT [EGOS S.9] ------------------------------
INIT:
0C00  3E 82         	LD A,82H		;[INIT] Parameter: letztes Segment als Einsernummer (2 Hexziffern, Vorgabe 01H)
0C02  CD 59 0A      	CALL ZLE
0C05  3E 01         	LD A,01H
L0C07:
0C07  D3 85         	OUT (85H),A		;je Segment: 4000H = Kennbyte 00 (frei), Distanz 7FF9H, FFH, Rest FFH ...
0C09  E5            	PUSH HL
0C0A  21 00 40      	LD HL,4000H
0C0D  75            	LD (HL),L
