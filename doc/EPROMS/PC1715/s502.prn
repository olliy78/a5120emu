0581  20 00       	DB	20H,00H		;SE-Register 20H := 00H: alle /SE und /LCK aktiv ...
0583  21 00       	DB	21H,00H		;... MO-Register 21H: Schreibzugriff uebernimmt /SE in /MO (alle Motoren an) -- Datenbyte egal [SH 1.5.2.2, Register A13:2]
0585  04 BF       	DB	04H,BFH		;Kopf anlegen /HL=0 (BFH)
0587  20 FF       	DB	20H,FFH		;SE-Register 20H := FFH: alle abwaehlen (Motoren laufen weiter)
0589  02 FF       	DB	02H,FFH		;Daten-PIO B Datenregister := FFH (Mode 1: ohne Wirkung; BRDY/ARDY-Anfangszustand [SH 1.5.3.6])
