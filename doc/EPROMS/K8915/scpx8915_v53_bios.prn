; ============================================================================
; scpx8915_v53_bios.prn  -  BIOS SCPX 8915 V5.3 (K8915 V3), D600H-EFEFH
;
; Quelle: doc/EPROMS/K8915/scpx8915_v53_sys.bin = Systemspuren der eigenen
; Bootdiskette (disks/k8915scpx_boot1.hfe), geladen wie vom ROM-Lader
; (tools/k8915_sysload.py): 12 272 Byte nach C000H-EFEFH, Einsprung D600H.
;   C000H  CCP   'SCPX V0/2 VEB ROBOTRON ELEKTRONIK ZELLA-MEHLIS (REZ), 1988';
;                beginnt mit JP C31DH / JP C319H -- nicht das DR-Layout
;   C800H  BDOS  Einsprung C806H (JP C811H + vier Fehlervektoren wie bei DR),
;                Texte 'SCPX ERR ON  : $BAD SECTOR$SELECT$FILE R/O$'
;   D600H  BIOS  (dieses Listing)
; CCP/BDOS sind nur abgegrenzt. Gegen das A5120-SCPX 1526 V1.7
; (disks/scpx17_cpa780_k5601.hfe) gibt es keinen verschoben gleichen Abschnitt
; ueber 85 Byte -- ein anderer Stand, fuer die Nachbildung ohne Belang.
;
; STATISCHES Disassemblat (tools/z80_disasm2.py, rekursiver Abstieg ab den 18
; Eintraegen der Sprungleiste, den IM-2-Vektoren und den zur Laufzeit gesetzten
; Vektoren, dazu linear die nur ueber Patches erreichbaren Varianten) +
; Handkommentare [STATISCH]. Keine Laufzeitbestaetigung -- es gibt noch keine
; K8915Machine. Erzeugt von tools/gen_k8915_bios_prn.py; Befunde im
; Design-Doc doc/design/16_k8915.md §4.4.
;
; Was der Kern fuer Etappe 3 daraus braucht (Kurzfassung):
;   - K5122 im /WAIT-Betrieb: der Lese-ISR E965H und der Schreibpfad EA94H
;     lesen/schreiben 16H/14H ausgerollt OHNE Statusabfrage.
;   - Interrupts (IM 2, I = FFH): SIO2-B (Tastatur) D0H..D6H, K5122-PIO1 A
;     (Index) F0H, PIO1 B Bit1 (Marke) F2H, CTC-ZRE K3 (Zeitgeber 37,6 Hz) FEH.
;   - Tastatur: K7672 im DCP-Modus, Scancodes Satz 1, Tabellen DC0FH..DCF1H.
;   - Port 61H = Anzeigefeld (E0H Lesen, D0H Schreiben, B0H bereit, 60H/50H Fehler).
;   - A8H nur 87H (Betrieb) und 06H (Bildspeicher, Warmstart ueber ROM 0406H).
; ============================================================================

	ORG	C000H

C000                	DS	2048		;CCP (abgegrenzt, s. Kopf)
C800                	DS	3584		;BDOS, Einsprung C806H (abgegrenzt)

JBOOT:
D600  C3 A7 D8      	JP D8A7H
JWBOOT:
D603  C3 FD D8      	JP D8FDH
JCONST:
D606  C3 60 D9      	JP D960H
JCONIN:
D609  C3 72 D9      	JP D972H
JCONOUT:
D60C  C3 F2 DC      	JP DCF2H
JLIST:
D60F  C3 99 DE      	JP DE99H
JPUNCH:
D612  C9            	RET		;PUNCH: nur RET
D613                	DB	00H,00H		;Rest von PUNCH (RET + 2 Fuellbytes)
JREADER:
D615  3E 1A         	LD A,1AH		;READER: liefert immer 1AH (^Z = Dateiende)
D617  C9            	RET
JHOME:
D618  C3 3C DF      	JP DF3CH
JSELDSK:
D61B  C3 4B DF      	JP DF4BH
JSETTRK:
D61E  C3 6C DF      	JP DF6CH
JSETSEC:
D621  C3 71 DF      	JP DF71H
JSETDMA:
D624  C3 76 DF      	JP DF76H
JREAD:
D627  C3 87 DF      	JP DF87H
JWRITE:
D62A  C3 49 E0      	JP E049H
JLISTST:
D62D  C3 A2 DE      	JP DEA2H
JSECTRAN:
D630  C3 7B DF      	JP DF7BH
JBIOS18:
D633  C3 92 E2      	JP E292H		;18. Eintrag (SCPX): JP E292H = Diskettentreiber zuruecksetzen, gerufen von WBOOT
D636  3E FF         	LD A,FFH		;Einhaengepunkt RAM-Disk E: (Laufwerksnummer 4, s. E019H/E225H): hier 'LD A,FFH / RET' = Fehler; RADE.COM patcht es auf seinen Treiber bei EE00H
D638  C9            	RET
D639                	DB	00H,50H,F1H,02H,35H,2EH,33H,4DH		;Konfiguration (DISGEN): D639H <>0 = Laufwerk E: (RAM-Disk) zugelassen, setzt RADE; D63AH Zeiger F150H (Tastaturpuffer); D63CH Laufwerkszahl (2); D63DH Versionsfeld '5.3M' (BIOS+3DH, von RADE geprueft)
D641                	DB	05H,72H,61H,64H,65H,0DH,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H		;Autostart: 40H Byte, beim Kaltstart nach F150H = TASTATURPUFFER kopiert (Zaehler 05, 'rade',CR) -- der CCP 'liest' das Kommando ueber CONIN
D651                	DB	00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H
D661                	DB	00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H
D671                	DB	00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H
D681                	DB	91H,44H,49H,53H,47H,45H,4EH,35H,33H,0DH,97H,4DH,38H,30H,20H,3DH		;F-Tasten-Belegung: Code 91H..9CH, danach Text bis zum naechsten Byte mit Bit7; FFH = Ende. F1 'DISGEN53'CR, F7 'M80 =', F8 'LINK', F9 'TP'CR, F10 'NSWP'CR, Umsch+BildAuf 'POWER'CR, Umsch+BildAb 'DIR'CR
D691                	DB	98H,4CH,49H,4EH,4BH,99H,54H,50H,0DH,9AH,4EH,53H,57H,50H,0DH,9BH
D6A1                	DB	50H,4FH,57H,45H,52H,0DH,9CH,44H,49H,52H,0DH,FFH
D6AD                	DB	00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H		;frei (00H)
D6BD                	DB	00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H
D6CD                	DB	00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H
D6DD                	DB	00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H
D6ED                	DB	00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H,00H
D6FD                	DB	00H,00H,00H,00H
D701                	DB	00H,00H,00H,00H,00H,00H,00H,00H,2AH,EFH,51H,D7H,DDH,EFH,AAH,EFH		;5 DPH (A:..E:), je 16 Byte: XLT=0, DIRBUF EF2AH, DPB, CSV, ALV
D711                	DB	00H,00H,00H,00H,00H,00H,00H,00H,2AH,EFH,74H,D7H,31H,F0H,FEH,EFH
D721                	DB	00H,00H,00H,00H,00H,00H,00H,00H,2AH,EFH,97H,D7H,85H,F0H,52H,F0H
D731                	DB	00H,00H,00H,00H,00H,00H,00H,00H,2AH,EFH,BAH,D7H,D9H,F0H,A6H,F0H
D741                	DB	00H,00H,00H,00H,00H,00H,00H,00H,2AH,EFH,DDH,D7H,2DH,F1H,FAH,F0H
D751                	DB	50H,00H,04H,0FH,00H,85H,01H,7FH,00H,C0H,00H,20H,00H,02H,00H,03H		;5 DPB + Treiberangaben, je 23H Byte (SELDSK: DPH+10 -> IY). A: 5x1024 (SPT 80, DSM 389, DRM 127, OFF 2) = cpa800; B: 16x256 (SPT 64, DSM 311); C:/D:/E: wie A:. IY+15 Sektorgroesse 0/1/2/3=128..1024, IY+20 Sektoren je Spur, IY+24 Laufwerksnummer, IY+21 Seiten
D761                	DB	16H,01H,03H,01H,05H,02H,50H,01H,00H,48H,50H,03H,32H,12H,50H,03H
D771                	DB	00H,00H,00H,40H,00H,04H,0FH,00H,37H,01H,7FH,00H,C0H,00H,20H,00H
D781                	DB	02H,00H,01H,16H,04H,03H,01H,10H,02H,50H,01H,01H,48H,50H,03H,32H
D791                	DB	12H,50H,03H,00H,00H,00H,50H,00H,04H,0FH,00H,85H,01H,7FH,00H,C0H
D7A1                	DB	00H,20H,00H,02H,00H,03H,16H,01H,03H,01H,05H,02H,50H,01H,02H,48H
D7B1                	DB	50H,03H,32H,12H,50H,03H,00H,00H,00H,50H,00H,04H,0FH,00H,85H,01H
D7C1                	DB	7FH,00H,C0H,00H,20H,00H,02H,00H,03H,16H,01H,03H,01H,05H,02H,50H
D7D1                	DB	01H,03H,48H,50H,03H,32H,12H,50H,03H,00H,00H,00H,50H,00H,04H,0FH
D7E1                	DB	00H,85H,01H,7FH,00H,C0H,00H,20H,00H,02H,00H,03H,16H,01H,03H,01H
D7F1                	DB	05H,02H,50H,01H,04H,48H,50H,03H,32H,12H,50H,03H,00H,00H
D7FF                	DB	00H,01H,07H,0DH,13H,19H,05H,0BH,11H,17H,03H,09H,0FH,15H,02H,08H		;Sektoruebersetzung 26 Sektoren, Versatz 6 (8-Zoll-Standard) -- kein DPH verweist darauf (alle XLT=0)
D80F                	DB	0EH,14H,1AH,06H,0CH,12H,18H,04H,0AH,10H
D819                	DB	16H,0AH,0DH,20H,20H,20H,20H,20H,20H,20H,20H,20H,20H,3EH,3EH,3EH		;Texte: Einschaltmeldung '>>>>> Konfigurierbare Datenstation K 8915 <<<<<', 'SCPX 8915 V 5.3 Anpassung: V24 (XON/XOFF)', 'System ?'
D829                	DB	'>>    Konfigurie'
D839                	DB	'rbare Datenstati'
D849                	DB	'on   K 8915    <'
D859                	DB	3CH,3CH,3CH,3CH,0AH,0AH,0DH,20H,20H,20H,20H,20H,20H,20H,20H,20H
D869                	DB	' SCPX 8915  V 5.'
D879                	DB	'3  Anpassung:  V'
D889                	DB	32H,34H,20H,20H,28H,58H,4FH,4EH,2FH,58H,4FH,46H,46H,29H,0AH,0DH
D899                	DB	24H,0AH,0DH,53H,79H,73H,74H,65H,6DH,20H,3FH,0AH,0DH,24H
BOOT:
D8A7  3E 87         	LD A,87H		;[BOOT] A8H=87H: Seiten 0-3 RAM, ROM aus (Design-Doc §4.2a)
D8A9  D3 A8         	OUT (A8H),A
D8AB  31 00 01      	LD SP,0100H
D8AE  3E 95         	LD A,95H		;IOBYTE (0003H) = 95H
D8B0  32 03 00      	LD (0003H),A
D8B3  21 E0 F7      	LD HL,F7E0H		;F7E0H..F7FAH loeschen und bei F7FBH 'JP D8F8H' ablegen (IOBYTE setzen + WBOOT) -- ein fester Einsprung fuer Fremdprogramme; weder ROM noch BIOS rufen F7FBH [?]
D8B6  06 1B         	LD B,1BH
D8B8  36 00         	LD (HL),00H
D8BA  23            	INC HL
D8BB  10 FB         	DJNZ D8B8H
D8BD  36 C3         	LD (HL),C3H
D8BF  23            	INC HL
D8C0  36 F8         	LD (HL),F8H
D8C2  23            	INC HL
D8C3  36 D8         	LD (HL),D8H
D8C5  AF            	XOR A		;Laufwerk/Nutzer (0004H) = 0, Zaehler Cursoradressierung (F1B7H) = 0
D8C6  32 04 00      	LD (0004H),A
D8C9  32 B7 F1      	LD (F1B7H),A
D8CC  3E B0         	LD A,B0H		;Port 61H = B0H: Anzeige 'bereit' (s. E011H)
D8CE  D3 61         	OUT (61H),A
D8D0  3E FF         	LD A,FFH		;I = FFH, IM 2: Vektortabelle ab FF00H, SIO2-B-Eintraege bei FFD0H (s. D9ACH)
D8D2  ED 47         	LD I,A
D8D4  ED 5E         	IM 2
D8D6  FB            	EI
D8D7  0E 0C         	LD C,0CH		;Bild loeschen (0CH), Einschaltmeldung ab D81AH ausgeben
D8D9  CD F2 DC      	CALL DCF2H
D8DC  21 1A D8      	LD HL,D81AH
D8DF  CD 53 D9      	CALL D953H
D8E2  CD 82 DE      	CALL DE82H		;Drucker-Schnittstelle SIO1-B einrichten (DE82H)
D8E5  CD 97 D9      	CALL D997H		;Tastatur einrichten (D997H): Puffer leeren, SIO2-B + IM-2-Tabelle, K7672-Kaltstartbefehle
D8E8  CD B6 E2      	CALL E2B6H		;Polaritaet von MKE (Port 12H Bit1) erkennen und den Treiber darauf einstellen (E2B6H)
D8EB  01 40 00      	LD BC,0040H		;Autostart: 40H Byte ab D641H in den Tastaturpuffer F150H ('rade' CR)
D8EE  11 50 F1      	LD DE,F150H
D8F1  21 41 D6      	LD HL,D641H
D8F4  ED B0         	LDIR
D8F6  18 30         	JR D928H
WBOOT_F7FB:
D8F8  3E 95         	LD A,95H		;[Einsprung ueber F7FBH] IOBYTE = 95H, weiter in WBOOT
D8FA  32 03 00      	LD (0003H),A
WBOOT:
D8FD  F3            	DI		;[WBOOT] DI, A8H=06H (ROM + Bildspeicher sichtbar), SP=F7E0H
D8FE  3E 06         	LD A,06H
D900  D3 A8         	OUT (A8H),A
D902  31 E0 F7      	LD SP,F7E0H
D905  3E 03         	LD A,03H		;03H an CTC-ZRE K3 (83H) und K5122-PIO1 A/B (11H/13H): Zeitgeber und Disketten-Interrupts aus, bevor der ROM-Lader laeuft
D907  00            	NOP
D908  00            	NOP
D909  D3 83         	OUT (83H),A
D90B  D3 11         	OUT (11H),A
D90D  D3 13         	OUT (13H),A
D90F  CD 06 04      	CALL 0406H		;CALL 0406H = Diskettenlader im Boot-ROM laedt CCP+BDOS neu; A = Ergebnis (0 = gut)
D912  47            	LD B,A
D913  3E 87         	LD A,87H		;A8H=87H (ROM aus), EI
D915  D3 A8         	OUT (A8H),A
D917  FB            	EI
D918  31 00 01      	LD SP,0100H
D91B  78            	LD A,B
D91C  A7            	AND A
D91D  28 06         	JR Z,D925H
D91F  21 30 17      	LD HL,1730H		;Ladefehler: Cursor an den Anfang der letzten Zeile (1730H = 1000H + 23*80)
D922  22 B5 F1      	LD (F1B5H),HL
D925  CD AC D9      	CALL D9ACH		;SIO2-B und IM-2-Tabelle neu (D9ACH)
D928  CD 92 E2      	CALL E292H		;Diskettentreiber zuruecksetzen (E292H), dann Seite 0 einrichten: JP D603H bei 0000H, JP C806H (BDOS) bei 0005H, DMA 0080H
D92B  3E C3         	LD A,C3H
D92D  32 00 00      	LD (0000H),A
D930  21 03 D6      	LD HL,D603H
D933  22 01 00      	LD (0001H),HL
D936  32 05 00      	LD (0005H),A
D939  21 06 C8      	LD HL,C806H
D93C  22 06 00      	LD (0006H),HL
D93F  01 80 00      	LD BC,0080H
D942  CD 76 DF      	CALL DF76H
D945  AF            	XOR A
D946  32 D8 F1      	LD (F1D8H),A
D949  32 DA F1      	LD (F1DAH),A
D94C  3A 04 00      	LD A,(0004H)
D94F  4F            	LD C,A
D950  C3 00 C0      	JP C000H		;JP C000H = CCP, C = Laufwerk/Nutzer
D953  4E            	LD C,(HL)		;Text ab HL bis '$' ueber CONOUT
D954  3E 24         	LD A,24H
D956  B9            	CP C
D957  C8            	RET Z
D958  E5            	PUSH HL
D959  CD F2 DC      	CALL DCF2H
D95C  E1            	POP HL
D95D  23            	INC HL
D95E  18 F3         	JR D953H
CONST:
D960  00            	NOP		;[CONST] zehn NOP = Patchplatz; FFH, wenn der Tastaturpuffer F150H nicht leer ist
D961  00            	NOP
D962  00            	NOP
D963  00            	NOP
D964  00            	NOP
D965  00            	NOP
D966  00            	NOP
D967  00            	NOP
D968  00            	NOP
D969  00            	NOP
D96A  3A 50 F1      	LD A,(F150H)
D96D  A7            	AND A
D96E  C8            	RET Z
D96F  3E FF         	LD A,FFH
D971  C9            	RET
CONIN:
D972  00            	NOP		;[CONIN] zehn NOP = Patchplatz; wartet auf F150H<>0, nimmt F151H und schiebt den Puffer nach (LDIR) -- alles andere macht die Empfangs-ISR DA19H
D973  00            	NOP
D974  00            	NOP
D975  00            	NOP
D976  00            	NOP
D977  00            	NOP
D978  00            	NOP
D979  00            	NOP
D97A  00            	NOP
D97B  00            	NOP
D97C  3A 50 F1      	LD A,(F150H)
D97F  A7            	AND A
D980  28 FA         	JR Z,D97CH
D982  F3            	DI
D983  3D            	DEC A
D984  32 50 F1      	LD (F150H),A
D987  4F            	LD C,A
D988  21 51 F1      	LD HL,F151H
D98B  7E            	LD A,(HL)
D98C  28 07         	JR Z,D995H
D98E  06 00         	LD B,00H
D990  54            	LD D,H
D991  5D            	LD E,L
D992  23            	INC HL
D993  ED B0         	LDIR
D995  FB            	EI
D996  C9            	RET
D997  AF            	XOR A		;Tastatur-Init: Puffer und Umschaltzustand F14FH loeschen, SIO2-B einrichten, Kaltstartbefehle DBE6H an die K7672 senden
D998  32 50 F1      	LD (F150H),A
D99B  32 4F F1      	LD (F14FH),A
D99E  CD AC D9      	CALL D9ACH
D9A1  21 E6 DB      	LD HL,DBE6H
D9A4  CD C7 DB      	CALL DBC7H
D9A7  AF            	XOR A
D9A8  32 50 F1      	LD (F150H),A
D9AB  C9            	RET
D9AC  01 08 00      	LD BC,0008H		;IM-2-Tabelle D9D5H nach (I)<<8|D0H = FFD0H kopieren, dann Init-Tabelle D9C7H: 2 Byte an 5AH (CTC2-K2), 12 Byte an 53H (SIO2-B)
D9AF  ED 57         	LD A,I
D9B1  57            	LD D,A
D9B2  1E D0         	LD E,D0H
D9B4  21 D5 D9      	LD HL,D9D5H
D9B7  ED B0         	LDIR
D9B9  21 C7 D9      	LD HL,D9C7H
D9BC  01 5A 02      	LD BC,025AH
D9BF  ED B3         	OTIR
D9C1  01 53 0C      	LD BC,0C53H
D9C4  ED B3         	OTIR
D9C6  C9            	RET
D9C7                	DB	07H,01H,00H,18H,04H,44H,03H,C1H,05H,EAH,01H,17H,02H,D0H		;Init CTC2-K2 (5AH: 07H,01H = 9600 Bd) und SIO2-B (53H: 00,18H Kanalreset, WR4=44H, WR3=C1H, WR5=EAH, WR1=17H, WR2=D0H Vektor)
D9D5                	DB	DDH,D9H,ECH,D9H,19H,DAH,FBH,D9H		;IM-2-Tabelle -> FFD0H (I=FFH): SIO2-B Tx-leer D9DDH, Ext/Status D9ECH, Rx-Zeichen DA19H, Rx-Sonderfall D9FBH ('status affects vector')
ISR_FFD0:
D9DD  ED 73 00 EF   	LD (EF00H),SP		;[ISR SIO2-B Tx leer] WR0 = 28H (Tx-Interrupt zuruecksetzen); eigener Stapel EF2AH
D9E1  31 2A EF      	LD SP,EF2AH
D9E4  F5            	PUSH AF
D9E5  C5            	PUSH BC
D9E6  D5            	PUSH DE
D9E7  E5            	PUSH HL
D9E8  06 28         	LD B,28H
D9EA  18 1C         	JR DA08H
ISR_FFD2:
D9EC  ED 73 00 EF   	LD (EF00H),SP		;[ISR SIO2-B Ext/Status] WR0 = 10H (Ext/Status zuruecksetzen)
D9F0  31 2A EF      	LD SP,EF2AH
D9F3  F5            	PUSH AF
D9F4  C5            	PUSH BC
D9F5  D5            	PUSH DE
D9F6  E5            	PUSH HL
D9F7  06 10         	LD B,10H
D9F9  18 0D         	JR DA08H
ISR_FFD6:
D9FB  ED 73 00 EF   	LD (EF00H),SP		;[ISR SIO2-B Rx-Sonderfall] WR0 = 30H (Fehler zuruecksetzen)
D9FF  31 2A EF      	LD SP,EF2AH
DA02  F5            	PUSH AF
DA03  C5            	PUSH BC
DA04  D5            	PUSH DE
DA05  E5            	PUSH HL
DA06  06 30         	LD B,30H
DA08  AF            	XOR A
DA09  D3 53         	OUT (53H),A
DA0B  78            	LD A,B
DA0C  D3 53         	OUT (53H),A
DA0E  E1            	POP HL
DA0F  D1            	POP DE
DA10  C1            	POP BC
DA11  F1            	POP AF
DA12  ED 7B 00 EF   	LD SP,(EF00H)
DA16  FB            	EI
DA17  ED 4D         	RETI
ISR_FFD4:
DA19  ED 73 00 EF   	LD (EF00H),SP		;[ISR SIO2-B Rx-Zeichen = TASTATUR] Scancode (PC/XT Satz 1) von der K7672 im DCP-Modus; 00H wird verworfen. F14FH = Zustand: Bit0 Strg, Bit1 Feststell, Bit2 Umschalt, Bit3 XOFF
