; ============================================================================
; s550.prn  -  PC 1715W  Urlader-ROM S550 (A6, U2716), 2 KB, Bank 0 0000H-07FFH (gespiegelt bis 0FFFH)
;
; Quelle : doc/EPROMS/PC1715W/pc1715w_s550_urlader.bin  (CRC32 0a96c754, MD5 f172cb0d1b6dc56692ee6d3d7dfb1691,
;          bytegleich mit S550.BIN aus xepb.org/robotron docs/1715w.zip); Kennung "111715W070887" ab 000BH
; Erzeugt: rohes Disassemblat tools/z80_disasm2.py + Handkommentare (AP-W0, 2026-10-03)
; Belege : [Bl. A..E] = Stromlaufplan 1715W (1.93.310411.8/04, Scans aus 1715w.zip),
;          [CRT A/B] = Stromlauf CRT-Steuerung 1715W, [LDR] = SCP-3.0-Lader in den Systemspuren
;          von tests/fixtures/disks/pc1715w_scp30_system.hfe (derselbe Treiber, erweitert),
;          [BIOS] = SCP3.SYS derselben Diskette.  [?] = Deutung ohne unmittelbaren Beleg.
; STATISCHE Analyse - kein Emulator des 1715W, keine Laufzeitbestaetigung.
; Hardwarebeschreibung: doc/pc1715/pc1715w_hardware.md
;
; ---- Auffaelligste Befunde ------------------------------------------------------------
;  * KEINE Bildschirmausgabe: der Urlader beruehrt weder den 8275 (18H/19H) noch 1AH/1BH,
;    weder ZG- noch Bild-RAM.  Bild bleibt dunkel, bis der geladene Lader den Zeichensatz
;    nach 2000H schreibt und den 8275 startet.  Kein Fehlertext, kein V.24-Boot.
;  * Benutzte Ports (vollstaendig, aus den Opcodes): OUT 00H (DMA), 20H (KRFD), 24H (BR),
;    28H (MOS); IN 00H (DMA-Register, INIR), 1CH (FDC-MSR), 1DH (FDC-Daten), 34H (KON).
;    Die in Plan 21 Par. 4 genannten "IN 04/3A/3B" sind Fehlgriffe einer Bytesuche
;    (DB 04/DB 3A/DB 3B stehen dort als Operanden von JR/LD-Befehlen).
;  * Laeuft nur die ersten 50 Befehle aus dem ROM: kopiert sich nach 4000H (Bank 0, RAM-Block
;    B1), schaltet BR = 11H und kopiert sich zurueck nach 0000H - ab 003FH laeuft alles aus dem
;    RAM in Bank 1.  Arbeitszellen IM ROM-BEREICH (074BH-0763H, 02C5H, Selbstaenderung 0046H)
;    gehen nur, weil das RAM ist.
;  * Interruptbetrieb IM 2, I = 12H, einziger Vektor: DMA (Vektor 14H, Tabelle 1214H).  Der
;    U8272 wird gepollt (MSR, SENSE INTERRUPT STATUS); sein INT wird nicht benutzt.
;  * Floppy nur ueber DMA: READ DATA (06H|MFM) mit DMA Port B = 41H, Byte-Betrieb, /RDY
;    low-aktiv, Interrupt bei Blockende; KRFD Bit 7 gibt TC frei (TC = DMA-Blockende), die
;    ISR nimmt Bit 7 zurueck.  Benutzte U8272-Befehle: SPECIFY 03, RECALIBRATE 07, SEEK 0F,
;    SENSE INTERRUPT STATUS 08, READ ID 0A, SENSE DRIVE STATUS 04, READ DATA 06.
;
; ---- Speicher waehrend des Laufs (alles Bank 1 = Block B1) -------------------------------
;   0000-07FF Kopie des Urladers (Code + Arbeitszellen)   1000-100D Parameterblock (IX)
;   1012-1091 Ladeliste (erster Satz)   1192 Stapel   1214 Vektor DMA   1392-13B1 Formatbeschreibungen
;   13B2-3BB1 Spurpuffer (DMA-Ziel, bis 10 KB)   3BB4-3BF9 Treiberzellen   4000-... Ziel des SCP-3.0-Laders
;
; ---- Ablauf ------------------------------------------------------------------------------
;   1 DI, KRFD 30H (FDC im Reset), IM 2/I 12H, EI; ROM -> 4000H; BR 11H; zurueck nach 0000H
;   2 NEUSTART: Laufwerk weiterzaehlen (0,1,2,3,0,... endlos), FDC-Grundzustand (Reset-Puls
;     KRFD 30H/70H, DMA-Blindlauf an Port 40H), Motor an (MOS 11H/22H/44H/88H), ~1,4 s
;     (spaeter ~2,8 s) warten
;   3 FORMAT_SUCHEN: READ ID mit vier Beschreibungen (8" MFM 26x256, 8" FM 26x128, 5,25"
;     MFM/FM); die Sektorlaenge N nimmt er aus dem gelesenen ID-Feld.  Nichts -> naechstes LW
;   4 BOOT: Spur 0, Kopf 0, Sektor 1 nach 13B2H.  Beginnt er mit 03H F0H, folgen ab Offset 64H
;     drei Formatbeschreibungen (SCP 3.0: 50H Spuren, 5 Sektoren, N = 3, ...), Wort bei Offset 4
;     = Satznummer der Ladeliste + 1, Wort bei Offset 9 = Startadresse, ab Offset 0CH die
;     Ladeliste (Adresse, Zahl der 128-Byte-Saetze; FFH Ende).  SCP 3.0: 79 Saetze ab Satz 1
;     nach 4000H, Start 4000H
;   5 Laden spurweise (Rest der Spur in EINEM READ DATA per DMA), Seiten-/Spurwechsel nach den
;     Formatbeschreibungen
;   6 FDC-Grundzustand, Motoren aus, DI, Sprung zur Startadresse; H = Bootlaufwerk, BR = 11H
;   Fehlerweg: jeder Treiberfehler -> NEUSTART mit dem naechsten Laufwerk (keine Meldung).
;   Treiber-Fehlercodes (IX+14): 20H Lesefehler, 52H nicht bereit, 53H Schreibschutz,
;   61H FDC-Ergebnisphase haengt, 62H SPECIFY, 63H SEEK/RECALIBRATE, 64H Suchen dauert,
;   F1H 8"-Format, aber DIP S8 Bit 0 = 0, F2H READ ID fehlerhaft, 01H Blockende nicht erreicht
;   mit ST2 = 40H [?]
;

; --- Symbolic labels (user-supplied) ---
START           EQU	0018H
IM_RAM          EQU	0032H
NEUSTART        EQU	003FH
NAECHSTES_LW    EQU	005BH
NAECHSTE_SPUR   EQU	0067H
BOOT            EQU	0082H
LADESCHLEIFE    EQU	00ACH
EINTRAG         EQU	0124H
SATZ            EQU	012EH
STARTEN         EQU	0199H
WARTEN          EQU	01B2H
SEKTORLAENGE    EQU	01BBH
SPURLAENGE      EQU	01CBH
REST_DER_SPUR   EQU	01D2H
LESEN_N         EQU	01D9H
PUFFERENDE      EQU	01F7H
FMT_UEBERN      EQU	0214H
PB_INIT         EQU	0239H
TREIBER_RUF     EQU	0248H
FORMAT_SUCHEN   EQU	0250H
FMT_TABELLE     EQU	029AH
PB_VORLAGE      EQU	02C4H
LW_PARAM_8      EQU	02D2H
LW_PARAM_5      EQU	02DDH
TREIBER         EQU	02E8H
TREIBER_ENDE    EQU	032AH
FEHLER_ENDE     EQU	0344H
INIT_CMD        EQU	0347H
FDC_GRUNDZUSTANDEQU	034DH
FDC_RESET       EQU	035DH
KRFD_OUT        EQU	0363H
DIP_PRUEFEN     EQU	0369H
LW_EINRICHTEN   EQU	0379H
DMA_LADEN       EQU	047CH
ERGEBNIS_LESEN  EQU	04ACH
FDC_BEREIT      EQU	04E4H
ERGEBNIS_UND_DMAEQU	04F8H
ZEITUEBERLAUF   EQU	0501H
DMA_STATUS      EQU	0527H
AUSWERTEN       EQU	0539H
DMA_DUMMY       EQU	056BH
SPECIFY         EQU	0583H
SENSE_DRIVE     EQU	058FH
RECAL_UND_SEEK  EQU	05A2H
RECALIBRATE     EQU	05B0H
SEEK            EQU	05C7H
READ_ID         EQU	05D9H
SENSE_INT       EQU	05FAH
READ_ID_CMD     EQU	060CH
BEREIT_UND_SEEK EQU	062BH
WARTE_SEEK_ENDE EQU	0667H
DMA_TAB_LESEN   EQU	0689H
DMA_TAB_DUMMY   EQU	06A4H
CMD_SPECIFY     EQU	06BBH
CMD_RECAL       EQU	06BFH
CMD_SEEK        EQU	06C2H
CMD_SENSEINT    EQU	06C6H
CMD_READID      EQU	06C8H
CMD_SENSEDRV    EQU	06CBH
BEFEHL_UND_WARTENEQU	06D0H
DMA_ISR         EQU	06E7H
FDC_BEFEHL      EQU	070EH
ISR_MERKER      EQU	074BH
KRFD_KOPIE      EQU	074CH
CMD_RW          EQU	074DH

	ORG	0000H

0000  18 16      	JR START		;JR START.  Ab 0000H steht der Urlader nach RESET in Bank 0 (BR = 00H, A62/A63 von /RESET geloescht; /CEPROM = Lesebank 0, Bl. A A40)
0002  00         	DB	00H
sub_0003:
0003  C3 E8 02   	JP TREIBER		;Einsprung des Floppytreibers (CALL 0003H aus TREIBER_RUF): IX = Parameterblock
0006  00         	DB	00H
0007  00         	DB	00H
0008  00         	DB	00H
0009  00         	DB	00H
000A  00         	DB	00H
000B              	DB	'111715W070887'		;Kennung "111715W070887" (PC 1715W, 07.08.87)
START:
0018  F3         	DI		;Kaltstart
0019  3E 30      	LD A,30H		;KRFD (20H) <- 30H: Bit 6 = 0 haelt den U8272 im RESET, Bit 4 UESEL = 1, Bit 5 = 1, Bit 7 TC-Freigabe = 0
001B  D3 20      	OUT (20H),A
001D  ED 5E      	IM 2		;IM 2, I = 12H: einziger Vektor ist der DMA-Vektor 14H -> Tabelle 1214H (wird in DMA_LADEN gesetzt)
001F  3E 12      	LD A,12H
0021  ED 47      	LD I,A
0023  FB         	EI		;EI (ab hier kann nur die DMA unterbrechen, und die ist noch nicht programmiert)
0024  21 00 00   	LD HL,0000H		;ROM 0000-07FF (Lesebank 0 = EPROM) nach 4000-47FF kopieren; Schreibbank 0 bei 4000H = RAM-Block B1 (/CAS1, 74S287)
0027  11 00 40   	LD DE,4000H
002A  01 00 08   	LD BC,0800H
002D  ED B0      	LDIR
002F  C3 32 40   	JP 4032H		;weiter in der RAM-Kopie: 4032H
IM_RAM:
0032  3E 11      	LD A,11H		;--- laeuft bei 4032H (RAM, Block B1) ---  BR (24H) <- 11H: Lese- und Schreibbank 1.  Bank 1 = Block B1 ganz, also bleibt 4000H dieselbe Zelle
0034  D3 24      	OUT (24H),A
0036  EB         	EX DE,HL		;HL = 4800H, DE = 0800H nach dem LDIR
0037  01 00 08   	LD BC,0800H
003A  ED B8      	LDDR		;LDDR 4800..4001 -> 0800..0001: die Kopie zurueck an die Sollage, jetzt RAM in Bank 1 (Byte 0000H wird nicht kopiert)
003C  C3 3F 00   	JP NEUSTART		;ab hier laeuft alles aus dem RAM bei 0000-07FF (Bank 1); das ROM ist nicht mehr sichtbar
NEUSTART:
003F  31 92 11   	LD SP,1192H		;NEUSTART (auch Fehlerweg): Stapel 1192H
0042  CD 5B 00   	CALL NAECHSTES_LW		;Parameterblock neu, Treiber mit Befehl 80H (FDC-Grundzustand), Laufwerk weiterzaehlen (02C5H: 3 -> 0 beim ersten Mal)
0045  06 05      	LD B,05H		;B = 05H, nach dem ersten Durchlauf 0AH (Selbstaenderung in 004CH): Wartezeit Motoranlauf
L0047:
0047  CD B2 01   	CALL WARTEN		;je ~0,3 s warten (WARTEN, 47250 x 24 T bei 4 MHz) [?]
004A  10 FB      	DJNZ L0047
004C  3E 0A      	LD A,0AH		;Operand von 0045H auf 0AH setzen (SELBSTAENDERND)
004E  32 46 00   	LD (0046H),A
L0051:
0051  CD 50 02   	CALL FORMAT_SUCHEN		;FORMAT_SUCHEN: Read ID mit vier Formatbeschreibungen; Z = Laufwerk antwortet
0054  28 2C      	JR Z,BOOT		;gefunden -> BOOT
0056  CD 5B 00   	CALL NAECHSTES_LW		;sonst naechstes Laufwerk (0..3 reihum, endlos) - KEINE Meldung
0059  18 F6      	JR L0051
NAECHSTES_LW:
005B  CD 39 02   	CALL PB_INIT		;Parameterblock 1000H aus der Vorlage, Befehl 80H ausfuehren
005E  21 C5 02   	LD HL,02C5H		;Bootlaufwerk 02C5H := (02C5H + 1) AND 3
0061  7E         	LD A,(HL)
0062  3C         	INC A
0063  E6 03      	AND 03H
0065  77         	LD (HL),A
0066  C9         	RET
NAECHSTE_SPUR:
0067  0C         	INC C		;naechste Spur/Seite waehrend des Ladens (C = Spur, B Bit 0 = Kopf)
0068  79         	LD A,C
0069  FD 96 00   	SUB (IY+0)
006C  D8         	RET C
006D  CB 40      	BIT 0,B
006F  20 CE      	JR NZ,NEUSTART
0071  FD CB 06 46	BIT 0,(IY+6)
0075  20 C8      	JR NZ,NEUSTART
0077  FD 7E 05   	LD A,(IY+5)
007A  A7         	AND A
007B  28 C2      	JR Z,NEUSTART
007D  01 00 01   	LD BC,L0100
0080  A7         	AND A
0081  C9         	RET
BOOT:
0082  3E 01      	LD A,01H		;BOOT: 1 Sektor (C=0, H=0, R=1 aus der Vorlage) nach 13B2H lesen
0084  CD D9 01   	CALL LESEN_N
0087  2A B2 13   	LD HL,(13B2H)		;HL = erstes Wort des Sektors.  Pruefung: nur F003H (Bytes 03 F0 = Kopf "03F0") gilt als Kopf mit Formattabelle
008A  E5         	PUSH HL
008B  11 00 10   	LD DE,1000H
008E  19         	ADD HL,DE
008F  30 1B      	JR NC,LADESCHLEIFE		;Wort < F000H -> ohne Formattabelle laden: Satznummer der Ladeliste = dieses Wort (LADESCHLEIFE)
0091  11 FE FF   	LD DE,FFFEH
0094  19         	ADD HL,DE
0095  30 A8      	JR NC,NEUSTART		;F000H/F001H/F002H -> NEUSTART
0097  11 FE FF   	LD DE,FFFEH
009A  19         	ADD HL,DE
009B  38 A2      	JR C,NEUSTART		;>= F004H -> NEUSTART
009D  2A B6 13   	LD HL,(13B6H)		;Kopf F003H: Satznummer der Ladeliste = Wort bei Offset 4 (SCP 3.0: 0001H -> Satz 0 = der Kopfsatz selbst)
00A0  E3         	EX (SP),HL
00A1  21 16 14   	LD HL,1416H		;Kopf ab Offset 64H (1416H): 3 x 8 + 4 Byte Formatbeschreibungen fuer Spur 0 / Rest / Seite 1 nach 1392H
00A4  11 92 13   	LD DE,1392H
00A7  01 1C 00   	LD BC,001CH
00AA  ED B0      	LDIR
LADESCHLEIFE:
00AC  E1         	POP HL		;LADESCHLEIFE: HL = Satznummer + 1 (DEC folgt); daraus Spur, Kopf und Sektor ausrechnen (Spur 0 zuerst nach Beschreibung 1392H, dann 13A2H/139AH)
00AD  2B         	DEC HL
00AE  FD 21 9A 13	LD IY,139AH
00B2  CD CB 01   	CALL SPURLAENGE
00B5  01 00 00   	LD BC,0000H
00B8  A7         	AND A
00B9  ED 52      	SBC HL,DE
00BB  38 3C      	JR C,L00F9
00BD  FD 7E 05   	LD A,(IY+5)
00C0  FD B6 06   	OR (IY+6)
00C3  28 0E      	JR Z,L00D3
L00C5:
00C5  FD 21 A2 13	LD IY,13A2H
00C9  CD CB 01   	CALL SPURLAENGE
00CC  06 01      	LD B,01H
00CE  A7         	AND A
00CF  ED 52      	SBC HL,DE
00D1  38 26      	JR C,L00F9
L00D3:
00D3  FD 21 92 13	LD IY,1392H
00D7  CD CB 01   	CALL SPURLAENGE
00DA  FD CB 06 46	BIT 0,(IY+6)
00DE  28 02      	JR Z,L00E2
L00E0:
00E0  06 00      	LD B,00H
L00E2:
00E2  CD 67 00   	CALL NAECHSTE_SPUR
00E5  30 DE      	JR NC,L00C5
00E7  A7         	AND A
00E8  ED 52      	SBC HL,DE
00EA  38 0D      	JR C,L00F9
00EC  FD CB 06 46	BIT 0,(IY+6)
00F0  28 F0      	JR Z,L00E2
00F2  06 01      	LD B,01H
00F4  A7         	AND A
00F5  ED 52      	SBC HL,DE
00F7  30 E7      	JR NC,L00E0
L00F9:
00F9  19         	ADD HL,DE		;(1002H) = Spur/Kopf (BC), dann Satznummer -> Byteoffset (x128)
00FA  ED 43 02 10	LD (1002H),BC
00FE  06 07      	LD B,07H
L0100:
0100  29         	ADD HL,HL
0101  10 FD      	DJNZ L0100
0103  CD BB 01   	CALL SEKTORLAENGE
0106  0E 00      	LD C,00H
L0108:
0108  0C         	INC C
0109  A7         	AND A
010A  ED 52      	SBC HL,DE
010C  30 FA      	JR NC,L0108
010E  19         	ADD HL,DE
010F  DD 71 04   	LD (IX+4),C		;IX+4 = Sektor (R)
0112  E5         	PUSH HL
0113  CD D2 01   	CALL REST_DER_SPUR		;Rest der Spur lesen (REST_DER_SPUR: von R bis Spurende in EINEM Read Data, DMA in den Puffer 13B2H)
0116  D1         	POP DE
0117  19         	ADD HL,DE
0118  01 80 00   	LD BC,0080H		;ersten 128-Byte-Satz des Puffers nach 1012H: das ist die Ladeliste
011B  11 12 10   	LD DE,1012H
011E  ED B0      	LDIR
0120  D9         	EXX		;Ladeliste ab 101EH: je Eintrag Zieladresse (2), Satzzahl (2); Endmarke FFH, FEH + Wort = neue Satznummer
0121  21 1D 10   	LD HL,101DH
EINTRAG:
0124  23         	INC HL		;naechster Eintrag: DE = Zieladresse, BC = Zahl der 128-Byte-Saetze
0125  5E         	LD E,(HL)
0126  23         	INC HL
0127  56         	LD D,(HL)
0128  23         	INC HL
0129  4E         	LD C,(HL)
012A  23         	INC HL
012B  46         	LD B,(HL)
012C  23         	INC HL
012D  D5         	PUSH DE
SATZ:
012E  D9         	EXX		;je Satz: Puffer erschoepft? (Pufferende 1010H)
012F  EB         	EX DE,HL
0130  2A 10 10   	LD HL,(1010H)
0133  A7         	AND A
0134  ED 52      	SBC HL,DE
0136  EB         	EX DE,HL
0137  30 42      	JR NC,L017B
0139  DD 7E 04   	LD A,(IX+4)		;ja: naechster Sektor; ueber das Spurende hinaus -> naechste Seite/Spur
013C  DD 86 07   	ADD A,(IX+7)
013F  DD 77 04   	LD (IX+4),A
0142  3D         	DEC A
0143  FD BE 01   	CP (IY+1)
0146  38 30      	JR C,L0178
0148  DD 36 04 01	LD (IX+4),01H
014C  ED 4B 02 10	LD BC,(1002H)
0150  FD 7E 05   	LD A,(IY+5)
0153  FD B6 06   	OR (IY+6)
0156  28 0C      	JR Z,L0164
0158  78         	LD A,B
0159  EE 01      	XOR 01H
015B  47         	LD B,A
015C  28 06      	JR Z,L0164
015E  79         	LD A,C
015F  A7         	AND A
0160  28 0B      	JR Z,L016D
0162  18 0D      	JR L0171
L0164:
0164  FD 21 92 13	LD IY,1392H
0168  CD 67 00   	CALL NAECHSTE_SPUR
016B  38 04      	JR C,L0171
L016D:
016D  FD 21 A2 13	LD IY,13A2H
L0171:
0171  CD CB 01   	CALL SPURLAENGE
0174  ED 43 02 10	LD (1002H),BC
L0178:
0178  CD D2 01   	CALL REST_DER_SPUR		;Rest der naechsten Spur nach 13B2H lesen
L017B:
017B  D1         	POP DE		;128 Byte aus dem Puffer an die Zieladresse kopieren (Schreibbank = 1)
017C  01 80 00   	LD BC,0080H
017F  ED B0      	LDIR
0181  D5         	PUSH DE
0182  D9         	EXX
0183  0B         	DEC BC
0184  78         	LD A,B
0185  B1         	OR C
0186  C2 2E 01   	JP NZ,SATZ
0189  D1         	POP DE
018A  34         	INC (HL)		;Endmarke FFH -> STARTEN; FEH -> neue Satznummer folgt
018B  28 0C      	JR Z,STARTEN
018D  34         	INC (HL)
018E  C2 24 01   	JP NZ,EINTRAG
0191  23         	INC HL
0192  5E         	LD E,(HL)
0193  23         	INC HL
0194  56         	LD D,(HL)
0195  D5         	PUSH DE
0196  C3 AC 00   	JP LADESCHLEIFE
STARTEN:
0199  CD 39 02   	CALL PB_INIT		;STARTEN: Treiber mit Befehl 80H (FDC-Reset, Motoren aus, UESEL = 1)
019C  2A 1B 10   	LD HL,(101BH)		;Startadresse = Kopfwort bei 1012H+9 (101BH); SCP 3.0: 4000H
019F  F3         	DI		;DI - das geladene Programm uebernimmt mit gesperrten Interrupts, IM 2, I = 12H, BR = 11H
01A0  E5         	PUSH HL
01A1  FD 21 AA 13	LD IY,13AAH		;Uebergabe: IY = 13AAH, DE = (13AAH), BC = (13ACH) [Formatbeschreibung Seite 1?], H = Bootlaufwerk (0..3)
01A5  ED 4B AC 13	LD BC,(13ACH)
01A9  ED 5B AA 13	LD DE,(13AAH)
01AD  3A C5 02   	LD A,(02C5H)
01B0  67         	LD H,A
01B1  C9         	RET		;RET = Sprung zur Startadresse
WARTEN:
01B2  11 92 B8   	LD DE,B892H		;Warteschleife ~0,28 s
L01B5:
01B5  1B         	DEC DE
01B6  7A         	LD A,D
01B7  B3         	OR E
01B8  20 FB      	JR NZ,L01B5
01BA  C9         	RET
SEKTORLAENGE:
01BB  11 80 00   	LD DE,0080H		;DE = Sektorlaenge 128 << N (N = IY+2)
L01BE:
01BE  EB         	EX DE,HL
01BF  FD 7E 02   	LD A,(IY+2)
01C2  3C         	INC A
L01C3:
01C3  3D         	DEC A
01C4  28 03      	JR Z,L01C9
01C6  29         	ADD HL,HL
01C7  18 FA      	JR L01C3
L01C9:
01C9  EB         	EX DE,HL
01CA  C9         	RET
SPURLAENGE:
01CB  16 00      	LD D,00H		;DE = Spurlaenge in Byte (IY+1 Sektoren x Sektorlaenge)
01CD  FD 5E 01   	LD E,(IY+1)
01D0  18 EC      	JR L01BE
REST_DER_SPUR:
01D2  FD 7E 01   	LD A,(IY+1)		;A = Sektoren bis Spurende (IY+1 + 1 - R)
01D5  3C         	INC A
01D6  DD 96 04   	SUB (IX+4)
LESEN_N:
01D9  DD 77 07   	LD (IX+7),A		;IX+7 := Sektorzahl; Format setzen; Befehl 70H = Lesen
01DC  CD 14 02   	CALL FMT_UEBERN
01DF  DD 36 00 70	LD (IX+0),70H
01E3  CD F7 01   	CALL PUFFERENDE		;passt das in den Puffer 13B2H-3BB2H (10 KB)?
01E6  38 05      	JR C,L01ED
01E8  CD 48 02   	CALL TREIBER_RUF
01EB  28 0A      	JR Z,PUFFERENDE
L01ED:
01ED  DD 36 07 01	LD (IX+7),01H		;nein: nur 1 Sektor lesen
01F1  CD 48 02   	CALL TREIBER_RUF
01F4  C2 3F 00   	JP NZ,NEUSTART		;Lesefehler -> NEUSTART (naechstes Laufwerk)
PUFFERENDE:
