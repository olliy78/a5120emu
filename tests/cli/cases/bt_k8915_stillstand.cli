# boot_trace --machine k8915 (§8a AP-E4d): ohne Diskette und ohne CR bleibt der Lader
# an der Coldstart-Meldung stehen — Abbruch als Stillstand, Exit 1.
tool:    boot_trace
disk:    k8915scpx_boot1.hfe
run:     --machine k8915 --skip-selftest --no-cr --stall 5000000 --quiet --json %DISK%
timeout: 120
exit:    1
expect:  "prompt":false,"stall":true
