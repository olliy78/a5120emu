# boot_trace --machine p8000 --keys (AP P7c): zwei Returns (Press RETURN → `>` → BOOT), UDOS
# von der WEGA-Startdiskette; --until beendet den Lauf, sobald die Koppelsoftware ihre
# Meldung ohne 16-Bit-Karte geschrieben hat.
tool:    boot_trace
disk:    udosP8000_640k_wega.hfe
run:     --machine p8000 --quiet --json --keys <CR><CR> --until "screen ~ \"Hardware Error in Connection\"" %DISK%
timeout: 240
exit:    0
expect:  "machine":"p8000"
expect:  "until":{"set":true,"met":true
