# boot_trace --machine k8915-g2 (AP-V6b): V3-Systemdiskette 901 an der Gen 2 — Selbsttestfehler
# "ROM C" -> CR -> Kaltstartmeldung -> CR -> Lader -> SCPX 8915 V5.3 bis zum stabilen Prompt.
tool:    boot_trace
disk:    k8915scpx_boot1.hfe
run:     --machine k8915-g2 --quiet --json %DISK%
timeout: 180
exit:    0
expect:  "machine":"k8915-g2","prompt":true,"stall":false
expect:  "a8":"0x87","lamps":"0xB0"
