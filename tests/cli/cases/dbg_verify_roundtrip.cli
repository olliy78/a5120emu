# dump A N datei → verify datei @A muss 100 % identisch sein (Datei↔RAM-Rundlauf).
tool:   k1520dbg
disk:   cpa_cpa780_k5601_clock.img
run:    %DISK%
tmpfile abbild.bin:
stdin:
  g 1000000
  dump 0x0100 64 %abbild.bin%
  verify %abbild.bin% @0x0100
  q
expect_re: 64 Bytes @0100, 64 identisch \(100.0 %\)
