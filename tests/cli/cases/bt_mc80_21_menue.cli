# boot_trace --machine mc80-21 (AP M12): das BSYS steht im Hauptmenue; die blinkende Marke in Spalte 5
# zaehlt nicht als Bildaenderung, sonst gaebe es nie einen Stillstand.  Exit 0 = Zeile mit TASTENTEST.
tool:    boot_trace
run:     --machine mc80-21 --quiet --json
timeout: 240
exit:    0
expect:  "machine":"mc80-21"
expect:  "menue":true
