# Zustand an einer Bedingung sichern, dann daraus fortsetzen (ROM-Einblendung
# muss dabei reproduziert werden).  Der Sicherungslauf ist ein setup_run —
# geprüft wird die Ausgabe des Fortsetzungslaufs.
tool:      boot_trace
disk:      cpa_cpa780_k5601_clock.img
tmpfile state.bin:
setup_run: -L /dev/null --until [0x03F8]==3 --save-state %state.bin% %DISK%
run:       -L /dev/null --load-state %state.bin% -c 2000 %DISK%
expect:    resuming at PC=0x0169
