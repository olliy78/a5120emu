# boot_trace --machine prg710-1 --keys (AP-P5c): wie am 710, die Tastatur ist hier die
# K7672 an SIO A32-B (Return = 0DH).
tool:    boot_trace
disk:    prg710-1_udos43_k5601_v43_189.hfe
run:     --machine prg710-1 --quiet --json --keys "<ET>021086<ET>" %DISK%
timeout: 240
exit:    0
expect:  "machine":"prg710-1","keywait":false,"stall":true,"prompt":true
