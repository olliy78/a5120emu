# boot_trace --machine k8915-g2 (AP-V6b), OHNE Diskette: mit der Vorgabe 175/176/repariertes 177
# (F9 geloest 2026-10-05) laeuft der Selbsttest ROM -> KEY -> CTC -> SIO -> RAM fehlerfrei durch
# (RAM-Test A8H = 87H, danach 06H) und der Lauf endet an der Kaltstartmeldung, ohne dass das
# Werkzeug CR auf einen Selbsttestfehler tippen muss.
tool:    boot_trace
run:     --machine k8915-g2 --until 'screen ~ "Coldstart"' -l %CLI_DIR%/../../doc/EPROMS/K8915G2/k8915g2_zre.prn@0xFC00:0021-03FF -l %CLI_DIR%/../../doc/EPROMS/K8915G2/k8915g2_zre.prn@:0400-0BFF
timeout: 120
exit:    0
forbid:  Selbsttestfehler
forbid:  Lampen: ERROR
expect:  === K8915 Gen 2 Boot Trace ===
expect:  OUT (A8H)=87  ZRE Speicherregister  map=MMMMMMMMMMMMMMMM /MEMDI
expect:  OUT (A8H)=06  ZRE Speicherregister  map=Z...MMMMMMMMMMMM  ; OUT (A8H),A ; A8H=06H zurueck
expect:  OUT (61H)=B0  Anzeigefeld  Lampen: RUN Mode
expect:  --until (screen ~ "Coldstart"): MET
expect:  432 line(s), offset +64512
expect_re: 0x[0-9A-F]{4} ROM : +[0-9]+ +\( *[0-9.]+%\) <KALTSTART\+[0-9]+>  ; 
