# Maschinenlesbare Registerausgabe (rj).
#
# GOLDEN-WERT: Registerabbild bei exakt 5 000 000 Takten der MASCHINENUHR
# (beide CPUs — seit origin/main 06dfa8d zaehlt `g N` so; `clock zve1` schaltet um).
# Die Zeitlage haengt am Floppy-Timing (u. a. Motor-Anlauf, K5122_MOTOR_SPINUP_MS).
#
# ACHTUNG: zyklusabhaengig und damit von Natur aus zerbrechlich — origin/main hat
# ihn schon zweimal nachziehen muessen.  Der deterministische Gegenpart ist
# `dbg_stop_json_matches_banner.cli` (Haltepunkt statt Taktzahl); dieser Fall
# bleibt als Waechter fuer die Zeitlage selbst.
tool:   k1520dbg
disk:   cpa_cpa780_k5601_clock.img
run:    %DISK%
stdin:
  g 5000000
  rj
  q
expect: "pc":"0x19CF"
expect: "hl":"0x1BCF"
