# `--json` muss dasselbe hergeben wie die Oberflaeche — auch die SEKTORLISTE.
#
# Sie ist der Schritt vor jeder Entscheidung: „ist das ueberhaupt, was ich suche?"
# Bei UDOS gibt es dafuer nicht einmal einen Namen, und die Saetze einer Datei liegen
# verkettet ueber die Diskette verstreut.  Ein Skript, das einen Fund vor dem Retten
# ansehen will, braucht die Liste genauso wie der Dialog — `cyl`/`head`/`sector`
# allein nennen nur den Anfang.
#
# `NOTE.TO.SD` sind 16 Saetze zu 128 B, dazu der Kopfsektor: 17 Eintraege.
tool:   k1520disktool
disk:   udos_boot_scp.hfe
setup_run: rm %DISK% Side1/NOTE.TO.SD --no-backup
run:    recover %DISK% --json
expect_re: "parts":\[\{"cyl":21,"head":1,"sector":6\}
expect: "restorable":false
expect: "quality":"sicher"
exit:   0
