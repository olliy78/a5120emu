# Zaehlen ist nicht dasselbe wie auswaehlen: es gibt EINE moegliche Reparatur,
# ausgefuehrt wuerde ohne `=alle` aber keine.  Die Fusszeile muss beides
# auseinanderhalten — sonst liest man „0 Reparatur(en)" ueber einer Zeile, die
# eine anbietet.
tool:   k1520disktool
disk:   cpa_cpa780_k5601_noclock.img
poke:   %DISK% 3b30 f00f
run:    fsck %DISK% --fs cpa780
expect: 1 Reparatur(en) moeglich
expect: alle mit Datenverlust
expect: --repair=alle
exit:   1
