# Ebene 0 (Entwurf §11): auf einer Diskette, auf der NICHTS erkannt wird, ist der
# Bericht die Begruendung.  `check` bricht dort nicht mehr mit einem Satz ab,
# sondern oeffnet roh und nennt jeden geprueften Kandidaten mit seinem Grund —
# genau die Frage („welche Probe sagt Nein und mit welcher Zahl"), die bei den
# drei zuletzt geloesten Fremdformaten die entscheidende war.
#
# Der Schaden: Verzeichnisplatz 0 bekommt einen Nutzerbereich > 15; damit weist
# die CP/M-Probe die Diskette ab.  Exit 2 = nicht erkannt (nicht 1 = Befunde).
tool:   k1520disktool
disk:   cpa_cpa780_k5601_noclock.img
poke:   %DISK% 3b00 dc
run:    check %DISK%
expect: erkennung.abgelehnt
expect: Nutzerbereich 0xDC
expect: nicht angelegt
expect: kein Dateisystem erkannt
forbid: ohne Befund
exit:   2
