# boot_trace --laderom v06 (AP A7, doc/a5120_alt/bcu.md): Lade-ROM V0.6 startet BCU 880 V1.2
# von der Diskette „SYL auf Spur 1“ (Satz 2, Bild 64x16 = K7023) auf dem alten Geraet; .img in
# Katalogformat k5601_ss40_26x128 ueber --format.
tool:    boot_trace
disk:    bcu12_ss40-26x128_k5600-10_syl-spur1-satz2.img
run:     -L /dev/null --ausfuehrung alt --laderom v06 --format k5601_ss40_26x128 --until "screen ~ \"BCU 880 VERS 1.2\"" -c 60000000 -p 1 %DISK%
expect:  BOOT SUCCESS: ZVE1 executing loaded code at PC=0x042E
expect:  Screen (VRAM as text, 64 cols
expect:  |BCU 880 VERS 1.2
forbid:  not met
