                                  IF cdtdc1 or cdtdtr
                         C      	include BIOSCSIO
                         C      ;===================================================================
                         C      ; SIO-Treiber, DTR- und DC1/DC3-Protokoll
                         C      ;===================================================================
                         C      ;
                         C      ; Aenderungen:
                         C      ; - Statusabfrage jedesmal, auch wenn zuvor frei gemeldet
                         C      ; - Pufferueberlauf bei UC1-Puffer kontrolliert
                         C      ; - bei DC1/DC3 nach Initialisierung 7fh an Drucker und max. 30 sec auf
                         C      ;  Antwort gewartet (sonst Fehler am SD1157, wenn zu frueh gesendet wird)
                         C      ; 29.6.88:
                         C      ; - bei DC1/3 Protokoll wird neu initialisiert, wenn DC4 vom Drucker kommt
                         C      ;  (Probleme bei K6314)
                         C      ; 20.09.88
                         C      ; - Neben DTR-Statusabfrage ueber Kanal B, Bit 3 (Treiber 1, Standard)
                         C      ;  auch DTR-Statusabfrage ueber Kanal A, Bit 5 (Treiber 3) unterstuetzt
                         C      ; 23.03.89
                         C      ; - CTS-Zusammenspiel bei K6311 u.ae. funktioniert nur, wenn bis zum
                         C      ;   Verlassen aller Bits aus dem Sender gewartet wird und nicht nur auf
                         C      ;   das Freiwerden des Sendepuffers - sonst Zeichenverlust!
                         C      ; - wenn UC1 am Kanal A wird WR1 Bit2 und WR2 im Kanal B gesetzt
                         C       IF cpu eq c1715
                         C       ENDIF
                         C      ; 04.04.89
                         C      ; - nach Drucker-Init 'set 0,(ix+ltpst)' statt 'ld (ix+ltpst),11h'
                         C      ; 06.07.89
                         C      ; - wegen K6314-Problemen wird nach Initialisierung DC1 angenommen
                         C      ; - bei UC1-Kopplung ueber DTR ohne Warten auf Senderegister leer,
                         C      ;   nur Warten auf Sendepuffer leer
                         C      ;   (Aenderung 23.03.89 daher nur fuer Drucker wirksam, sonst zu langsam)
                         C      ; 15.09.89
                         C      ; - bei UC1-Kopplung ueber DC1/DC3 nicht 7fh zu Beginn gesendet, sondern DC1
                         C      ;**************************************************************************
                         C      
  D12F                   C      cdsioi	equ	dumi		;keine Zeicheneingabe unterstuetzt
                         C      
                         C      ; Einzelzeichenausgabe Reg. A
  D7D0    DD 4E 02       C      cdsioo:	ld	c,(ix+ltpsd)	;Datenport
  D7D3    ED 79          C      	out	(c),a
  D7D5    C9             C      	ret
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-55


                         C      
                         C      ;------------------------------------
                         C      
                         C      ; Statusabfrage
  D7D6    DD 7E 00       C      cdsios:	ld	a,(ix+ltpst)	;Status
  D7D9    CB 4F          C      	bit	1,a		;senderseitig blockiert?
  D7DB    20 3F          C      	jr	nz,lstsr	;ja, frei rueckmelden
  D7DD    B7             C      	or	a		;initialisiert?
  D7DE    CC D843        C      	call	z,cdsins	;nein
  D7E1    DD CB 0A 7E    C      	bit	7,(ix+ltpw5)	;Prozedur DTR?
  D7E5    28 3A          C      	JR	Z,lstsdc	;nein
  D7E7    DD 4E 03       C      	ld	c,(ix+ltpsc)	;SIO Kommando
                         C       IF iobuc1
  D7EA    DD CB 01 7E    C      	bit	7,(ix+ltpdc)	;Warten auf Senderegister leer?
  D7EE    28 0C          C      	jr	z,lstse0	;ja
  D7F0    3E 10          C      	ld	a,00010000b	;Reset Ext/Status-Interrupt, Lesereg. 0
  D7F2    ED 79          C      	out	(c),a		;Status abspeichern
  D7F4    ED 78          C      	in	a,(c)		;Lesereg. 0
  D7F6    CB 57          C      	bit	2,a		;Sendepuffer leer?
  D7F8    20 0C          C      	jr	nz,lstse1	;ja
  D7FA    18 20          C      	jr	lstsr		;nein, Drucker besetzt
  D7FC                   C      lstse0:
                         C       ENDIF
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  D7FC    3E 11          C      	LD	a,00010001b	;Reset Ext/Status-Interrupt, Lesereg. 1
  D7FE    ED 79          C      	OUT	(C),a		;Status abspeichern
  D800    ED 78          C      	IN	a,(C)		;Leseregister 1
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  D802    CB 47          C      	bit	0,a		;alle Bits gesendet?
                         C      				; Sendepuffer frei reicht nicht, da
                         C      				; K6311 u.ae. nicht korrekt arbeiten
  D804    28 16          C      	jr	z,lstsr		;nein, Drucker besetzt
  D806    DD CB 01 5E    C      lstse1:	bit	3,(ix+ltpdc)	;Abfrage DTR ueber DCD im Kanal B?
  D80A    20 06          C      	jr	nz,lstsb3	;ja
  D80C    ED 78          C      	in	a,(c)		;Leseregister 0
  D80E    CB 6F          C      	bit	5,a		;CTS?
  D810    18 0A          C      	jr	lstsr		;nz bei ja
  D812    0C             C      lstsb3:	inc	c
  D813    0C             C      	inc	c		;auf Kanal B
  D814    3E 10          C      	LD	a,00010000b	;Reset Ext/Status-Interrupt, Lesereg. 0
  D816    ED 79          C      	out	(c),a		;DCD in RR0 Kanal B abspeichern
  D818    ED 78          C      	in	a,(c)		;Leseregister 0 des Kanal B
  D81A    CB 5F          C      	bit	3,a		;DCD im Kanal B (ist DTR-Bit vom Kanal A)
                         C      ; Ausgang Senderstatus
  D81C                   C      lstsr:
  D81C    3E FF          C      lstsr1:	ld	a,0ffh
  D81E    C0             C      	ret	nz		;senderseitig frei
  D81F    3C             C      	inc	a		;A=00, ret z
  D820    C9             C      	RET			;senderseitig besetzt
                         C      ;-----------------------
                         C      ; DC1/DC3 und XON/XOFF
  D821    DD 4E 02       C      lstsdc:	LD	C,(ix+ltpsd)	;SIO Daten
  D824    ED 78          C      	IN	A,(C)		;Status lesen (SIO speichert letzten Status)
  D826    DD 77 01       C      	LD	(ix+ltpdc),A	;zuletzt empf. Zeichen fuer Fehlersuche merken
  D829    E6 7F          C      	and	7fh		;evtl. Paritaet ignorieren
  D82B    FE 13          C      	cp	13h		;DC3?
  D82D    28 12          C      	jr	z,lstsd2	;ja, besetzt
  D82F    FE 14          C      	cp	14h		;DC4 (Status)?
  D831    20 05          C      	jr	nz,lstsd1	;nein (DC1 angenommen)
  D833    CD D877        C      	call	cdsini		;statt Status abzuholen neu initialisieren
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-56


  D836    18 E9          C      	jr	lstsdc		;und Status neu abfragen
  D838    DD 4E 03       C      lstsd1:	ld	c,(ix+ltpsc)	;SIO Kommando
  D83B    ED 78          C      	in	a,(c)
  D83D    CB 57          C      	bit	2,a		;Sendepuffer leer? (nz bei ja)
  D83F    18 DB          C      	jr	lstsr
  D841    AF             C      lstsd2:	xor	a		;A=00, ret z
  D842    C9             C      	ret			;senderseitig besetzt
                         C      
                         C      ;-----------------------
                         C      
                         C      ; (Re-)Initialisierung
                         C      ; IX auf Steuertabelle
                         C      ; ret: C zeigt auf Kommandoport
                         C      
                         C      ; Sender initialisieren
  D843                   C      cdsins:
  D843    DD CB 00 C6    C      	set	0,(ix+ltpst)	;Sender ist initialisiert
  D847    CD D877        C      	call	cdsini
  D84A    DD CB 0A 7E    C      	bit	7,(ix+ltpw5)	;Prozedur DC1/DC3?
  D84E    C0             C      	ret	nz		;nein
  D84F    41             C      	ld	b,c
  D850    DD 4E 02       C      	ld	c,(ix+ltpsd)	;Datenport
                         C       IF iobuc1
  D853    DD CB 01 7E    C       	bit	7,(ix+ltpdc)	;Warten auf Senderegister leer?
  D857    28 06          C      	jr	z,cdsind	;ja, Drucker
  D859    3E 11          C      	ld	a,11h		;bei UC1: mit DC1/DC3-Protokoll DC1 senden
  D85B    ED 79          C      	out	(c),a
  D85D    48             C      	ld	c,b
  D85E    C9             C      	ret
                         C       ENDIF
  D85F    3E 7F          C      cdsind:	ld	a,7fh		;nach Initialisierung RESET senden
  D861    ED 79          C      	out	(c),a
  D863    48             C      	ld	c,b
  D864    11 0BB8        C      	ld	de,30*100	;max. Wartezeit ca. 30 sec (SD1157!)
  D867    ED 78          C      cdsinw:	in	a,(c)
  D869    CB 47          C      	bit	0,a		;Antwort da?
  D86B    C0             C      	ret	nz		;ja
  D86C    06 01          C      	ld	b,1
  D86E    CD E702        C      	call	wait10		;10ms warten
  D871    1B             C      	dec	de
  D872    7A             C      	ld	a,d
  D873    B3             C      	or	e		;max. Wartezeit abgelaufen?
  D874    20 F1          C      	jr	nz,cdsinw	;nein
  D876    C9             C      	ret			;sonst Drucker wohl nicht bereit
                         C      
                         C      
                         C      ; gem. UP fuer Sender und Empf. initialisieren
  D877                   C      cdsini:
  D877    DD E5          C      	push	ix
  D879    E1             C      	pop	hl
  D87A    01 000B        C      	ld	bc,ltpini
  D87D    09             C      	add	hl,bc
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  D87E    CD D76F        C      	call	portpr		;CTC, WR0, WR4, WR1, WR3
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  D881    DD 5E 0A       C      ltpow5:	LD	e,(ix+ltpw5)	;Prozedurtyp/Bitanzahl
                         C      ; Stellen Schreibregister 5
                         C      ; Reg. B,HL bleiben erhalten
  D884    3E 05          C      ltpot5:	ld	a,5
  D886    DD 4E 03       C      	ld	c,(ix+ltpsc)
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-57


                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  D889    ED 79          C      	OUT	(C),A
  D88B    ED 59          C      	OUT	(C),e
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  D88D    C9             C      	RET
                         C      
                         C      ;-------------------------------------
                         C       if iobuc1
                         C      
                         C      ; UC1-Routinen (ausser Senden)
                         C      
                         C      ; UC1: Empf.-Status
                         C      ;==================
                         C      ; o A=0, ret z	: kein Zeichen empfangen
                         C      ; o A=ff,ret nz	: Zeichen da
  D88E    DD 21 D7B3     C      uc1st:	ld	ix,lstuc1	;Stellen IX auf Steuertabelle
  D892                   C      uc1si:	;interner Aufruf mit gestelltem IX
  D892    DD CB 00 66    C      	bit	4,(ix+ltpst)	;initialisiert?
  D896    20 19          C      	jr	nz,uc1si1	;ja
  D898    AF             C      	xor	a
  D899    32 D95F        C      	ld	(uc1bfp),a	;Puffer leeren
  D89C    CD D877        C      	call	cdsini		;Initialisierung
  D89F    DD CB 00 E6    C      	set	4,(ix+ltpst)	;Empfaenger ist initialisiert
  D8A3    F3             C      	di
                         C       IF (uc1dat xor uc1sta) eq 01b	;Kanal-Nr ist Bit 1 (bei Buerocomp und OEM)
                         C        IF (uc1sta and 10b) eq 00b	;UC1 ist an Kanal A
  D8A4    CB C9          C      	set	1,c		;Kanal B erzwingen
                         C        ENDIF
                         C       ENDIF
  D8A6    21 D8B9        C      	ld	hl,uc1i2	;WR1,WR2 programmieren
  D8A9    06 04          C       	ld	b,uc1il
  D8AB    ED B3          C      	otir
  D8AD    FB             C      	ei
  D8AE    CD D8E8        C      	call	uc1ird		;DTR bzw. DC1 senden
  D8B1    3A D95F        C      uc1si1:	ld	a,(uc1bfp)	;Zeichen im Empfpuffer?
  D8B4    B7             C      	or	a
  D8B5    C8             C      	ret	z		;nein
  D8B6    3E FF          C      	ld	a,0ffh
  D8B8    C9             C      	ret
                         C      
  D8B9                   C      uc1i2: ;zusaetzliche Initialisierung fuer WR1/Bit2 und WR2 (beide nur Kanal B)
                         C       IF (uc1dat xor uc1sta) eq 01b	;Kanal-Nr ist Bit 1 (bei Buerocomp und OEM)
                         C        IF (uc1sta and 10b) eq 00b	;UC1 ist an Kanal A
  D8B9    01 04          C      	db	1,00000100b	;WR1, Kanal B: Intv.modif. setzen
                         C        ENDIF
                         C       ENDIF
  D8BB    02 D0          C      	db	2,ivsio0	;WR2, Kanal B: Interruptvektor
  0004                   C      uc1il	equ	$-uc1i2
                         C      ; UC1: empf. Zeichen an Nutzer
                         C      ;=============================
                         C      ; o A:	aeltestes empf. Zeichen
                         C      
  D8BD    DD 21 D7B3     C      uc1i:	ld	ix,lstuc1	;Stellen IX auf Steuertabelle
                         C      
  D8C1                   C      uc1ii:	;interner Aufruf mit gestelltem IX
  D8C1    FB             C      uc1iw:	ei			;UC1:-Interrupt zulassen
  D8C2    CD D892        C      	call	uc1si		;Zeichen da?
  D8C5    28 FA          C      	jr	z,uc1iw		;nein ***keine Zeitueberwachung!***
  D8C7    21 D95F        C      	ld	hl,uc1bfp
  D8CA    F3             C      	di
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-58


  D8CB    4E             C      	ld	c,(hl)
  D8CC    35             C      	dec	(hl)		;Pufferlaenge -1
  D8CD    06 00          C      	ld	b,0
  D8CF    23             C      	inc	hl		;^(aeltestes Pufferzeichen)
  D8D0    7E             C      	ld	a,(hl)		;Zeichen nach A
  D8D1    11 D961        C      	ld	de,uc1buf+1
  D8D4    EB             C      	ex	de,hl
  D8D5    ED B0          C      	ldir			;Puffer aufschieben
  D8D7    FB             C      	ei
  D8D8    DD CB 00 7E    C      	bit	7,(ix+ltpst)	;war Stopaufforderung?
  D8DC    C8             C      	ret	z		;nein
  D8DD    F5             C      	push	af		;retten Zeichen
  D8DE    3A D95F        C      	ld	a,(uc1bfp)	;Pufferbelegung
  D8E1    FE 06          C      	cp	1*uc1bfl/3	;unter dem Limit?
  D8E3    DC D8E8        C      	call	c,uc1ird	;ja, Senden wieder erlauben
  D8E6    F1             C      	pop	af
  D8E7    C9             C      	ret
                         C      
                         C      ; Empfangsbereitschaft anzeigen
  D8E8    DD CB 00 BE    C      uc1ird:	res	7,(ix+ltpst)
  D8EC    DD CB 0A 7E    C      	bit	7,(ix+ltpw5)	;Prozedur DC1/DC3?
  D8F0    C2 D881        C      	jp	nz,ltpow5	;nein, DTR wieder setzen
  D8F3    3E 11          C      	ld	a,11h		;DC1 (Senden wieder erlauben)
  D8F5    DD 4E 02       C      	LD	C,(ix+ltpsd)	;SIO Daten
  D8F8    ED 79          C      	OUT	(C),A
  D8FA    C9             C      	ret
                         C      
                         C      ; UC1: Empf.-Interrupt
                         C      ;=====================
  D8FB    ED 73 E51F     C      uc1rin:	ld	(intsp),sp
  D8FF    31 F061        C      	ld	sp,intstk
  D902    F5             C      	push	af
  D903    E5             C      	push	hl
  D904    D5             C      	push	de
  D905    C5             C      	push	bc
  D906    DD E5          C      	push	ix
  D908    21 D928        C      	ld	hl,uc1rir
  D90B    E5             C      	push	hl
  D90C    DD 21 D7B3     C      	ld	ix,lstuc1	;Stellen IX auf Steuertabelle
  D910    DD 4E 02       C      	ld	c,(ix+ltpsd)	;SIO Daten
  D913    ED 40          C      	in	b,(c)		;Zeichen lesen
  D915    21 D95F        C      	ld	hl,uc1bfp	;Pufferzeiger zum zuletzt empf. Zeichen
  D918    7E             C      	ld	a,(hl)
  D919    FE 14          C      	cp	uc1bfl		;Puffer voll?
  D91B    D0             C      	ret	nc		;ja, Zeichen ignorieren
  D91C    FE 0D          C      	cp	2*uc1bfl/3	;Puffer fast voll (SIO-Empf.puffer 3 Byte!)?
  D91E    D4 D92D        C      	call	nc,uc1ri1	;ja, DC3 senden bzw. DTR wegnehmen
  D921    34             C      	inc	(hl)		;+1
  D922    5E             C      	ld	e,(hl)
  D923    16 00          C      	ld	d,0
  D925    19             C      	add	hl,de		;naechste freie Stelle
  D926    70             C      	ld	(hl),b		;Zeichen in Puffer
  D927    C9             C      	ret
  D928    DD E1          C      uc1rir:	pop	ix
  D92A    C3 E51A        C      	jp	intrbc		;fertig
                         C      
                         C      ; Stopaufforderung senden
                         C      ; B,HL bleibt erhalten
  D92D    DD CB 00 FE    C      uc1ri1:	set	7,(ix+ltpst)	;merken Stopaufforderung
  D931    DD 5E 0A       C      	ld	e,(ix+ltpw5)
  D934    CB 7B          C      	bit	7,e		;Prozedur DC1/DC3?
  D936    28 05          C      	jr	z,uc1ri2	;ja
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-59


  D938    CB BB          C      	res	7,e		;DTR loeschen
  D93A    C3 D884        C      	jp	ltpot5
  D93D    3E 13          C      uc1ri2:	ld	a,13h		;DC3 an Partner (Senden stopppen)
  D93F    DD 4E 02       C      	LD	C,(ix+ltpsd)	;SIO Daten
  D942    ED 79          C      	OUT	(C),A
  D944    C9             C      	ret
                         C      
                         C      ; UC1: Interrupt Empf.-Fehler (Parit., Ueberlauf, Rahmenfehler)
                         C      ;============================
  D945    ED 73 E51F     C      uc1err:	ld	(intsp),sp
  D949    31 F061        C      	ld	sp,intstk
  D94C    F5             C      	push	af
  D94D    E5             C      	push	hl
  D94E    D5             C      	push	de
  D94F    C5             C      	push	bc
  D950    DD E5          C      	push	ix
  D952    DD 21 D7B3     C      	ld	ix,lstuc1	;Stellen IX auf Steuertabelle
  D956    DD 4E 03       C      	ld	c,(ix+ltpsc)	;SIO Kommando
  D959    16 30          C      	ld	d,00110000b	;Reset Fehler-Interrupt
  D95B    ED 51          C      	out	(c),d
                         C      				;keine Fehlermeldung, da bei
                         C      				;Empf.ueberlauf alles noch
                         C      				;mehr verzoegert wird
  D95D    18 C9          C      	jr	uc1rir
                         C      
                         C      ; UC1: Empfangspuffer
                         C      ;====================
  D95F    00             C      uc1bfp:	db	0
  D960                   C      uc1buf:	ds	uc1bfl,0
                         C      
                         C       endif	;uc1
                         C      
                                  ENDIF
                                  IF cdtsib
                                  ENDIF
                                  IF cdtpio
                                  ENDIF
                                  IF cdtp54
                                  ENDIF
                                  IF cdth54
                                  ENDIF
                                  IF cdtn56 or cdtp56
                                  ENDIF
                                 ENDIF
                                
                         C      	include BIOSDSK
                         C      
                         C      ;****************************************************
                         C      ;	Diskettentreiber; Umkleidung des phys. Transfers
                         C      ;	Version 04.11.88
                         C      ; Aenderungen:
                         C      ; - Jeder Fehler in Spur 0, Sektor 1 fuehrt zur Annahme von Systemspuren
                         C      ;   (A7100-System mit 5" FM und 8272-Hardware mit 128er Sektorlaenge)
                         C      ; - !!Schnittstelle fuer diskio-Aufruf neu!! (Flags neu, side zusaetzlich)
                         C      ; - Verify nach Schreiben kann laufwerksspezifisch gewaehlt werden
                         C      ; - Laufwerkskapazitaet nach phys. LW-Nr in Statuszeile
                         C      ; - Fehlerkorrektur bei KAYPRO IV fuer C128
                         C      ; 12.06.88
                         C      ; - bei stzaus in synflg keine Pflege der Statuszeile
                         C      ; 06.07.88:
                         C      ; - Spurnummer generell auf 16 bit erweitert
                         C      ; 14.10.88
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-60


                         C      ; - Generierung ohne Floppy-Laufwerke moeglich
                         C      ; 26.10.88
                         C      ; - Test der Laufwerksbereitschaft bei Select
                         C      ; 04.11.88
                         C      ; - bei 5" und 512 Sektorlaenge Dir-Groesse 0
                         C      ; 12.03.89
                         C      ; - 'ibmfrm' gestrichen, phys. Formaterkennung fuer SIOS erfolgt immer
                         C      ;****************************************************
                         C      
                         C       if1
                         C       endif
                         C      
                         C      ; Laufwerksauswahl
                         C      ;=================
                         C      ; i C: Laufw. (0=A:, 1=B: ...)
                         C      ; i E: Bit 0 ist LOGIN-Bit von BDOS (=0, wenn LOGIN)
                         C      
  D974    CD E7E9        C      seldsk:	call	dgetpb		;HL auf DPH stellen, IX auf DPB
  D977    C8             C      	ret	z		;Geraet ex. nicht
  D978    79             C      	ld	a,c
  D979    32 DF51        C      	ld	(ddrive),a	;Laufwerk merken
  D97C    CB 43          C      	bit	0,e		;LOGIN von BDOS?
  D97E    C0             C      	ret	nz		;nein
                         C       if ramfl
                         C      ;###RAM-Floppy
  D97F    DD CB 0F 7E    C      	bit	dpbfnd,(ix+dpbflg)	;Diskette?
  D983    C0             C      	ret	nz		;nein, fertig
                         C      ;####
                         C       endif
  D984    E5             C      	push	hl		;^DPH merken
                         C      
                         C      	IF	dbufsz gt 7
  D985    21 DF48        C      	ld	hl,dbdev
  D988    BE             C      	cp	(hl)		;LOGIN fuer gepuffertes Device?
  D989    20 07          C      	jr	nz,dselnb	;nein
  D98B    36 FF          C      	ld	(hl),0ffh	;Puffer ist ungueltig
  D98D    21 DF47        C      	ld	hl,dbflg
  D990    CB 96          C      	res	dfbwr,(hl)	;kein veraend. Puffer auszug.!
  D992                   C      dselnb:
                         C      	ENDIF
                         C      
                         C       IF format
  D992    DD CB 0F 76    C      	bit	dpbfrm,(ix+dpbflg);Formaterkennung unterdr.?
  D996    28 1A          C      	jr	z,drdfrm	;nein
                         C       ENDIF
                         C      
                         C      ; Test der Laufwerks-Bereitschaft; nur dann Select Disk ok
                         C      ;---------------------------------------------------------
  D998    32 DF3A        C      	ld	(drddev),a	;log. LW
  D99B    DD 6E 0D       C      	ld	l,(ix+dpbofs)
  D99E    DD 66 0E       C      	ld	h,(ix+dpbofs+1)
  D9A1    22 DF3B        C      	ld	(drdtrk),hl	;auf Beginn des Verzeichnisses
  D9A4    21 DF39        C      	ld	hl,drdcdb	;Positionieren ohne Fehlerbehandlung
  D9A7    CD DD8A        C      	call	dsktra
  D9AA    CA DB5F        C      	jp	z,selext	;ok
  D9AD    E1             C      	pop	hl		;^DPH wegschmeissen
  D9AE    21 0000        C      	ld	hl,0		;Select Fehler
  D9B1    C9             C      	ret
  D9B2                   C      drdfrm:
                         C      
                         C      	IF	format
                         C      ;++++++++++Automatische Format-Erkennung++++++++++
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-61


                         C      ; Reg. C zeigt auf Laufwerk
                         C      
                         C      	IF	dbufsz gt 7
  D9B2    CD DD6A        C       	call	dbtrw		;Puffer freimachen
                         C      				;und auf Lesen schalten
  D9B5    21 DF5E        C      	ld	hl,dbnb
  D9B8    36 FF          C      	ld	(hl),0ffh	;Puffernummer ist ungueltig, obwohl evtl.
                         C      				;alle anderen Pufferparameter stimmen
                         C      				;(da nur 128 Bytes vom Puffer belegt sind)
                         C      	ENDIF
                         C      
  D9BA    79             C      	ld	a,c
  D9BB    32 DF41        C      	ld	(dfrmdv),a
  D9BE    32 DF48        C      	ld	(dbdev),a
                         C      
  D9C1    AF             C      	xor	a
  D9C2    DD 77 0F       C      	ld	(ix+dpbflg),a	;ruecksetzen alle Flags
  D9C5    DD 77 13       C      	ld	(ix+dpbsn0),a	;keine Weiter-Numm. auf Ruecks.
  D9C8    DD 77 0D       C      	ld	(ix+dpbofs),a	;keine Systemspuren
                         C      
  D9CB    32 DF42        C      	ld	(dfrmtr),a	;Spur 0
  D9CE    32 DF49        C      	ld	(dbtrk),a
  D9D1    32 DF4A        C      	ld	(dbtrk+1),a
  D9D4    3C             C      	inc	a
  D9D5    32 DF4B        C      	ld	(dbsec),a	;Sektor 1
  D9D8    32 DF4D        C      	ld	(dbsnb),a	;1 phys. Sektor lesen
                         C      
                         C      ; Stellen  Sektor-Translate-Tabelle 1,2,3,...
  D9DB    DD E5          C      	push	ix
  D9DD    06 1A          C      	ld	b,26		;max. Laenge der Tabelle
                         C       IF dsk8mf
                         C       ENDIF
  D9DF    DD 77 19       C      selstz:	ld	(ix+dpbstr),a
  D9E2    DD 23          C      	inc	ix
  D9E4    3C             C      	inc	a
  D9E5    10 F8          C      	djnz	selstz
  D9E7    DD E1          C      	pop	ix
                         C      
                         C      ; Positionieren auf Spur 0 und analysieren Systemspuren
  D9E9    CD DD82        C      	call	dsidtr		;beliebigen Sekt.Id lesen
  D9EC    20 3E          C      	jr	nz,selsys	;Fehler beim Lesen; Systemsp. annehmen
                         C      ;				 (z.B. SCP1700 mit 5"FM in Spur 0!!)
  D9EE    7C             C      	ld	a,h
  D9EF    32 DF4C        C      	ld	(dbslc),a	;setzen Spurformat fuer Sp. 0
                         C      	IF	dbufsz le 7
                         C      	ENDIF
  D9F2    21 DF47        C      	ld	hl,dbflg
                         C       IF dsk8mf
                         C       ENDIF
  D9F5    46             C      	ld	b,(hl)		;merken Fehlerprotokoll-Bit
  D9F6    CB E6          C      	set	dfbtr,(hl)	;kein Fehlerprotokoll
  D9F8    E5             C      	push	hl
  D9F9    CD DD70        C      	call	dbtran		;Lesen Spur 0, Sektor 1
  D9FC    E1             C      	pop	hl
  D9FD    70             C      	ld	(hl),b		;setzen Standard fuer Fehlerprotokoll-Bit
  D9FE    20 2C          C      	jr	nz,selsys	;Fehler, Systemspuren annehmen
  DA00    FD E5          C      	push	iy
  DA02    FD 2A DF4E     C      	ld	iy,(dbdma)
  DA06    FD 7E 00       C      	ld	a,(iy+0)	;Format-Loeschbyte
  DA09    FE E5          C      	cp	0e5h		;leere Diskette/geloeschter Eintrag?
  DA0B    20 0A          C      	jr	nz,selsy2	;nein, weder/noch
  DA0D    FD BE 01       C      	cp	(iy+1)		;auch danach 0e5h?
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-62


  DA10    20 15          C      	jr	nz,selsy0	;nein, geloeschter Dir-Eintrag
  DA12    DD 35 0D       C      	dec	(ix+dpbofs)	;Flag: leere Disk oder leere Systemsp.
  DA15    18 10          C      	jr	selsy0		;dpbofs auf 254
  DA17                   C      selsy2:
  DA17    FE 40          C      	cp	40h		;IBM-Format (SIOS-Daten-Diskette)?
  DA19    28 0F          C      	jr	z,selsy1	;ja, 0 Systemspuren annehmen
  DA1B    FE 20          C      	cp	20h		;<=31 ? ("S"YL ist groesser!)
  DA1D    30 0B          C      	jr	nc,selsy1	;nein, kann kein Directory sein; 0 Systemsp.
                         C      ;Systemlader fuer PC1715 beginnt mit 02 oder 03
  DA1F    FD 7E 20       C      	ld	a,(iy+20h)	;bei SCP1715-Systemdiskette dort 00h
                         C      				;bei MicroDos dort 10h
  DA22    FD B6 21       C      	or	(iy+21h)	;bei SCP1715-Systemdiskette dort 00h
                         C      				;bei CP/A dort Dir-Eintrag (E5 oder Filename)
  DA25    28 03          C      	jr	z,selsy1	;beides 00h, kein Directory; 0 Systemsp.
  DA27    DD 35 0D       C      selsy0:	dec	(ix+dpbofs)	;=255, wenn Directory; =254 wenn vorn leer
  DA2A                   C      selsy1:
  DA2A    FD E1          C      	pop	iy
  DA2C                   C      selsys:
                         C      
                         C      ; Analysieren Datenspur
                         C      
                         C      ; SS/DS-Analyse
  DA2C    DD 36 12 02    C      	ld	(ix+dpbstp),2	;Doppel-Step-Impulse
  DA30    3E 03          C      	ld	a,dlgint	;auf LOGIN-Spur
  DA32    CD DD7F        C      	call	dsidtt		;belieb. SektId Vorderseite lesen
  DA35    20 2B          C      	jr	nz,seldle	;Fehler, unsicheres Format
  DA37    54             C      	ld	d,h		;d:=Sektorlcode, e:=Spur
                         C       IF dsk8mf
                         C       ENDIF
                         C       IF dskds
  DA38    DD CB 18 46    C      	bit	dpbtds,(ix+dpbtyp)	;ist es ein DS-Laufwerk?
  DA3C    28 14          C      	jr	z,selss		;nein, SS
  DA3E    D5             C      	push	de		;merken Sektorlaengencode und Spur
  DA3F    DD CB 0F EE    C      	set	dpbfds,(ix+dpbflg)
  DA43    3E 07          C      	ld	a,1+(dlgint*2)	;Rueckseite der Spur,
                         C      				;ab der Format bei SS konstant
  DA45    CD DD7F        C      	call	dsidtt		;beliebigen Sekt.Id Ruecks. lesen
  DA48    7A             C      	ld	a,d		;merken side Ruecks.
  DA49    6B             C      	ld	l,e		;h:=Sektorlcode, l:=Spur Rueckseite
  DA4A    D1             C      	pop	de		;wiederherstellen Vorderseite
  DA4B    20 05          C      	jr	nz,selss	;Fehler beim Lesen, SS
  DA4D    B7             C      	or	a
  DA4E    ED 52          C      	sbc	hl,de		;Vorder- gleich Rueckseite?
  DA50    28 04          C      	jr	z,sel48		;ja; 40 Tr/ 80 Tr unterscheiden
  DA52    DD CB 0F AE    C      selss:	res	dpbfds,(ix+dpbflg)
                         C       ENDIF
                         C      
                         C      ; 40/80 Track Analyse
  DA56    7B             C      sel48:	ld	a,e		;trk
  DA57    D6 03          C      	sub	dlgint		;waren 2 Steps richtig? 
  DA59    28 12          C      	jr	z,seldl1	;ja
  DA5B    DD 35 12       C      	dec	(ix+dpbstp)	;Einzelstep-Impulse
  DA5E    D6 03          C      	sub	dlgint		;waere 1 Step richtig?
  DA60    28 0B          C      	jr	z,seldl1	;ja
                         C      				;nein, unsicher
  DA62    DD 36 10 FF    C      seldle:	ld	(ix+dpbslc),0ffh;provozieren 'BAD SECTOR'
  DA66    21 0000        C      	ld	hl,0		;erzeugen 'SELECT' Error
  DA69    E3             C      	ex	(sp),hl
  DA6A    C3 DB5F        C      	jp	selext
                         C      
                         C      ; DS/SS und 40/80 ist unterschieden, es fehlt Sektorlaenge
  DA6D    7A             C      seldl1:	ld	a,d
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-63


  DA6E    DD 77 10       C      	ld	(ix+dpbslc),a	;definieren Sektorlaengencode
                         C       IF	dbufsz le 7
                         C       ELSE
                         C      	IF	dbufsz lt 10	;Test, ob Disk-Puffer ausreicht
                         C      	ENDIF
  DA71    B7             C      	or	a		;Sektorlaenge 128?
  DA72    20 0F          C      	jr	nz,seldxl	;nein, normale Sektorfolge
                         C       ENDIF	;dbufsz gt 7
                         C       IF dsk8mf
                         C       ENDIF
  DA74                   C      seldsv:
                         C      ; Stellen Sektor-Translate-Tabelle 1,7,13,..
  DA74    DD E5          C      	push	ix
  DA76    E1             C      	pop	hl
  DA77    01 0019        C      	ld	bc,dpbstr
  DA7A    09             C      	add	hl,bc
  DA7B    EB             C      	ex	de,hl
  DA7C    21 DF0E        C      	ld	hl,xlt
  DA7F    0E 1A          C      	ld	c,26
  DA81    ED B0          C      	ldir
  DA83                   C      seldxl:
                         C      
  DA83    CD DEA1        C      	call	dtrsla		;stellen hl entspr. Sektorlaenge
  DA86    20 DA          C      	jr	nz,seldle	;unzulaessig
  DA88    01 0005        C      	ld	bc,dsll		;Laenge eines Eintrags
                         C       IF disk8
                         C       ENDIF
  DA8B    DD CB 12 4E    C      	bit	1,(ix+dpbstp)	;40 Tr. auf 80er LW?
  DA8F    20 08          C      	jr	nz,seld40	;ja
  DA91    DD 7E 16       C      	ld	a,(ix+dpbptr)	;40er LW?
  DA94    FE 29          C      	cp	40+1
  DA96    38 01          C      	jr	c,seld40	;ja, 40 Tr. auf 40er LW
  DA98    09             C      	add	hl,bc		;auf 80er Format stellen
  DA99    DD CB 0F 6E    C      seld40:	bit	dpbfds,(ix+dpbflg)	;DS?
  DA9D    28 02          C      	jr	z,seldss	;nein
  DA9F    09             C      	add	hl,bc		;auf DS Format
  DAA0    09             C      	add	hl,bc
  DAA1                   C      seldss:
  DAA1                   C      selset:
                         C      ; DPB modifizieren entsprechend erkanntem Format
  DAA1    4E             C      	ld	c,(hl)		;Zahl der benutzten Spuren
  DAA2    DD 71 14       C      	ld	(ix+dpbtrk),c
  DAA5    23             C      	inc	hl
  DAA6    4E             C      	ld	c,(hl)		;Anzahl 128er Sektoren pro Spur
  DAA7    DD 71 00       C      	ld	(ix+dpbspt),c
  DAAA    23             C      	inc	hl
  DAAB    4E             C      	ld	c,(hl)		;Anzahl der Dir-Eintraege -1
  DAAC    23             C      	inc	hl
  DAAD    7E             C      	ld	a,(hl)		;Anzahl der Systemspuren
  DAAE    CB 3F          C      	srl	a		;feste Anzahl erzwungen?
  DAB0    38 28          C      	jr	c,seldof	;ja
  DAB2    DD CB 0D 7E    C      	bit	7,(ix+dpbofs)	;kann Spur 0 Directory sein?
  DAB6    28 22          C      	jr	z,seldof	;nein, Standardanzahl setzen
  DAB8    DD 34 0D       C      	inc	(ix+dpbofs)	;evtl. leere Systemspur?
  DABB    28 1C          C      	jr	z,seldo0	;nein, 0 Systemspuren
  DABD    47             C      	ld	b,a		;retten Anzahl Systemspuren
  DABE    32 DF49        C      	ld	(dbtrk),a	;einlesen evtl. moeglicher Datenbeginn
  DAC1    E5             C      	push	hl
  DAC2    CD DD70        C      	call	dbtran		; dauert bei falscher Spur etwas laenger
  DAC5    E1             C      	pop	hl
  DAC6    78             C      	ld	a,b
  DAC7    20 11          C      	jr	nz,seldof	;Fehler, mit Systemspuren annehmen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-64


  DAC9    FD E5          C      	push	iy
  DACB    FD 2A DF4E     C      	ld	iy,(dbdma)
  DACF    FD 7E 0E       C      	ld	a,(iy+14)	;falls dort Dir, so Byte 14 von Dir =0
  DAD2    FE E5          C      	cp	0e5h		;Daten auch leer?
  DAD4    FD E1          C      	pop	iy
  DAD6    78             C      	ld	a,b
  DAD7    20 01          C      	jr	nz,seldof	;nein, vorn liegen nichtbelegte Systemspuren
  DAD9    AF             C      seldo0:	xor	a		;sonst ohne Systemspuren
  DADA    DD 77 0D       C      seldof:	ld	(ix+dpbofs),a
  DADD    B7             C      	or	a		;0 Systemspuren?
  DADE    28 07          C      	jr	z,selddr	;ja
  DAE0    79             C      	ld	a,c		;Anzahl Dir-Eintraege -1
  DAE1    FE BF          C      	cp	192-1		;>=192 Dir-Eintraege ?
  DAE3    38 02          C      	jr	c,selddr	;nein
  DAE5    0E 7F          C      	ld	c,128-1		;780k hat 128 Dir-Eintraege
  DAE7    DD 71 07       C      selddr:	ld	(ix+dpbdir),c
  DAEA    23             C      	inc	hl
  DAEB    4E             C      	ld	c,(hl)		;Abstand der Blockgroessentab.
  DAEC    06 00          C      	ld	b,0
  DAEE    09             C      	add	hl,bc		;auf Blockgroessentabelle
  DAEF    4E             C      	ld	c,(hl)
  DAF0    DD 71 02       C      	ld	(ix+dpbbls),c
  DAF3    23             C      	inc	hl
  DAF4    4E             C      	ld	c,(hl)
  DAF5    DD 71 03       C      	ld	(ix+dpbblm),c
  DAF8    23             C      	inc	hl
  DAF9    4E             C      	ld	c,(hl)
  DAFA    DD 71 04       C      	ld	(ix+dpbexm),c
                         C      
                         C      ; Bestimmen Zahl der abweichenden 128er-Sektoren ab Spur 0
                         C      
  DAFD    AF             C      	xor	a
  DAFE    32 DF42        C      	ld	(dfrmtr),a	;ab Spur 0
                         C      		;(gleichz. Spurkorr. bei falschen Doppelstepimpulsen)
  DB01    CD DD82        C      sf128z:	call	dsidtr		;beliebigen SektId lesen
  DB04    20 18          C      	jr	nz,sf128e	;Fehler
  DB06    7C             C      	ld	a,h		;Sektorlaenge
  DB07    DD BE 10       C      	cp	(ix+dpbslc)	;gleich Disketten-Rest?
  DB0A    28 12          C      	jr	z,sf128e	;ja
  DB0C    DD 7E 0F       C      	ld	a,(ix+dpbflg)
  DB0F    E6 03          C      	and	dpbfsm		;bisherige Anzahl abweichender Spuren
  DB11    FE 03          C      	cp	dpbfsm		;Zaehler voll?
  DB13    28 09          C      	jr	z,sf128e	;ja
  DB15    DD 34 0F       C      	inc	(ix+dpbflg)	;erhoehen abweich. Spurzahl
  DB18    21 DF42        C      	ld	hl,dfrmtr	;naechste (logische!) Spur
  DB1B    34             C      	inc	(hl)
  DB1C    18 E3          C      	jr	sf128z
  DB1E                   C      sf128e:
                         C      
                         C      ; Setzen Anzahl der logischen 128er Rekords im Puffer -1
                         C      ; Es wird immer das Maximum gesetzt, dies setzt eine dichte
                         C      ; Sektorfolge beim Transfer voraus! (so in dpbstr)
                         C      
                         C      	IF	dbufsz gt 7
  DB1E    DD 36 11 07    C      	ld	(ix+dpbbfm),+(1 shl (dbufsz-7))-1
                         C      	ENDIF
                         C      
                         C      ; Berechnen Speicherkapazitaet-1 in BDOS-Bloecken aus
                         C      ; ((Tracks-dpbofs)*dpbspt/(2**dpbbls))-1
  DB22    DD 6E 14       C      	ld	l,(ix+dpbtrk)
  DB25    AF             C      	xor	a
  DB26    67             C      	ld	h,a		;hl:=log. Spurzahl
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-65


  DB27    DD 5E 0D       C      	ld	e,(ix+dpbofs)
  DB2A    57             C      	ld	d,a		;de:=log. offset-Spurzahl
  DB2B    ED 52          C      	sbc	hl,de
  DB2D    EB             C      	ex	de,hl		;de:=log. Daten-Spurzahl
  DB2E    6F             C      	ld	l,a		;hl:=0
  DB2F    DD 46 00       C      	ld	b,(ix+dpbspt)
  DB32    19             C      dsizmz:	add	hl,de
  DB33    10 FD          C      	djnz	dsizmz		;hl:=(tracks-dpbofs)*dpbspt
  DB35    DD 46 02       C      dsizme:	ld	b,(ix+dpbbls)
  DB38    CB 3C          C      dsizdz:	srl	h
  DB3A    CB 1D          C      	rr	l
  DB3C    10 FA          C      	djnz	dsizdz
  DB3E    2B             C      	dec	hl
  DB3F    DD 75 05       C      	ld	(ix+dpbsiz),l
  DB42    DD 74 06       C      	ld	(ix+dpbsiz+1),h
  DB45    DD 7E 07       C      	ld	a,(ix+dpbdir)	;Dir-Groesse
  DB48    3C             C      	inc	a
  DB49    E6 FC          C      	and	0fch		;abrunden auf durch 4 teilbare Dir-Groesse
  DB4B    0F             C      	rrca
  DB4C    0F             C      	rrca			;div 4, da 4 Dir-Eintr. /Sekt.
  DB4D    DD 77 0B       C      	ld	(ix+dpbchk),a	;ist Sektorzahl = Check size
  DB50    DD 46 02       C      	ld	b,(ix+dpbbls)	;block shift
  DB53    0F             C      seldla:	rrca			;BDOS-Bloecke fuer Dir.
  DB54    10 FD          C      	djnz	seldla
  DB56    47             C      	ld	b,a
  DB57    AF             C      	xor	a
  DB58    37             C      seldal:	scf			;Allocation-Bits fuer Dir.
  DB59    1F             C      	rra
  DB5A    10 FC          C      	djnz	seldal
  DB5C    DD 77 09       C      	ld	(ix+dpbalc),a
                         C      ;+++++++++++Ende automatische Formaterkennung+++++++++++++
                         C      	ENDIF	;format
                         C      
  DB5F                   C      selext:
                         C       IF cpastz
                         C      ; Anzeigen Diskformat als Speicherkapazitaet in kBytes
  DB5F    3A D03D        C      	ld	a,(synflg)
  DB62    CB 77          C      	bit	stzaus,a	;Anzeige in Statuszeile erlaubt?
  DB64    20 49          C      	jr	nz,selexx	;nein
                         C      ; Ermitteln Stelle in Statuszeile
  DB66    DD 7E 15       C      	ld	a,(ix+dpbdnr)
                         C        IF dev eq cpd
                         C        ELSE
  DB69    4F             C      	ld	c,a
  DB6A    21 FF81        C      	ld	hl,statz2+statzk-stzkl
  DB6B                   C      crtm40	equ	$-2
  DB6D    11 0006        C      	ld	de,stzkl
  DB70    3C             C      	inc	a
  DB71    19             C      selexb:	add	hl,de
  DB72    3D             C      	dec	a
  DB73    20 FC          C      	jr	nz,selexb
  DB75    22 DBB5        C      	ld	(selex5),hl
                         C        ENDIF
                         C      
  DB78    79             C      	ld	a,c
  DB79    C6 30          C      	add	a,'0'
  DB7B    CD DBB4        C      	call	selex4
  DB7E    3E 3A          C      	ld	a,':'
  DB80    DD CB 18 76    C      	bit	dpbtwv,(ix+dpbtyp)	;Verify nach Schreiben?
  DB84    28 02          C      	jr	z,selexv	;nein
  DB86    3E 76          C      	ld	a,'v'		;sonst durch 'v' kennzeichnen
  DB88    CD DBB4        C      selexv:	call	selex4
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-66


                         C      
                         C      ; (dpbsiz+1)*(2**(dpbbls-3))
  DB8B    DD 6E 05       C      	ld	l,(ix+dpbsiz)
  DB8E    DD 66 06       C      	ld	h,(ix+dpbsiz+1)
  DB91    23             C      	inc	hl
  DB92    DD 7E 02       C      	ld	a,(ix+dpbbls)
  DB95    D6 03          C      	sub	3
  DB97    28 04          C      	jr	z,selex1
  DB99    29             C      selex2:	add	hl,hl
  DB9A    3D             C      	dec	a
  DB9B    20 FC          C      	jr	nz,selex2
  DB9D    11 FF9C        C      selex1:	ld	de,-100		;immer dreistellig
  DBA0    CD DBB1        C      	call	selex3
  DBA3    11 FFF6        C      	ld	de,-10
  DBA6    CD DBB1        C      	call	selex3
  DBA9    7D             C      	ld	a,l
  DBAA    F6 30          C      	or	'0'
  DBAC    CD DBB4        C      	call	selex4
                         C       ENDIF
                         C      
  DBAF    E1             C      selexx:	pop	hl		;hl auf DPH
  DBB0    C9             C      	ret			;Return Seldsk
                         C      
                         C       IF cpastz
                         C        IF dev eq cpd
                         C        ELSE
  DBB1    CD E727        C      selex3:	call	mhldig		;10er Ziffer nach A
  DBB4    11 0000        C      selex4:	ld	de,0
  DBB5                   C      selex5	equ	$-2		;Zeiger in Statuszeile
                         C      	setbs
  DBB7    12             C      	ld	(de),a		;ablegen in Statuszeile
                         C      	setram
  DBB8    13             C      	inc	de
  DBB9    ED 53 DBB5     C      	ld	(selex5),de
  DBBD    C9             C      	ret
                         C        ENDIF
                         C       ENDIF
                         C      
                         C      
                         C      ; auf Spur 0 zurueck (vor jedem Dir-Zugriff)
                         C      ;===================
  DBBE                   C      home:
                         C      	IF	dbufsz gt 7
  DBBE    21 DF47        C      	ld	hl,dbflg
  DBC1    CB 56          C      	bit	dfbwr,(hl)	;veraenderter Puffer?
  DBC3    20 05          C      	jr	nz,home1	;ja, nicht freigeben
  DBC5    3E FF          C      	ld	a,0ffh		;sonst Diskwechsel erlauben
  DBC7    32 DF48        C      	ld	(dbdev),a	;Puffer ist nicht aktiv
                         C      	ENDIF
  DBCA    01 0000        C      home1:	ld	bc,0
                         C      ;-----------------------
                         C      
                         C      ; Einstellen Spur in Reg. BC
                         C      ;================
  DBCD                   C      settrk:
  DBCD    ED 43 DF52     C      	ld	(dtrack),bc	;Spur merken
  DBD1    C9             C      	ret
                         C      ;-----------------------
                         C      
                         C      ; Einstellen Sektor in Reg. C
                         C      ;==================
  DBD2    79             C      setsec:	LD	A,C
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-67


  DBD3    32 DF54        C      	LD	(dsectr),A
  DBD6    C9             C      	RET
                         C      ;-----------------------
                         C      
                         C      ; Einstellen DMA in Reg. BC
                         C      ;===============
  DBD7    ED 43 DF57     C      setdma:	LD	(ddma),BC
  DBDB    C9             C      	RET
                         C      ;-----------------------
                         C      
                         C      ; Uebersetzung Sektornummer 
                         C      ;==========================
                         C      ; Translate-Tab-Adr. in DE, Eingangs-Sektornummer in BC,
                         C      ;			    Ausgangs-Sektornummer in HL
                         C      ; Es wird keine Translate-Tabelle benutzt, da die Sektor-
                         C      ; nummernverwaltung verallgemeinert im nicht-Standard-DPB 
                         C      ; enthalten ist (auch fuer physische Sektorlaenge <>128)
                         C      
  DBDC                   C      sectran:
  DBDC    60             C      	LD	H,B
  DBDD    69             C      	LD	L,C
  DBDE    23             C      	inc	hl		;Sektoren zaehlen in CP/A ab 1
  DBDF    C9             C      	RET
                         C      ;-----------------------
                         C      
                         C      ; Schreiben Sektor
                         C      ;=================
                         C      ; Register C (vom BDOS gestellt):
                         C      ;	=0, wenn normales write
                         C      ;	=1, wenn directory-write (sofort ausgeben)
                         C      ;	=2, wenn Beginn eines neuen Datenblocks (kein preread)
                         C      
  DBE0                   C      write:
                         C       IF @write
  DBE0    59             C      	ld	e,c		;retten Reg. C
  DBE1    3A DF51        C      	ld	a,(ddrive)
  DBE4    4F             C      	ld	c,a
  DBE5    CD E7E9        C      	call	dgetpb		;ix:=dpb(ddrive)
  DBE8    28 6B          C      	jr	z,drwerr	;Geraet ex. nicht
                         C       if ramfl
                         C      ;###RAM-Floppy
  DBEA    DD CB 0F 7E    C      	bit	dpbfnd,(ix+dpbflg)	;Diskette?
  DBEE    C2 E44F        C      	jp	nz,wrramf	;nein
                         C      ;###
                         C       endif
  DBF1    21 DF50        C      	ld	hl,dflg
  DBF4    CB D6          C      	set	dfwr,(hl)	;Write-Flag setzen
                         C      
                         C      	IF	dbufsz gt 7	;gepufferte Disk E/A
  DBF6    21 DF47        C      	ld	hl,dbflg
  DBF9    CB C6          C      	set	dfbprr,(hl)	;Annahme preread notwendig
  DBFB    7B             C      	ld	a,e		;A:= Write-Typ
  DBFC    32 DF5F        C      	ld	(dwrtyp),a	;merken Write-Typ
  DBFF    FE 02          C      	cp	2		;write to unallocated?
  DC01    20 17          C      	jr	nz,chkuna	;nein
  DC03    DD 7E 03       C      	ld	a,(ix+dpbblm)	;Zahl der 128-Sekt. im Block -1
  DC06    3C             C      	inc	a
  DC07    32 DF59        C      	ld	(unacnt),a	;fuer diese Sekt. kein preread
  DC0A    21 DF5A        C      	ld	hl,unadev
  DC0D    71             C      	ld	(hl),c
  DC0E    2A DF52        C      	ld	hl,(dtrack)
  DC11    22 DF5B        C      	ld	(unatrk),hl
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-68


  DC14    3A DF54        C      	ld	a,(dsectr)
  DC17    32 DF5D        C      	ld	(unasec),a
  DC1A    21 DF59        C      chkuna:	ld	hl,unacnt
  DC1D    7E             C      	ld	a,(hl)
  DC1E    B7             C      	or	a		;noch nicht geschr. Sekt. da?
  DC1F    28 56          C      	jr	z,alloc		;nein
  DC21    3D             C      	dec	a		;sonst Restzahl -1
  DC22    77             C      	ld	(hl),a
  DC23    23             C      	inc	hl
  DC24    79             C      	ld	a,c
  DC25    BE             C      	cp	(hl)		;gleiches Geraet?
  DC26    20 4F          C      	jr	nz,alloc	;nein
  DC28    23             C      	inc	hl
  DC29    3A DF52        C      	ld	a,(dtrack)
  DC2C    BE             C      	cp	(hl)		;gleiche Spur?
  DC2D    20 48          C      	jr	nz,alloc	;nein
  DC2F    23             C      	inc	hl
  DC30    3A DF53        C      	ld	a,(dtrack+1)
