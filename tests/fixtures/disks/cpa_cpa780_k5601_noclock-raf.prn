                         C      
                         C      ; RAF-DPB komplett, Test, ob RAF jungfraeulich
  0B4B    CD 0B69        C      	call	rafr01		;Spur 0, Sector 1
                         C      				;evtl. moeglicher Parity-Fehler ignoriert
  0B4E    21 F061        C      	ld	hl,dirbuf
  0B51    11 0B85        C      	ld	de,rafvld
  0B54    06 20          C      	ld	b,32		;Test RAF-valid Entry einschl. Kapazitaet
  0B56    1A             C      rafvl1:	ld	a,(de)
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-145


  0B57    BE             C      	cp	(hl)
