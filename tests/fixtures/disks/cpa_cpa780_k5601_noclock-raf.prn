  D798    5E             C      	db	@ld	;Port fuer Daten
  D799    5F             C      	DB	@ls	;Port fuer Status/Kommando
                         C       IF (@lt mod 10) lt 5	;;SIO ###########################################
                         C       if ((@lt mod 10) eq 0) or ((@lt mod 10) eq 1) or ((@lt mod 10) eq 3)
  D79A    D7D0           C      	dw	cdsioo	;;Senden
