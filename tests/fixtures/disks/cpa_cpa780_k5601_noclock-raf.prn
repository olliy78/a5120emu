  0B5A    13             C      	inc	de
  0B5B    23             C      	inc	hl
  0B5C    10 F8          C      	djnz	rafvl1
  0B5E    18 05          C      	jr	rafvlf		;keine Jungfrau mehr
                         C      
                         C      ; RAF ist frisch zugeschaltet
  0B60    D1             C      rafvl2:	pop	de
