                         C      ; Vorbereiten naechsten unalloc write-Aufruf
  DC3D    DD BE 00       C      	cp	(ix+dpbspt)	;neue Spur?
  DC40    38 0A          C      	jr	c,unatr1	;nein
  DC42    2B             C      	dec	hl
  DC43    56             C      	ld	d,(hl)
  DC44    2B             C      	dec	hl
  DC45    5E             C      	ld	e,(hl)
