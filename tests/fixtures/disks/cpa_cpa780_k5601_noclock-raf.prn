                         C      
                         C      ; Test, ob Taste (neu) gedrueckt
                         C      ;===============================
                         C      ; o AF	=00 und Z=1	keine Taste
                         C      ;	=FF und Z=0	es ist eine Taste gedrueckt
  D233                   C      kbdst1:
                         C      
