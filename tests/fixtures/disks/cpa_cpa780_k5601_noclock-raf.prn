                         C       ENDIF	;format
                         C      
                         C      	include BIOSDSKW
                         C      ;;***************************************************************
                         C      ;;	Arbeitsbereiche logischer Floppy-Treiber im System-RAM *
                         C      ;;***************************************************************
                         C      ;; 03.06.89
                         C      
                         C       IF errvar
                         C      ;; Fehlermeldung Disk I/O Error
                         C      ;;=============================
                         C      ;; Genau so lang (kurz), wie in Statuszeile Platz dafuer da ist!
                         C      ;; und das sind 17 Bytes!
  DF28                   C      derrms:
                         C       IF cpastz
                         C       ENDIF
  DF28    58             C      derrrw:	db	'X'
  DF29    58 3B 54 2C    C      derrcd:	db	'X;T,Si,Se='
  DF2D    53 69 2C 53    C      
  DF31    65 3D          C      
  DF33    58 58          C      derrtr:	db	'XX'
  DF35    58 58          C      derrts:	db	'XX'
  DF37    58 58          C      derrsc:	db	'XX'
                         C       IF cpastz
                         C       ENDIF
                         C      
                         C       ENDIF
                         C      
                         C      ;; CDB's
                         C      ;;======
                         C      
                         C      ;;CDB fuer Bestimmung Laufwerksbereitschaft bei Select Disk
                         C      ;;--------------------------------------------------------
  DF39                   C      drdcdb:
  DF39    10             C      drdflg:	db	(1 shl dioftr)	;;Lesen, kein Fehlerprotokoll
  DF3A    FF             C      drddev:	db	0ffh		;;Geraet
  DF3B    0000           C      drdtrk:	dw	0		;;Spur
  DF3D    01             C      	db	1		;;Sektor (bel.)
  DF3E    01             C      	db	1		;;Sektorlaengencode (>0, 1..3)
  DF3F    00             C      	db	0		;;Sektoranzahl=0 -> nur Positionieren
                         C      
                         C      	IF	format
                         C      ;; CDB fuer Bestimmung Spurformat
                         C      ;;------------------------------------
  DF40                   C      dfrcdb:
  DF40    12             C      dfrflg:	db	(1 shl diofid)+(1 shl dioftr)
                         C      ;;		Lesen Sektorid., kein Fehlerprotokoll
  DF41    FF             C      dfrmdv:	db	0ffh		;;Geraet
  DF42    FF             C      dfrmtr:	db	0ffh		;;Spur
  DF43    FF             C      	db	0ffh		;;Seite (bel.)
  DF44    01             C      	db	1		;;Sektor (bel.)
  DF45    01             C      	db	1		;;Sektorlaengencode (>0, 1..3)
  DF46    01             C      	db	1		;;Sektoranzahl (>0)
                         C      	ENDIF
                         C      
                         C      	IF	format or (dbufsz gt 7)
                         C      ;; Puffer-CDB
                         C      ;;-----------
  DF47                   C      dbcdb:
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-79


  DF47    00             C      dbflg:	db	0
  0000                   C      dfbprr	equ	diof00		;;=1, wenn Puffer erst gelesen 
                         C      ;;				     werden muss
  0002                   C      dfbwr	equ	diofwr		;;=1, wenn Puffer durch
                         C      ;;				     Schreiben veraendert
  0004                   C      dfbtr	equ	dioftr		;;=1, wenn mit Fehlerprotokoll
                         C      ;; restliche Bits immer =0
  DF48    FF             C      dbdev:	db	0ffh
  DF49    FF             C      dbtrk:	db	0ffh
  DF4A    FF             C      dbsid:	db	0ffh
  DF4B    FF             C      dbsec:	db	0ffh
  DF4C    FF             C      dbslc:	db	0ffh
  DF4D    FF             C      dbsnb:	db	0ffh
                         C      	IF	dbufsz gt 7
  DF4E    F2B7           C      dbdma:	dw	dbuf
                         C      	ENDIF
                         C      	ENDIF
                         C      
                         C      ;; CDB fuer ungepufferte E/A
                         C      ;;--------------------------
                         C      
  DF50                   C      dcdb:
  DF50    00             C      dflg:	db	0
  0002                   C      dfwr	equ	diofwr 		;;=1, wenn write-Aufruf
                         C      ;; restliche Bits immer =0
  DF51    00             C      ddrive:	db	0
  DF52    FF             C      dtrack:	db	0ffh
  DF53    FF             C      	db	0ffh		;;Seite
  DF54    FF             C      dsectr:	db	0ffh
  DF55    00             C      	db	0		;;128 Bytes Sektorlaenge
  DF56    01             C      	db	1		;;immer nur 1 Sektor
  DF57    FFFF           C      ddma:	dw	0ffffh
                         C      
                         C       if ramfl
  DF52                   C      rtrack	equ	dtrack
                         C       endif
                         C      
                         C      ;; Pufferzugriff
                         C       IF @write
                         C       IF dbufsz gt 7
  DF59    00 FF FF FF    C      unacnt:	db	0,0ffh,0ffh,0ffh,0
  DF5D    00             C      
  DF5A                   C      unadev	equ	unacnt+1
  DF5B                   C      unatrk	equ	unacnt+2
  DF5D                   C      unasec	equ	unacnt+4
                         C       ENDIF
                         C       ENDIF
                         C       IF dbufsz gt 7
  DF5E    FF             C      dbnb:	db	0ffh
  DF5F    FF             C      dwrtyp:	db	0ffh
  DF60    00             C      dberrf:	db	0		;;Ergebnisflag letztes dbtran
                         C       ENDIF
                         C      	include BIOSDSKB
                         C      ;;***************************************************************
                         C      ;;	Arbeitsbereiche logischer Floppy-Treiber im BIOS-RAM   *
                         C      ;;***************************************************************
                         C       IF dev eq cpd
                         C       ELSE
  DF61                   C      diocdb:	ds	9,0ffh
                         C       ENDIF
  DF61                   C      diocfl	equ	diocdb+0
  DF62                   C      diocde	equ	diocdb+1
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-80


  DF63                   C      dioctr	equ	diocdb+2
  DF64                   C      diocsi	equ	diocdb+3
  DF65                   C      diocse	equ	diocdb+4
  DF66                   C      diocsl	equ	diocdb+5
  DF67                   C      diocsn	equ	diocdb+6
  DF68                   C      diocad	equ	diocdb+7
  0009                   C      diocdl	equ	9		;;Anzahl der Bytes
                         C      
                         C       IF dev eq cpd
                         C       ELSE
                         C        IF disknb eq 0
                         C        ENDIF
                         C       ENDIF
                                 IF disknb ne 0
                         C      	include BIOSDSKT
                         C      ;*********************************************************
                         C      ; physischer Disketten-Transfer
                         C      ; Aenderungen:
                         C      ; - Es koennen 9 statt bisher 4 phys. Sektoren auf einmal gelesen werden
                         C      ;!-!Schnittstellenaenderung bei SektId lesen:
                         C      ;   ft.anz muss <>0 sein (zuvor beliebig, bei =0 kein Transfer)
                         C      ;   ft.len muss 0..3 sein (zuvor beliebig, bei >3 fehlerhafte Tabellenmodif.)
                         C      ;   ft.kom, Bit 7 eingefuehrt: =0 Vorderseite, =1 Rueckseite
                         C      ;   ft.kom, Bit 0 (Verify nach Schreiben) auf Bit 6 verlegt
                         C      ;   ft.kom, Bit 0 =1 bedeutet "keine Fehlerwiederholung"
                         C      ; - Floppy-Treiber auch fuer Variante K5120/22 generierbar
                         C      ; 06.07.88
                         C      ; - Motor-Start-Wait von 254 auf 252 veraendert (2.5 Umdrehungen)
                         C      ;   (ist bei einigen Laufwerken wegen PreReady notwendig)
                         C      ; 03.11.22
                         C      ; - Variante K5122 eingefuegt
                         C      ; 25.09.89
                         C      ; - bei MFS 1.2 bei Mehr-Sektor-Transfer "Fault reset" zwischen den Sektoren
                         C      ;*********************************************************
                         C      
                         C      ; Aufruf:
                         C      ; -------
                         C      ; Bereitstellung der Parameter auf den Bytes:
                         C      
                         C      ;       ft.kom:	db	0	; bit0 - =1 ohne Fehlerwiederholung
                         C      ;				     1 - =1 lesen ft.len von beliebigem Sektor
                         C      ;				     2 - =0 lesen ; =1 schreiben Sektor(en)
                         C      ;				     3 - =0-FM; =1-MFM   (5"FM nur bei PC1715)
                         C      ;				     4 - =0-8"; =1-5"
                         C      ;				     5 - =0- 40-Spur-Laufwerk; =1- 80-Spur-LW
                         C      ;				     6 - =1 bei verify nach schreiben
                         C      ;				     7 - =0 Vorderseite, =1 Rueckseite
                         C      ;	ft.adr: dw	0	; Transferadresse
                         C      ;	ft.lwn: db	0	; 0..3 phys. Laufwerksnummer
                         C      ;	ft.trk: db	0	; 0..  track
                         C      ;	ft.sid: db	0	; 0..ff side (side=0 auf Rueckseite moeglich!)
                         C      ;	ft.sec: db	0	; 0..  sector (beliebig bei SektId lesen)
                         C      ;	ft.len: db	0	; 0..3 Sektorlaenge (auch 0..3 bei SektId les.)
                         C      ;	ft.anz: db	0	; 0..9 Anzahl der zu uebertragenden Sektoren
                         C      ;				;      =0: nur Positionieren
                         C      ;				;      (<>0 bei SektId lesen)
                         C      ;       ft.stp: db	0	;      Anzahl der Stepimpulse von Spur zu Spur
                         C      ;	ft.sti: db	0	;      Schrittzeit von Spur zu Spur
                         C      ;				;      in 0,1ms Einheiten
                         C      ;
                         C      ;	call	floppy
                         C      ;       ...			; in A steht Ergebniskode
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-81


                         C      ;				; alle Register (auch IX) undef.
                         C      ;
                         C      ; Ergebniskode (in Reg. A):
                         C      ;	00h kein Fehler (Z-Flag nicht von floppy gesetzt)
                         C      ;	'C' CRC-Fehler
                         C      ;	'D' LW nicht existent
                         C      ;	'R' Geraet nicht bereit, aber existent
                         C      ;	'L' unzulaessige Transferlaenge
                         C      ;	'S' Sektor nicht gefunden
                         C      ;	'T' Spurnummer zu gross
                         C      ;	'U' keine Marke gefunden
                         C      ;	'W' Diskette schreibgeschuetzt
                         C      
                         C      ; Paramfeld wird an folgenden Stellen veraendert:
                         C      ;  Komm. "Lesen Sekt,Id.":	ft.trk .. ft.len gestellt
                         C      ;  Komm. "Schreiben mit Verify":ft.kom, bit 2 geloescht
                         C      ;**************************************************
                         C      
  0004                   C      maxlw	equ	4		; Anzahl der Laufwerke (1..4)
                         C      
                         C      ; Adressen der Floppy-Karte
                         C      ;==========================
                         C      
                         C       IF (fdc eq k5120) or (fdc eq k5122)
                         C      ;Steuer-PIO
  0010                   C      flcoad    equ  10h  ;PORT A
  0011                   C      flcoac    equ  11h
  0012                   C      flcobd    equ  12h  ;PORT B
  0013                   C      flcobc    equ  13h
                         C      
                         C      ;Daten-PIO
  0014                   C      fldaad    equ  14h  ;Port A Schreib-Daten
  0015                   C      fldaac    equ  15h
  0016                   C      fldabd    equ  16h  ;Port B Lese-Daten
  0017                   C      fldabc    equ  17h
                         C      
                         C      ;Select-Latch
  0018                   C      flsel     equ  18h  ;Bit 7..4 /Sel LW3..0;Bit 3..0  /LCK  LW 3..0
                         C      ;
                         C       ENDIF
                         C      
                         C       IF (fdc eq f1715)
                         C       ENDIF
                         C      
                         C      ;; Legende AMF:
                         C      ;;   Port A
                         C      ;;  | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |
                         C      ;;    |   |   |   |   |   |   |   |__ A  /WE  0-Schreiben ein
                         C      ;;    |   |   |   |   |   |   |______ A   MK  lesen  0-MFM-A1 Erkennung
                         C      ;;    |   |   |   |   |   |                          1-FM-Mark., MFM-C2 Erkenn.
                         C      ;;    |   |   |   |   |   |               schreiben  0-Takt fuer MFM
                         C      ;;    |   |   |   |   |   |                          1-Marken FM und A1 MFM
                         C      ;;    |   |   |   |   |   |__________ A  /SIDE 0-Kopf Seite 1; 1-Kopf Seite 0
                         C      ;;    |   |   |   |   |        oder   A  /FR   0-Fault reset;  1-kein FR
                         C      ;;    |   |   |   |   |______________ A  /STR 0-AMF aktiv
                         C      ;;    |   |   |   |                           1-AMF ausgeschaltet
                         C      ;;    |   |   |   |__________________ A   MK1 lesen  0-Informationen einlesen
                         C      ;;    |   |   |                                      1-nur 1 einlesen
                         C      ;;    |   |   |                           schreiben  0-FM-Daten schreiben
                         C      ;;    |   |   |                                      1-MFM und FM-Marken schr.
                         C      ;;    |   |   |______________________ A   MR, SD     0-steppen Richtung aussen
                         C      ;;    |   |                                          1-Marke-erkannt loeschen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-82


                         C      ;;    |   |                                            steppen Richtung innen
                         C      ;;    |   |__________________________ A  /HL         0-Kopf geladen
                         C      ;;    |                                              1-Kopf entladen
                         C      ;;    |______________________________ A  /ST         0-Stepsignal an LW ein
                         C      ;;                                                   1-Stepsignal an LW aus
                         C      ;;
                         C      ;;  Port B
                         C      ;;  | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |
                         C      ;;    |   |   |   |   |   |   |   |__ E  /RDY  0-Laufwerk bereit
                         C      ;;    |   |   |   |   |   |   |                1-Laufwerk nicht bereit
                         C      ;;    |   |   |   |   |   |   |______ E  /MKE  0-Marke erkannt
                         C      ;;    |   |   |   |   |   |                    1-Marke noch nicht erkannt
                         C      ;;    |   |   |   |   |	 oder PC1715  E   MKE  1-Marke erkannt
                         C      ;;    |   |   |   |   |   | u.K5122            0-Marke noch nicht erkannt
                         C      ;;    |   |   |   |   |   |__________ E  /SYN  ???? (K5120)
                         C      ;;    |   |   |   |   |  oder K5122   A  /HF   0-Takt fuer 8" MFM
                         C      ;;    |   |   |   |   |                        1-Takt fuer 5" MFM und 8" FM
                         C      ;;    |   |   |   |   |  oder PC1715: A   MFM  0-FM-Aufzeichnung
                         C      ;;    |   |   |   |   |                        1-MFM-Aufzeichnung
                         C      ;;    |   |   |   |   |______________ A   PRE  0-schreiben ohne Prekompensation
                         C      ;;    |   |   |   |                            1-schreiben mit         "
                         C      ;;    |   |   |   |__________________ E  /FA   0-Fehler in der AMF aufgetreten
                         C      ;;    |   |   |                                1-kein Fehler aufgetreten
                         C      ;;    |   |   |          oder PC1715: A   FO   0-5"-Disketten
                         C      ;;    |   |   |                                1-8"-Disketten
                         C      ;;    |   |   |______________________ E  /WP   0-Schreibschutz ist ein
                         C      ;;    |   |                                    1-kein Schreibschutz
                         C      ;;    |   |__________________________ E  /FW   0-Laufwerk meldete Schreibfehler
                         C      ;;    |                                        1-Laufwerk meldete keinen Fehler
                         C      ;;    |______________________________ E  /T0   0-Kopf steht auf Spur 0
                         C      ;;                                             1-Kopf steht nicht auf Spur 0
                         C      
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                         C      ;	FLOPPY-Treiber
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
  DF6A                   C      floppy:
                         C      
                         C      ; Anfangswerte stellen
  DF6A    3A E242        C      	ld	a,(ft.kom)
  DF6D    E6 01          C      	and	1		;Fehlerwiederholung?
  DF6F    20 02          C      	jr	nz,setecr	;nein, A=0+1 (keine Wiederholung)
  DF71    3E 10          C      	ld	a,15+1
  DF73    32 E268        C      setecr:	ld	(crerc),a	; Fehlerzaehler fuer CRC-Fehlerwiederholungen
  DF76    20 02          C      	jr	nz,setesp
  DF78    3E 05          C      	ld	a,4+1		; Fehlerzaehler fuer Spurfindewiederholungen
  DF7A    32 E269        C      setesp:	ld	(sperc),a
                         C      
                         C      ; Laufwerksnummer pruefen
  DF7D    3A E245        C      	ld	a,(ft.lwn)	; LW
                         C      ;	cp	maxlw		; LW < groesster LW-Nr.?
                         C      ;	jr	nc,nolw		; -> nein, Fehler: LW nicht existent
  DF80    4F             C      	ld	c,a		; merken LW fuer Motor-an-Test
  DF81    47             C      	ld	b,a		; fuer djnz
  DF82    B7             C      	or	a		; LW=0?
  DF83    3A E26B        C      	ld	a,(lwexis)
  DF86    28 04          C      	jr	z,drv0		; ->ja
  DF88    0F             C      sp13: 	rrca
  DF89    0F             C      	rrca
  DF8A    10 FC          C      	djnz	sp13
  DF8C    E6 03          C      drv0: 	and	3
  DF8E    20 05          C      	jr	nz,drv0a
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-83


  DF90    3E 44          C      nolw: 	ld	a,'D'		; LW nicht existent
  DF92    C3 E13E        C      	jp	fehret		; -> Fehler
                         C      
  DF95                   C      drv0a:
                         C      ; LW selektieren und Motor einschalten
  DF95    AF             C      	xor	a
  DF96    32 E213        C      	ld	(pretx+1),a	;Motorabschaltung verhindern
  DF99    3D             C      	dec	a		;A:=255
  DF9A    CD E1FA        C      	call	fl.sto		;Index-Ueberwachung ein
  DF9D    CB D9          C      	set	3,c		; Motor-an-Bit setzen
  DF9F    21 E26C        C      	ld	hl,alwnr
  DFA2    7E             C      	ld	a,(hl)
  DFA3    B9             C      	cp	c		; ist es das richtige LW und Motor an?
  DFA4    3E 6A          C      	ld	a,+pvrw2-(xpvrw+2) ; jr z,pvrw2 (keine Vertikalstab.)
  DFA6    28 42          C      	jr	z,dskmon	; ->ja, Kopf ist noch aufgesetzt
                         C      ; falsches LW oder Motor des LW aus
  DFA8    CD E22D        C      	call	flres		; alte Spurnr. merken
                         C      
                         C      ; neues LW anwaehlen, Motor einschalten und alte Spurnr. holen
  DFAB    71             C      	ld	(hl),c		; neues LW, Motor-an-Bit
  DFAC    EB             C      	ex	de,hl		;merken ^alwnr
  DFAD    CB 99          C      	res	3,c		; alte Spurnr. holen
  DFAF    06 00          C      	ld	b,0
  DFB1    21 E26E        C      	ld	hl,spnrl
  DFB4    09             C      	add	hl,bc
  DFB5    7E             C      	ld	a,(hl)
  DFB6    32 E26D        C      	ld	(aspnr),a
  DFB9    41             C      	ld	b,c
  DFBA    04             C      	inc	b
  DFBB    3E 77          C      	ld	a,077h		; LW-Anwahlbyte bilden (mit Lock)
  DFBD    07             C      nfdei2: rlca
  DFBE    10 FD          C      	djnz	nfdei2
  DFC0    D3 18          C      	out	(flsel),a	; Laufwerk selektieren (und evtl. Motor ein)
                         C       IF fdc eq f1715
                         C       ENDIF
  DFC2    3E A9          C      	ld	a,10101001b	; Kopf laden, Fault reset
  DFC4    D3 10          C      	out	(flcoad),a
                         C      
                         C      ; Motor-Start
  DFC6    2E FD          C      	ld	l,252+1		;von 255 auf 252, d.h. mind 2 Umdrehungen?
  DFC8    3A E242        C      	ld	a,(ft.kom)
  DFCB    CB 67          C      	bit	4,a		;5"?
  DFCD    28 06          C      	jr	z,dskmo1	;nein
  DFCF    CB 6F          C      	bit	5,a		;5" 40 Spur?
  DFD1    20 02          C      	jr	nz,dskmo1	;nein
  DFD3    2E FB          C      	ld	l,250+1		;von 255 auf 250,
                         C      				; d.h. mind. 4 volle Umdrehungen?
                         C      				;(bei MFS 1.2 kommt evtl. ready zu frueh)
  DFD5                   C      dskmo1:
  DFD5    3A E20B        C      dskdaw:	ld	a,(fl.zto)	;Index-Interrupt-Zaehler
  DFD8    BD             C      	cp	l		;entprechend viele Umdrehungen vorbei?
  DFD9    38 0D          C      	jr	c,dskda		;ja
  DFDB    0D             C      	dec	c		; warten, bis Diskette eingeschoben
  DFDC    20 F7          C      	jr	nz,dskdaw
  DFDE    10 F5          C      	djnz	dskdaw
  DFE0    EB             C      	ex	de,hl
  DFE1    CB 9E          C      	res	3,(hl)		;loeschen Motor an Bit
  DFE3    3E 52          C      	ld	a,'R'		;LW nicht bereit
  DFE5    C3 E13E        C      	jp	fehret
  DFE8    3E 61          C      dskda:	ld	a,+pvrw1-(xpvrw+2) ; jr z,pvrw1 (mit Vertikal-Stabil.)
  DFEA                   C      dskmon:
  DFEA    32 E032        C      	ld	(xpvrw+1),a	; Vertikal-Stabilisierung ein/aus
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-84


                         C      
                         C      
                         C       IF dsk8fm+dsk8mf+dsk5fm; Standard ist 5"MFM
                         C       ELSE
                         C       IF @write
  DFED    21 E402        C      	ld	hl,diwmfm
  DFF0    22 E367        C      	ld	(dioop),hl	;Schreiben einstellen (falls Lesen war)
                         C       ENDIF
                         C       ENDIF
                         C       if dsk80
  DFF3    3A E242        C      	ld	a,(ft.kom)
                         C       if dsk8fm+dsk8mf
                         C       endif
  DFF6    CB 6F          C      	bit	5,a		;80-Spur-LW?
  DFF8    3E 19          C      	ld	a,25		;Spur, ab der mit Praekomp.
  DFFA    28 02          C      	jr	z,dprec2	;nein
  DFFC    3E 29          C      	ld	a,41
  DFFE    32 E0B8        C      dprec2:	ld	(dpretr),a
  E001                   C      dprecn:
                         C       endif
                         C      
                         C      ; modifizieren entspr. phys. Sektorlaenge
  E001    3A E249        C      	ld	a,(ft.len)
  E004    32 E316        C      	ld	(sidlen),a
  E007    21 E27C        C      	ld	hl,dsln0-dslnl
  E00A    47             C      	ld	b,a
  E00B    04             C      	inc	b
  E00C    11 0009        C      	ld	de,dslnl
  E00F    19             C      dtrsll:	add	hl,de
  E010    10 FD          C      	djnz	dtrsll
  E012    EB             C      	ex	de,hl
  E013    21 E272        C      	ld	hl,dslnmt	;Tabelle der Modif.adr.
  E016    CD E19B        C      	call	flmodf
                         C      
                         C      ; Kopf positionieren
  E019    21 E246        C      	ld	hl,ft.trk	; gewuenschte Spur
  E01C    7E             C      	ld	a,(hl)
  E01D    B7             C      	or	a		;Spur 0?
  E01E    20 0D          C      	jr	nz,npost0	;nein
  E020    3A E24A        C      	ld	a,(ft.anz)	;Sektorzahl
  E023    B7             C      	or	a		;nur positionieren auf Spur 0 (FORMAT-Progr.)
  E024    28 4F          C      	jr	z,trk0		;ja, Spur 0 immer ueber Recalibrate
  E026    3A E242        C      	ld	a,(ft.kom)
  E029    CB 4F          C      	bit	1,a		;Lesen Sekt.id Spur 0?
  E02B    20 53          C      	jr	nz,trk0s	;ja, Lesen Sektid Spur 0 ueber Recalibrate
  E02D    3A E26D        C      npost0:	ld	a,(aspnr)	; stimmt Spur?
  E030    BE             C      	cp	(hl)
  E031    28 61          C      xpvrw:	jr	z,pvrw1		; -> ja, Kopf evtl. vertikal stabilisieren
                         C      				; auf jr z,pvrw2, wenn Kopf noch aufgesetzt
  E033                   C      spprty:				;Wiederholung bei fehlerhafter Spur
                         C      ; Positionierung auf ft.trk
  E033    3A E246        C      spe: 	ld	a,(ft.trk)
  E036    06 8F          C      	ld	b,08fh		; stepout-Befehl
  E038    21 E26D        C      	ld	hl,aspnr
  E03B    BE             C      	cp	(hl)		; auf richtiger Spur angekommen?
  E03C    28 56          C      	jr	z,phrw		; -> ja, Kopf horizontal stabilisieren
  E03E    38 0D          C      	jr	c,spre		; -> stepout
  E040    FE 55          C      xmaxtr: cp	85		; Spur zu gross?
  E042    38 05          C      	jr	c,spve		; -> nein, stepin
  E044    3E 54          C      	ld	a,'T'		; Fehler: Spurnr. zu gross
  E046    C3 E13E        C      	jp	fehret
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-85


                         C      ; stepin
  E049    06 AF          C      spve:	ld	b,0afh		; stepin-Befehl
  E04B    34             C      	inc	(hl)		; alte Spurnr. erhoehen
  E04C    34             C      	inc	(hl)		; wegen stepout-dec
                         C      
                         C      ; stepout
  E04D    35             C      spre: 	dec	(hl)		; alte Spurnr. verringern
  E04E    CD E053        C      	call	step
  E051    18 E0          C      	jr	spe
                         C      
                         C      ; steppen
  E053    3A E24B        C      step: 	ld	a,(ft.stp)	; Anzahl der Stepimpulse pro Step
  E056    0E 10          C      step0: 	ld	c,flcoad
  E058    ED 41          C      	out	(c),b		; select direction
                         C      ;;;	push	bc
                         C      ;;;	ld	b,0
                         C      ;;;step1: 	djnz	step1		; 1,3ms warten
                         C      ;;;	pop	bc
  E05A    C5             C      step2: 	push	bc
  E05B    CB B8          C      	res	7,b
  E05D    F3             C      	di			;verhindern Unterbrechung
  E05E    ED 41          C      	out	(c),b
  E060    CB F8          C      	set	7,b
  E062    ED 41          C      	out	(c),b		; step
  E064    FB             C      	ei
  E065    ED 4B E24C     C      	ld	bc,(ft.sti)	; 13,2 / 11,6 / 3,0 ms Schrittzeit
  E069    06 13          C      stepw1: ld	b,19		;(19*13)/(256*9600)=0.0001
  E06B    10 FE          C      stepw: 	djnz	stepw		;0.1 ms warten
  E06D    0D             C      	dec	c
  E06E    20 F9          C      	jr	nz,stepw1
  E070    C1             C      	pop	bc
  E071    3D             C      	dec	a
  E072    20 E6          C      	jr	nz,step2
  E074    C9             C      	ret
                         C      
                         C      ; Spur 0 anfahren (Recalibrate)
  E075    06 02          C      trk0:	ld	b,2		; nach innen, falls auf Spur -1
  E077    C5             C      trk0i:	push	bc
  E078    06 AF          C      	ld	b,0afh	 	; stepin
  E07A    CD E053        C      	call	step
  E07D    C1             C      	pop	bc
  E07E    10 F7          C      	djnz	trk0i
  E080    DB 12          C      trk0s:	in	a,(flcobd)
  E082    07             C      	rlca			; Spur 0 erreicht?
  E083    30 09          C      	jr	nc,trk0f	; -> ja
  E085    06 8F          C      	ld	b,08fh		; stepout-Befehl
  E087    3E 01          C      	ld	a,1		; in phys. Schritten
  E089    CD E056        C      	call	step0
  E08C    18 F2          C      	jr	trk0s
  E08E    AF             C      trk0f: 	xor	a
  E08F    32 E26D        C      	ld	(aspnr),a	; aktuelle Spurnr ist 0
  E092    18 9F          C      	jr	spprty
                         C      
                         C      
                         C      ; Kopf stabilisieren (horizontal und vertikal)
  E094                   C      pvrw1:	; Kopf vertikal stabilisieren
  E094                   C      phrw:	; Kopf horizontal (und evtl. auch vertikal) stabilisieren
  E094    3E 32          C      	ld	a,50		; 50 ms (fuer alle Laufwerkstypen)
  E096    06 BD          C      phrww1: ld	b,189		; (189*13)/(256*9600)=0.001
  E098    10 FE          C      phrww: 	djnz	phrww		; 1 ms warten
  E09A    3D             C      	dec	a
  E09B    20 F9          C      	jr	nz,phrww1
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-86


  E09D                   C      pvrw2:	; Kopf war aufgesetzt und Spur stimmte auch - keine Stabilis.
                         C      
  E09D                   C      rdwr:
                         C      ; Anfangswerte fuer Transfer der physischen Sektoren
  E09D    3A E24A        C      	ld	a,(ft.anz)	; Anzahl der zu uebertragenden phys. Sektoren
  E0A0    32 E30B        C      	ld	(secan1),a
  E0A3    32 E1AD        C      	ld	(secanz),a	; fuer CRC-Berechnung
                         C      
  E0A6    3A E246        C      	ld	a,(ft.trk)	; Spur
  E0A9    32 E312        C      	ld	(sidtr),a
  E0AC    21 E24B        C      	ld	hl,ft.stp
  E0AF    CB 46          C      	bit	0,(hl)		;Doppelschritte?
  E0B1    28 01          C      	jr	z,dprec1	;nein
  E0B3    87             C      	add	a,a		;sonst phys. Spur verdoppeln
  E0B4                   C      dprec1:
                         C      ; evtl. Precompensation einschalten
  E0B4    01 0412        C      	ld	bc,00000100b*256+flcobd
  E0B6                   C      dfrcod	equ	$-1		; Frequenzcode
  E0B7    FE 19          C      	cp	25		; Spur ab der mit writeprecomp.
  E0B8                   C      dpretr	equ	$-1
  E0B9    38 02          C      	jr	c,prec		; <, ohne Precompensation
  E0BB    CB D8          C      	set	3,b		; >= , mit
  E0BD    ED 41          C      prec: 	out	(c),b
                         C      
  E0BF    3A E248        C      	ld	a,(ft.sec)	; erste zu uebertr. Sektornr.
  E0C2    32 E315        C      	ld	(sidsec),a
  E0C5    3A E247        C      	ld	a,(ft.sid)
  E0C8    32 E313        C      	ld	(sidsid),a
                         C      
                         C       IF dskds ; double sided
                         C      ; evtl. side 1 anwaehlen vorbereiten
  E0CB    3A E242        C      	ld	a,(ft.kom)
  E0CE    21 E2A9        C      	ld	hl,dsidmt
  E0D1    46             C      	ld	b,(hl)
  E0D2    23             C      dsidmz:	inc	hl
  E0D3    5E             C      	ld	e,(hl)
  E0D4    23             C      	inc	hl
  E0D5    56             C      	ld	d,(hl)
  E0D6    EB             C      	ex	de,hl
  E0D7    CB 7F          C      	bit	7,a		; side 0?
  E0D9    28 04          C      	jr	z,pside0	; ja
  E0DB    CB 96          C      	res	2,(hl)		; side 1 einstellen
  E0DD    18 02          C      	jr 	pside1
  E0DF    CB D6          C      pside0:	set	2,(hl)
  E0E1    EB             C      pside1:	ex	de,hl
  E0E2    10 EE          C      	djnz	dsidmz
  E0E4    CB 6F          C      	bit	5,a		;40-Spur LW?
  E0E6    20 03          C      	jr	nz,pside2	;nein
  E0E8    EB             C      	ex	de,hl		;diom11
  E0E9    CB 96          C      	res	2,(hl)		;fault reset zwischen den Sektoren
  E0EB                   C      pside2:
                         C       ENDIF
                         C      
                         C      ; evtl. nur Lesen Sektor-Id.
  E0EB    3A E242        C      	ld	a,(ft.kom)
  E0EE    CB 4F          C      	bit	1,a		; Lesen Sekt.Id?
  E0F0    21 E303        C      	ld	hl,dio
  E0F3    28 03          C      	jr	z,srdsid	; -> nein
  E0F5    21 E369        C      	ld	hl,diotsr
  E0F8    22 E2C3        C      srdsid:	ld	(diortn),hl
                         C      
                         C       IF @write
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-87


  E0FB    3A E242        C      	ld	a,(ft.kom)	; Schreiben?
  E0FE    CB 57          C      	bit	2,a
  E100    20 08          C      	jr	nz,writpt	; -> ja, Schreibroutine steht auf dioop
                         C       ENDIF
  E102    21 E3BE        C      	ld	hl,diord
  E105    22 E367        C      	ld	(dioop),hl	; read einstellen
                         C      
                         C       IF @write
  E108    18 22          C      	jr	dtrdyt
  E10A                   C      writpt:		; pruefen, ob Schreiben erlaubt ist
  E10A    DB 12          C      	in	a,(flcobd)
  E10C    CB 6F          C      	bit	5,a		; /WP
  E10E    3E 57          C      	ld	a,'W'		; Fehler: write protected
  E110    CA E13E        C      	jp	z,fehret
                         C      
                         C      ; CRC-Zeichen der zu schreibenden Daten berechnen und in crcber ablegen
  E113    2A E243        C      	ld	hl,(ft.adr)
  E116    DD 21 E24D     C      	ld	ix,crcber	; Pointer auf 1. Daten-CRC stellen
  E11A    DD 36 00 FB    C      crcbes: ld	(ix),0fbh	; Datenbeginn
  E11E    CD E1BD        C      	call	crcbd		; CRC eines phys. Sektors berechnen
  E121    DD 72 00       C      	ld	(ix+0),d
  E124    DD 73 01       C      	ld	(ix+1),e	; ... und ablegen
  E127    CD E1A8        C      	call	crcnb		; weiterer phys. Sektor?
  E12A    20 EE          C      	jr	nz,crcbes	; -> ja
                         C       ENDIF ;@write
                         C      
                         C      
                         C      ; Disk inzwischen ready?
                         C      
  E12C                   C      dtrdyt:
  E12C    DB 12          C      dtrdyz:	IN	A,(flcobd)
  E12E    1F             C      	RRA			;ready-bit =0?
  E12F    38 FB          C      dtrdyw:	JR	C,dtrdyz	;nein, 5" Disk not ready
                         C      				;auf jr c,$+2 modif bei 8"
                         C      
  E131    3E 05          C      	ld	a,5
  E133    CD E1FA        C      	call	fl.sto		;bei evtl. Fehlerwiederholung
                         C      				; timeout-Wert wieder hochstellen
                         C      				; fuer Ueberwachung auf fehlende Marke
  E136    3A E24A        C      	ld	a,(ft.anz)	;Sektorzahl
  E139    B7             C      	or	a		; nur positionieren?
  E13A    C2 E2BC        C      	jp	nz,diorun	; -> nein, Start des Transfers
                         C      
                         C      ; kein Fehler aufgetreten
  E13D    AF             C      noerr:	xor	a
                         C      
                         C      ; Fertigmelden, Ergebnis in A
  E13E    F5             C      fehret:	push	af
  E13F    21 E213        C      	ld	hl,pretx+1	;Motorabschaltung ueber Index-Interrupt
  E142    36 0B          C      	ld	(hl),pret3-pret4;jr pret4
  E144    3E 14          C      	ld	a,20		;nach 20*200ms = 4 sec
  E146    CD E1FA        C      	call	fl.sto
  E149    F1             C      	pop	af
  E14A    C9             C      	ret
                         C      
                         C      ; normale Beendigung
                         C      ;===================
                         C      
                         C      ; Schreiben
  E14B    21 E242        C      dtrwre:	ld	hl,ft.kom
  E14E    CB 76          C      	bit	6,(hl)		;Kontrollesen?
  E150    28 EB          C      	jr	z,noerr		;nein, fertig
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-88


  E152    CB 96          C      	res	2,(hl)		;sonst schreiben loeschen (d.h. auf lesen)
  E154    C3 E09D        C      	jp	rdwr		;und auf gleichen Puffer zuruecklesen
                         C      
                         C      ; Lesen
  E157    2A E243        C      dtrrde:	ld	hl,(ft.adr)
  E15A    DD 21 E24D     C      	ld	ix,crcber
  E15E    CD E1BD        C      crcbel:	call	crcbd		;CRC bilden
  E161    CD E1B3        C      	call	crcvgl		; und vergleichen
  E164    20 07          C      	jr	nz,crcerx	; -> Fehler
  E166    CD E1A8        C      	call	crcnb		;noch ein Sektor?
  E169    20 F3          C      	jr	nz,crcbel	;ja
  E16B    18 D0          C      	jr	noerr
                         C      
                         C      ; Fehlerbehandlung
                         C      ;=================
                         C      ; blieb weiterer Versuch, Sektor CRC-richtig reinzubekommen?
  E16D    21 E268        C      crcerx: ld	hl,crerc
  E170    35             C      	dec	(hl)
  E171    C2 E09D        C      	jp	nz,rdwr		; -> ja, alles noch mal
  E174    3E 43          C      	ld	a,'C'		; Fehler: CRC-Zeichen falsch
  E176    18 C6          C      	jr	fehret
                         C      
                         C      ; Sektor nicht gefunden, evtl. falsche Spur
  E178                   C      serrx:
                         C      ; blieb weiterer Versuch, die richtige Spur zu finden?
  E178    21 E269        C      	ld	hl,sperc
  E17B    35             C      	dec	(hl)
  E17C    28 15          C      	jr	z,sperr2	; Wiederhlg. abgelaufen
  E17E    3E 02          C      	ld	a,2
  E180    BE             C      	cp	(hl)		;> 2 Wiederhlg?
  E181    DA E075        C      	jp	c,trk0		;ja, Spur neu anfahren
  E184    06 8F          C      	ld	b,08fh		;stepout
  E186    28 05          C      	jr	z,sperr4	;=2 Wiederhlg., stepout
  E188    06 AF          C      	ld	b,0afh		;stepin
  E18A    CD E053        C      	call	step		;2 mal (zuvor war stepout)
  E18D    CD E053        C      sperr4:	call	step
  E190    C3 E094        C      	jp	phrw		;Wiederholung
                         C      
  E193    3E 53          C      sperr2:	ld	a,'S'		; Fehler: Sektor ist nicht zu finden
  E195    18 A7          C      	jr	fehret
                         C      
                         C      
  E197                   C      fl.to1: ; keine Sektor-Marke gefunden
  E197    3E 55          C      	ld	a,'U'		; time-out (undefind)
  E199    18 A3          C      	jr	fehret
                         C      
                         C      ; Modifizierung entsprechend Steuertabelle
                         C      ;=========================================
                         C      ; i HL	Tabelle der Modifizierungsadressen (wohin)
                         C      ; i DE	Tabelle der Modifizierungsbytes    (was)
  E19B    46             C      flmodf:	ld	b,(hl)		;Anzahl der Adressen
  E19C    23             C      dslnmz:	inc	hl
  E19D    C5             C      	push	bc
  E19E    4E             C      	ld	c,(hl)
  E19F    23             C      	inc	hl
  E1A0    46             C      	ld	b,(hl)		;bc:=wohin
  E1A1    1A             C      	ld	a,(de)		;a:=was
  E1A2    13             C      	inc	de
  E1A3    02             C      	ld	(bc),a
  E1A4    C1             C      	pop	bc
  E1A5    10 F5          C      	djnz	dslnmz
  E1A7    C9             C      	ret
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-89


                         C      
                         C      ; CRC-Berechnung
                         C      ;===============
                         C      
                         C      ; von weiterem Sektor CRC-Zeichen berechnen?
                         C      ; IX wird weitergestellt
  E1A8    DD 23          C      crcnb: 	inc	ix		; CRC-Pointer erhoehen
  E1AA    DD 23          C      	inc	ix
  E1AC    3E FF          C      	ld	a,0ffh
  E1AD                   C      secanz	equ	$-1
  E1AE    3D             C      	dec	a
  E1AF    32 E1AD        C      	ld	(secanz),a
  E1B2    C9             C      	ret
                         C      
                         C      ; CRC-Vergleich DE mit (IX)
  E1B3    DD 7E 00       C      crcvgl: ld	a,(ix+0)
  E1B6    BA             C      	cp	d
  E1B7    C0             C      	ret	nz
  E1B8    DD 7E 01       C      	ld	a,(ix+1)
  E1BB    BB             C      	cp	e
  E1BC    C9             C      	ret
                         C      
                         C      ; von einem phys. Sektor ab HL die CRC-Zeichen berechnen
                         C      ; HL wird weitergestellt
  E1BD    11 CDB4        C      crcbd:	ld	de,0cdb4h	;CRC Anfangswert
  E1BE                   C      crcbeg	equ	$-2
  E1C0    DD E5          C      	push	ix
  E1C2    E3             C      	ex	(sp),hl		;hl:= ^Datenbeginn-Byte
  E1C3    06 01          C      	ld	b,1
  E1C5    CD E1D7        C      	call	bercrc		;CRC ueber Datenbeginn-Byte
  E1C8    E3             C      	ex	(sp),hl
  E1C9    DD E1          C      	pop	ix
  E1CB    06 01          C      	ld	b,1
  E1CC                   C      fl.tsb	equ	$-1		; Zahl der 128er Bloecke
  E1CD    C5             C      sp74: 	push	bc
  E1CE    06 80          C      	ld	b,128
  E1D0    CD E1D7        C      	call	bercrc
  E1D3    C1             C      	pop	bc
  E1D4    10 F7          C      	djnz	sp74
  E1D6    C9             C      	ret
                         C      
                         C      ; von HL an B Zeichen auf DE als CRC-Polynom draufrechnen
  E1D7    7E             C      bercrc: ld	a,(hl)
  E1D8    AA             C      	xor	d
  E1D9    57             C      	ld	d,a
  E1DA    0F             C      	rrca
  E1DB    0F             C      	rrca
  E1DC    0F             C      	rrca
  E1DD    0F             C      	rrca
  E1DE    E6 0F          C      	and	0fh
  E1E0    AA             C      	xor	d
  E1E1    57             C      	ld	d,a
  E1E2    0F             C      	rrca
  E1E3    0F             C      	rrca
  E1E4    0F             C      	rrca
  E1E5    4F             C      	ld	c,a
  E1E6    E6 1F          C      	and	1fh
  E1E8    AB             C      	xor	e
  E1E9    5F             C      	ld	e,a
  E1EA    79             C      	ld	a,c
  E1EB    0F             C      	rrca
  E1EC    E6 F0          C      	and	0f0h
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-90


  E1EE    AB             C      	xor	e
  E1EF    5F             C      	ld	e,a
  E1F0    79             C      	ld	a,c
  E1F1    E6 E0          C      	and	0e0h
  E1F3    AA             C      	xor	d
  E1F4    53             C      	ld	d,e
  E1F5    5F             C      	ld	e,a
  E1F6    23             C      	inc	hl
  E1F7    10 DE          C      	djnz	bercrc
  E1F9    C9             C      	ret
                         C      
                         C      ; Aktivieren Indexpunktueberwachung
                         C      ; i A	Zaehler (wird bis 0 runtergezaehlt)
                         C      ; nur Reg. A zerstoert
                         C      
  E1FA    32 E20B        C      fl.sto:	ld	(fl.zto),a	;Setzen Zaehler fuer Indexpunkte
  E1FD    3E 83          C      	ld	a,83h		;zulassen Indexinterrupt
  E1FF    D3 11          C      	out	(flcoac),a
  E201    C9             C      	ret
                         C      
                         C      ; Interruptbehandlungsroutine: time-out-Zeit abgelaufen
                         C      ; ausgeloest durch Index-Interrupt
  E202    ED 73 E51F     C      itimeo: ld	(intsp),sp
  E206    31 F061        C      	ld	sp,intstk
  E209    F5             C      	push	af
  E20A    3E 00          C      	ld	a,0		; Zaehler fuer time-out Takte
  E20B                   C      fl.zto	equ	$-1
  E20C    3D             C      	dec	a		; time-out -1
  E20D    32 E20B        C      	ld	(fl.zto),a
  E210    20 10          C      	jr	nz,pret1	;-> nicht abgelaufen
  E212    18 0B          C      pretx:	jr	pret3		;modif. auf "jr pret4" waehrend Transfer
  E214                   C      pret4:
                         C       IF cpu eq k2526
  E214    3E A9          C      	ld	a,10101001b	;Time out waehrend Transfer
  E216    D3 10          C      	out	(flcoad),a	;CPU 2 stoppen
  E218    3E 00          C      	ld	a,dtrtor-dtrwjr
  E21A    32 E2F3        C      	ld	(dtrret),a	;Reaktionsroutine "keine Marke gefunden"
                         C       ENDIF
  E21D    18 03          C      	jr	pret1
  E21F    CD E225        C      pret3:	call	headup
  E222    C3 E51D        C      pret1: 	jp	intraf		; allg. Ausgang Interruptroutinen
                         C      
                         C      ; Motor-Abschaltung von aussen her
                         C      ; nur Reg. AF zerstoert
  E225    3E 03          C      headup:	ld	a,3		; Indexinterrupt sperren
  E227    D3 11          C      	out	(flcoac),a
  E229    3E FF          C      	ld	a,0ffh		; Motor aus
  E22B    D3 18          C      	out	(flsel),a
                         C       IF fdc eq f1715
                         C       ENDIF
                         C      ; Motor aus und alte Spurnummer merken
  E22D    E5             C      flres: 	push	hl
  E22E    C5             C      	push	bc
  E22F    21 E26C        C      	ld	hl,alwnr
  E232    CB 9E          C      	res	3,(hl)		; Motor aus vermerken
  E234    4E             C      	ld	c,(hl)
  E235    06 00          C      	ld	b,0
  E237    21 E26E        C      	ld	hl,spnrl	; alte Spurnr. in Tabelle merken
  E23A    09             C      	add	hl,bc
  E23B    3A E26D        C       	ld	a,(aspnr)
  E23E    77             C      	ld	(hl),a
  E23F    C1             C      	pop	bc
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-91


  E240    E1             C      	pop	hl
  E241    C9             C      	ret
                         C      
                         C      
                         C      ;*****************************************************
                         C      ;	Arbeitsbereiche phys. Floppy-Treiber
                         C      ;*****************************************************
                         C      
                         C      ; Parameterfeld
                         C      ;==============
  E242    00             C      ft.kom: db	0	; Kommando
  E243    0000           C      ft.adr: dw	0	; Transferadresse
  E245    00             C      ft.lwn: db	0	; Laufwerksnummer 0..3
  E246    00             C      ft.trk: db	0	; Spurnummer   0..
  E247    00             C      ft.sid: db	0	; side-Nr.     0..1
  E248    00             C      ft.sec: db	0	; Sektornummer
  E249    00             C      ft.len: db	0	; Sektorlaenge 0..3
  E24A    00             C      ft.anz: db	0	; Anz. phys. Sektoren
  E24B    00             C      ft.stp: db	0	; Anzahl der Stepimpulse pro Spur
  E24C    00             C      ft.sti: db	0	; Schrittzeit von Spur zu Spur
                         C      
  E24D                   C      crcber: ds	3*9,0ffh; Ber. zum Ablegen der gelesenen/zu schreibenden CRC-Z.
                         C      			; reicht fuer 9 physische Sektoren pro Transfer
                         C      ; Fehler-Wiederholungszaehler
  E268    00             C      crerc: 	db	0	; CRC-Fehler
  E269    00             C      sperc: 	db	0	; Spur nicht gefunden
  E26A    00             C      seerc: 	db	0	; Sektor nicht gefunden
  E26B    00             C      lwexis: db	0	; Anzeigebyte fuer vorhandene Laufwerke
                         C      			; bit 0 = 1 LW 0 vorhanden
                         C      			; bit 2 = 1 LW 1 vorhanden
                         C      			; bit 4 = 1 LW 2 vorhanden
                         C      			; bit 6 = 1 LW 3 vorhanden
                         C      
  E26C    00             C      alwnr: 	db	0	; alte Laufwerksnummer vom vergangenen Zugriff
                         C      			; bit 0-2 LW-Nr., bit 3 = 1 Motor laeuft noch
                         C      
  E26D    00             C      aspnr:	db	0	; aktuelle Spur des durch alwnr bezeichneten LW
  E26E    00 00 00 00    C      spnrl: 	db	0,0,0,0	; Tabelle der alten Spurnummern
                         C      
                         C       IF dsk8fm+dsk8mf+dsk5fm
                         C       ENDIF ;nicht nur 5" MFM
                         C      
                         C      ; Modifizierungstabelle entspr. Sektorlaenge
                         C      
  E272    09             C      dslnmt:	db	dslnl		;Tabellenlaenge
  E273    E1CC           C      	dw	fl.tsb		;Anzahl der 128er Bloecke
  E275    E3CF           C      	dw	diosl1		;Laenge erstes INIR
                         C       IF cpu eq k2526
  E277    E3DB           C      	dw	dini1+1		;INI oder INIR
  E279    E3DE           C      	dw	dini2+1
  E27B    E3E1           C      	dw	dini3+1
                         C       ENDIF
                         C       if @write
  E27D    E42F           C      	dw	diosl2		;Laenge erstes OTIR
                         C        IF cpu eq k2526
  E27F    E432           C      	dw	doti1+1		;OUTI oder OTIR
  E281    E434           C      	dw	doti2+1
  E283    E436           C      	dw	doti3+1
                         C        ENDIF
                         C       endif
  0009                   C      dslnl	equ	($-dslnmt-1)/2	;Tabellenlaenge
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-92


                         C      ; 128
  E285    01             C      dsln0:	db	1
                         C       IF cpu eq k2526
  E286    80 A2 A2 A2    C      	db	128,0a2h,0a2h,0a2h
                         C       ENDIF
                         C       if @write
                         C        IF cpu eq k2526
  E28A    80 A3 A3 A3    C      	db	128,0a3h,0a3h,0a3h
                         C        ENDIF
                         C       endif
                         C      
                         C      ; 256
  E28E    02             C      dsln1:	db	2
                         C       IF cpu eq k2526
  E28F    00 A2 A2 A2    C      	db	0,0a2h,0a2h,0a2h
                         C       ENDIF
                         C       if @write
                         C        IF cpu eq k2526
  E293    00 A3 A3 A3    C      	db	0,0a3h,0a3h,0a3h
                         C        ENDIF
                         C       endif
                         C      
                         C      ; 512
  E297    04             C      dsln2:	db	4
                         C       IF cpu eq k2526
  E298    00 A2 A2 B2    C      	db	0,0a2h,0a2h,0b2h
                         C       ENDIF
                         C       if @write
                         C        IF cpu eq k2526
  E29C    00 A3 A3 B3    C      	db	0,0a3h,0a3h,0b3h
                         C        ENDIF
                         C       endif
                         C      
                         C      ; 1024
  E2A0    08             C      dsln3:	db	8
                         C       IF cpu eq k2526
  E2A1    00 B2 B2 B2    C      	db	0,0b2h,0b2h,0b2h
                         C       ENDIF
                         C       if @write
                         C        IF cpu eq k2526
  E2A5    00 B3 B3 B3    C      	db	0,0b3h,0b3h,0b3h
                         C        ENDIF
                         C       endif
                         C      
                         C       IF dskds
                         C      ; Modifizierungsadressen fuer Seitenauswahl
  E2A9    09             C      dsidmt:	db	dsidtl		; MFM		 FM
  E2AA    E334           C      	dw	diom01		;85/81		87/83
                         C       IF cpu eq k2526
  E2AC    E2E0           C      	dw	diom02		;a5/a1		a5/a1
  E2AE    E330           C       	dw	diom03		;b5/b1		b5/b1
  E2B0    E320           C      	dw	diom13		;bd/b9		bd/b9
                         C       ENDIF
                         C       if @write
                         C        IF dsk8fm+dsk5fm
                         C        ENDIF
  E2B2    E408           C      	dw	diom07		;b4/b0		 -
  E2B4    E41A           C      	dw	diom08		;b6/b2		 -
  E2B6    E424           C      	dw	diom09		;b4/b0		 -
                         C       endif
  E2B8    E3C7           C      	dw	diom10		;b5/b1		b5/b1
                         C      ;;diom11 muss letztes Byte in der Tabelle sein
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-93


  E2BA    E446           C      	dw	diom11		;b5/b1		b5/b1
  0009                   C      dsidtl	equ	($-dsidmt-1)/2
                         C       ENDIF
                         C      	include BIOSDSKP
                         C      ;****************************************************************
                         C      ; Treiber fuer Ansteuerung K5120/K5122 ueber K2526 (mit Hilfsprozessor)
                         C      ; 04.06.87
                         C      ; - Fehlerkorrektur 8" MFM (Taktzeiten)
                         C      ; 25.09.89
                         C      ; - wegen MFS 1.2 nach Transfer b1 (= fault reset) als Standardwert
                         C      ;****************************************************************
                         C      
  E2BC                   C      diorun:
  E2BC    2A E243        C      	ld	hl,(ft.adr)
  E2BF    22 E308        C      	ld	(diodma),hl
                         C      
                         C      ; physischen Transfer ueber CPU 2 starten
                         C      
  E2C2    21 E303        C      	ld	hl,dio
  E2C3                   C      diortn	equ	$-2
  E2C5    ED 4B 0001     C      	ld	bc,(1)		;retten HS 1
  E2C9    22 0001        C      	ld	(1),hl		;CPU 2 -Routine
  E2CC    3E FE          C      	ld	a,0feh
  E2CE    32 E2F3        C      	ld	(dtrret),a	;stellen Warte-Reaktion
  E2D1    AF             C      	XOR	A
  E2D2    D3 14          C      	OUT	(fldaad),A
  E2D4    D3 04          C      	OUT	(04H),A		;reset CPU 2
  E2D6    3D             C      	dec	a		;Mode 3 (Bit E/A)
  E2D7    D3 17          C      	OUT	(fldabc),A
  E2D9    D3 17          C      	OUT	(fldabc),A	;alles Input
  E2DB    3E B9          C      	ld	a,10111001b	;AMF aus, Fault reset
  E2DD    D3 10          C      	out	(flcoad),a
  E2DF    3E A5          C      	LD	A,10100101b	;Seite einstellen, Mark reset, AMF aktiv
  E2E0                   C      diom02	equ	$-1		;a5/a1
  E2E1    D3 10          C      	OUT	(flcoad),A
  E2E3    3E 7F          C      	LD	A,7FH		;Mode 1
  E2E5    D3 17          C      	OUT	(fldabc),A
  E2E7    DB 16          C      	IN	A,(fldabd)	;CPU2 starten (ueber BUSRQ)
                         C      ; durch die Anfangsinitialisierung der CPU2 vergehen die notwendigen
                         C      ; 100 Mikrosek. fuer Seitenumschaltung
  E2E9    ED 43 0001     C      	ld	(1),bc		;HS 1 wiederherst.
  E2ED    3A E334        C      	LD	A,(diom01)	;Lesen Marke
  E2F0    D3 10          C      	OUT	(flcoad),A	;weiter bei CPU2 nach Anfangsinit.
                         C      ; Achtung!! Zur Synchronisation CPU1 und CPU2 keine 2-Byte-Werte
                         C      ; (Adressen) verwenden, da dazwischen BUSRQ auftreten kann und dann
                         C      ; nur ein Byte gesetzt wurde!!
  E2F2    18 FE          C      	jr	$		;auf CPU 2 Ende warten
  E2F3                   C      dtrret	equ	$-1
  E2F4                   C      dtrwjr:
  E2F4    C3 E197        C      dtrtor:	jp	fl.to1		;time out
  E2F7    C3 E13D        C      dtrner:	jp	noerr		;fehlerfrei (Sekt.id)
  E2FA    C3 E178        C      dtrnsr:	jp	serrx		;Sektor nicht gefunden
  E2FD    C3 E157        C      dtrrdr:	jp	dtrrde		;Read Ende
  E300    C3 E14B        C      dtrwrr:	jp	dtrwre		;Write Ende
                         C      ;--------------------------
                         C      
                         C      
                         C      ; Code CPU 2 fuer phys. Diskettentransfer
                         C      ;========================================
                         C      ; Zeitbedingungen fuer 8" MFM:
                         C      ; 6 Umdrehungen pro Sec bei 2*5208 Bytes pro Spur bedeutet
                         C      ; 1/(6*2*5208), d.h. 16 Mikrosec pro Byte!!
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-94


                         C      ; Bei einer Taktfrequenz von (9600*256)=2457600 Hz sind das
                         C      ; (9600*256)/(6*2*5208) Takte, d.h. max. 39 Takte pro Byte!!
                         C      ; Wegen BUSRQ/BUSAK muss davon der laengste Maschinenzyklus
                         C      ; der CPU 1 abgezogen werden, d.h. 6 Takte (Interruptannahme),
                         C      ; weiterhin je ein Takt fuer BUSRQ/BUSAK-Umschaltung,
                         C      ; es verbleiben 31 Takte zwischen den E/A-Maschinenzyklen!!
                         C      
                         C      ; normaler Entry in phys. Diskettentransfer
                         C      ;==========================================
  E303                   C      dio:	
  E303    AF             C      	xor	a		;wiederherstellen 'jr diokl'
  E304    32 E33C        C      	ld	(diomd1+1),a
  E307    21 0000        C      	ld	hl,0
  E308                   C      diodma	equ	$-2		;Transferadresse
  E30A    3E 00          C      	ld	a,0
  E30B                   C      secan1	equ	$-1		;a':=Zahl zu transfer. phys. Sekt.
  E30C    08             C      	ex	af,af'
  E30D    11 E24D        C      	ld	de,crcber	;auf Beginn Datenbyte-/CRC-Vektor
  E310    D9             C      dio2:	exx
  E311    01 00FF        C      	ld	bc,000ffh	;bc':= Spur, Seite
  E312                   C      sidtr	equ	$-2
  E313                   C      sidsid	equ	$-1
  E314    21 FFFF        C      	ld	hl,0ffffh	;hl':= Sektor, Sektlngflag
  E315                   C      sidsec	equ	$-2
  E316                   C      sidlen	equ	$-1
  E317    11 FEA1        C      	ld	de,0fea1h	;de':= Sektorid-Byte, Kluftbyte
  E31A    3E 3C          C      	ld	a,60		;Wiederholungszaehler falscher Sektid.
  E31C    32 E26A        C      	ld	(seerc),a	;fuer ersten Sektor stellen
  E31F    3E BD          C      diostp:	ld	a,10111101b	;bd/b9, AMF aus, Seite bleibt (>=100 Mikros.)
  E320                   C      diom13	equ	$-1
  E321    D3 10          C      	out	(flcoad),a	;Ende CPU2
  E323    18 12          C      	jr	diogo		;Fortsetzung nach Anfangsinit
                         C      
  E325                   C      dionss:
  E325    3E 3C          C      	ld	a,60		;Wiederholungszaehler falscher Sektid.
  E327    32 E26A        C      	ld	(seerc),a	;fuer naechsten Sektor setzen
  E32A                   C      diomr:
  E32A    3E 05          C      	ld	a,5		;verhindern unendl. Schleife
  E32C    32 E20B        C      	ld	(fl.zto),a	;bei fehlender Sektor-Marke
  E32F    3E B5          C      diomrk:	ld	a,10110101b	;b5/b1 MFM; b5/b1 FM
  E330                   C      diom03	equ	$-1		;Mark reset, lesen 1
  E331    D3 10          C      	out	(flcoad),a
  E333    3E 85          C      	ld	a,10000101b	;85/81 MFM; 87/83 FM
  E334                   C      diom01	equ	$-1		;Lesen Marke entspr. Aufzverf.
  E335    D3 10          C      	out	(flcoad),a
  E337    DB 16          C      diogo:	in	a,(fldabd)
  E339    D3 14          C      	out	(fldaad),a
  E33B    18 00          C      diomd1:	jr	diomd1+2	;wird modifiziert mit 'jr diotrr',
                         C      				;wenn Sektorid zu lesen
  E33D    DB 16          C      diokl:	in	a,(fldabd)
  E33F    BB             C      	cp	e		;'A1', d.h. noch in Kluft?
  E340    28 FB          C      	jr	z,diokl		;ja
  E342    BA             C      	cp	d		;'FE', d.h. Sektorbeginn?
  E343    DB 16          C      	in	a,(fldabd)
  E345    20 E8          C      	jr	nz,diomrk	;nein, weitersuchen
  E347    B9             C      	cp	c		;Spur ok?
  E348    DB 16          C      	in	a,(fldabd)
  E34A    20 5D          C      	jr	nz,serr		;nein, falscher Sektid.
  E34C    B8             C      	cp	b		;Seite ok?
  E34D    DB 16          C      	in	a,(fldabd)
  E34F    20 58          C      	jr	nz,serr		;nein, falscher Sektid.
  E351    BD             C      	cp	l		;Sektor ok?
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-95


  E352    DB 16          C      	in	a,(fldabd)
  E354    20 53          C      	jr	nz,serr		;nein, falscher Sektid.
  E356    BC             C      	cp	h		;Sekt-Laengencode?
  E357    DB 16          C      	in	a,(fldabd)	;**ignorieren CRC Sektid**
  E359    20 4E          C      	jr	nz,serr		;nein, falscher Sektid.
  E35B    D9             C      	exx
  E35C    DB 16          C      	in	a,(fldabd)	;**ignorieren CRC Sektid**
  E35E    06 11          C      	ld	b,17		;Zahl zu uebergeh. Bytes
  E35F                   C      diomd2	equ	$-1		;bei DD auf 17, bei SD auf 6
  E360    DB 16          C      diosyn:	in	a,(fldabd)	;Bytes ignorieren
  E362    10 FC          C      	djnz	diosyn
  E364    DB 16          C      	in	a,(fldabd)
  E366    C3 E3BE        C      	jp	diord
  E367                   C      dioop	equ	$-2		;wird modifiziert entspr. Oper.
                         C      ;				 mit diord, diwmfm, diowfm
                         C      
                         C      ; Entry fuer phys. Treiber zum Lesen Sekt.-Id. auf akt. Spur
                         C      ;===========================================================
  E369    3E 39          C      diotsr:	ld	a,diotrr-(diomd1+2)	;jr diotrr
  E36B    32 E33C        C      	ld	(diomd1+1),a	;modifizieren
  E36E    01 0316        C      	ld	bc,3*256+fldabd	;Lesen 3 Bytes Sektorid
  E371    21 E247        C      	ld	hl,ft.trk+1	;dorthin Sektorid hinterlegen
  E374    18 9A          C      	jr	dio2		;Einsprung in phys. Treiber
  E376                   C      diotrr:
  E376    DB 16          C      diotr0:	in	a,(fldabd)
  E378    BB             C      	cp	e		;'A1', d.h. noch in Kluft?
  E379    28 FB          C      	jr	z,diotr0	;ja
  E37B    BA             C      	cp	d		;'FE', d.h. Sektorbeginn?
  E37C    DB 16          C      	in	a,(fldabd)	;wenn ja, so ist das die Spur
  E37E    20 AF          C      	jr	nz,diomrk	;nein, weitersuchen
  E380    D9             C      	exx
  E381    ED B2          C      	inir			;Sektorid lesen
  E383    D9             C      	exx
  E384    6F             C      	ld	l,a		;Spur retten
  E385    3A E330        C      	ld	a,(diom03)
  E388    D3 10          C      	out	(flcoad),a	;Lesen 1
  E38A    7D             C      	ld	a,l
  E38B    B9             C      	cp	c		;richtige Spur?
  E38C    28 09          C      	jr	z,diotr1	;ja
  E38E    3A E247        C      	ld	a,(ft.sid)
  E391    90             C      	sub	b		;stimmt side?
  E392    20 0B          C      	jr	nz,diotre	;nein, dies ist kein Sektid.
  E394    B9             C      	cp	c		;war Spur 0 gefordert?
  E395    28 23          C      	jr	z,serr2		;ja, nachjustieren (ft.trk steht noch)
  E397    7D             C      diotr1:	ld	a,l
  E398    32 E246        C      	ld	(ft.trk),a	;(tatsaechliche) Spur aus Sekt.Id.
  E39B    3E 03          C      	ld	a,dtrner-dtrwjr	;Reaktionsroutine
  E39D    18 5D          C      	jr	dioend		;Abschlussbehandlung
  E39F    D9             C      diotre:	exx
  E3A0    01 0316        C      	ld	bc,3*256+fldabd	;Lesen 3 Bytes Sektorid
  E3A3    21 E247        C      	ld	hl,ft.trk+1	;dorthin Sektorid hinterlegen
  E3A6    D9             C      	exx
  E3A7    18 07          C      	jr	serr1
                         C      ;---------------------------
                         C      
                         C      ; Fehlerausgaenge
                         C      ;----------------
                         C      ; falscher Sektorid.
  E3A9    DB 16          C      serr:	in	a,(fldabd)
  E3AB    3A E330        C      	ld	a,(diom03)	;Lesen 1
  E3AE    D3 10          C      	out	(flcoad),a
  E3B0    3A E26A        C      serr1:	ld	a,(seerc)
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-96


  E3B3    3D             C      	dec	a		;blieb weiterer Versuch?
  E3B4    32 E26A        C      	ld	(seerc),a
  E3B7    C2 E32A        C      	jp	nz,diomr	;ja
  E3BA    3E 06          C      serr2:	ld	a,dtrnsr-dtrwjr	;Sektor nicht gefunden
  E3BC    18 3E          C      	jr	dioend
                         C      
                         C      ; Lesen
                         C      ;-------
  E3BE    DB 16          C      diord:	in	a,(fldabd)
  E3C0    06 06          C      	ld	b,6
  E3C2    DB 16          C      diords:	in	a,(fldabd)	;uebergehen Synchron-Bytes
  E3C4    10 FC          C      	djnz	diords
  E3C6    3E B5          C      	ld	a,10110101b	;b5/b1
  E3C7                   C      diom10	equ	$-1
  E3C8    D3 10          C      	out	(flcoad),a	;Lesen 1
  E3CA    3A E334        C      	ld	a,(diom01)	;85/81 MFM; 87/83 FM
  E3CD    01 8016        C      	ld	bc,128*256+fldabd ;b:=inir-Laenge
  E3CF                   C      diosl1	equ	$-1		  ;   128 bei Sektl 128, sonst =0
  E3D0    D3 10          C      	out	(flcoad),a	;Lesen Marke
  E3D2    DB 16          C      	in	a,(fldabd)	;ignorieren evtl. anstehenden Muell
  E3D4    DB 16          C      diorkl:	in	a,(fldabd)
  E3D6    FE A1          C      	cp	0a1h		;noch in Kluft?
  E3D8    28 FA          C      	jr	z,diorkl	;ja
  E3DA    ED A2          C      dini1:	ini			;Daten lesen
  E3DC    12             C      	ld	(de),a		;Datenbeginn-Byte hinterlegen
  E3DD    ED A2          C      dini2:	ini
  E3DF    13             C      	inc	de
  E3E0    ED A2          C      dini3:	ini
  E3E2    ED B2          C      	inir
  E3E4    EB             C      	ex	de,hl
  E3E5    ED A2          C      	ini			;CRC Daten
  E3E7    ED A2          C      	ini
  E3E9    3A E446        C      	ld	a,(diom11)	;b1 fuer MFS 1.2 Fault reset, sonst b5/b1
  E3EC    D3 10          C      	out	(flcoad),a	;Lesen 1
  E3EE    EB             C      	ex	de,hl
  E3EF    3E 09          C      	ld	a,dtrrdr-dtrwjr	;Reaktionsroutine Read Ende
                         C      
                         C      ; naechsten Sektor behandeln
                         C      ;---------------------------
  E3F1    08             C      dions:	ex	af,af'		;Zahl zu uebertr. Sektoren
  E3F2    3D             C      	dec	a
  E3F3    28 06          C      	jr	z,dionse	;=0, fertig
  E3F5    08             C      	ex	af,af'
  E3F6    D9             C      	exx
  E3F7    2C             C      	inc	l		;Sektor+1
  E3F8    C3 E325        C      	jp	dionss
  E3FB    08             C      dionse:	ex	af,af'
                         C      
                         C      ; Abschlussbehandlung
                         C      ;--------------------
  E3FC                   C      dioend:
  E3FC    32 E2F3        C      	ld	(dtrret),a	;Reaktionsroutine hinterlegen
  E3FF    C3 E31F        C      	jp	diostp		;Stop CPU2
                         C      
                         C       IF @write
                         C      
                         C       IF dsk8fm+dsk8mf+dsk5fm
                         C       ENDIF
                         C      
                         C      
                         C      ; Schreiben  MFM
                         C      ;---------------
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-97


  E402    DB 16          C      diwmfm:	in	a,(fldabd)
  E404    DB 16          C      	in	a,(fldabd)
  E406    01 B410        C      	ld	bc,10110100b*256+flcoad
  E408                   C      diom07	equ	$-1		;b4/b0
  E409    DB 16          C      	in	a,(fldabd)
  E40B    ED 41          C      	out	(c),b		;Schreiben MFM normal
  E40D    DB 16          C      	in	a,(fldabd)
  E40F    AF             C      	xor	a
  E410    D3 14          C      	out	(fldaad),a	; 1*'00'
  E412    01 0A14        C      	ld	bc,10*256+fldaad
  E415    D3 14          C      diwmfs:	out	(fldaad),a	;10*'00'
  E417    10 FC          C      	djnz	diwmfs
  E419    3E B6          C      	ld	a,10110110b
  E41A                   C      diom08	equ	$-1		;b6/b2
  E41B    ED 41          C      	out	(c),b		; 1*'00'
  E41D    D3 10          C      	out	(flcoad),a	;Schreiben MFM Marke
  E41F    06 A1          C      	ld	b,0a1h
  E421    ED 41          C      	out	(c),b		;3*'A1'
  E423    3E B4          C      	ld	a,10110100b
  E424                   C      diom09	equ	$-1		;b4/b0
  E425    ED 41          C      	out	(c),b
  E427    EB             C      	ex	de,hl
  E428    ED 41          C      	out	(c),b
  E42A    D3 10          C      	out	(flcoad),a	;Schreiben MFM normal
  E42C    ED A3          C      	outi			;'FB'
                         C      
  E42E    06 80          C      diowrt:	ld	b,128		;Laenge erster OTIR-Block
  E42F                   C      diosl2	equ	$-1		;128 bei Sektl 128, sonst 0
  E430    EB             C      	ex	de,hl
  E431    ED A3          C      doti1:	outi			;Daten ausgeben
  E433    ED A3          C      doti2:	outi
  E435    ED A3          C      doti3:	outi
  E437    ED B3          C      	otir
  E439    EB             C      	ex	de,hl
  E43A    ED A3          C      	outi			;CRC Daten
  E43C    AF             C      	xor	a
  E43D    ED A3          C      	outi
  E43F    06 14          C      diowm1:	ld	b,20		;Anzahl der Nach-Null-Bytes
                         C      				;5" MFM/FM: 20; 8" MFM/FM: 2
  E441    D3 14          C      diow00:	out	(fldaad),a	;'00'
  E443    10 FC          C      	djnz	diow00
  E445    3E B1          C      	ld	a,10110001b	;b1 fuer MFS 1.2 Fault reset, sonst b5/b1
  E446                   C      diom11	equ	$-1
  E447    D3 10          C      	out	(flcoad),a	;Schreiben aus, Lesen 1
  E449    EB             C      	ex	de,hl
  E44A    3E 0C          C      	ld	a,dtrwrr-dtrwjr	;Schreiben OK Reaktion
  E44C    C3 E3F1        C      	jp	dions		;naechster Sektor
                         C      
                         C      	ENDIF	;@write
                                 ENDIF
                                 IF hdsk
                                 ENDIF
                                 IF oss
                                 ENDIF
                                 IF em256
                                 ENDIF
                                 IF mkd256
