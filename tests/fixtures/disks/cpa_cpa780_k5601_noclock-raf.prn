  DCEF    70             C      	ld	(hl),b
  DCF0    04             C      	inc	b
  DCF1    05             C      	dec	b		;Puffernr. 0?
  DCF2    28 03          C      	jr	z,dbsec0	;ja
  DCF4    82             C      dbsecz:	add	a,d		;0. phys. Sekt. im Puffer
  DCF5    10 FD          C      	djnz	dbsecz		;=dbsnb.*Puffernr.
  DCF7    5F             C      dbsec0:	ld	e,a		;merken Pufferanf.-Sektor
  DCF8    DD 46 10       C      	ld	b,(ix+dpbslc)
