  DCE2    3C             C      	inc	a
  DCE3    87             C      	add	a,a		;CY:=0
  DCE4    04             C      	inc	b		;fuer djnz, falls dpbslc=0
  DCE5    0F             C      dbsnbz:	rrca			;Zahl der phys. Sekt. im Puff.
  DCE6    10 FD          C      	djnz	dbsnbz
  DCE8    57             C      	ld	d,a		;merken
  DCE9    AF             C      	xor	a
