  DC5C    CD E7E9        C      	call	dgetpb		;ix:=dpb(ddrive)
  DC5F    28 F4          C      	jr	z,drwerr	;Geraet ex. nicht
                         C       if ramfl
                         C      ;###RAM-Floppy
  DC61    DD CB 0F 7E    C      	bit	dpbfnd,(ix+dpbflg)	;Diskette?
  DC65    C2 E462        C      	jp	nz,rdramf	;nein
