                         C      ;				BDOS-Blocks zum Pufferanfang
  DD2A    20 03          C      	jr	nz,dbprr
  DD2C    32 DF60        C      	ld	(dberrf),a	;fehlerfrei gel. anzeigen
  DD2F    C4 DD70        C      dbprr:	call	nz,dbtran	;Puffer lesen
                         C       endif
  DD32                   C      dbmat:	
                         C      
                         C      ; Sektor in/aus Puffer holen
                         C      ;===========================
  DD32    F1             C      	pop	af		;Puffernr. in Spur wegschm.
  DD33    F1             C      	pop	af		;128-er Index im Puffer
  DD34    F5             C      	push	af
  DD35    1F             C      	rra			;Sektornb*128 berechnen
  DD36    47             C      	ld	b,a
  DD37    0E 00          C      	ld	c,0
  DD39    CB 19          C      	rr	c
  DD3B    21 F2B7        C      	ld	hl,dbuf
