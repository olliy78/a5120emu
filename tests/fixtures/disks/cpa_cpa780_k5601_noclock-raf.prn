  E7B1    21 0007        C+     	ld	hl,statz1+statzk
  E7B4    06 17          C+     	ld	b,stzke-stzka
  E7B6    36 20          C+     clstkz: ld	(hl),' '
  E7B8    23             C+     	inc	hl
  E7B9    10 FB          C+     	djnz	clstkz
  E7BB    21 0004        C+     setcld: ld	hl,defaul
  E7BE    4E             C+     	ld	c,(hl)
  E7BF    C5             C+     	push	bc
  E7C0    79             C+     	ld	a,c
  E7C1    E6 0F          C+     	and	0fh
  E7C3    4F             C+     	ld	c,a
