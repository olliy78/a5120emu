                         C      
                         C      ; RAF-Test
                         C      ;=========
                         C      
                         C      ; Es erfolgt ein nichtzerstoerender Test auf Verfuegbarkeit und Kapazitaet.
                         C      ; Maximal werden 'raf_nb' (<=4) Karten mit aufeinanderfolgenden I/O-Adressen
                         C      ; unterstuetzt, die beliebiger Art (RAF16..RAF2048) sein koennen, d.h.
                         C      ; gemischt und auch nur teilbestueckt, jedoch immer dicht und ab 0.
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-143


                         C      ; Maximal werden damit 8MByte RAF unterstuetzt.
                         C      ; Rueckkehr:
                         C      ; ret z, wenn keine RAF da
                         C      ; ret nz, wenn RAF da, dann
                         C      ;	DE Gesamt-Kapazitaet in 1K
                         C      ;	HL Gesamtzahl Spuren
                         C      ;	ret nc, wenn nicht jungfraeulich, sonst ret c
                         C      
  0AB4    21 E4DC        C      raftst:	ld	hl,raftrt	;Tabelle fuer jeweilige Kapazitaet in Spuren
  0AB7    11 0000        C      	ld	de,0		;Gesamtkapazitaet
  0ABA    01 0488        C      	ld	bc,raf_nb*256+raf_d
                         C      
                         C      ; naechste RAF-Karte
  0ABD    C5             C      rafinx:	push	bc
  0ABE    E5             C      	push	hl
  0ABF    06 00          C      	ld	b,0		;b:=Spur (0..127)
                         C      ; naechste Spur
  0AC1    C5             C      rafint:	push	bc
  0AC2    AF             C      	xor	a		;Sektor 0
  0AC3    CD E499        C      	call	raftrs		;spur, sektor laden
  0AC6    3E 5A          C      	ld	a,5ah		;Muster
  0AC8    ED 68          C      	in	l,(c)		;altes Byte retten
  0ACA    ED 79          C      	out	(c),a		;neues Byte
  0ACC    05             C      	dec	b		;auch Nachbarbyte wegen Datenbuss
  0ACD    2F             C      	cpl
  0ACE    ED 60          C      	in	h,(c)
  0AD0    ED 79          C      	out	(c),a
  0AD2    04             C      	inc	b
  0AD3    ED 78          C      	in	a,(c)		;neues Byte zuruecklesen
  0AD5    FE 5A          C      	cp	5ah		;ist dort eine RAF?
  0AD7    ED 69          C      	out	(c),l		;altes Byte zurueck
  0AD9    20 0E          C      	jr	nz,rafine	;nein
  0ADB    05             C      	dec	b
  0ADC    ED 78          C      	in	a,(c)
  0ADE    FE A5          C      	cp	0a5h
  0AE0    ED 61          C      	out	(c),h
  0AE2    20 05          C      	jr	nz,rafine
  0AE4    C1             C      	pop	bc
  0AE5    04             C      	inc	b		;naechste Spur
  0AE6    20 D9          C      	jr	nz,rafint	;Zwangsabbruch nach 256 Spuren (Fehler, 0 Sp.)
  0AE8    C5             C      	push	bc
  0AE9    C1             C      rafine:	pop	bc
  0AEA    78             C      	ld	a,b		;Kapazitaet in Spuren 0..128 retten
  0AEB    06 FF          C      	ld	b,0ffh		;Zugriffsverbot
  0AED    0C             C      	inc	c
  0AEE    ED 41          C      	out	(c),b		;fuer RAF-Karte
  0AF0    E1             C      	pop	hl		;raftrt
  0AF1    77             C      	ld	(hl),a		;Kapazitaet dieser Karte merken (0..128)
  0AF2    83             C      	add	a,e		;Gesamtzahl Spuren
  0AF3    5F             C      	ld	e,a
  0AF4    3E 00          C      	ld	a,0
  0AF6    8A             C      	adc	a,d
  0AF7    57             C      	ld	d,a
  0AF8    C1             C      	pop	bc
  0AF9    23             C      	inc	hl		;raftrt weiter
  0AFA    0C             C      	inc	c
  0AFB    0C             C      	inc	c		;I/O-Adresse weiter
  0AFC    10 BF          C      	djnz	rafinx		;naechste RAF-Karte testen
                         C      
                         C      ; alle RAF-Karten getestet, DE enthaelt Geamtzahl Spuren (jeweils 16k-Spur)
                         C      ; DPB entsprechend Kapazitaet festlegen
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-144


  0AFE    7A             C      	ld	a,d
  0AFF    B3             C      	or	e		;mindestens eine RAF da?
  0B00    CA 0B68        C      	jp	z,rafien	;nein, ret z
