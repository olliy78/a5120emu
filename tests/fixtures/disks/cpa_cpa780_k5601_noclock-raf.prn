                                ;-------------------------------
                                
                                	IRP	di,<A,B,C,D>
                                 IF disk&di
                                dph&di: DW	0,0,0,0,dirbuf
                                	DW	dpb&di,csv&di,alv&di
                                dpha&di aset	dph&di
                                 ENDIF
                                	ENDM
  D03F    0000 0000       +     dph&A: DW	0,0,0,0,dirbuf
