                                 IF raf
                         C      	include BIOSRAF		;RAM-Floppy mit RAF
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-98


                         C      ;********************************************************
                         C      ;	RAM-Floppy auf Basis RAF vom ZWG der AdW
                         C      ; Version 11.10.87
                         C      ;********************************************************
                         C      
                         C       if1
                         C       endif ;if1
                         C      
                         C      
                         C      ;**************************************************************
                         C      ;	Schreiben RAM-Floppy
                         C      ;**************************************************************
  E44F                   C      wrramf:
                         C      ; Schreiben RAF
                         C      ;==============
  E44F    CD E47D        C      rafwr:	call	rafsst		;setzen RAF-Parameter, A:=0
                         C       IF rafpar
                         C      ; Schreiben mit XOR-Parity: 42 Takte statt 21 Takte ohne Parity
  E452    56             C      rafwrz:	ld	d,(hl)
  E453    23             C      	inc	hl
  E454    ED 51          C      	out	(c),d		;Byte 0,127,126,...,1
  E456    AA             C      	xor	d		;A=0 war durch rafsst
  E457    10 F9          C      	djnz	rafwrz
  E459    57             C      	ld	d,a
  E45A    CD E4B1        C      	call	rafchs		;adressieren Parity-Byte
  E45D    ED 51          C      	out	(c),d		;neues Byte setzen
  E45F    AF             C      	xor	a		;Transfer fehlerfrei
                         C       ENDIF
  E460    18 15          C      	jr	rafdis
                         C      
                         C      
                         C      ;**************************************************************
                         C      ;	Lesen RAM-Floppy
                         C      ;**************************************************************
                         C      
  E462                   C      rdramf:
                         C      ; Lesen RAF
                         C      ;==========
  E462    CD E47D        C      rafrd:	call	rafsst		;setzen RAF-Parameter, A:=0
                         C       IF rafpar
                         C      ; Lesen mit XOR-Parity: 42 Takte statt 21 Takte ohne Parity
  E465    ED 50          C      rafrdz:	in	d,(c)		;Byte 0,127,126,...,1
  E467    AA             C      	xor	d		;A=0 war durch rafsst
  E468    72             C      	ld	(hl),d
  E469    23             C      	inc	hl
  E46A    10 F9          C      	djnz	rafrdz
  E46C    57             C      	ld	d,a		;beim Lesen berechnetes Parity-Byte
  E46D    CD E4B1        C      	call	rafchs		;adressieren Parity-Byte fuer aktuellen Sektor
  E470    ED 78          C      	in	a,(c)
  E472    AA             C      	xor	d		;Parity ok?
  E473    28 02          C      	jr	z,rafdis	;ja, A=0
  E475    3E 01          C      	ld	a,1		;sonst Fehler melden
                         C       ENDIF
  E477                   C      rafdis:
                         C      ; A,D muessen erhalten bleiben
  E477    0C             C      	inc	c
  E478    06 FF          C      	ld	b,0ffh
  E47A    ED 41          C      	out	(c),b		;weiteren Zugriff verbieten
  E47C    C9             C      	ret
                         C      
                         C      ;********************************************************************
                         C      ;	Unterprogramme fuer RAM-Floppy
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-99


                         C      ;********************************************************************
                         C      
                         C      ; UP: Setzen RAF-Parameter
                         C      ;-------------------------
  E47D    21 E4DB        C      rafsst:	ld	hl,raftrt-1	;Tabelle der RAF-Kapazitaeten je Karte
  E480    ED 5B DF52     C      	ld	de,(rtrack)	;0..1ffh
  E484    0E 86          C      	ld	c,raf_d-2	;Beginn bei RAF-Karte mit niedrigster I/O-Adr.
  E486    7B             C      	ld	a,e
  E487    0C             C      rafst1:	inc	c
  E488    0C             C      	inc	c		;naechste Karte
  E489    23             C      	inc	hl		;naechste Kapazitaet
  E48A    96             C      	sub	(hl)		;ist gesuchte Spur auf dieser Karte?
  E48B    30 FA          C      	jr	nc,rafst1	;nein
  E48D    15             C      	dec	d		;war Spur >=100h?
  E48E    28 F7          C      	jr	z,rafst1	;ja, weitersuchen
  E490    86             C      	add	a,(hl)		;relative Spur in aktueller Karte
  E491    47             C      	ld	b,a		;0..127
  E492    3A DF54        C      	ld	a,(dsectr)	;Sektor 1..128
  E495    3D             C      	dec	a		;0..127
  E496    2A DF57        C      	ld	hl,(ddma)
                         C      ; UP: Laden Track/Sector nach in RAF-Steuer-Register
                         C      ;---------------------------------------------------
                         C      ; i A	Sektor 0..127
                         C      ; i B	Spur 0..127 (16k pro Spur)
                         C      ; i C	raf_d (I/O-Adresse fuer Karte)
                         C       IF rafpar
                         C      ; o B	128 fuer in/out
                         C       ENDIF
                         C      ; C,D,E,H,L bleiben erhalten
  E499                   C      raftrs:
                         C       IF rafpar
  E499    32 E4BA        C      	ld	(rafcx0),a	;merken Sektor
                         C       ENDIF
  E49C    87             C      	add	a,a		;wegen rra spaeter
  E49D    CB 38          C      	srl	b		;00tttttt	PROT-Bit geloescht
  E49F    1F             C      	rra			;tsssssss
  E4A0    0C             C      	inc	c
  E4A1    ED 79          C      	out	(c),a		;Laden RAF-Steuer-Register 00tttttttsssssss
                         C       IF rafpar
  E4A3    ED 43 E4B2     C      	ld	(rafcx1),bc	;merken fuer out(c),r
  E4A7    F6 7F          C      	or	7fh		;Sektor 127
  E4A9    32 E4B5        C      	ld	(rafcx2),a	;einschliesslich niederwertigstes track-Bit
                         C       ENDIF
  E4AC    0D             C      	dec	c		;zurueck auf raf_d
                         C       IF rafpar
  E4AD    06 80          C      	ld	b,128		;fuer in/out
                         C       ENDIF
  E4AF    AF             C      	xor	a		;Transfer fehlerfrei bzw. Parity vorbereiten
  E4B0    C9             C      	ret
                         C      
                         C       IF rafpar
                         C      ; UP: Adressieren Parity-Byte fuer aktuellen Sektor
                         C      ; i	raftrs muss zuvor aufgerufen worden sein
                         C      ; oB	Index 0..126 im Parity-Sektor
                         C      ; oC	raf-I/O-Adr Data
                         C      ; D bleibt erhalten
  E4B1    01 0000        C      rafchs:	ld	bc,0
  E4B2                   C      rafcx1	equ	$-2		;wird von raftrs gestellt
  E4B4    3E 00          C      	ld	a,0
  E4B5                   C      rafcx2	equ	$-1		;wird von raftrs gestellt
  E4B6    ED 79          C      	out	(c),a		;Laden RAF Steuerregister 00tttttttt1111111
  E4B8    0D             C      	dec	c		;zurueck auf RAF-data
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-100


  E4B9    06 00          C      	ld	b,0		;Index 0..126 in Parity-Sektor
  E4BA                   C      rafcx0	equ	$-1		;wird von raftrs gestellt
  E4BB    C9             C      	ret
                         C       ENDIF
                         C      
                         C      
                         C      ;*************************************************************
                         C      ; Steuertabellen fuer RAM-Floppy
                         C      ;*************************************************************
                         C      
  E4BC                   C      dphm:
  E4BC    0000           C      rafdph:	dw	0		;ohne Translate-Tabelle
  E4BE    0000 0000      C      	dw	0,0,0
  E4C2    0000           C      
  E4C4    F061           C      	dw	dirbuf
  E4C6    E4CC           C      	dw	rafdpb
  E4C8    0000           C      	dw	0
  E4CA    F237           C      	dw	alvraf
                         C      
  E4CC                   C      dpbm:
  E4CC                   C      rafdpb:	;wird je nach RAF-Kapazitaet gestellt, Beispiel 512K
                         C       IF rafpar
  E4CC    007F           C      	dw	128-1		;letzter Sektor in Spur fuer Parity
                         C       ENDIF
  E4CE    04 0F 01       C      	db	4,15,1		;2k Gruppen
  E4D1    00FF           C      	dw	256-1
  E4D3    007F 00C0      C      	dw	128-1,0c0h	;128 Dir
  E4D7    0000 0000      C      	dw	0,0
  E4DB    80             C        	db	80h		;kein Disketten-DPB
                         C      
  E4DC    00 00 00 00    C      raftrt:	db	0,0,0,0	;Tabelle der RAF-Kapazitaet in 16k Einheiten
                         C      
                         C      
  E4BC                   C      dpham	aset	dphm		;definieren LW "M:"
                                 ENDIF
                                 IF rna
                                 ENDIF
                                
                         C      	include BIOSTIM
                         C      ;*************************************************************
                         C      ;	Zeitgeberdienst
                         C      ; 15.06.88
                         C      ; - BAB2 als Standard
                         C       IF cpu eq c1715
                         C       ENDIF
                         C      ; - zusaetzliche Laufwerksabschaltung ueber Zeittakt eingefuehrt
                         C      ; - Abfrage von 'synsem' in 1-sec-Interrupt entfernt (kein setbs/setram notw.)
                         C      ; 24.09.88
                         C      ; - Bildschirmpuffer kann ausserhalb des normalen RAM's liegen
                         C      ; 09.10.88
                         C      ; - Pflege der Statuszeile nur bei stzaus=0
                         C      ; 23.12.88
                         C      ; - Einbau der Pflege des Datums
                         C      ; 07.01.89
                         C      ; - Tastaturpolling nur wenn Zugriff zur Statuszeile erlaubt
                         C      ; 20.03.89
                         C      ; - Laufwerksabschaltung ueber Zeittakt nur bei FDC K5120/22 und F1715
                         C      ;*************************************************************
                         C      
                         C       IF1
                         C       ENDIF
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-101


                         C      ; 5ms/25ms an
  E4E0                   C      tim5on:
                         C       IF cpu eq c1715
                         C       ENDIF
  E4E0    3E B1          C      	ld	a,10110001b
                         C      	;int./zeitg./vort.256/pos.flanke/naechst.zykl./keine zk/weiter/1
  E4E2    F3             C      tim5ot:	DI
  E4E3    D3 0E          C      	out	(sysctc+tim5ct),a
  E4E5    FB             C      	EI
  E4E6    C9             C      ret:	ret
                         C      
                         C      ; 5ms/25ms aus
  E4E7                   C      tim5of:
                         C       IF cpu eq c1715
                         C       ENDIF
  E4E7    3E 31          C      	ld	a,00110001b	;kein int./...
  E4E9    18 F7          C      	jr	tim5ot
                         C      
                         C       IF cpu eq c1715
                         C       ELSE
                         C      ; 1s an
  E4EB    3E D1          C      tim1on:	ld	a,11010001b
                         C      	;int./zaehler//pos.flanke//keine zk/weiter/1
  E4ED    F3             C      tim1ot:	DI
  E4EE    D3 0F          C      	out	(sysctc+tim1ct),a
  E4F0    FB             C      	EI
  E4F1    C9             C      	ret
                         C      ; 1s aus
  E4F2    3E 51          C      tim1of:	ld	a,01010001b	;kein int./...
  E4F4    18 F7          C      	jr	tim1ot
                         C       ENDIF
                         C      
                         C      ; Interr.routine 5ms/25ms
  E4F6                   C      tim5it:
                         C       IF stpvar or monitor
  E4F6    22 E4FE        C      	ld	(t5ihl),hl	;retten hl
  E4F9    21 E62C        C      	ld	hl,chksp	;Test auf haengende Spezialfktnen
  E4FC    E5             C      	push	hl		;nach const-Aufruf in CTC-Interrupt
  E4FD    21 0000        C      	ld	hl,0		;wiederherstellen hl
  E4FE                   C      t5ihl	equ	$-2
                         C       ENDIF
  E500    ED 73 E51F     C      	ld	(intsp),sp
  E504    31 F061        C      	ld	sp,intstk
  E507    F5             C      	push	af
  E508    E5             C      	push	hl
  E509    D5             C      	push	de
  E50A    C5             C      	push	bc
  E50B    2A 0041        C      	ld	hl,(tim5cn)
  E50E    23             C      	inc	hl
  E50F    22 0041        C      	ld	(tim5cn),hl
                         C       IF cpu eq c1715
                         C       ENDIF
  E512    3A D03D        C      	ld	a,(synflg)
  E515    CB 77          C      	bit	stzaus,a	;Zugriff zur Statuszeile erlaubt?
  E517    CC D157        C      intkbd:	call	z,kbdsti	;ja, Tastatur abfragen und puffern
                         C      				;auf 'ld hl,.. .' waehrend Lampen-Ausgabe
  E51A                   C      intrbc:				;allg. Interr.-ausgang
  E51A    C1             C      	pop	bc
  E51B    D1             C      	pop	de
  E51C                   C      intrhl:				;allg. Interr.-ausgang
  E51C    E1             C      	pop	hl
  E51D                   C      intraf:				;allg. Interr.-ausgang
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-102


  E51D    F1             C      	pop	af
  E51E    31 0000        C      	ld	sp,0
  E51F                   C      intsp	equ	$-2
  E521                   C      intret:				;allg. Interr.-ausgang
  E521    FB             C      	ei
  E522    ED 4D          C      	reti
                         C      
                         C       IF cpu ne c1715
                         C      ; Interr.routine 1s
  E524    ED 73 E51F     C      tim1it:	ld	(intsp),sp
  E528    31 F061        C      	ld	sp,intstk
  E52B    F5             C      	push	af
  E52C    E5             C      	push	hl
  E52D    D5             C      	push	de
  E52E    C5             C      	push	bc
  E52F    CD E534        C      	call	tim1up
  E532    18 E6          C      	jr	intrbc
                         C       ENDIF
                         C      
                         C      ; Reaktionsroutine fuer 1 sec Interrupt
  E534    2A 0043        C      tim1up:	ld	hl,(tim1cn)
  E537    2B             C      	dec	hl
  E538    22 0043        C      	ld	(tim1cn),hl
                         C       IF uhrvar
                         C       ENDIF
  E53B    3A E517        C      	ld	a,(intkbd)	;lampen aktiv?
  E53E    FE 21          C      	cp	021h		;  call-Befehl oder ld hl,...
  E540    C4 D2B0        C      	call	nz,lampen	;nein, Aktualisierung Lampen
                         C      
  E543    21 E580        C      intcrt:	ld	hl,tim1uu	;auf jp,... waehrend conout
                         C      
                         C       IF cpastz or uhrvar
  E546    3A D03D        C      	ld	a,(synflg)
  E549    CB 77          C      	bit	stzaus,a	;Pflege der Statuszeile?
  E54B    20 33          C      	jr	nz,nt1stz	;nein
                         C        IF crtbfl eq 0
                         C        ENDIF
                         C       ENDIF
                         C       IF uhrvar
                         C       ENDIF
                         C      
                         C       IF cpastz
                         C      ; Default-LW, User in Statuszeile
  E54D    3A 0004        C      	ld	a,(defaul)
  E550    F5             C      	push	af
  E551    E6 0F          C      	and	0fh		;User loeschen
  E553    C6 41          C      	add	a,'A'
                         C        IF crtbfl ;Bildschirmpuffer liegt im adressierbaren RAM
  E555    11 FF81        C      	ld	de,statz2+statzd
  E556                   C      crtm27	equ	$-2		;BS-Puffer-Adr
                         C        ENDIF
  E558    12             C      	ld	(de),a		;anzeigen default-LW
  E559    F1             C      	pop	af
  E55A    13             C      	inc	de
  E55B    CD E714        C      	call	mrecol		;anzeigen user
                         C      
                         C      ; I/O-Byte in Statuszeile
  E55E    3A 0003        C      	ld	a,(iobyte)
                         C       IF crtbfl ;Bildschirmpuffer liegt im adressierbaren RAM
  E561    11 FFA0        C      	ld	de,statz2+statzi
  E562                   C      crtm38	equ	$-2
                         C       ENDIF
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-103


  E564    CD E711        C      	call	mrecoa
                         C      
                         C      ; Lampen-Byte in Statuszeile
  E567    3A 0040        C      	ld	a,(lampbf)
                         C       IF crtbfl ;Bildschirmpuffer liegt im adressierbaren RAM
  E56A    11 FFA4        C      	ld	de,statz2+statzl
  E56B                   C      crtm39	equ	$-2
                         C       ENDIF
  E56D    CD E711        C      	call	mrecoa
                         C      
                         C       ENDIF ;cpastz
                         C      
                         C       IF cpastz or uhrvar
                         C        IF crtbfl eq 0 ;Bildschirmpuffer liegt nicht im adressierbaren RAM
                         C        ENDIF ;crtbfl eq 0
                         C       ENDIF ;cpastz or uhrvar
                         C      
                         C       IF cpastz
                         C      ; wenn Anzeigezeit um, so BIOS-Meldung wieder loeschen
  E570    21 E701        C      	ld	hl,stzbto	;Anzeigezeit in Sekunden
  E573    35             C      	dec	(hl)		;abgelaufen?
  E574    20 0A          C      	jr	nz,nstzcl	;nein
  E576    06 11          C      	ld	b,stzbl
  E578    21 FFA7        C      	ld	hl,statz2+statzb
  E579                   C      crtm28	equ	$-2		;BS-Puffer-Adr.
  E57B    36 20          C      stzclz:	ld	(hl),' '
  E57D    23             C      	inc	hl
  E57E    10 FB          C      	djnz	stzclz
  E580                   C      nstzcl:
                         C       .comment % wegen Stoerungen auf dem Bildschirm bei Arbeit ohne Wait abgeklemmt
                         C        IF crt eq dsy5
                         C      ; Statuszeile invertieren
                         C      	ld	hl,statz2+statzd
                         C      	ld	b,statzt-statzd	;bis vor Tastaturpuffer
                         C      stzinv:	set	7,(hl)
                         C      	inc	hl
                         C      	djnz	stzinv	
                         C        ENDIF
                         C      %
                         C       ENDIF ;cpastz
                         C      
                         C       IF cpastz or uhrvar
                         C        IF crtbfl eq 0 ;Bildschirmpuffer liegt nicht im adressierbaren RAM
                         C        ENDIF
  E580                   C      nt1stz:
                         C       ENDIF
                         C      
  E580                   C      tim1uu:
                         C       IF disknb ne 0
                         C        IF (fdc eq K5120) or (fdc eq K5122) or (fdc eq f1715)
                         C      ; zusaetzliche Laufwerksabschaltung ueber Zeittakt
  E580    3A E213        C      	ld	a,(pretx+1)	;Motorabschaltung unterdrueckt?
  E583    B7             C      	or	a
  E584    28 0E          C      	jr	z,t1nmo1	;ja
  E586    3A E20B        C      	ld	a,(fl.zto)	;pro Sekunde 5 Umdrehungen
  E589    D6 04          C      	sub	4		;noch >= 4* 200ms Zeit?
  E58B    30 01          C      	jr	nc,t1nmo2	;ja
  E58D    AF             C      	xor	a
  E58E    32 E20B        C      t1nmo2:	ld	(fl.zto),a
  E591    CC E225        C      	call	z,headup	;Ueberw.zeit abgelaufen -> Motor aus
  E594                   C      t1nmo1:
                         C        ENDIF
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-104


                         C       ENDIF
  E594    2A 0045        C      	ld	hl,(tim1rt)	;Adresse der Nutzerroutine
  E597    E9             C      	jp	(hl)		;1-sec-Nutzerroutine ausfuehren, ret
                         C      
                         C       IF cpastz or uhrvar
                         C        IF crtbfl eq 0
                         C        ENDIF
                         C       ENDIF
                                
                                 IF	mprot
                                 ENDIF
                                
                                 IF	monitor
                                 ENDIF
                                
                         C      	include BIOSNUC
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                         C      ; Zentrale BIOS-Kompenenten
                         C      ; - rst 38h fuehrt bei Monitor zu seinem Aufruf, sonst Warmstart
                         C      ; - Nachladen CCP aus RAM-Floppy vereinheitlicht (unabh. von RAM-Floppy)
                         C      ; - synflg hinter BIOS-Sprungvektor fuer Modifizierung von aussen
                         C      ; - Verwendung der Interruptsaeule in Generierungsteil verlagert
                         C      ; 25.09.88
                         C      ; - Streichen des Tastaturpuffers in Tastaturstatus
                         C      ; 09.10.88
                         C      ; - Pflege der Statuszeile nur bei stzaus=0
                         C      ; 11.01.89
                         C      ; - Variante wbootv=4 (@CCP.COM) eingefuehrt
                         C      ; 17.05.89
                         C      ; - Generierung ohne LW A moeglich
                         C      ; 05.06.89
                         C      ; - Unterstuetzung NANOS-RAF
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                         C      
                         C       IF iobvar
                         C      ;Verteiler fuer die 1-Zeichen-Kanaele entsprechend IOBYTE:
                         C      ;=========================================================
                         C      
  E598                   C      const:			; iobyte  00 00 00 xx
  E598    CD E5F8        C      	call	iodisp
  E59B    07             C      	db	7
  E59C    D14F           C      	dw	kbdst		;0 kbd:
  E59E    D14F           C      	dw	kbdst		;1 kbd:
  E5A0    E5BC           C      	dw	reades		;2 rdr:
  E5A2    D88E           C      	dw	uc1st		;3 uc1: (liefert, ob Z. da)
                         C      
  E5A4                   C      conin:			; iobyte:  00 00 00 xx
  E5A4    CD E5F8        C      	call	iodisp
  E5A7    07             C      	db	7
  E5A8    D1E7           C      	dw	kbdi		;0 kbd:
  E5AA    D1E7           C      	dw	kbdi		;1 kbd:
  E5AC    E5C8           C      	dw	reader		;2 rdr:
  E5AE    D8BD           C      	dw	uc1i		;3 uc1: (wartet, bis Z. da)
                         C      
  E5B0                   C      conout:			; iobyte:  00 00 00 xx
  E5B0    CD E5F8        C      	call	iodisp
  E5B3    07             C      	db	7
  E5B4    D454           C      	dw	crto		;0 crt:
  E5B6    D132           C      	dw	dumo		;1 dum:
  E5B8    E5D4           C      	dw	punch		;2 pun:
  E5BA    D6EB           C      	dw	uc1o		;3 uc1: (wartet, bis frei)
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-105


  E5BC                   C      reades:			; iobyte:   00 00 xx 00
  E5BC    CD E5F8        C      	call	iodisp
  E5BF    01             C      	db	1
  E5C0    D14F           C      	dw	kbdst		;0 kbd:
  E5C2    D12C           C      	dw	dumst		;1 dum:
  E5C4    D12C           C      	dw	dumst		;2 dum:
  E5C6    D88E           C      	dw	uc1st		;3 uc1: (liefert, ob Z. da)
                         C      
  E5C8                   C      reader:			; iobyte:   00 00 xx 00
  E5C8    CD E5F8        C      	call	iodisp
  E5CB    01             C      	db	1
  E5CC    D1E7           C      	dw	kbdi		;0 kbd:
  E5CE    D12F           C      	dw	dumi		;1 dum:
  E5D0    D12F           C      	dw	dumi		;2 dum:
  E5D2    D8BD           C      	dw	uc1i		;3 uc1: (wartet, bis Z. da)
                         C      
                         C      
  E5D4                   C      punch:			; iobyte:   00 xx 00 00
  E5D4    CD E5F8        C      	call	iodisp
  E5D7    03             C      	db	3
  E5D8    D454           C      	dw	crto		;0 crt:
  E5DA    D132           C      	dw	dumo		;1 dum:
  E5DC    E5EC           C      	dw	list		;2 lst:
  E5DE    D6EB           C      	dw	uc1o		;3 uc1: (wartet, bis frei)
                         C      
                         C      
  E5E0                   C      listst:			; iobyte:  xx 00 00 00
  E5E0    CD E5F8        C      	call	iodisp
  E5E3    05             C      	db	5
  E5E4    D751           C      	dw	ttyst		;0 tty:
  E5E6    D12C           C      	dw	crtst		;1 crt:
  E5E8    D757           C      	dw	lptst		;2 lpt:
  E5EA    D12C           C      	dw	dumst		;3 dum:
                         C      
  E5EC                   C      list:			; iobyte:  xx 00 00 00
  E5EC    CD E5F8        C      	call	iodisp
  E5EF    05             C      	db	5
  E5F0    D6DF           C      	dw	ttyo		;0 tty:
  E5F2    D454           C      	dw	crto		;1 crt:
  E5F4    D6E5           C      	dw	lpto		;2 lpt:
  E5F6    D132           C      	dw	dumo		;3 dum:
                         C      
                         C      
                         C      ; IOBYTE-Auswertung - Verteilung auf die physischen Geraete
                         C      ; ---------------------------------------------------------
                         C      ; A,HL werden zerstoert
                         C      ; Anwender-IX wird gerettet, darf von Treiber-Routine zerstoert werden
                         C      ; damit kann Treiber auch aus Interrupt-Routine aufgerufen werden
                         C      
  E5F8                   C      iodisp:
  E5F8    E1             C      	pop	hl
  E5F9    C5             C      	push	bc
  E5FA    46             C      	ld	b,(hl)
  E5FB    23             C      	inc	hl
  E5FC    3A 0003        C      	ld	a,(iobyte)
  E5FF    0F             C      iodis1: rrca
  E600    10 FD          C      	djnz	iodis1
  E602    E6 06          C      	and	6
  E604    4F             C      	ld	c,a
  E605    09             C      	add	hl,bc
  E606    7E             C      	ld	a,(hl)
  E607    23             C      	inc	hl
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-106


  E608    66             C      	ld	h,(hl)
  E609    6F             C      	ld	l,a
  E60A    C1             C      	pop	bc
  E60B    DD E5          C      	push	ix		;retten Anwender-IX
  E60D    CD E6E4        C      	call	callhl
  E610    DD E1          C      	pop	ix		;wiederherstellen Anwender-IX
  E612    C9             C      	ret
                         C      
                         C       ENDIF
                         C      
                         C      ;************************************************************
                         C      ;	Spezialroutinen
                         C      ;************************************************************
                         C      
                         C      	IF	monitor
                         C      	ENDIF
                         C      
                         C      
                         C      ; Arbeit mit asynchronen Sonderaktionen
                         C      ;======================================
                         C      ; Die folgenden beiden Routinen werden vom BIOS immer dann aufgerufen,
                         C      ; wenn wegen zeitkritischer (z.B. Floppy-Bedienung) oder anderer
                         C      ; BIOS-Arbeit (z.B. Bildschirmrollen) keine parallelen Sonderaktionen
                         C      ; erlaubt sind.
                         C      
                         C      ; Reg A bleibt erhalten
  E613    F5             C      delsps: push	af
  E614    2A 004A        C      	ld	hl,(kritbg)	;evtl. Nutzerroutine fuer Beginn krit. BIOS
  E617    CD E6E4        C      	call	callhl		;aufrufen
  E61A    F1             C      	pop	af
  E61B    21 D03E        C      	ld	hl,synsem	;Verzoegern Sonderaktionen
  E61E    34             C      	inc	(hl)
  E61F    C9             C      	ret
                         C      
                         C      ; Reg A bleibt erhalten
  E620    F5             C      delspr: push	af
  E621    2A 004C        C      	ld	hl,(kriten)	;evtl. Nutzerroutine fuer Ende krit. BIOS
  E624    CD E6E4        C      	call	callhl		;aufrufen
  E627    F1             C      	pop	af
  E628    21 D03E        C      	ld	hl,synsem	;Zulassen Sonderaktionen
  E62B    35             C      	dec	(hl)
                         C      
                         C       IF stpvar or monitor
                         C      
                         C      ; Test auf zwischenzeitliche Anforderung von Sonderroutinen
                         C      ;----------------------------------------------------------
                         C      
                         C      ; Diese Routine wird nach dem Lesen eines Tastaturzeichens
                         C      ; als "Ohr" eingeschoben, bevor zur eigentlichen Interrupt-
                         C      ; adresse zurueckgekehrt wird. Sie wird nicht innerhalb der
                         C      ; Interruptroutine ausgefuehrt, um mit offenen Interrupts
                         C      ; arbeiten zu koennen.
                         C      ; maximale Stackbelastung nach RETI von Interruptroutinen:
                         C      ; -	Return-Adresse zum Nutzer
                         C      ; -	AF
  E62C    F3             C      chksp:	di
  E62D    F5             C      	push	af		;A und F Reg retten
  E62E    3A D03E        C      	ld	a,(synsem)
  E631    B7             C      	or	a		;asynchr. Routinen zugelassen?
  E632    C2 E649        C      	jp	nz,chkspx	;nein
  E635    3C             C      	inc	a		;weiteren Eintritt verhindern
  E636    32 D03E        C      	ld	(synsem),a
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-107


  E639    FB             C      chkspn: ei
  E63A    3A D03D        C      	ld	a,(synflg)	;inzw. (neue) Anforderung?
  0000                   C      rqmask	aset	0
                         C       IF monitor
                         C       ENDIF
                         C       IF stpvar
  0010                   C      rqmask	aset	rqmask+(1 shl stoprq)
                         C       IF chdvar
  0018                   C      rqmask	aset	rqmask+(1 shl synlrq)
                         C       ENDIF
                         C       ENDIF
  E63D    E6 18          C      	and	rqmask
  E63F    C2 E64C        C      	jp	nz,chkspd	;ja, ausfuehren
  E642    3A D03E        C      	ld	a,(synsem)
  E645    3D             C      	dec	a
  E646    32 D03E        C      	ld	(synsem),a
  E649    F1             C      chkspx: pop	af
  E64A    FB             C      	ei
  E64B    C9             C      	ret
                         C      
                         C      ; asynchrone Aktionen ausfuehren
  E64C                   C      chkspd:
                         C       IF monitor
                         C       ENDIF
                         C      
                         C       IF stpvar
  E64C    3A D03D        C      	ld	a,(synflg)
  E64F    CB 67          C      	bit	stoprq,a	;inzwischen Stop-Forderung?
  E651    28 10          C      	jr	z,nstpsp	;nein
  E653    CB A7          C      	res	stoprq,a
  E655    32 D03D        C      	ld	(synflg),a
  E658    F1             C      	pop	af		;Nutzer-Stackbelastung verringern
  E659    22 E691        C      	ld	(asynhl),hl	;HL freimachen
  E65C    21 E694        C      	ld	hl,stoprt	;Routine
  E65F    CD E67D        C      	call	asynrt		;aufrufen mit eigenem Stack
  E662    F5             C      	push	af
  E663                   C      nstpsp:
                         C      
                         C       IF chdvar
  E663    3A D03D        C      	ld	a,(synflg)
  E666    CB 5F          C      	bit	synlrq,a	;inzwischen LST:-Synchr.?
  E668    28 10          C      	jr	z,nsynlr	;nein
  E66A    CB 9F          C      	res	synlrq,a
  E66C    32 D03D        C      	ld	(synflg),a
  E66F    F1             C      	pop	af
  E670    22 E691        C      	ld	(asynhl),hl
  E673    21 D764        C      	ld	hl,lsynch
  E676    CD E67D        C      	call	asynrt
  E679    F5             C      	push	af
  E67A                   C      nsynlr:
                         C       ENDIF
                         C       ENDIF	;stpvar
                         C      
  E67A    C3 E639        C      	jp	chkspn		;Test auf neue Requests
                         C      
                         C       IF stpvar or chdvar
                         C      ; Asynchrone Routine (HL) mit eigenem Stack aufrufen
                         C      ;---------------------------------------------------
                         C      
  E67D    ED 73 E68E     C      asynrt: ld	(asynsv),sp	;asynchr. Routinen haben
  E681    31 F049        C      	ld	sp,stpstk	;ein eigenes Stack
  E684    F5             C      	push	af
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-108


  E685    D5             C      	push	de
  E686    C5             C      	push	bc
  E687    CD E6E4        C      	call	callhl		;Routine aufrufen
  E68A    C1             C      	pop	bc
  E68B    D1             C      	pop	de
  E68C    F1             C      	pop	af
  E68D    31 0000        C      	ld	sp,0		;SP wiederherstellen
  E68E                   C      asynsv	equ	$-2
  E690    21 0000        C      	ld	hl,0		;gerettetes hl wiederherst.
  E691                   C      asynhl	equ	$-2
  E693    C9             C      	ret
                         C       ENDIF
                         C      
                         C       IF stpvar
                         C      ; Asynchrone Stop-Routine
                         C      ;------------------------
  E694                   C      stoprt:
                         C       IF disknb ne 0
  E694    CD E225        C      	call	headup		;Disk-Kopf abheben
                         C       ENDIF
  E697    CD E6CE        C      stopz:	call	stpchp		;holen naechste phys. Taste
                         C      
                         C       IF umlaut
  E69A    FE 75          C      	cp	'u'		;Umlaut-Modus umschalten ?
  E69C    28 04          C      	jr	z,stopzu
  E69E    FE 55          C      	cp	'U'
  E6A0    20 08          C      	jr	nz,stopnu	;Nein !
  E6A2    21 D03D        C      stopzu: ld	hl,synflg	;Umlaute-Flag im Flagbyte
  E6A5    7E             C      	ld	a,(hl)
  E6A6    EE 04          C      	xor	1 shl umlflg	;umschalten
  E6A8    77             C      	ld	(hl),a
  E6A9    C9             C      	ret
  E6AA                   C      stopnu:
                         C       ENDIF
                         C      
                         C       IF chdvar
  E6AA    FE FB          C      	cp	zblmin		;"- im Ziffernblock": Hardcopy BS -> LIST?
  E6AC    CA D61A        C      	jp	z,crthrd	;ja, ausfuehren
  E6AF    FE CD          C      	cp	spcins		;"INS": I/O-Byte im LST:Kanal weiterschalten?
  E6B1    20 08          C      	jr	nz,stopz2	;nein
  E6B3    21 0003        C      	ld	hl,iobyte
  E6B6    7E             C      	ld	a,(hl)
  E6B7    C6 40          C      	add	a,40h		;Ueberlauf wird ignoriert
  E6B9    77             C      	ld	(hl),a
  E6BA    C9             C      	ret
  E6BB                   C      stopz2:
                         C      
                         C       IF l2bahn
                         C       ENDIF
                         C       ENDIF
                         C      
                         C       IF cpastz or uhrvar
  E6BB    FE EE          C      	cp	pfec		;"F14": Status-Anzeige ein/aus?
  E6BD    20 08          C      	jr	nz,stopz3	;nein
  E6BF    21 D03D        C      	ld	hl,synflg
  E6C2    7E             C      	ld	a,(hl)
  E6C3    EE 40          C      	xor	1 shl stzaus	;Status-Anzeige ein/aus
  E6C5    77             C      	ld	(hl),a
  E6C6    C9             C      	ret			;fertig
  E6C7                   C      stopz3:
                         C       ENDIF
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-109


                         C       IF costu
                         C       ENDIF
                         C      
  E6C7    D6 C7          C      	sub	kcurpd		;"Page down": ^C ?
  E6C9    C0             C      	ret	nz		;nein, Stop-Ende
  E6CA    32 D03E        C      	ld	(synsem),a	;falls rst 0 nicht in BIOS fuehrt
  E6CD    C7             C      	rst	0		;sonst Warmstart
                         C      
                         C      ; Holen naechste Taste physisch
  E6CE    21 D03D        C      stpchp: ld	hl,synflg
  E6D1    CB FE          C      	set	phyact,(hl)	;naechste Taste physisch
  E6D3    E5             C      	push	hl
  E6D4    CD E6DB        C      	call	stopch		;holen naechstes Tastaturz.
  E6D7    E1             C      	pop	hl
  E6D8    CB BE          C      	res	phyact,(hl)	;physisches Lesen beendet
  E6DA    C9             C      	ret
                         C      
                         C      ; Holen naechste Taste im Stopzustand
  E6DB    CD D5FB        C      stopch: call	swilmp		;Stop-Lampe an
  E6DE    CD D1E7        C      	call	kbdi		;Warten auf naechstes Zeichen
  E6E1    C3 D5FB        C      	jp	swilmp		;danach Stop-Lampe aus
                         C      
                         C       ENDIF ;stpvar
                         C       ENDIF ;asynchr. Routinen
                         C      
                         C      ;***************************************************
                         C      ;	Allgemeine BIOS-Hilfsprogramme
                         C      ;***************************************************
                         C      
                         C      ; Aufruf der Routine (HL)
  E6E4    E9             C      callhl: jp	(hl)
                         C      
                         C      ; Ausgabe Text ab (HL) bis 00h auf CON: und evtl. LST:
  E6E5    7E             C      putmes: LD	A,(HL)
  E6E6    B7             C      	OR	A
  E6E7    C8             C      	RET	Z
  E6E8    E5             C      	PUSH	HL
  E6E9    4F             C      	LD	C,A
  E6EA    CD D00C        C      	CALL	conol
  E6ED    E1             C      	POP	HL
  E6EE    23             C      	INC	HL
  E6EF    18 F4          C      	JR	putmes
                         C      
                         C      ; Ausgabe Text ab (HL) mit exakter Laenge "stzbl" in Statuszeile
                         C       IF cpastz
  E6F1    11 0027        C      biosms: ld	de,statz1+statzb
  E6F2                   C      crtm29	equ	$-2		;BS-Pufferadr. fuer Message
  E6F4    01 0011        C      	ld	bc,stzbl
                         C      	setbs
  E6F7    ED B0          C      	ldir
                         C      	setram
  E6F9    21 E701        C      	ld	hl,stzbto	;Anzeigezeit in Sekunden
  E6FC    36 1E          C      	ld	(hl),30
  E6FE    C3 D5F3        C      	jp	crtclk		;Blinken
                         C      
  E701    F0             C      stzbto: db	4*60		;Anzeigezeit fuer CP/A-Text
                         C       ENDIF
                         C      
                         C      ;	Wait 0.01 sec * (B)
                         C      ; Reg HL bleibt erhalten
  E702    C5             C      wait10: push	bc
  E703    0E 0A          C      	ld	c,10		;10* 1ms warten
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-110


  E705    06 BD          C      wait2z: ld	b,189		;(189*13)/(256*9600)=0.001
  E707    10 FE          C      wait1z: djnz	wait1z		;1ms warten
  E709    0D             C      	dec	c
  E70A    20 F9          C      	jr	nz,wait2z
  E70C    C1             C      	pop	bc
  E70D    10 F3          C      	djnz	wait10
  E70F    C9             C      	ret
                         C      
                         C      ;************************************************************
                         C      ;	zentral verwendete Rueckkonvertierungsroutinen
                         C      ;************************************************************
                         C      
                         C       IF monitor or errvar or iobvar or uhrvar or mprot
                         C      
                         C      ; Rueckkonvertieren Byte ab (HL) nach (DE)
                         C      ; RET: 2 Zeichen ab (DE), DE zeigt auf naechstes freies Byte
  E710    7E             C      mbreco: ld	a,(hl)
                         C      
                         C      ; Rueckkonvertieren Byte in A nach (DE)
                         C      ; RET: 2 Zeichen ab (DE), DE zeigt auf naechstes freies Byte
  E711    CD E714        C      mrecoa: call	mreca
                         C      
                         C      ; Rueckkonvertieren A in HEX-Ziffern nach (DE)
                         C      ; RET: A um 4 bits nach rechts rotiert
                         C      ;      DE zeigt auf naechstes Byte
  E714                   C      mrecol:
  E714    0F             C      mreca:	rrca			;linkes Halbbyte
  E715    0F             C      	rrca
  E716    0F             C      	rrca
  E717    0F             C      	rrca
  E718                   C      mrecor:				;rechtes Halbbyte
  E718    F5             C      	push	af		;fuer 2. mreca-Aufruf retten
  E719    E6 0F          C      	and	0fh
  E71B    D6 0A          C      	sub	9+1
  E71D    38 02          C      	jr	c,mrecod	;0..9
  E71F    C6 07          C      	add	a,7		;A..F
  E721    C6 3A          C      mrecod: add	a,'0'+10
  E723    12             C      	ld	(de),a
  E724    13             C      	inc	de
  E725    F1             C      	pop	af
  E726    C9             C      	ret
                         C      
                         C       ENDIF
                         C      
                         C       IF monitor or cpastz
                         C      
                         C      ; Ermitteln 10er-Ziffer von HL zur Basis -DE
                         C      ; C =0, wenn bisher nur fuehrende Nullen
                         C      ; RET: HL enthaelt Rest; C>0 bei Ziffer >'0'
                         C      ;	B,DE erhalten
                         C      ;	ret z bei fuehrender Null
                         C      
  E727    3E 2F          C      mhldig: ld	a,'0'-1		;ASCII-Zaehler
  E729    3C             C      mhdig1: inc	a
  E72A    19             C      	add	hl,de
  E72B    38 FC          C      	jr	c,mhdig1
  E72D    ED 52          C      	sbc	hl,de		;einmal zuviel gezaehlt
  E72F    0C             C      	inc	c
  E730    FE 30          C      	cp	'0'		;Null ?
  E732    C0             C      	ret	nz		;nein
  E733    0D             C      	dec	c		; Test auf fuehrende Null
  E734    C9             C      	ret			;ret z bei ja
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-111


                         C      
                         C       ENDIF
