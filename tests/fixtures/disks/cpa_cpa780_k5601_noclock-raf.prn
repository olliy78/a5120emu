  DE4C    2A DF68        C      	ld	hl,(diocad)
  DE4F    22 E243        C      	ld	(ft.adr),hl
                         C      
                         C       IF stpvar or monitor
  DE52    CD E613        C      	call	delsps		;Sondertasten verbieten
                         C       ENDIF
                         C       IF hdsk
