  DCBE    20 06          C      	jr	nz,dbn
  DCC0    3A DF48        C      	ld	a,(dbdev)	;zum Puffer gehoeriges Geraet
  DCC3    B9             C      	cp	c		;richtiges Geraet?
  DCC4    28 6C          C      	jr	z,dbmat		;ja, Sektor steht im Puffer
                         C      
  DCC6    C5             C      dbn:	push	bc		;retten ddrive
  DCC7    CD DD6A        C      	call	dbtrw		;veraenderten Puffer ausgeben
  DCCA    C1             C      	pop	bc		;c:=ddrive
  DCCB    21 DF48        C      	ld	hl,dbdev
