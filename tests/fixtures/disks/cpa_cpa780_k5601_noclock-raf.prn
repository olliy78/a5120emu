BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-72


                         C      	IF	format
                         C      ; Lesen beliebigen Sektor-Id.
                         C      ;===========================
  DD7F    32 DF42        C      dsidtt:	ld	(dfrmtr),a	;Eingang fuer Spur in A
  DD82                   C      dsidtr:
  DD82    21 DF40        C      	ld	hl,dfrcdb
                         C       IF dsk8mf
                         C       ENDIF
  DD85    18 03          C      	jr	dsktra		;belieb. SektId lesen
                         C      	ENDIF
                         C      
                         C      
                         C      ; gemeinsamer Zweig Read/Write 128-Sektor einzeln
                         C      ;================================================
  DD87                   C      drwsec:
  DD87    21 DF50        C      	ld	hl,dcdb
                         C      
                         C      ; interner Aufruf phys. Diskettentransfer
                         C      ;----------------------------------------
                         C      ; i HL auf CDB
  DD8A                   C      dsktra:
                         C       IF dev eq cpd
                         C       ENDIF
                         C      
                         C      ;*********************************************************
                         C      ; Umkleidung des physischer Disketten-Transfers
                         C      ;*********************************************************
                         C      
                         C      ; Parameter: HL auf CDB mit folgender Struktur:
                         C      ; +0: cdbfl	;Flags	(Struktur angepasst an ft.kom)
  0000                   C      diof00	equ	0	;** frei fuer Anw. ** (frueher Verify nach Schreiben)
  0001                   C      diofid	equ	1	;fest	;=1, wenn nur Sektid. zu lesen
  0002                   C      diofwr	equ	2	;fest	;=1, wenn Schreiben
  0003                   C      dioffm	equ	3	;fest	;=1, wenn temporaer FM-Format erzwungen
  0004                   C      dioftr	equ	4		;=1, wenn keine Fehlermeldung (und -behandlg)
  0005                   C      diofhd	equ	5		;=1, wenn Kopf hochnehmen ("headup")
  0006                   C      diofps	equ	6		;=1, wenn trk,sid,sec schon physisch
  0007                   C      diofs1	equ	7	;fest	;=1, wenn Rueckseite
                         C      
                         C      ; ab hier unwichtig bei "diofhd" in cdbfl =1 (headup)
                         C      ; +1: cdbdev	;logisches Geraet 0 .. dphnb-1
                         C      ; +2: cdbtrk	;log./phys. Spur
                         C      ; +3: cdbsid	;bel./phys. Seite
                         C      ; +4: cdbsec	;log./phys. Sektor
                         C      ; +5: cdbslc	;Sektorlaengencode (0=128, 1=256, 2=512, 3=1024)
                         C      ; +6: cdbsnb	;Anz. zu uebertr. ph. Sekt. (wenn =0, so nur position.)
                         C      ; ab hier nur wichtig, wenn "diofid" in cdbfl =0:
                         C      ; +7,8: cdbdma	;Transferadresse
                         C      
                         C      ; Return, falls nicht "diofhd" in cdbfl =1:
                         C      ;	A=0 (ret z) bei fehlerfrei, sonst A=1 (ret nz) bei cdbfl, "dioftr" =0
                         C      ;	oder Returncode phys. Transfer
                         C      ;	E:=trk, D:=sid ,L:=sec, H:=len
                         C      ;	BC,IX unveraendert
                         C      
  DD8A                   C      diskio:	;Aufruf ueber Sprungvektor von BIOS-Erweiterung
  DD8A    C5             C      	push	bc
  DD8B    11 DF61        C      	ld	de,diocdb	;CDB des Nutzers auf internen Hilfsspeicher
  DD8E    01 0009        C      	ld	bc,diocdl	;da modifiziert
  DD91    D5             C       	push	de
                         C       IF dev eq cpd
                         C       ELSE
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-73


  DD92    ED B0          C      	ldir
                         C       ENDIF
  DD94    E1             C      diskii:	pop	hl		;hl auf diocdb
  DD95    C1             C      	pop	bc
                         C      
  DD96    CB 6E          C      	bit	diofhd,(hl)	;Kopf hochnehmen?
                         C       IF disknb ne 0
  DD98    C2 E225        C      	jp	nz,headup	;ja, kein Transfer
                         C       ENDIF
  DD9B    C5             C      	push	bc
  DD9C    DD E5          C      	push	ix
  DD9E    E5             C      	push	hl
  DD9F    23             C       	inc	hl
  DDA0    4E             C      	ld	c,(hl)		;logisches Laufwerk
  DDA1    CD E7E9        C      	call	dgetpb		;IX auf DPB stellen
  DDA4    E1             C      	pop	hl		;wiederherstellen hl
  DDA5    3E 44          C      	ld	a,'D'		;falls LW nicht ex.
  DDA7    CA DE5E        C      	jp	z,dioert	;LW ex. nicht
                         C      
                         C       IF hdsk
                         C       ENDIF
  DDAA    CB 76          C      	bit	diofps,(hl)	;trk,sid,sec schon physisch?
  DDAC    20 5A          C      	jr	nz,diophy	;ja
                         C       IF dsk8mf
                         C       ENDIF
                         C      ; Track, Side und Sector entpsr. Diskettenformat setzen
  DDAE    23             C      	inc	hl
  DDAF    23             C      	inc	hl
  DDB0    56             C      	ld	d,(hl)		;Track
  DDB1    5A             C      	ld	e,d		;merken
  DDB2    23             C      	inc	hl
  DDB3    23             C      	inc	hl
  DDB4    4E             C      	ld	c,(hl)		;Sektornummer ab 1
  DDB5    0D             C      	dec	c		;Sektornr. ab 0
  DDB6    DD CB 0F 66    C      	bit	dpbf86,(ix+dpbflg)	;Fortsetzung Dsk. auf Ruecks.?
  DDBA    20 0C          C      	jr	nz,diots2	;ja
  DDBC    DD CB 0F 6E    C      	bit	dpbfds,(ix+dpbflg)	;ungerade Spuren auf Rueckseite?
  DDC0    28 29          C      	jr	z,diotrs	;nein, einseitig
  DDC2    CB 3A          C      	srl	d		;Spur halbieren
  DDC4    30 25          C      	jr	nc,diotrs	;gerade Spur, Vorderseite
  DDC6    18 12          C      	jr	diots1		;auf Rueckseite
  DDC8    DD 46 14       C      diots2:	ld	b,(ix+dpbtrk)	;log. Spurzahl
  DDCB    CB 38          C      	srl	b		;Spuren auf Vorderseite
  DDCD    7A             C      	ld	a,d
  DDCE    90             C      	sub	b		;Spur auf Vorderseite?
  DDCF    38 1A          C      	jr	c,diotrs	;ja, Spur in d unveraendert lassen
                         C      				;40 ->  0; 41 ->  1; ...; 79 ->  39
                         C      				;77 ->  0; 78 ->  1; ...;153 ->  76
  DDD1    DD CB 0F 5E    C      	bit	dpbfsv,(ix+dpbflg)	;Ruecks. von aussen nach innen?
  DDD5    20 02          C      	jr	nz,diots4	;ja
  DDD7    2F             C      	cpl			;40 -> -1; 41 -> -2; ...; 79 -> -40
                         C      				;77 -> -1; 78 -> -2; ...;153 -> -77
  DDD8    80             C      	add	a,b		;40 -> 39; 41 -> 38; ...; 79 ->   0
                         C      				;77 -> 76; 78 -> 75; ...;153 ->   0
  DDD9    57             C      diots4:	ld	d,a
  DDDA    3A DF61        C      diots1:	ld	a,(diocfl)
  DDDD    CB FF          C      	set	diofs1,a	;vermerken Rueckseite
  DDDF    32 DF61        C      	ld	(diocfl),a
  DDE2    DD 7E 13       C      	ld	a,(ix+dpbsn0)	;Versch. der Sektornr. auf Rueckseite
  DDE5    81             C      	add	a,c		;Sektornr. evtl. weiterzaehlen
                         C      ;;;	cp	c		;Weiternummerierung auf Rueckseite?
  DDE6    4F             C      	ld	c,a
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-74


                         C      ;;;	jr	nz,diotrs	;ja, dann side:=0
  DDE7    3E 01          C      	ld	a,1		;side:=1
  DDE9    18 01          C      	jr	diotss
  DDEB    AF             C      diotrs:	xor	a		;side:=0
  DDEC    32 DF64        C      diotss:	ld	(diocsi),a	;phys. Seite setzen
  DDEF    7A             C      	ld	a,d
  DDF0    32 DF63        C      	ld	(dioctr),a	;phys. Spur setzen
                         C      
  DDF3    7B             C      	ld	a,e		;log. Spurnr. zurueck nach A
  DDF4    DD E5          C      	push	ix
  DDF6    E1             C      	pop	hl
  DDF7    11 0019        C      	ld	de,dpbstr	;d:=0
  DDFA    19             C      	add	hl,de
  DDFB    DD BE 0D       C      	cp	(ix+dpbofs)	;Systemspur?
  DDFE    38 03          C      	jr	c,diossp	;ja, Sektornummern nicht logisch
  DE00    59             C      	ld	e,c
  DE01    19             C      	add	hl,de		;HL entspr. Index in dpbstr
  DE02    4A             C      	ld	c,d		;c:=0
  DE03    79             C      diossp:	ld	a,c		;phys. Sektornr. ab 0
  DE04    86             C      	add	a,(hl)		;+echte Sektornr.
  DE05    32 DF65        C      	ld	(diocse),a	;phys. Sektor setzen
  DE08                   C      diophy:
                         C      
                         C      ; i ret, BC, IX im Stack
                         C      ; i cdb auf diocdb
                         C      ; i IX auf DPB
                         C      
  DE08                   C      diorty:	;interne Wiederholung diskio
  DE08    DD E5          C      	push	ix		;retten IX fuer evtl. Wiederholung
  DE0A    21 DF61        C      	ld	hl,diocdb
  DE0D    E5             C      	push	hl
  DE0E    7E             C      	ld	a,(hl)		;side 0/1, -/FM, read/write, -/sectid l.
  DE0F    E6 8E          C       and (1 shl diofs1)+(1 shl dioffm)+(1 shl diofwr)+(1 shl diofid)
  DE11    47             C      	ld	b,a
  DE12    DD 7E 18       C      	ld	a,(ix+dpbtyp)	;5"/8", FM/MFM, 40/80, Verify nach Schreiben
  DE15    E6 78          C       and (1 shl dpbt80)+(1 shl dpbt5z)+(1 shl dpbtdd)+(1 shl dpbtwv) ;aus DPB
  DE17    A8             C      	xor	b
                         C       IF dsk8mf
                         C       ENDIF
  DE18    CB 66          C      	bit	dioftr,(hl)	;Fehlerbehandlung unterdruecken?
  DE1A    28 01          C      	jr	z,dionft	;nein
  DE1C    3C             C      	inc	a
  DE1D                   C      dionft:
  DE1D    32 E242        C      	ld	(ft.kom),a	
                         C      
  DE20    23             C      	inc	hl
  DE21    DD 7E 15       C      	ld	a,(ix+dpbdnr)	;physische LW-Nr.
  DE24    32 E245        C      	ld	(ft.lwn),a
                         C      
  DE27    23             C      	inc	hl
  DE28    7E             C      	ld	a,(hl)
  DE29    32 E246        C      	ld	(ft.trk),a
  DE2C    23             C      	inc	hl
  DE2D    7E             C      	ld	a,(hl)
  DE2E    32 E247        C      	ld	(ft.sid),a
  DE31    23             C      	inc	hl
  DE32    7E             C      	ld	a,(hl)
  DE33    32 E248        C      	ld	(ft.sec),a
  DE36    23             C      	inc	hl
  DE37    7E             C      	ld	a,(hl)
  DE38    32 E249        C      	ld	(ft.len),a
  DE3B    23             C      	inc	hl
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-75


  DE3C    7E             C      	ld	a,(hl)
  DE3D    32 E24A        C      	ld	(ft.anz),a
                         C      
  DE40    DD 7E 12       C      	ld	a,(ix+dpbstp)	;Anzahl der Stepimpulse
  DE43    32 E24B        C      	ld	(ft.stp),a
                         C      
  DE46    DD 7E 17       C      	ld	a,(ix+dpbsti)	;Schrittzeit
  DE49    32 E24C        C      	ld	(ft.sti),a
