                         C      ;###
                         C       endif
  DC68    21 DF50        C      	ld	hl,dflg
  DC6B    CB 96          C      	res	dfwr,(hl)	;Lesen anzeigen
                         C      
                         C       IF dbufsz gt 7
  DC6D    21 DF47        C      	ld	hl,dbflg
  DC70    CB C6          C      	set	dfbprr,(hl)	;preread notwendig
  DC72    3E 02          C      	ld	a,2
  DC74    32 DF5F        C      	ld	(dwrtyp),a
                         C      
  DC77                   C      alloc:
                         C        IF @write
  DC77    AF             C      	xor	a
  DC78    32 DF59        C      	ld	(unacnt),a	;Ende unalloc
                         C        ENDIF
                         C      
                         C       ENDIF
                         C      
                         C      ; gemeinsamer Zweig read/write Floppy
                         C      ;------------------------------------
                         C      
  DC7B    3A DF54        C      drw:	ld	a,(dsectr)	;Sektornummer in 1..dpbspt ?
  DC7E    3D             C      	dec	a		;ab 0 zaehlen
  DC7F    FA DC55        C      	jp	m,drwerr	;<0, Fehler
  DC82    DD BE 00       C      	cp	(ix+dpbspt)	;<dpbspt?
  DC85    30 CE          C      	jr	nc,drwerr	;nein, Fehler
                         C       IF dbufsz gt 7
  DC87    47             C      	ld	b,a		;retten dsectr-1
                         C       ENDIF
  DC88    DD 7E 0F       C      	ld	a,(ix+dpbflg)
  DC8B    E6 03          C      	and	dpbfsm		;Anzahl der abweich. 128er Spuren
  DC8D    5F             C      	ld	e,a
  DC8E    16 00          C      	ld	d,0
  DC90    2A DF52        C      	ld	hl,(dtrack)	;verlangte Spur
  DC93    B7             C      	or	a
  DC94    ED 52          C      	sbc	hl,de		;im abweichenden Spurformat?
  DC96    DA DD87        C      	jp	c,drwsec	;ja, Sektorlaenge 128
                         C      
                         C       IF dbufsz gt 7	;gepufferte Disk E/A
                         C       IF dbufsz lt 12 ;<2**12 =4K Puffer
  DC99    DD 7E 10       C      	ld	a,(ix+dpbslc)	;phys. Sektorlaenge 128?
  DC9C    B7             C      	or	a		;d.h. mit Sektorversatz?
  DC9D    CA DD87        C      	jp	z,drwsec	;ja, keine Pufferung sinnvoll
                         C       ENDIF
  DCA0    78             C      	ld	a,b
  DCA1    DD 56 11       C      	ld	d,(ix+dpbbfm)	;Puffermaske
  DCA4    A2             C      	and	d		;rel. Sekt.nr. des BDOS-Blocks zum Puff.anf.
  DCA5    F5             C      	push	af		;merken fuer move
  DCA6    A8             C      	xor	b		;a ist Sektornr. des Puff.anf.
  DCA7    CB 3F          C      drwbnr:	srl	a		;ermitteln Puffernr in Spur
  DCA9    CB 1A          C      	rr	d		;noch Bits in Puffermaske?
  DCAB    20 FA          C      	jr	nz,drwbnr	;ja
                         C      ; Test, ob dieser Puffer da ist
  DCAD    F5             C      	push	af		;merken Puffernummer
  DCAE    21 DF5E        C      	ld	hl,dbnb
  DCB1    BE             C      	cp	(hl)		;richtige Puffernummer?
  DCB2    20 12          C      	jr	nz,dbn		;nein
  DCB4    2A DF52        C      	ld	hl,(dtrack)	;geforderte Spur
  DCB7    ED 5B DF49     C      	ld	de,(dbtrk)
  DCBB    B7             C      	or	a
  DCBC    ED 52          C      	sbc	hl,de		;richtige Spur?
