  DD02    10 FC          C      	djnz	dbsecm
  DD04    93             C      	sub	e		;Restsektorzahl auf Spur
  DD05    BA             C      	cp	d		;>= Zahl zu transferierender?
  DD06    30 01          C      	jr	nc,dbseco	;ja
  DD08    57             C      	ld	d,a		;sonst nur Restsektorzahl
  DD09    1C             C      dbseco:	inc	e		;Sektoren zaehlen ab 1
  DD0A    7B             C      	ld	a,e
  DD0B    32 DF4B        C      	ld	(dbsec),a	;Sektor
  DD0E    7A             C      	ld	a,d
  DD0F    32 DF4D        C      	ld	(dbsnb),a	;Sektorzahl
  DD12    21 DF47        C      	ld	hl,dbflg
  DD15    CB 96          C      	res	dfbwr,(hl)
                         C       if @write
  DD17    CB 46          C      	bit	dfbprr,(hl)	;muss neuer Puffer gel. werden?
  DD19    20 14          C      	jr	nz,dbprr	;ja
