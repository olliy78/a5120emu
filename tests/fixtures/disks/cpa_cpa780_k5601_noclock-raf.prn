  DE71    28 02          C      	jr	z,derrr		;ja
  DE73    3E 57          C      	ld	a,'W'
  DE75    32 DF28        C      derrr:	ld	(derrrw),a
                         C        IF dev eq cpd
                         C        ELSE
  DE78    21 E246        C      	ld	hl,ft.trk	;phys. Spur
  DE7B    11 DF33        C      	ld	de,derrtr
  DE7E    CD E710        C      	call	mbreco
  DE81    21 E247        C      	ld	hl,ft.sid	;Seite
  DE84    CD E710        C      	call	mbreco
  DE87    21 E248        C      	ld	hl,ft.sec	;Sektor
  DE8A    CD E710        C      	call	mbreco
                         C        ENDIF
  DE8D    21 DF28        C      	ld	hl,derrms
  DE90    CD E6F1        C      	call	biosms
                         C       ENDIF
  DE93    3E 01          C       	ld	a,1		;return mit Fehler
                         C      
  DE95    B7             C      dtrok:	or	a		;stellen Z-Flag
  DE96    ED 5B E246     C      	ld	de,(ft.trk)	;E:=trk, D:=sid
  DE9A    2A E248        C      	ld	hl,(ft.sec)	;L:=sec, H:=len
  DE9D    DD E1          C      	pop	ix
  DE9F    C1             C      	pop	bc
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-76


  DEA0    C9             C      	ret
                         C      
                         C       IF	format
                         C      
                         C      ; Stellen HL entsprechend Sektorlaengencode in (A)
                         C      ;=================================================
                         C      ; ret nz bei unzulaessigem
  DEA1    B7             C      dtrsla:	or	a
  DEA2    21 DEB5        C      	ld	hl,dtrsl0
  DEA5    C8             C      	ret	z		;=0 (128)
  DEA6    3D             C      	dec	a
  DEA7    21 DEC9        C      	ld	hl,dtrsl1	;=1 (256)
  DEAA    C8             C      	ret	z
  DEAB    3D             C      	dec	a
  DEAC    21 DEDD        C      	ld	hl,dtrsl2	;=2 (512)
  DEAF    C8             C      	ret	z
  DEB0    3D             C      	dec	a
  DEB1    21 DEF1        C      	ld	hl,dtrsl3	;=3 (1024)
  DEB4    C9             C      	ret
                         C      
                         C       ENDIF
                         C      
                         C      ;************************************************
                         C      ;	Steuertabellen
                         C      ;************************************************
                         C      
                         C      
                         C       IF	format
                         C      ; Modifizierungstabellen entspr. Sektorlaenge und LW-Typ
                         C      ;-------------------------------------------------------
                         C      
                         C      ; Struktur:
                         C      
  0000                   C      dsltrk	equ	0		;benutzte Spuren
  0001                   C      dslspt	equ	dsltrk+1	;Sektoren/Spur
  0002                   C      dsldir	equ	dslspt+1	;Dir-Eintraege
  0003                   C      dsloff	equ	dsldir+1	;2*offset
                         C      				;[+Flag fuer festes offset]
  0001                   C      dslfo	equ	1		;festes offset
  0000                   C      dslvo	equ	0		;offset =0, falls Directory mgl.
  0004                   C      dslblk	equ	dsloff+1	;rel. Adr. Tab. BDOS-Blockgroesse
  0005                   C      dsll	equ	5		;Laenge eines Eintrags
                         C      
                         C      ; Reihenfolge
                         C      ; 5", 40 Tr, SS
                         C      ; 5", 80 Tr, SS
                         C      ; 5", 40 Tr, DS
                         C      ; 5", 80 Tr, DS
                         C       if	disk8
                         C       endif
                         C      
                         C      ; Zur automatischen Bestimmung des Spurformats wird dasjenige
                         C      ; Format der Spur "dlgint" benutzt, alle folgenden Spuren
                         C      ; muessen das gleiche Format haben!
  0003                   C      dlgint	equ	3	;groesste Anzahl SS-Systemspuren
                         C      
                         C      ; 128
  DEB5                   C      dtrsl0:	
  DEB5    28 1A 3F 04    C      	db	40,26,63,2*2+dslvo,dbl1k-$	;CP/M Standard
  DEB9    4C             C      
  DEBA    50 1A 7F 04    C      	db	80,26,127,2*2+dslvo,dbl2k-$
  DEBE    4A             C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-77


  DEBF    50 1A 7F 01    C      	db	80,26,127,2*0+dslfo,dbl2k-$
  DEC3    45             C      
  DEC4    A0 1A 7F 01    C      	db	160,26,127,2*0+dslfo,dbl2k0-$
  DEC8    43             C      
                         C      
                         C      	if	disk8
                         C      	endif
                         C      
                         C      ; 256
  DEC9                   C      dtrsl1:	
  DEC9    28 20 3F 07    C      	db	40,32,63,2*3+dslfo,dbl2k-$	;SCP Hausformat A51xx
  DECD    3B             C      
  DECE    50 20 3F 07    C      	db	80,32,63,2*3+dslfo,dbl2k-$	;SCP
  DED2    36             C      
  DED3    50 20 7F 09    C      	db	80,32,127,2*4+dslfo,dbl2k-$
  DED7    31             C      
  DED8    A0 20 7F 09    C      	db	160,32,127,2*4+dslfo,dbl2k0-$	;SCP Hausformat PC1715
  DEDC    2F             C      
                         C      
                         C      	if	disk8
                         C      	endif
                         C      
                         C      ; 512
  DEDD                   C      dtrsl2:	
  DEDD    28 24 00 01    C      	db	40,36,0,2*0+dslfo,dbl1k-$
  DEE1    24             C      
  DEE2    50 24 00 01    C      	db	80,36,0,2*0+dslfo,dbl2k-$
  DEE6    22             C      
  DEE7    50 24 00 01    C      	db	80,36,0,2*0+dslfo,dbl2k-$
  DEEB    1D             C      
  DEEC    A0 24 00 01    C      	db	160,36,0,2*0+dslfo,dbl2k0-$
  DEF0    1B             C      
                         C      
                         C      	if	disk8
                         C      	endif
                         C      	
                         C      ; 1024
  DEF1                   C      dtrsl3:	
  DEF1    28 28 3F 04    C      	db	40,40,63,2*2+dslvo,dbl1k-$	;CP/A Standard A51xx
  DEF5    10             C      
  DEF6    50 28 7F 04    C      	db	80,40,127,2*2+dslvo,dbl2k-$	;CP/A
  DEFA    0E             C      
  DEFB    50 28 7F 00    C      	db	80,40,127,2*0+dslvo,dbl2k-$	;CP/A
  DEFF    09             C      
  DF00    A0 28 BF 08    C      	db	160,40,191,2*4+dslvo,dbl2k0-$	;CP/A (und SCP)
  DF04    07             C      
                         C      
                         C      	if	disk8
                         C      	endif
                         C      
                         C      ; Modifizierungstabellen fuer BDOS-Blockgroesse
  DF05    03 07 00       C      dbl1k:	db	3,7,0		;Bl. Shift, Bl. Mask, Ext. Mask
  DF08    04 0F 01       C      dbl2k:	db	4,0fh,1
  DF0B    04 0F 00       C      dbl2k0:	db	4,0fh,0		;fuer Kapazitaet >255
                         C      
                         C      ; log. Sektortranslate-Tabelle fuer 26*128
  DF0E    01 07 0D 13    C      xlt:	db	1,7,13,19,25,5,11,17,23,3,9,15,21
  DF12    19 05 0B 11    C      
  DF16    17 03 09 0F    C      
  DF1A    15             C      
  DF1B    02 08 0E 14    C      	db	2,8,14,20,26,6,12,18,24,4,10,16,22
  DF1F    1A 06 0C 12    C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-78


  DF23    18 04 0A 10    C      
  DF27    16             C      
