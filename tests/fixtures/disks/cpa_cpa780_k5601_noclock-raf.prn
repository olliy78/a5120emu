                         C      ;*************************************************************
                         C      ;	wiederholter Kaltstart
                         C      ;*************************************************************
  E735                   C      kalts1:
                         C       IF cpu eq k2521
                         C       ENDIF
                         C       IF (cpu eq k2526) or (cpu eq c1715)
  E735    CD E4E7        C      	call	tim5of		;totlegen aller Interruptquellen
                         C        IF cpu eq k2526
  E738    CD E4F2        C      	call	tim1of
                         C        ENDIF
                         C        IF cpu eq c1715
                         C        ENDIF
  E73B    F3             C      	di
                         C        IF cpu eq k2526
  E73C    3E F7          C      	ld	a,0f7h
  E73E    D3 0A          C      	out	(0ah),a		;Lade-ROM zuschalten
                         C        ENDIF
                         C        IF cpu eq c1715
                         C        ENDIF
  E740    C7             C      	rst	0		;RESET
                         C       ENDIF
                         C      
                         C      ;*************************************************************
                         C      ;	Warmstart
                         C      ;*************************************************************
                         C       if1
                         C       endif
                         C      
                         C       IF	wbootv eq 1	;Warmstart=Kaltstart
                         C       ELSE
  E741    31 0080        C      WARMST: LD	SP,tpa-80h
                         C      
                         C         if	wbootv eq 0		;;CCP-Kopie im BIOS
  E744    21 E80C        C      	ld	hl,ccpkop	;;CCP von Kopie wiederherst.
  E747    11 BA00        C      	ld	de,CCP
  E74A    01 0811        C      	ld	bc,ccpkpl+bdskpl
  E74D    ED B0          C      	ldir
                         C         endif
                         C      
                         C         if	(wbootv eq 2) or (wbootv eq 3) or (wbootv eq 4)
                         C         endif ;(wbootv eq 2) or (wbootv eq 3) or (wbootv eq 4)
                         C      
                         C         if (wbootv eq 0) or (wbootv eq 2) or (wbootv eq 3)
  E74F    21 BA03        C      	LD	HL,CCP+3	;EINGANG MIT KOMMANDOLOESCHEN
                         C         endif
                         C         if wbootv eq 4
                         C         endif
                         C      	warmin
  E752    F3             C+     wbinit: DI
  E753    E5             C+     	PUSH	HL
  E754    3E F7          C+     	LD	A,high(intvr)
  E756    ED 47          C+     	LD	I,A
  E758    ED 5E          C+     	im	2
  E75A    3E C3          C+     	LD	A,0C3H
  E75C    32 0000        C+     	LD	(REBOOT),A
  E75F    21 0003'       C+     	LD	HL,BIOS+3
  E762    22 0001        C+     	LD	(REBOOT+1),HL
