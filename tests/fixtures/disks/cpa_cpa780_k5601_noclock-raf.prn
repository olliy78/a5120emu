                         C      
  DE5E                   C      dioert:
                         C      ; Fehlerprotokoll
  DE5E    CB 66          C      	bit	dioftr,(hl)	;Fehlerprotokoll und -behandlung  unterdr.?
  DE60    20 33          C      	jr	nz,dtrok	;ja
  DE62    B7             C      	or	a		;Returncode
  DE63    28 30          C      	jr	z,dtrok		; -> fehlerfrei
  DE65    FE 52          C      	cp	'R'		;not ready?
  DE67    CA DE08        C      	jp	z,diorty	;ja, Wiederholung
                         C      
                         C       IF errvar
  DE6A    32 DF29        C      	ld	(derrcd),a	;Fehlercode
  DE6D    CB 56          C      	bit	diofwr,(hl)	;war lesen?
