                         C      ;	ld	a,0ffh		;Schnittmaske c0..ff -> c0..ff
                         C      ;	jr	z,cst37b	;nein
                         C      ;	ld	a,0bfh		;Schnittmaske c0..ff -> 80..bf
                         C      ;cst37b:ld	(kbdlcs),a
                         C      ;	xor	a
                         C      ;	dec	a		;(a)=ff, z=0
                         C      ;	ret
                         C      
