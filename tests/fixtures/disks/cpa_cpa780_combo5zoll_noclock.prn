  D2A5    20 0C          C      	jr	nz,kbdnhc
  D2A7    21 D10C        C      	ld	hl,conol
  D2AA    7E             C      	ld	a,(hl)
  D2AB    EE 0E          C      	xor	0cdh xor 0c3h	;CALL aus JP u.umgekehrt
  D2AD    77             C      	ld	(hl),a
  D2AE    3E 80          C      	ld	a,1 shl lmphcp	;Hardcopy-Lampe
  D2B0    C3 D3AB        C      	jp	kbdslm
  D2B3                   C      kbdnhc:
                         C       ENDIF
                         C       ENDIF	;stpvar
                         C      
                         C       IF monitor
                         C       ENDIF
                         C      
  D2B3    FE D1          C      	cp	Sel0		;Selector 0?
  D2B5    38 09          C      	jr	c,kbdnsl	;nein
  D2B7    FE D9          C      	cp	Sel3+1		;Selector 0..3?
  D2B9    30 05          C      	jr	nc,kbdnsl	;nein
  D2BB    E6 0F          C      	and	0fh		;Bit 0..3
  D2BD    C3 D3AB        C      	jp	kbdslm
  D2C0                   C      kbdnsl:
  D2C0    B7             C      	or	a		;Taste zu ignorieren?
  D2C1    F8             C      	ret	m		;ja
                         C      
                         C      ; Zeichen im Puffer ablegen
                         C      ;--------------------------
  D2C2                   C      kbdput:
                         C       IF cpastz
                         C       ENDIF
  D2C2    21 FFFF        C      	ld	hl,0ffffh	;Pufferadresse
  D2C3                   C      crtm35	equ	$-2
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-26


  D2C5    01 0014        C      	ld	bc,kbdbl	;Pufferlaenge
  D2C8    5F             C      	ld	e,a		;A retten
  D2C9    AF             C      	xor	a		;Pufferende-Kennzeichen
  D2CA    ED B1          C      	cpir
  D2CC    20 08          C      	jr	nz,kbdpt1	;Puffer voll
  D2CE    77             C      	ld	(hl),a		;neues Pufferende anzeigen
  D2CF    7B             C      	ld	a,e		;A wiederherstellen
  D2D0    2B             C      	dec	hl
  D2D1    77             C      	ld	(hl),a		;Zeichen puffern
                         C      ;um bei Arbeit mit Anzeige des Tastaturpuffers in Statuszeile
                         C      ;Bildschirmflimmern zu vermeiden hinterlegen des gepufferten Zeichens
                         C      ;ausserhalb des Bildschirmbereichs fuer Test, ob ueberhaupt etwas im Puffer
