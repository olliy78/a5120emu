  F28F                   C      dbuf	equ	@dsad		;Diskettenpuffer
  F68F                   C      @dsad	aset	@dsad+(1 shl dbufsz)
                         C       ENDIF
                         C      
                         C      ; ============Tastatur=================
                         C      
                         C       IF cpastz
                         C       ELSE
  F68F                   C      kbdbuf	equ	@dsad
  F6A4                   C      @dsad	aset	@dsad+kbdbl+1
                         C       ENDIF
                         C      
                         C      ; Es folgt der Bereich fuer nutzereigene Stringdefinition
