  DD58    BE             C      	cp	(hl)		;richtige Puffernummer?
  DD59    20 12          C      	jr	nz,dbn		;nein
  DD5B    2A DFFD        C      	ld	hl,(dtrack)	;geforderte Spur
  DD5E    ED 5B DFF4     C      	ld	de,(dbtrk)
  DD62    B7             C      	or	a
  DD63    ED 52          C      	sbc	hl,de		;richtige Spur?
  DD65    20 06          C      	jr	nz,dbn
  DD67    3A DFF3        C      	ld	a,(dbdev)	;zum Puffer gehoeriges Geraet
  DD6A    B9             C      	cp	c		;richtiges Geraet?
  DD6B    28 6C          C      	jr	z,dbmat		;ja, Sektor steht im Puffer
                         C      
  DD6D    C5             C      dbn:	push	bc		;retten ddrive
  DD6E    CD DE11        C      	call	dbtrw		;veraenderten Puffer ausgeben
