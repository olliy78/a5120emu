  D4A8    E5 01 0C       C+     	db	pf5c,1,'L' and 1fh
  D4AB    E6 02 0F 44    C+     	db	pf6c,2,'O' and 1fh,'D'
  D4AF    E7 02 0F 47    C+     	db	pf7c,2,'O' and 1fh,'G'
  D4B3    E8 01 17       C+     	db	pf8c,1,'W' and 1fh
  D4B6    E9 01 1A       C+     	db	pf9c,1,'Z' and 1fh
  D4B9    EA 04 0B 53    C+     	db	pfac,4,'K' and 1fh,'S','Q' and 1fh,'P'
  D4BD    11 50          C+     
  D4BF    EB 02 0B 42    C+     	db	pfbc,2,'K' and 1fh,'B'
  D4C3    EC 02 0B 4B    C+     	db	pfcc,2,'K' and 1fh,'K'
  D4C7    ED 02 0B 56    C+     	db	pfdc,2,'K' and 1fh,'V'
  D4CB    EE 01 DB       C+     	db	pfec,1,Monc
  D4CE    EF 01 DE       C+     	db	pffc,1,Stpc
  D4D1    F1 01 31       C+     	db	zbl1,1,'1'
