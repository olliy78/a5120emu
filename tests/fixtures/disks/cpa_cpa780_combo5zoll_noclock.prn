  D7BF    D668           C      	dw	crtcl	;08
  D7C1    D65A           C      	dw	crtlf	;0A
  D7C3    D671           C      	dw	crtbsl	;0C
  D7C5    D649           C      	dw	crtcr	;0D
                         C       if umlaut
  D7C7    D70A           C      	dw	crt2zs	;0E
  D7C9    D712           C      	dw	crt1zs	;0F
                         C       endif
  D7CB    D674           C      	dw	crtbsr	;14
