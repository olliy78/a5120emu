                         C      
                         C      ; Tabelle der Adressen der DPH's
                         C      ;===============================
                         C      
                         C      ;===============================================
  000D                   C      @din	aset	dphnb
  E823                   C      dphatb: IRP	di,<A,B,C,D,E,F,G,H,I,J,K,L,M,N,O,P>
                         C      	if	@din eq 0
                         C      	EXITM
                         C      	endif
                         C      @din	aset	@din-1
                         C       IF dpha&di ; Laufwerk A auf erstes definiertes Geraet legen
                         C      dphaA	aset	dpha&di
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-110


                         C       ENDIF
                         C      	dw	dpha&di
                         C      	ENDM
  E823    D13F           C+     	dw	dpha&A
  E825    D14F           C+     	dw	dpha&B
  E827    D15F           C+     	dw	dpha&C
  E829    0000           C+     	dw	dpha&D
  E82B    0000           C+     	dw	dpha&E
  E82D    0000           C+     	dw	dpha&F
  E82F    0000           C+     	dw	dpha&G
  E831    0000           C+     	dw	dpha&H
  E833    0000           C+     	dw	dpha&I
  E835    0000           C+     	dw	dpha&J
  E837    0000           C+     	dw	dpha&K
  E839    0000           C+     	dw	dpha&L
  E83B    E578           C+     	dw	dpha&M
                         C      
                         C      ; Ermitteln DPH und DPB von (c) nach HL bzw. IX
                         C      ; ret z		DPH existiert nicht, HL=0
                         C      ; ret nz	ok, HL auf DPH, IX auf DPB
                         C      ; BC, DE bleiben erhalten
                         C      ;=====================================================
  E83D    D5             C      dgetpb: push	de
  E83E    21 0000        C      	ld	hl,0
  E841    79             C      	ld	a,c
  E842    FE 0D          C      	cp	dphnb		;DPH definiert?
  E844    30 16          C      	jr	nc,dgetp0	;nein
  E846    EB             C      	ex	de,hl
  E847    21 E823        C      	ld	hl,dphatb	;Adresstabelle fuer DPH's
  E84A    59             C      	ld	e,c
  E84B    19             C      	add	hl,de
  E84C    19             C      	add	hl,de
  E84D    7E             C      	ld	a,(hl)
  E84E    23             C      	inc	hl
  E84F    66             C      	ld	h,(hl)
  E850    6F             C      	ld	l,a		;hl:=^DPH
  E851    E5             C      	push	hl
  E852    1E 0A          C      	ld	e,10
  E854    19             C      	add	hl,de
  E855    5E             C      	ld	e,(hl)
  E856    23             C      	inc	hl
  E857    56             C      	ld	d,(hl)		;de:=^dpb
  E858    D5             C      	push	de
  E859    DD E1          C      	pop	ix		;ix:=^dpb
  E85B    E1             C      	pop	hl
  E85C    D1             C      dgetp0: pop	de
  E85D    7C             C      	ld	a,h
  E85E    B5             C      	or	l		;ret z bei hl=0
  E85F    C9             C      	ret
                         C      
                         C      
                         C      ;**************************************************
                         C      ;	Arbeits-Felder (ab hier keine Konstanten!!)
                         C      ;	Arbeits-Felder werden benutzt fuer Kaltstart-Routinen
                         C      ;**************************************************
  E860                   C      biosds	equ	$
  E860                   C      @dsad	aset	biosds
                         C      
                         C      ; ===========allgemeine BIOS-Funktionen=============
                         C      
  0800                   C      ccpkpl	equ	ccpln		;Laenge CCP+ BDOS-Anfang
  0011                   C      bdskpl	equ	11h		;BDOS-Anfang
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-111


                         C      
                         C      	if	wbootv eq 0	;CCP-Kopie im BIOS
  E860                   C      ccpkop	equ	@dsad
  F071                   C      ccpkpe	equ	ccpkop+ccpkpl+bdskpl
  F071                   C      @dsad	aset	ccpkpe	;Ende CCP-Kopie
                         C      	endif
                         C      
                         C      	if	(wbootv eq 2) or (wbootv eq 3)
                         C      	endif
                         C      
                         C       IF stpvar
  F09D                   C      @dsad	aset	@dsad+2*22	;Stack fuer asynchrone Routinen
  F09D                   C      stpstk	equ	@dsad
                         C       ENDIF
  F0B5                   C      @dsad	aset	@dsad+2*12	;Stack fuer Interrupt-Routinen
  F0B5                   C      intstk	equ	@dsad
                         C      
                         C      ;=============Disketten-Arbeit============
                         C      
  F0B5                   C      dirbuf	equ	@dsad	;Directory-Puffer fuer alle Laufwerke
  F135                   C      @dsad	aset	@dsad+128
                         C      	IRP	di,<A,B,C,D>
                         C       IF disk&di
                         C      alv&di	equ	@dsad		;;Allocation-Vector Disk.
                         C      	IF	((disk&di mod 1000)/100) eq 5	;;5" 
                         C      	if	((disk&di mod 10000)/1000)	;;DS
                         C      @dsad	aset	@dsad+(400+7)/8 ;;reicht fuer 400k (1K Bloecke)
                         C      				;;	bzw. 800K (2K Bloecke)
                         C      	else					;;SS
                         C      @dsad	aset	@dsad+(200+7)/8 ;;reicht fuer 200k (1K Bloecke)
                         C      				;;	bzw. 400K (2K Bloecke)
                         C      	endif
                         C      	ELSE					;;8" 
                         C      	if	(disk&di ge 10000)		;;MFM
                         C      @dsad	aset	@dsad+(352+7)/8 ;;reicht fuer 704 2K Bloecke
                         C      	else					;;FM
                         C      @dsad	aset	@dsad+(250+7)/8 ;;reicht fuer 250K (1K Bloecke)
                         C      				;;	bzw. 500K (2K-Bloecke)
                         C      	endif
                         C      	ENDIF
                         C      csv&di	equ	@dsad		;;Check Sum
                         C      	IF	(disk&di mod 100) gt 40 ;;8",77 oder 5",80 Track
                         C      	if	((disk&di mod 10000)/1000)	;;DS
                         C      @dsad	aset	@dsad+256/4	;;reicht fuer 256 Dir.eintraege
                         C      	else					;;SS
                         C      @dsad	aset	@dsad+128/4	;;reicht fuer 128 Dir.eintraege
                         C      	endif
                         C      	ELSE				;;5" 40 Track
                         C      	if	((disk&di mod 10000)/1000)	;;DS
                         C      @dsad	aset	@dsad+128/4	;;reicht fuer 128 Dir.eintraege
                         C      	else
                         C      @dsad	aset	@dsad+64/4	;;reicht fuer 64 Dir.eintraege
                         C      	endif
                         C      	ENDIF
                         C       ENDIF
                         C      	ENDM
                         C      
                         C      	if	oss
  F209                   C      alvoss	equ	@dsad		;Allocation Vector RAM-Floppy
  F20F                   C      @dsad	aset	@dsad+(48+7)/8	;reicht fuer 48K (1K Bloecke)
                         C      ; kein checksum vektor, da nicht wechselbar
  F20F                   C      ossbf1	equ	@dsad		;Rettungsfeld fuer 'ossbuf'
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-112


  F28F                   C      @dsad	aset	@dsad+128
                         C      	endif
                         C      
                         C      
                         C      	IF	em256
                         C      	ENDIF
                         C      
                         C      	IF	mkd256
                         C      	ENDIF
                         C      
                         C       IF raf
                         C       ENDIF
                         C      
                         C       IF rna
                         C       ENDIF
                         C      
