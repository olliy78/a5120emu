  D2F5    C5             C      kbdwa:	push	bc
  D2F6    06 01          C      	ld	b,1		;0,01 sec warten
  D2F8    CD E763        C      	call	wait10
  D2FB    C1             C      	pop	bc
  D2FC    CD D333        C      kbdwst:	call	kbdst1		;taste neu gedrueckt?
  D2FF    20 13          C      	jr	nz,kbdwb	;ja, abholen ueber kbdst
  D301    DB 06          C      	in	a,(kbdpci)	;taste noch gedrueckt?
  D303    B7             C      	or	a		;(funktioniert nur bei K760X!)
  D304    28 0E          C      	jr	z,kbdwb		;nein; warten
