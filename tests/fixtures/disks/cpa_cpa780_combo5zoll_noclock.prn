  DDD9    F1             C      	pop	af		;Puffernr. in Spur wegschm.
  DDDA    F1             C      	pop	af		;128-er Index im Puffer
  DDDB    F5             C      	push	af
  DDDC    1F             C      	rra			;Sektornb*128 berechnen
  DDDD    47             C      	ld	b,a
  DDDE    0E 00          C      	ld	c,0
  DDE0    CB 19          C      	rr	c
  DDE2    21 F28F        C      	ld	hl,dbuf
  DDE5    09             C      	add	hl,bc		;Adresse im Puffer
  DDE6    ED 5B E002     C      	ld	de,(ddma)	;Nutzer-DMA
  DDEA    3A DFFB        C      	ld	a,(dflg)
  DDED    CB 57          C      	bit	dfwr,a		;Schreiben?
  DDEF    28 09          C      	jr	z,dsmove	;nein
  DDF1    3A DFF2        C      	ld	a,(dbflg)
  DDF4    CB D7          C      	set	dfbwr,a		;anzeigen Puffer beschrieben
