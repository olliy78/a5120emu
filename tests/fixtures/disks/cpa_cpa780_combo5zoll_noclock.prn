  D71A    E5             C      crthrd:	push	hl
  D71B    21 FC00        C      	ld	hl,bsanf1
  D71C                   C      crtm22	equ	$-2
  D71E    0E 11          C      	ld	c,bszl1+1
  D71F                   C      crtm23	equ	$-1
  D720    18 30          C      	jr	crthd3		;zu Beginn neue Zeile
  D722    06 40          C      crthd1:	ld	b,bssp1
  D723                   C      crtm24	equ	$-1
  D724    C5             C      crthd2:	push	bc
                         C      	setbs
  D725    7E             C      	ld	a,(hl)
                         C      	setram
  D726    23             C      	inc	hl
  D727    E5             C      	push	hl
  D728    E6 7F          C      	and	7fh
  D72A    FE 20          C      	cp	20h		;BS-Steuerzeichen?
  D72C    30 1C          C      	jr	nc,crthd4	;nein
                         C       IF umlaut
  D72E    21 D13D        C      	ld	hl,synflg	;Schalterbyte 
  D731    CB 56          C      	bit	umlflg,(hl)	;Umlaute anzeigen ?
  D733    28 13          C      	jr	z,cnuml1	;nein!
  D735    21 D78B        C      	ld	hl,umltb2	;Umlautcodierung ?
  D738    01 000B        C      	ld	bc,umllen
  D73B    ED B1          C      	cpir
  D73D    20 09          C      	jr	nz,cnuml1	;nein !
  D73F    01 000C        C      	ld	bc,umllen+1	;sonst rueckkodieren
  D742    B7             C      	or	a
  D743    ED 42          C      	sbc	hl,bc
  D745    7E             C      	ld	a,(hl)		;rueckkodiertes Zeichen
  D746    18 02          C      	jr	crthd4
  D748                   C      cnuml1:
                         C       ENDIF
  D748    3E 5E          C      	ld	a,'^'		;sonst Sonderzeichen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-43


  D74A    4F             C      crthd4:	ld	c,a
  D74B    CD D10F        C      	call	BIOS0F		;LIST
  D74E    E1             C      	pop	hl
  D74F    C1             C      	pop	bc
  D750    10 D2          C      	djnz	crthd2		;bis Zeilenende
  D752    C5             C      crthd3:	push	bc
  D753    E5             C      	push	hl
  D754    0E 0D          C      	ld	c,0dh
  D756    CD D10F        C      	call	BIOS0F
  D759    0E 0A          C      	ld	c,0ah
  D75B    CD D10F        C      	call	BIOS0F
  D75E    E1             C      	pop	hl
  D75F    C1             C      	pop	bc
  D760    0D             C      	dec	c		;Bildschirmende?
  D761    20 BF          C      	jr	nz,crthd1	;nein
  D763    E1             C      	pop	hl
  D764    C9             C      	ret
                         C       ENDIF
                         C       ENDIF	;stpvar
                         C      
                         C       IF umlaut
                         C      ; Umlaute umcodieren fuer Anzeige auf BAB1/BAB2 (Sonder-PROM)
  D765                   C      crtuml:	
  D765    E5             C      	push 	hl		;retten wegen evtl. ext. Verwendung
  D766    C5             C      	push 	bc
  D767    21 D13D        C      	ld	hl,synflg	;Schalterbyte
  D76A    CB 56          C      	bit	umlflg,(hl)	;Umlaute anzeigen ?
  D76C    28 0F          C      	jr	z,umlcn1	;nein !
  D76E    21 D780        C      	ld 	hl,umltb1
  D771    01 000B        C      	ld 	bc,umllen
  D774    ED B1          C      	cpir			;in Tabelle suchen
  D776    20 05          C      	jr	nz,umlcn1	;nicht gefunden
  D778    01 000A        C      	ld	bc,umllen-1	;wegen cpir
  D77B    09             C      	add 	hl,bc
  D77C    7E             C      	ld	a,(hl)		;umcodieren
  D77D    C1             C      umlcn1:	pop	bc
  D77E    E1             C      	pop	hl
  D77F    C9             C      	ret
                         C      
                         C      ;------------------------------
                         C      ; Umcodiertabelle fuer Umlautumcodierung
                         C       IF zsuml ;auf freie 7023/24-Steuerzeichen (IH Mittweida, Koll. Geiler)
                         C      ;		Ae  Oe  Ue  ae  oe  ue  sz  **2 **3 Par my
  D780    5B 5C 5D 7B    C      umltb1:db	5bh,5ch,5dh,7bh,7ch,7dh,7eh,3ch,3eh,40h,5eh
  D784    7C 7D 7E 3C    C      
  D788    3E 40 5E       C      
  D78B    15 16 17 1C    C      umltb2:db	15h,16h,17h,1ch,1dh,1eh,1fh,10h,12h,14h,18h
  D78F    1D 1E 1F 10    C      
  D793    12 14 18       C      
  000B                   C      umllen	equ	umltb2-umltb1
                         C       ENDIF
                         C       IF zsibm ;auf 00..1f erweiterter IBM-Zeichensatz
                         C       ENDIF	
                         C       ENDIF	
