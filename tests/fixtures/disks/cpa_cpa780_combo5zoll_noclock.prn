                                  IF cdtdc1 or cdtdtr
                         C      	include BIOSCSIO
                         C      ;===================================================================
                         C      ; SIO-Treiber, DTR- und DC1/DC3-Protokoll
                         C      ;===================================================================
                         C      ;
                         C      ; Aenderungen:
                         C      ; - Statusabfrage jedesmal, auch wenn zuvor frei gemeldet
                         C      ; - Pufferueberlauf bei UC1-Puffer kontrolliert
                         C      ; - bei DC1/DC3 nach Initialisierung 7fh an Drucker und max. 30 sec auf
                         C      ;  Antwort gewartet (sonst Fehler am SD1157, wenn zu frueh gesendet wird)
                         C      ; 29.6.88:
                         C      ; - bei DC1/3 Protokoll wird neu initialisiert, wenn DC4 vom Drucker kommt
                         C      ;  (Probleme bei K6314)
                         C      ; 20.09.88
                         C      ; - Neben DTR-Statusabfrage ueber Kanal B, Bit 3 (Treiber 1, Standard)
                         C      ;  auch DTR-Statusabfrage ueber Kanal A, Bit 5 (Treiber 3) unterstuetzt
                         C      ; 23.03.89
                         C      ; - CTS-Zusammenspiel bei K6311 u.ae. funktioniert nur, wenn bis zum
                         C      ;   Verlassen aller Bits aus dem Sender gewartet wird und nicht nur auf
                         C      ;   das Freiwerden des Sendepuffers - sonst Zeichenverlust!
                         C      ; - wenn UC1 am Kanal A wird WR1 Bit2 und WR2 im Kanal B gesetzt
                         C       IF cpu eq c1715
                         C       ENDIF
                         C      ; 04.04.89
                         C      ; - nach Drucker-Init 'set 0,(ix+ltpst)' statt 'ld (ix+ltpst),11h'
                         C      ; 06.07.89
                         C      ; - wegen K6314-Problemen wird nach Initialisierung DC1 angenommen
                         C      ; - bei UC1-Kopplung ueber DTR ohne Warten auf Senderegister leer,
                         C      ;   nur Warten auf Sendepuffer leer
                         C      ;   (Aenderung 23.03.89 daher nur fuer Drucker wirksam, sonst zu langsam)
                         C      ; 15.09.89
                         C      ; - bei UC1-Kopplung ueber DC1/DC3 nicht 7fh zu Beginn gesendet, sondern DC1
                         C      ;**************************************************************************
                         C      
  D22F                   C      cdsioi	equ	dumi		;keine Zeicheneingabe unterstuetzt
                         C      
                         C      ; Einzelzeichenausgabe Reg. A
  D8D4    DD 4E 02       C      cdsioo:	ld	c,(ix+ltpsd)	;Datenport
  D8D7    ED 79          C      	out	(c),a
  D8D9    C9             C      	ret
                         C      
                         C      ;------------------------------------
                         C      
                         C      ; Statusabfrage
  D8DA    DD 7E 00       C      cdsios:	ld	a,(ix+ltpst)	;Status
  D8DD    CB 4F          C      	bit	1,a		;senderseitig blockiert?
  D8DF    20 3F          C      	jr	nz,lstsr	;ja, frei rueckmelden
  D8E1    B7             C      	or	a		;initialisiert?
  D8E2    CC D947        C      	call	z,cdsins	;nein
  D8E5    DD CB 0A 7E    C      	bit	7,(ix+ltpw5)	;Prozedur DTR?
  D8E9    28 3A          C      	JR	Z,lstsdc	;nein
  D8EB    DD 4E 03       C      	ld	c,(ix+ltpsc)	;SIO Kommando
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-55


                         C       IF iobuc1
  D8EE    DD CB 01 7E    C      	bit	7,(ix+ltpdc)	;Warten auf Senderegister leer?
  D8F2    28 0C          C      	jr	z,lstse0	;ja
  D8F4    3E 10          C      	ld	a,00010000b	;Reset Ext/Status-Interrupt, Lesereg. 0
  D8F6    ED 79          C      	out	(c),a		;Status abspeichern
  D8F8    ED 78          C      	in	a,(c)		;Lesereg. 0
  D8FA    CB 57          C      	bit	2,a		;Sendepuffer leer?
  D8FC    20 0C          C      	jr	nz,lstse1	;ja
  D8FE    18 20          C      	jr	lstsr		;nein, Drucker besetzt
  D900                   C      lstse0:
                         C       ENDIF
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  D900    3E 11          C      	LD	a,00010001b	;Reset Ext/Status-Interrupt, Lesereg. 1
  D902    ED 79          C      	OUT	(C),a		;Status abspeichern
  D904    ED 78          C      	IN	a,(C)		;Leseregister 1
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  D906    CB 47          C      	bit	0,a		;alle Bits gesendet?
                         C      				; Sendepuffer frei reicht nicht, da
                         C      				; K6311 u.ae. nicht korrekt arbeiten
  D908    28 16          C      	jr	z,lstsr		;nein, Drucker besetzt
  D90A    DD CB 01 5E    C      lstse1:	bit	3,(ix+ltpdc)	;Abfrage DTR ueber DCD im Kanal B?
  D90E    20 06          C      	jr	nz,lstsb3	;ja
  D910    ED 78          C      	in	a,(c)		;Leseregister 0
  D912    CB 6F          C      	bit	5,a		;CTS?
  D914    18 0A          C      	jr	lstsr		;nz bei ja
  D916    0C             C      lstsb3:	inc	c
  D917    0C             C      	inc	c		;auf Kanal B
  D918    3E 10          C      	LD	a,00010000b	;Reset Ext/Status-Interrupt, Lesereg. 0
  D91A    ED 79          C      	out	(c),a		;DCD in RR0 Kanal B abspeichern
  D91C    ED 78          C      	in	a,(c)		;Leseregister 0 des Kanal B
  D91E    CB 5F          C      	bit	3,a		;DCD im Kanal B (ist DTR-Bit vom Kanal A)
                         C      ; Ausgang Senderstatus
  D920                   C      lstsr:
  D920    3E FF          C      lstsr1:	ld	a,0ffh
  D922    C0             C      	ret	nz		;senderseitig frei
  D923    3C             C      	inc	a		;A=00, ret z
  D924    C9             C      	RET			;senderseitig besetzt
                         C      ;-----------------------
                         C      ; DC1/DC3 und XON/XOFF
  D925    DD 4E 02       C      lstsdc:	LD	C,(ix+ltpsd)	;SIO Daten
  D928    ED 78          C      	IN	A,(C)		;Status lesen (SIO speichert letzten Status)
  D92A    DD 77 01       C      	LD	(ix+ltpdc),A	;zuletzt empf. Zeichen fuer Fehlersuche merken
  D92D    E6 7F          C      	and	7fh		;evtl. Paritaet ignorieren
  D92F    FE 13          C      	cp	13h		;DC3?
  D931    28 12          C      	jr	z,lstsd2	;ja, besetzt
  D933    FE 14          C      	cp	14h		;DC4 (Status)?
  D935    20 05          C      	jr	nz,lstsd1	;nein (DC1 angenommen)
  D937    CD D97B        C      	call	cdsini		;statt Status abzuholen neu initialisieren
  D93A    18 E9          C      	jr	lstsdc		;und Status neu abfragen
  D93C    DD 4E 03       C      lstsd1:	ld	c,(ix+ltpsc)	;SIO Kommando
  D93F    ED 78          C      	in	a,(c)
  D941    CB 57          C      	bit	2,a		;Sendepuffer leer? (nz bei ja)
  D943    18 DB          C      	jr	lstsr
  D945    AF             C      lstsd2:	xor	a		;A=00, ret z
  D946    C9             C      	ret			;senderseitig besetzt
                         C      
                         C      ;-----------------------
                         C      
                         C      ; (Re-)Initialisierung
                         C      ; IX auf Steuertabelle
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-56


                         C      ; ret: C zeigt auf Kommandoport
                         C      
                         C      ; Sender initialisieren
  D947                   C      cdsins:
  D947    DD CB 00 C6    C      	set	0,(ix+ltpst)	;Sender ist initialisiert
  D94B    CD D97B        C      	call	cdsini
  D94E    DD CB 0A 7E    C      	bit	7,(ix+ltpw5)	;Prozedur DC1/DC3?
  D952    C0             C      	ret	nz		;nein
  D953    41             C      	ld	b,c
  D954    DD 4E 02       C      	ld	c,(ix+ltpsd)	;Datenport
                         C       IF iobuc1
  D957    DD CB 01 7E    C       	bit	7,(ix+ltpdc)	;Warten auf Senderegister leer?
  D95B    28 06          C      	jr	z,cdsind	;ja, Drucker
  D95D    3E 11          C      	ld	a,11h		;bei UC1: mit DC1/DC3-Protokoll DC1 senden
  D95F    ED 79          C      	out	(c),a
  D961    48             C      	ld	c,b
  D962    C9             C      	ret
                         C       ENDIF
  D963    3E 7F          C      cdsind:	ld	a,7fh		;nach Initialisierung RESET senden
  D965    ED 79          C      	out	(c),a
  D967    48             C      	ld	c,b
  D968    11 0BB8        C      	ld	de,30*100	;max. Wartezeit ca. 30 sec (SD1157!)
  D96B    ED 78          C      cdsinw:	in	a,(c)
  D96D    CB 47          C      	bit	0,a		;Antwort da?
  D96F    C0             C      	ret	nz		;ja
  D970    06 01          C      	ld	b,1
  D972    CD E763        C      	call	wait10		;10ms warten
  D975    1B             C      	dec	de
  D976    7A             C      	ld	a,d
  D977    B3             C      	or	e		;max. Wartezeit abgelaufen?
  D978    20 F1          C      	jr	nz,cdsinw	;nein
  D97A    C9             C      	ret			;sonst Drucker wohl nicht bereit
                         C      
                         C      
                         C      ; gem. UP fuer Sender und Empf. initialisieren
  D97B                   C      cdsini:
  D97B    DD E5          C      	push	ix
  D97D    E1             C      	pop	hl
  D97E    01 000B        C      	ld	bc,ltpini
  D981    09             C      	add	hl,bc
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  D982    CD D873        C      	call	portpr		;CTC, WR0, WR4, WR1, WR3
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  D985    DD 5E 0A       C      ltpow5:	LD	e,(ix+ltpw5)	;Prozedurtyp/Bitanzahl
                         C      ; Stellen Schreibregister 5
                         C      ; Reg. B,HL bleiben erhalten
  D988    3E 05          C      ltpot5:	ld	a,5
  D98A    DD 4E 03       C      	ld	c,(ix+ltpsc)
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  D98D    ED 79          C      	OUT	(C),A
  D98F    ED 59          C      	OUT	(C),e
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  D991    C9             C      	RET
                         C      
                         C      ;-------------------------------------
                         C       if iobuc1
                         C      
                         C      ; UC1-Routinen (ausser Senden)
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-57


                         C      
                         C      ; UC1: Empf.-Status
                         C      ;==================
                         C      ; o A=0, ret z	: kein Zeichen empfangen
                         C      ; o A=ff,ret nz	: Zeichen da
  D992    DD 21 D8B7     C      uc1st:	ld	ix,lstuc1	;Stellen IX auf Steuertabelle
  D996                   C      uc1si:	;interner Aufruf mit gestelltem IX
  D996    DD CB 00 66    C      	bit	4,(ix+ltpst)	;initialisiert?
  D99A    20 19          C      	jr	nz,uc1si1	;ja
  D99C    AF             C      	xor	a
  D99D    32 DA63        C      	ld	(uc1bfp),a	;Puffer leeren
  D9A0    CD D97B        C      	call	cdsini		;Initialisierung
  D9A3    DD CB 00 E6    C      	set	4,(ix+ltpst)	;Empfaenger ist initialisiert
  D9A7    F3             C      	di
                         C       IF (uc1dat xor uc1sta) eq 01b	;Kanal-Nr ist Bit 1 (bei Buerocomp und OEM)
                         C        IF (uc1sta and 10b) eq 00b	;UC1 ist an Kanal A
  D9A8    CB C9          C      	set	1,c		;Kanal B erzwingen
                         C        ENDIF
                         C       ENDIF
  D9AA    21 D9BD        C      	ld	hl,uc1i2	;WR1,WR2 programmieren
  D9AD    06 04          C       	ld	b,uc1il
  D9AF    ED B3          C      	otir
  D9B1    FB             C      	ei
  D9B2    CD D9EC        C      	call	uc1ird		;DTR bzw. DC1 senden
  D9B5    3A DA63        C      uc1si1:	ld	a,(uc1bfp)	;Zeichen im Empfpuffer?
  D9B8    B7             C      	or	a
  D9B9    C8             C      	ret	z		;nein
  D9BA    3E FF          C      	ld	a,0ffh
  D9BC    C9             C      	ret
                         C      
  D9BD                   C      uc1i2: ;zusaetzliche Initialisierung fuer WR1/Bit2 und WR2 (beide nur Kanal B)
                         C       IF (uc1dat xor uc1sta) eq 01b	;Kanal-Nr ist Bit 1 (bei Buerocomp und OEM)
                         C        IF (uc1sta and 10b) eq 00b	;UC1 ist an Kanal A
  D9BD    01 04          C      	db	1,00000100b	;WR1, Kanal B: Intv.modif. setzen
                         C        ENDIF
                         C       ENDIF
  D9BF    02 D0          C      	db	2,ivsio0	;WR2, Kanal B: Interruptvektor
  0004                   C      uc1il	equ	$-uc1i2
                         C      ; UC1: empf. Zeichen an Nutzer
                         C      ;=============================
                         C      ; o A:	aeltestes empf. Zeichen
                         C      
  D9C1    DD 21 D8B7     C      uc1i:	ld	ix,lstuc1	;Stellen IX auf Steuertabelle
                         C      
  D9C5                   C      uc1ii:	;interner Aufruf mit gestelltem IX
  D9C5    FB             C      uc1iw:	ei			;UC1:-Interrupt zulassen
  D9C6    CD D996        C      	call	uc1si		;Zeichen da?
  D9C9    28 FA          C      	jr	z,uc1iw		;nein ***keine Zeitueberwachung!***
  D9CB    21 DA63        C      	ld	hl,uc1bfp
  D9CE    F3             C      	di
  D9CF    4E             C      	ld	c,(hl)
  D9D0    35             C      	dec	(hl)		;Pufferlaenge -1
  D9D1    06 00          C      	ld	b,0
  D9D3    23             C      	inc	hl		;^(aeltestes Pufferzeichen)
  D9D4    7E             C      	ld	a,(hl)		;Zeichen nach A
  D9D5    11 DA65        C      	ld	de,uc1buf+1
  D9D8    EB             C      	ex	de,hl
  D9D9    ED B0          C      	ldir			;Puffer aufschieben
  D9DB    FB             C      	ei
  D9DC    DD CB 00 7E    C      	bit	7,(ix+ltpst)	;war Stopaufforderung?
  D9E0    C8             C      	ret	z		;nein
  D9E1    F5             C      	push	af		;retten Zeichen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-58


  D9E2    3A DA63        C      	ld	a,(uc1bfp)	;Pufferbelegung
  D9E5    FE 06          C      	cp	1*uc1bfl/3	;unter dem Limit?
  D9E7    DC D9EC        C      	call	c,uc1ird	;ja, Senden wieder erlauben
  D9EA    F1             C      	pop	af
  D9EB    C9             C      	ret
                         C      
                         C      ; Empfangsbereitschaft anzeigen
  D9EC    DD CB 00 BE    C      uc1ird:	res	7,(ix+ltpst)
  D9F0    DD CB 0A 7E    C      	bit	7,(ix+ltpw5)	;Prozedur DC1/DC3?
  D9F4    C2 D985        C      	jp	nz,ltpow5	;nein, DTR wieder setzen
  D9F7    3E 11          C      	ld	a,11h		;DC1 (Senden wieder erlauben)
  D9F9    DD 4E 02       C      	LD	C,(ix+ltpsd)	;SIO Daten
  D9FC    ED 79          C      	OUT	(C),A
  D9FE    C9             C      	ret
                         C      
                         C      ; UC1: Empf.-Interrupt
                         C      ;=====================
  D9FF    ED 73 E5D7     C      uc1rin:	ld	(intsp),sp
  DA03    31 F0B5        C      	ld	sp,intstk
  DA06    F5             C      	push	af
  DA07    E5             C      	push	hl
  DA08    D5             C      	push	de
  DA09    C5             C      	push	bc
  DA0A    DD E5          C      	push	ix
  DA0C    21 DA2C        C      	ld	hl,uc1rir
  DA0F    E5             C      	push	hl
  DA10    DD 21 D8B7     C      	ld	ix,lstuc1	;Stellen IX auf Steuertabelle
  DA14    DD 4E 02       C      	ld	c,(ix+ltpsd)	;SIO Daten
  DA17    ED 40          C      	in	b,(c)		;Zeichen lesen
  DA19    21 DA63        C      	ld	hl,uc1bfp	;Pufferzeiger zum zuletzt empf. Zeichen
  DA1C    7E             C      	ld	a,(hl)
  DA1D    FE 14          C      	cp	uc1bfl		;Puffer voll?
  DA1F    D0             C      	ret	nc		;ja, Zeichen ignorieren
  DA20    FE 0D          C      	cp	2*uc1bfl/3	;Puffer fast voll (SIO-Empf.puffer 3 Byte!)?
  DA22    D4 DA31        C      	call	nc,uc1ri1	;ja, DC3 senden bzw. DTR wegnehmen
  DA25    34             C      	inc	(hl)		;+1
  DA26    5E             C      	ld	e,(hl)
  DA27    16 00          C      	ld	d,0
  DA29    19             C      	add	hl,de		;naechste freie Stelle
  DA2A    70             C      	ld	(hl),b		;Zeichen in Puffer
  DA2B    C9             C      	ret
  DA2C    DD E1          C      uc1rir:	pop	ix
  DA2E    C3 E5D2        C      	jp	intrbc		;fertig
                         C      
                         C      ; Stopaufforderung senden
                         C      ; B,HL bleibt erhalten
  DA31    DD CB 00 FE    C      uc1ri1:	set	7,(ix+ltpst)	;merken Stopaufforderung
  DA35    DD 5E 0A       C      	ld	e,(ix+ltpw5)
  DA38    CB 7B          C      	bit	7,e		;Prozedur DC1/DC3?
  DA3A    28 05          C      	jr	z,uc1ri2	;ja
  DA3C    CB BB          C      	res	7,e		;DTR loeschen
  DA3E    C3 D988        C      	jp	ltpot5
  DA41    3E 13          C      uc1ri2:	ld	a,13h		;DC3 an Partner (Senden stopppen)
  DA43    DD 4E 02       C      	LD	C,(ix+ltpsd)	;SIO Daten
  DA46    ED 79          C      	OUT	(C),A
  DA48    C9             C      	ret
                         C      
                         C      ; UC1: Interrupt Empf.-Fehler (Parit., Ueberlauf, Rahmenfehler)
                         C      ;============================
  DA49    ED 73 E5D7     C      uc1err:	ld	(intsp),sp
  DA4D    31 F0B5        C      	ld	sp,intstk
  DA50    F5             C      	push	af
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-59


  DA51    E5             C      	push	hl
  DA52    D5             C      	push	de
  DA53    C5             C      	push	bc
  DA54    DD E5          C      	push	ix
  DA56    DD 21 D8B7     C      	ld	ix,lstuc1	;Stellen IX auf Steuertabelle
  DA5A    DD 4E 03       C      	ld	c,(ix+ltpsc)	;SIO Kommando
  DA5D    16 30          C      	ld	d,00110000b	;Reset Fehler-Interrupt
  DA5F    ED 51          C      	out	(c),d
                         C      				;keine Fehlermeldung, da bei
                         C      				;Empf.ueberlauf alles noch
                         C      				;mehr verzoegert wird
  DA61    18 C9          C      	jr	uc1rir
                         C      
                         C      ; UC1: Empfangspuffer
                         C      ;====================
  DA63    00             C      uc1bfp:	db	0
  DA64                   C      uc1buf:	ds	uc1bfl,0
                         C      
                         C       endif	;uc1
                         C      
                                  ENDIF
                                  IF cdtsib
                                  ENDIF
                                  IF cdtpio
                                  ENDIF
                                  IF cdtp54
                                  ENDIF
                                  IF cdth54
                                  ENDIF
                                  IF cdtn56 or cdtp56
                                  ENDIF
                                 ENDIF
                                
                         C      	include BIOSDSK
                         C      
                         C      ;****************************************************
                         C      ;	Diskettentreiber; Umkleidung des phys. Transfers
                         C      ;	Version 04.11.88
                         C      ; Aenderungen:
                         C      ; - Jeder Fehler in Spur 0, Sektor 1 fuehrt zur Annahme von Systemspuren
                         C      ;   (A7100-System mit 5" FM und 8272-Hardware mit 128er Sektorlaenge)
                         C      ; - !!Schnittstelle fuer diskio-Aufruf neu!! (Flags neu, side zusaetzlich)
                         C      ; - Verify nach Schreiben kann laufwerksspezifisch gewaehlt werden
                         C      ; - Laufwerkskapazitaet nach phys. LW-Nr in Statuszeile
                         C      ; - Fehlerkorrektur bei KAYPRO IV fuer C128
                         C      ; 12.06.88
                         C      ; - bei stzaus in synflg keine Pflege der Statuszeile
                         C      ; 06.07.88:
                         C      ; - Spurnummer generell auf 16 bit erweitert
                         C      ; 14.10.88
                         C      ; - Generierung ohne Floppy-Laufwerke moeglich
                         C      ; 26.10.88
                         C      ; - Test der Laufwerksbereitschaft bei Select
                         C      ; 04.11.88
                         C      ; - bei 5" und 512 Sektorlaenge Dir-Groesse 0
                         C      ; 12.03.89
                         C      ; - 'ibmfrm' gestrichen, phys. Formaterkennung fuer SIOS erfolgt immer
                         C      ;****************************************************
                         C      
                         C       if1
                         C       endif
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-60


                         C      ; Laufwerksauswahl
                         C      ;=================
                         C      ; i C: Laufw. (0=A:, 1=B: ...)
                         C      ; i E: Bit 0 ist LOGIN-Bit von BDOS (=0, wenn LOGIN)
                         C      
  DA78    CD E83D        C      seldsk:	call	dgetpb		;HL auf DPH stellen, IX auf DPB
  DA7B    C8             C      	ret	z		;Geraet ex. nicht
  DA7C    79             C      	ld	a,c
  DA7D    32 DFFC        C      	ld	(ddrive),a	;Laufwerk merken
  DA80    CB 43          C      	bit	0,e		;LOGIN von BDOS?
  DA82    C0             C      	ret	nz		;nein
                         C       if ramfl
                         C      ;###RAM-Floppy
  DA83    DD CB 0F 7E    C      	bit	dpbfnd,(ix+dpbflg)	;Diskette?
  DA87    C0             C      	ret	nz		;nein, fertig
                         C      ;####
                         C       endif
  DA88    E5             C      	push	hl		;^DPH merken
                         C      
                         C      	IF	dbufsz gt 7
  DA89    21 DFF3        C      	ld	hl,dbdev
  DA8C    BE             C      	cp	(hl)		;LOGIN fuer gepuffertes Device?
  DA8D    20 07          C      	jr	nz,dselnb	;nein
  DA8F    36 FF          C      	ld	(hl),0ffh	;Puffer ist ungueltig
  DA91    21 DFF2        C      	ld	hl,dbflg
  DA94    CB 96          C      	res	dfbwr,(hl)	;kein veraend. Puffer auszug.!
  DA96                   C      dselnb:
                         C      	ENDIF
                         C      
                         C       IF format
  DA96    DD CB 0F 76    C      	bit	dpbfrm,(ix+dpbflg);Formaterkennung unterdr.?
  DA9A    28 1A          C      	jr	z,drdfrm	;nein
                         C       ENDIF
                         C      
                         C      ; Test der Laufwerks-Bereitschaft; nur dann Select Disk ok
                         C      ;---------------------------------------------------------
  DA9C    32 DFE5        C      	ld	(drddev),a	;log. LW
  DA9F    DD 6E 0D       C      	ld	l,(ix+dpbofs)
  DAA2    DD 66 0E       C      	ld	h,(ix+dpbofs+1)
  DAA5    22 DFE6        C      	ld	(drdtrk),hl	;auf Beginn des Verzeichnisses
  DAA8    21 DFE4        C      	ld	hl,drdcdb	;Positionieren ohne Fehlerbehandlung
  DAAB    CD DE31        C      	call	dsktra
  DAAE    CA DC63        C      	jp	z,selext	;ok
  DAB1    E1             C      	pop	hl		;^DPH wegschmeissen
  DAB2    21 0000        C      	ld	hl,0		;Select Fehler
  DAB5    C9             C      	ret
  DAB6                   C      drdfrm:
                         C      
                         C      	IF	format
                         C      ;++++++++++Automatische Format-Erkennung++++++++++
                         C      ; Reg. C zeigt auf Laufwerk
                         C      
                         C      	IF	dbufsz gt 7
  DAB6    CD DE11        C       	call	dbtrw		;Puffer freimachen
                         C      				;und auf Lesen schalten
  DAB9    21 E009        C      	ld	hl,dbnb
  DABC    36 FF          C      	ld	(hl),0ffh	;Puffernummer ist ungueltig, obwohl evtl.
                         C      				;alle anderen Pufferparameter stimmen
                         C      				;(da nur 128 Bytes vom Puffer belegt sind)
                         C      	ENDIF
                         C      
  DABE    79             C      	ld	a,c
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-61


  DABF    32 DFEC        C      	ld	(dfrmdv),a
  DAC2    32 DFF3        C      	ld	(dbdev),a
                         C      
  DAC5    AF             C      	xor	a
  DAC6    DD 77 0F       C      	ld	(ix+dpbflg),a	;ruecksetzen alle Flags
  DAC9    DD 77 13       C      	ld	(ix+dpbsn0),a	;keine Weiter-Numm. auf Ruecks.
  DACC    DD 77 0D       C      	ld	(ix+dpbofs),a	;keine Systemspuren
                         C      
  DACF    32 DFED        C      	ld	(dfrmtr),a	;Spur 0
  DAD2    32 DFF4        C      	ld	(dbtrk),a
  DAD5    32 DFF5        C      	ld	(dbtrk+1),a
  DAD8    3C             C      	inc	a
  DAD9    32 DFF6        C      	ld	(dbsec),a	;Sektor 1
  DADC    32 DFF8        C      	ld	(dbsnb),a	;1 phys. Sektor lesen
                         C      
                         C      ; Stellen  Sektor-Translate-Tabelle 1,2,3,...
  DADF    DD E5          C      	push	ix
  DAE1    06 1A          C      	ld	b,26		;max. Laenge der Tabelle
                         C       IF dsk8mf
                         C       ENDIF
  DAE3    DD 77 19       C      selstz:	ld	(ix+dpbstr),a
  DAE6    DD 23          C      	inc	ix
  DAE8    3C             C      	inc	a
  DAE9    10 F8          C      	djnz	selstz
  DAEB    DD E1          C      	pop	ix
                         C      
                         C      ; Positionieren auf Spur 0 und analysieren Systemspuren
  DAED    CD DE29        C      	call	dsidtr		;beliebigen Sekt.Id lesen
  DAF0    20 3E          C      	jr	nz,selsys	;Fehler beim Lesen; Systemsp. annehmen
                         C      ;				 (z.B. SCP1700 mit 5"FM in Spur 0!!)
  DAF2    7C             C      	ld	a,h
  DAF3    32 DFF7        C      	ld	(dbslc),a	;setzen Spurformat fuer Sp. 0
                         C      	IF	dbufsz le 7
                         C      	ENDIF
  DAF6    21 DFF2        C      	ld	hl,dbflg
                         C       IF dsk8mf
                         C       ENDIF
  DAF9    46             C      	ld	b,(hl)		;merken Fehlerprotokoll-Bit
  DAFA    CB E6          C      	set	dfbtr,(hl)	;kein Fehlerprotokoll
  DAFC    E5             C      	push	hl
  DAFD    CD DE17        C      	call	dbtran		;Lesen Spur 0, Sektor 1
  DB00    E1             C      	pop	hl
  DB01    70             C      	ld	(hl),b		;setzen Standard fuer Fehlerprotokoll-Bit
  DB02    20 2C          C      	jr	nz,selsys	;Fehler, Systemspuren annehmen
  DB04    FD E5          C      	push	iy
  DB06    FD 2A DFF9     C      	ld	iy,(dbdma)
  DB0A    FD 7E 00       C      	ld	a,(iy+0)	;Format-Loeschbyte
  DB0D    FE E5          C      	cp	0e5h		;leere Diskette/geloeschter Eintrag?
  DB0F    20 0A          C      	jr	nz,selsy2	;nein, weder/noch
  DB11    FD BE 01       C      	cp	(iy+1)		;auch danach 0e5h?
  DB14    20 15          C      	jr	nz,selsy0	;nein, geloeschter Dir-Eintrag
  DB16    DD 35 0D       C      	dec	(ix+dpbofs)	;Flag: leere Disk oder leere Systemsp.
  DB19    18 10          C      	jr	selsy0		;dpbofs auf 254
  DB1B                   C      selsy2:
  DB1B    FE 40          C      	cp	40h		;IBM-Format (SIOS-Daten-Diskette)?
  DB1D    28 0F          C      	jr	z,selsy1	;ja, 0 Systemspuren annehmen
  DB1F    FE 20          C      	cp	20h		;<=31 ? ("S"YL ist groesser!)
  DB21    30 0B          C      	jr	nc,selsy1	;nein, kann kein Directory sein; 0 Systemsp.
                         C      ;Systemlader fuer PC1715 beginnt mit 02 oder 03
  DB23    FD 7E 20       C      	ld	a,(iy+20h)	;bei SCP1715-Systemdiskette dort 00h
                         C      				;bei MicroDos dort 10h
  DB26    FD B6 21       C      	or	(iy+21h)	;bei SCP1715-Systemdiskette dort 00h
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-62


                         C      				;bei CP/A dort Dir-Eintrag (E5 oder Filename)
  DB29    28 03          C      	jr	z,selsy1	;beides 00h, kein Directory; 0 Systemsp.
  DB2B    DD 35 0D       C      selsy0:	dec	(ix+dpbofs)	;=255, wenn Directory; =254 wenn vorn leer
  DB2E                   C      selsy1:
  DB2E    FD E1          C      	pop	iy
  DB30                   C      selsys:
                         C      
                         C      ; Analysieren Datenspur
                         C      
                         C      ; SS/DS-Analyse
  DB30    DD 36 12 02    C      	ld	(ix+dpbstp),2	;Doppel-Step-Impulse
  DB34    3E 03          C      	ld	a,dlgint	;auf LOGIN-Spur
  DB36    CD DE26        C      	call	dsidtt		;belieb. SektId Vorderseite lesen
  DB39    20 2B          C      	jr	nz,seldle	;Fehler, unsicheres Format
  DB3B    54             C      	ld	d,h		;d:=Sektorlcode, e:=Spur
                         C       IF dsk8mf
                         C       ENDIF
                         C       IF dskds
  DB3C    DD CB 18 46    C      	bit	dpbtds,(ix+dpbtyp)	;ist es ein DS-Laufwerk?
  DB40    28 14          C      	jr	z,selss		;nein, SS
  DB42    D5             C      	push	de		;merken Sektorlaengencode und Spur
  DB43    DD CB 0F EE    C      	set	dpbfds,(ix+dpbflg)
  DB47    3E 07          C      	ld	a,1+(dlgint*2)	;Rueckseite der Spur,
                         C      				;ab der Format bei SS konstant
  DB49    CD DE26        C      	call	dsidtt		;beliebigen Sekt.Id Ruecks. lesen
  DB4C    7A             C      	ld	a,d		;merken side Ruecks.
  DB4D    6B             C      	ld	l,e		;h:=Sektorlcode, l:=Spur Rueckseite
  DB4E    D1             C      	pop	de		;wiederherstellen Vorderseite
  DB4F    20 05          C      	jr	nz,selss	;Fehler beim Lesen, SS
  DB51    B7             C      	or	a
  DB52    ED 52          C      	sbc	hl,de		;Vorder- gleich Rueckseite?
  DB54    28 04          C      	jr	z,sel48		;ja; 40 Tr/ 80 Tr unterscheiden
  DB56    DD CB 0F AE    C      selss:	res	dpbfds,(ix+dpbflg)
                         C       ENDIF
                         C      
                         C      ; 40/80 Track Analyse
  DB5A    7B             C      sel48:	ld	a,e		;trk
  DB5B    D6 03          C      	sub	dlgint		;waren 2 Steps richtig? 
  DB5D    28 12          C      	jr	z,seldl1	;ja
  DB5F    DD 35 12       C      	dec	(ix+dpbstp)	;Einzelstep-Impulse
  DB62    D6 03          C      	sub	dlgint		;waere 1 Step richtig?
  DB64    28 0B          C      	jr	z,seldl1	;ja
                         C      				;nein, unsicher
  DB66    DD 36 10 FF    C      seldle:	ld	(ix+dpbslc),0ffh;provozieren 'BAD SECTOR'
  DB6A    21 0000        C      	ld	hl,0		;erzeugen 'SELECT' Error
  DB6D    E3             C      	ex	(sp),hl
  DB6E    C3 DC63        C      	jp	selext
                         C      
                         C      ; DS/SS und 40/80 ist unterschieden, es fehlt Sektorlaenge
  DB71    7A             C      seldl1:	ld	a,d
  DB72    DD 77 10       C      	ld	(ix+dpbslc),a	;definieren Sektorlaengencode
                         C       IF	dbufsz le 7
                         C       ELSE
                         C      	IF	dbufsz lt 10	;Test, ob Disk-Puffer ausreicht
                         C      	ENDIF
  DB75    B7             C      	or	a		;Sektorlaenge 128?
  DB76    20 0F          C      	jr	nz,seldxl	;nein, normale Sektorfolge
                         C       ENDIF	;dbufsz gt 7
                         C       IF dsk8mf
                         C       ENDIF
  DB78                   C      seldsv:
                         C      ; Stellen Sektor-Translate-Tabelle 1,7,13,..
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-63


  DB78    DD E5          C      	push	ix
  DB7A    E1             C      	pop	hl
  DB7B    01 0019        C      	ld	bc,dpbstr
  DB7E    09             C      	add	hl,bc
  DB7F    EB             C      	ex	de,hl
  DB80    21 DFB5        C      	ld	hl,xlt
  DB83    0E 1A          C      	ld	c,26
  DB85    ED B0          C      	ldir
  DB87                   C      seldxl:
                         C      
  DB87    CD DF48        C      	call	dtrsla		;stellen hl entspr. Sektorlaenge
  DB8A    20 DA          C      	jr	nz,seldle	;unzulaessig
  DB8C    01 0005        C      	ld	bc,dsll		;Laenge eines Eintrags
                         C       IF disk8
                         C       ENDIF
  DB8F    DD CB 12 4E    C      	bit	1,(ix+dpbstp)	;40 Tr. auf 80er LW?
  DB93    20 08          C      	jr	nz,seld40	;ja
  DB95    DD 7E 16       C      	ld	a,(ix+dpbptr)	;40er LW?
  DB98    FE 29          C      	cp	40+1
  DB9A    38 01          C      	jr	c,seld40	;ja, 40 Tr. auf 40er LW
  DB9C    09             C      	add	hl,bc		;auf 80er Format stellen
  DB9D    DD CB 0F 6E    C      seld40:	bit	dpbfds,(ix+dpbflg)	;DS?
  DBA1    28 02          C      	jr	z,seldss	;nein
  DBA3    09             C      	add	hl,bc		;auf DS Format
  DBA4    09             C      	add	hl,bc
  DBA5                   C      seldss:
  DBA5                   C      selset:
                         C      ; DPB modifizieren entsprechend erkanntem Format
  DBA5    4E             C      	ld	c,(hl)		;Zahl der benutzten Spuren
  DBA6    DD 71 14       C      	ld	(ix+dpbtrk),c
  DBA9    23             C      	inc	hl
  DBAA    4E             C      	ld	c,(hl)		;Anzahl 128er Sektoren pro Spur
  DBAB    DD 71 00       C      	ld	(ix+dpbspt),c
  DBAE    23             C      	inc	hl
  DBAF    4E             C      	ld	c,(hl)		;Anzahl der Dir-Eintraege -1
  DBB0    23             C      	inc	hl
  DBB1    7E             C      	ld	a,(hl)		;Anzahl der Systemspuren
  DBB2    CB 3F          C      	srl	a		;feste Anzahl erzwungen?
  DBB4    38 28          C      	jr	c,seldof	;ja
  DBB6    DD CB 0D 7E    C      	bit	7,(ix+dpbofs)	;kann Spur 0 Directory sein?
  DBBA    28 22          C      	jr	z,seldof	;nein, Standardanzahl setzen
  DBBC    DD 34 0D       C      	inc	(ix+dpbofs)	;evtl. leere Systemspur?
  DBBF    28 1C          C      	jr	z,seldo0	;nein, 0 Systemspuren
  DBC1    47             C      	ld	b,a		;retten Anzahl Systemspuren
  DBC2    32 DFF4        C      	ld	(dbtrk),a	;einlesen evtl. moeglicher Datenbeginn
  DBC5    E5             C      	push	hl
  DBC6    CD DE17        C      	call	dbtran		; dauert bei falscher Spur etwas laenger
  DBC9    E1             C      	pop	hl
  DBCA    78             C      	ld	a,b
  DBCB    20 11          C      	jr	nz,seldof	;Fehler, mit Systemspuren annehmen
  DBCD    FD E5          C      	push	iy
  DBCF    FD 2A DFF9     C      	ld	iy,(dbdma)
  DBD3    FD 7E 0E       C      	ld	a,(iy+14)	;falls dort Dir, so Byte 14 von Dir =0
  DBD6    FE E5          C      	cp	0e5h		;Daten auch leer?
  DBD8    FD E1          C      	pop	iy
  DBDA    78             C      	ld	a,b
  DBDB    20 01          C      	jr	nz,seldof	;nein, vorn liegen nichtbelegte Systemspuren
  DBDD    AF             C      seldo0:	xor	a		;sonst ohne Systemspuren
  DBDE    DD 77 0D       C      seldof:	ld	(ix+dpbofs),a
  DBE1    B7             C      	or	a		;0 Systemspuren?
  DBE2    28 07          C      	jr	z,selddr	;ja
  DBE4    79             C      	ld	a,c		;Anzahl Dir-Eintraege -1
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-64


  DBE5    FE BF          C      	cp	192-1		;>=192 Dir-Eintraege ?
  DBE7    38 02          C      	jr	c,selddr	;nein
  DBE9    0E 7F          C      	ld	c,128-1		;780k hat 128 Dir-Eintraege
  DBEB    DD 71 07       C      selddr:	ld	(ix+dpbdir),c
  DBEE    23             C      	inc	hl
  DBEF    4E             C      	ld	c,(hl)		;Abstand der Blockgroessentab.
  DBF0    06 00          C      	ld	b,0
