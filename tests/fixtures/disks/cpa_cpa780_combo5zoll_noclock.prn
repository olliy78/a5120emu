                                ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                                ;	Beginn BIOS-Treiber
                                ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                                
                                ; Dummy-Treiber
  D22C                          dumst:
  D22C    AF                    	xor	a
  D22D    3D                    	dec	a		;Status immer FF (bereit)
                                 IF iobvar
                                 ENDIF
  D22E    C9                    	ret			;Status immer FF (bereit)
                                
                                 IF iobvar
  D22F    3E 1A                 dumi:	ld	a,1ah		;Eingabe-Zeichen immer EOF
  D231    C9                    	ret
  D232    79                    dumo:	ld	a,c
  D233    11 D23F               	ld	de,dumoh
  D236    CD E772               	call	mrecoa		;Zeichen hex aufbereiten
  D239    0E 28                 	ld	c,'('
  D23B    CD D554               	call	crto
  D23E    01 0000               	ld	bc,0
  D23F                          dumoh	equ	$-2
  D241    C5                    	push	bc
  D242    CD D554               	call	crto
  D245    C1                    	pop	bc
  D246    48                    	ld	c,b
  D247    CD D554               	call	crto
  D24A    0E 29                 	ld	c,')'
  D24C    C3 D554               	jp	crto
                                 ENDIF
                                
                         C      	include BIOSKBD
                         C      ;****************************************************
                         C      ;	Tastatur-Eingabe
                         C      ; - Unterstuetzung weiterer Steckplaetze fuer IFSS-Tastatur
                         C      ;   (z.B. Digitalisier-AP)
                         C      ; - freie Belegbarkeit Kursor- und rechter Ziffernblock
                         C      ; 17.07.88
                         C      ; - uebersichtlichere Darstellung phys. -> virtueller Tastencode
                         C      ; 24.09.88
                         C      ; - Anpassung Tastaturpuffer in Statuszeile an umschaltbaren Bildschirmpuffer
                         C      ; 25.09.88
                         C      ; - Fehler in Stop-Tasten-Behandlung korrigiert
                         C      ; 07.11.88
                         C      ; - Erweiterung des virtuellen Tastaturcodes um K7634-spezifische Tasten
                         C      ; 23.12.88
                         C      ; - saemtliche Sondertasten c0..ff liefern mit Control oder Shift einen
                         C      ;   virtuellen Zwischencode 80..bf
                         C      ; 14.01.89
                         C      ; - Variante K7633 (kbdotp eq 3) eingefuehrt
                         C      ; - wenn Tastatur nach RESET gross schreibt, so caps-lock-Test invertiert
                         C      ; 20.01.89
                         C      ; - Abtesten auf ^Q-Prefix ueber virtuellen Tastencode
                         C      ; 22.03.89
                         C      ; - Control-Flag gilt genau fuer das naechste Zeichen
                         C      ; 31.03.89
                         C      ; - Sondertasten >=80h ignoriert, wenn nicht in Tastatur-Tabelle
                         C      ; 25.09.89
                         C      ; - Fehlerkorrektur K7637: CTRL-Ersatztaste brachte kein ^Q-Prefix
                         C      ;****************************************************
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-24


                         C      
                         C       if1
                         C       endif	;if1
                         C      
                         C      ; Tastatur-Status
                         C      ;================
  D24F                   C      kbdst:
                         C      ; vor Pufferabfrage anstehende Zeichen lesen (falls 5ms Takt aus)
  D24F    F3             C      	di			;parallele Abfrage ueber 5ms verhindern
                         C       IF cpastz
                         C       ENDIF
  D250    CD D257        C      	call	kbdsti		;interner Aufruf
  D253    FB             C      	ei
                         C       IF stpvar or monitor
  D254    C3 E6AA        C      	jp	chksp		;Test auf Spezialfunktionen
                         C       ENDIF
                         C      
  D257                   C      kbdsti:				;kbdst-Aufruf intern
  D257    CD D333        C      kbdstz:	call	kbdst1		;Taste neu gedrueckt ?
  D25A    28 05          C      	jr	z,kbdsnt	;nein
  D25C    CD D268        C      	call	kbdrdt		;Taste in Puffer ablegen
                         C       IF stpvar
                         C       ENDIF
  D25F    18 F6          C      	jr	kbdstz		;auf neuen Tastendruck testen
                         C      
  D261    3E 00          C      kbdsnt:	ld	a,0		;erstes Pufferzeichen
  D262                   C      kbdbfe	equ	$-1
  D263    B7             C      	or	a		;Puffer leer?
  D264    C8             C      	ret	z		;ja
  D265    3E FF          C      	ld	a,0ffh
  D267    C9             C      	ret
                         C      
                         C      ;------------------------------------------------------------
                         C      
                         C      
                         C      ; Taste umkodieren und im Puffer ablegen
                         C      ;=======================================
                         C      ; Achtung!! Dieses UP wird aus Interruptroutine aufgmrufen
  D268    CD D353        C      kbdrdt:	call	kbdrch		;Zeichen evtl. umkodieren
  D26B    21 D13D        C      	ld	hl,synflg
                         C      
  D26E    FE DF          C      	cp	ctlc		;Ersatz-Control-Taste ?
  D270    20 05          C      	jr	nz,kbdnct	;nein
  D272    7E             C      	ld	a,(hl)
  D273    EE 01          C      	xor	1 shl ctrlst	;CTRL-Status umkehren
  D275    77             C      	ld	(hl),a
  D276    C9             C      	ret			;und Zeichen ignorieren
  D277                   C      kbdnct:
                         C      
                         C       IF stpvar
  D277    CB 7E          C      	bit	phyact,(hl)	;Taste physisch in Puffer?
  D279    C2 D2C2        C      	jp	nz,kbdput	;ja, direkt ablegen
                         C       ENDIF
                         C       IF costu
                         C       ENDIF
  D27C    2A D13B        C      	ld	hl,(kbdsst)	;Adresse der Standardstringtabelle
  D27F    CD D399        C      	call	costr		;Standardstring?
  D282    28 07          C      	jr	z,kbdnco	;nein
  D284    1D             C      kbdco:	dec	e		;String der Laenge 0?
  D285    C8             C      	ret	z		;ja, zu ignorierende Taste
  D286    1D             C      	dec	e		;String exakt ein Zeichen lang?
  D287    C2 D2D9        C      	jp	nz,kbdco1	;nein, kann keine Sondertaste sein
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-25


  D28A    7E             C      	ld	a,(hl)		;holen erstes Stringzeichen
  D28B    21 D13D        C      kbdnco:	ld	hl,synflg
                         C      
                         C      ; Auswertung Sondertasten, die nicht im Puffer abgelegt werden
                         C      ;-------------------------------------------------------------
                         C      
  D28E    FE DE          C      	cp	stpc		;STOP ?
  D290    20 0A          C      	jr	nz,kbdnst
  D292    CB E6          C      	set	stoprq,(hl)	;Stop-Request vermerken
                         C      
                         C      ; Rest des Konsolpuffers streichen
                         C      ;---------------------------------
  D294    AF             C      kbdbcl:	xor	a
                         C       IF cpastz
                         C       ENDIF
  D295    32 FFFF        C      	ld	(0ffffh),a
  D296                   C      crtm36	equ	$-2
                         C       IF cpastz
                         C       ENDIF
  D298    32 D262        C      	ld	(kbdbfe),a
  D29B    C9             C      	ret
