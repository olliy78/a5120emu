                         C         endif
                         C        endif
                         C       endif
                         C      
  0000                   C      @dpbhl	aset	0		;;vorbereiten Laufwerkstyp-Flags
                         C      
                         C       if	(diskdi ge 10000)
  0008                   C      @dpbhl	aset	@dpbhl xor (1 shl dpbtdd)	;;double density
                         C       endif
                         C       if	(diskdi mod 1000)/100 eq 5
  0018                   C      @dpbhl	aset	@dpbhl xor (1 shl dpbt5z)	;;5" 
                         C       endif
