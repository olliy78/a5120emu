BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-44


                         C      ; Tabelle der Sonderzeichen, SCP kompatibel!
                         C      ;==========================================
                         C      
  D797                   C      dszta:	
  D797    00             C      	db	00h	;nop
  D798    01             C      	db	01h	;home
  D799    02             C      	db	02h	;(auch 82h) cursor an
  D79A    03             C      	db	03h	;(auch 83h) cursor aus
  D79B    04             C      	db	04h	;(auch 84h) normal, nicht inv.
  D79C    05             C      	db	05h	;(auch 85h) normal,       inv.
  D79D    06             C      	db	06h	;(auch 86h) hell  , nicht inv.
                         C      ;			 (nur  87h) hell  ,       inv.
  D79E    07             C      	db	07h	;bell (akustisches zeichen)
  D79F    08             C      	db	08h	;cursor zurueck
  D7A0    0A             C      	db	0ah	;LF
  D7A1    0C             C      	db	0ch	;bs loeschen, cursor links oben
  D7A2    0D             C      	db	0dh	;CR
                         C       if umlaut
  D7A3    0E             C      	db	0eh	;umschalten auf 2. Zeichensatz
  D7A4    0F             C      	db	0fh	;umschalten auf 1. Zeichensatz
                         C       endif
  D7A5    14             C      	db	14h	;rest bs loeschen
  D7A6    15             C      	db	15h	;cursor vorwaerts
  D7A7    16             C      	db	16h	;rest der zeile loeschen
                         C       IF inslin
  D7A8    17             C      	db	17h	;Insert Line
                         C       ENDIF
  D7A9    18             C      	db	18h	;zeile loeschen, cursor an zeilanf.
                         C       IF inslin
  D7AA    19             C      	db	19h	;Delete Line
                         C       ENDIF
  D7AB    1A             C      	db	1ah	;eine zeile hoch
                         C      			;bei ADM3a wie 0ch
  D7AC    1B             C      	db	1bh	;escape
                         C      ;		1b zeile+80h spalte+80h		Kursor posit. SCP
                         C      ;		1b zeile+00h spalte+00h		geht auch bei CP/A
                         C      ;		1b '='/'Y' zeile+20h spalte+20h	Kursor posit. bei ADM3A
                         C      ;		1b 5e xx	Feldattribut setzen (SCP1715 fuer 8275-Contr.)
                         C      ;			mit xx= 01urggbh
                         C      ;				  u		unterstreichen,
                         C      ;				   r		invers,
                         C      ;				    gg		Zeichengenerator-Umschaltung,
                         C      ;				      b		blinken,
                         C      ;				       h	heller 
                         C      ;		1b 5f xx	Spezialzeichen setzen (SCP1715 fuer 8275)
                         C      ;			mit xx= 01ssssbh
                         C      ;				  ssss		Zeichencode (1100 Sonderfkt)
                         C      ;				      b		blinken des Sonderzeichens
                         C      ;				       h	heller des Sonderzeichens
                         C      	if	adm3a
                         C      	endif
                         C       if crt eq dsy5
                         C       endif
  D7AD    7F             C      	db	7fh	;delete
  D7AE    87             C      	db	87h	;(nicht 07h) hell  ,      inv.
  0018                   C       dsztal	equ	$-dszta	;Tabellenlaenge
                         C      
                         C      ; Reaktionsroutinen fuer Sonderzeichen
                         C      
  D7AF    D5F7           C      	dw	crtnop	;00
  D7B1    D686           C      	dw	crthom	;01
  D7B3    D6EA           C      	dw	crtcrt	;02/82
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-45


  D7B5    D6EE           C      	dw	crtcof	;03/83
  D7B7    D5D0           C      	dw	crto84	;04/84
  D7B9    D5D0           C      	dw	crto85	;05/85
  D7BB    D5D0           C      	dw	crto86	;06/86
