  D6BC                   C      crtm46	equ	$-2
                         C      	setbs
  D6BE    ED B8          C      	lddr			;eine Zeile nach unten schieben
                         C      	setram
  D6C0    D1             C      crtil1:	pop	de
  D6C1    62             C      	ld	h,d
  D6C2    6B             C      	ld	l,e
  D6C3    18 D5          C      	jr	crtzlr		;freigewordene Zeile loeschen
                         C      ;-----------------------------
  D6C5    CD D649        C      crtdll:	call	crtcr		;Delete Line
  D6C8    E5             C      	push	hl
  D6C9    11 FF30        C      	ld	de,bsend2-bssp2+1	;Anfang letzte Zeile
  D6CA                   C      crtm47	equ	$-2
  D6CC    EB             C      	ex	de,hl
  D6CD    B7             C      	or	a
  D6CE    ED 52          C      	sbc	hl,de		;Laenge
  D6D0    28 08          C      	jr	z,crtdl1	;letzte Zeile
  D6D2    E3             C      	ex	(sp),hl
  D6D3    54             C      	ld	d,h
  D6D4    5D             C      	ld	e,l		;de auf Ziel (Zeilenanfang)
  D6D5    09             C      	add	hl,bc		;hl auf Quelle
  D6D6    C1             C      	pop	bc
  D6D7    D5             C      	push	de
                         C      	setbs
  D6D8    ED B0          C      	ldir			;eine Zeile nach oben schieben
                         C      	setram
  D6DA    21 FF30        C      crtdl1:	ld	hl,bsend2-bssp2+1
  D6DB                   C      crtm48	equ	$-2
  D6DD    54             C      	ld	d,h
  D6DE    5D             C      	ld	e,l
  D6DF    CD D69A        C      	call	crtzlr		;letzte Zeile loeschen
  D6E2    E1             C      	pop	hl
  D6E3    C9             C      	ret
                         C      ;-----------------------------
                         C       ENDIF	;inslin
  D6E4    3E 02          C      crtesc:	ld	a,2		;escape flag setzen
  D6E6    32 D592        C      	ld	(desc),a
                         C      
                         C      	if	costu or adm3a
                         C      	endif
                         C      
  D6E9    C9             C      	ret
                         C      ;-----------------------------
  D6EA    3E 80          C      crtcrt:	ld	a,80h		;cursor an
  D6EC    18 01          C      	jr	crto14
                         C      ;-----------------------------
  D6EE    AF             C      crtcof:	xor	a		;cursor aus
  D6EF    32 D566        C      crto14:	ld	(dcurs),a
  D6F2    C9             C      	ret
                         C      ;-----------------------------
                         C      ; Realisierung 07h
                         C      ; Achtung! Diese Routine wird aus Interruptroutine aufgerufen!
  D6F3    CD D6F6        C      crtclk:	call	crtcl1		;Fehlerlampe umschalten
                         C      
  D6F6    06 19          C      crtcl1:	ld	b,25		;0.25 sec warten
  D6F8    CD E763        C      	call	wait10
                         C      				;Fehlerlampe wieder zurueck
                         C      ; Fehlerlampe umschalten
                         C      ; Reg. A, HL bleiben erhalten
  D6FB    F5             C      swilmp:	push	af
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-42


  D6FC    E5             C      	push	hl
  D6FD    21 0040        C      	ld	hl,lampbf
  D700    7E             C      	ld	a,(hl)
  D701    EE 40          C      	xor	1 shl lmperr
  D703    77             C      	ld	(hl),a
  D704    CD D3B0        C      	call	lampen
  D707    E1             C      	pop	hl
  D708    F1             C      	pop	af
  D709    C9             C      	ret
                         C      ;-----------------------------
                         C       IF umlaut
