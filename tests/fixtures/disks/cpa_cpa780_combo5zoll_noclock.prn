  DBFC    23             C      	inc	hl
  DBFD    4E             C      	ld	c,(hl)
  DBFE    DD 71 04       C      	ld	(ix+dpbexm),c
                         C      
                         C      ; Bestimmen Zahl der abweichenden 128er-Sektoren ab Spur 0
                         C      
  DC01    AF             C      	xor	a
  DC02    32 DFED        C      	ld	(dfrmtr),a	;ab Spur 0
                         C      		;(gleichz. Spurkorr. bei falschen Doppelstepimpulsen)
  DC05    CD DE29        C      sf128z:	call	dsidtr		;beliebigen SektId lesen
  DC08    20 18          C      	jr	nz,sf128e	;Fehler
  DC0A    7C             C      	ld	a,h		;Sektorlaenge
  DC0B    DD BE 10       C      	cp	(ix+dpbslc)	;gleich Disketten-Rest?
  DC0E    28 12          C      	jr	z,sf128e	;ja
  DC10    DD 7E 0F       C      	ld	a,(ix+dpbflg)
  DC13    E6 03          C      	and	dpbfsm		;bisherige Anzahl abweichender Spuren
  DC15    FE 03          C      	cp	dpbfsm		;Zaehler voll?
  DC17    28 09          C      	jr	z,sf128e	;ja
  DC19    DD 34 0F       C      	inc	(ix+dpbflg)	;erhoehen abweich. Spurzahl
  DC1C    21 DFED        C      	ld	hl,dfrmtr	;naechste (logische!) Spur
  DC1F    34             C      	inc	(hl)
  DC20    18 E3          C      	jr	sf128z
  DC22                   C      sf128e:
                         C      
                         C      ; Setzen Anzahl der logischen 128er Rekords im Puffer -1
                         C      ; Es wird immer das Maximum gesetzt, dies setzt eine dichte
                         C      ; Sektorfolge beim Transfer voraus! (so in dpbstr)
                         C      
                         C      	IF	dbufsz gt 7
  DC22    DD 36 11 07    C      	ld	(ix+dpbbfm),+(1 shl (dbufsz-7))-1
                         C      	ENDIF
                         C      
                         C      ; Berechnen Speicherkapazitaet-1 in BDOS-Bloecken aus
                         C      ; ((Tracks-dpbofs)*dpbspt/(2**dpbbls))-1
  DC26    DD 6E 14       C      	ld	l,(ix+dpbtrk)
  DC29    AF             C      	xor	a
  DC2A    67             C      	ld	h,a		;hl:=log. Spurzahl
  DC2B    DD 5E 0D       C      	ld	e,(ix+dpbofs)
  DC2E    57             C      	ld	d,a		;de:=log. offset-Spurzahl
  DC2F    ED 52          C      	sbc	hl,de
  DC31    EB             C      	ex	de,hl		;de:=log. Daten-Spurzahl
  DC32    6F             C      	ld	l,a		;hl:=0
  DC33    DD 46 00       C      	ld	b,(ix+dpbspt)
  DC36    19             C      dsizmz:	add	hl,de
  DC37    10 FD          C      	djnz	dsizmz		;hl:=(tracks-dpbofs)*dpbspt
  DC39    DD 46 02       C      dsizme:	ld	b,(ix+dpbbls)
  DC3C    CB 3C          C      dsizdz:	srl	h
  DC3E    CB 1D          C      	rr	l
  DC40    10 FA          C      	djnz	dsizdz
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-65


  DC42    2B             C      	dec	hl
  DC43    DD 75 05       C      	ld	(ix+dpbsiz),l
  DC46    DD 74 06       C      	ld	(ix+dpbsiz+1),h
  DC49    DD 7E 07       C      	ld	a,(ix+dpbdir)	;Dir-Groesse
  DC4C    3C             C      	inc	a
  DC4D    E6 FC          C      	and	0fch		;abrunden auf durch 4 teilbare Dir-Groesse
  DC4F    0F             C      	rrca
  DC50    0F             C      	rrca			;div 4, da 4 Dir-Eintr. /Sekt.
  DC51    DD 77 0B       C      	ld	(ix+dpbchk),a	;ist Sektorzahl = Check size
  DC54    DD 46 02       C      	ld	b,(ix+dpbbls)	;block shift
  DC57    0F             C      seldla:	rrca			;BDOS-Bloecke fuer Dir.
  DC58    10 FD          C      	djnz	seldla
