  DC65                   C      home:
                         C      	IF	dbufsz gt 7
  DC65    21 DFF2        C      	ld	hl,dbflg
  DC68    CB 56          C      	bit	dfbwr,(hl)	;veraenderter Puffer?
  DC6A    20 05          C      	jr	nz,home1	;ja, nicht freigeben
