  DCDE    3A DFFF        C      	ld	a,(dsectr)
  DCE1    BE             C      	cp	(hl)		;gleicher Sektor?
  DCE2    20 3A          C      	jr	nz,alloc	;nein
                         C      ; Vorbereiten naechsten unalloc write-Aufruf
