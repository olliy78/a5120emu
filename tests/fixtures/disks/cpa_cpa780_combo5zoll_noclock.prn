  DD9B    82             C      dbsecz:	add	a,d		;0. phys. Sekt. im Puffer
  DD9C    10 FD          C      	djnz	dbsecz		;=dbsnb.*Puffernr.
  DD9E    5F             C      dbsec0:	ld	e,a		;merken Pufferanf.-Sektor
  DD9F    DD 46 10       C      	ld	b,(ix+dpbslc)
