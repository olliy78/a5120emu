BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-66


  DC82    C9             C      	RET
                         C      ;-----------------------
                         C      
                         C      ; Uebersetzung Sektornummer 
                         C      ;==========================
                         C      ; Translate-Tab-Adr. in DE, Eingangs-Sektornummer in BC,
                         C      ;			    Ausgangs-Sektornummer in HL
                         C      ; Es wird keine Translate-Tabelle benutzt, da die Sektor-
                         C      ; nummernverwaltung verallgemeinert im nicht-Standard-DPB 
                         C      ; enthalten ist (auch fuer physische Sektorlaenge <>128)
                         C      
  DC83                   C      sectran:
  DC83    60             C      	LD	H,B
  DC84    69             C      	LD	L,C
  DC85    23             C      	inc	hl		;Sektoren zaehlen in CP/A ab 1
  DC86    C9             C      	RET
                         C      ;-----------------------
                         C      
                         C      ; Schreiben Sektor
                         C      ;=================
                         C      ; Register C (vom BDOS gestellt):
                         C      ;	=0, wenn normales write
                         C      ;	=1, wenn directory-write (sofort ausgeben)
                         C      ;	=2, wenn Beginn eines neuen Datenblocks (kein preread)
                         C      
  DC87                   C      write:
                         C       IF @write
  DC87    59             C      	ld	e,c		;retten Reg. C
  DC88    3A DFFC        C      	ld	a,(ddrive)
  DC8B    4F             C      	ld	c,a
  DC8C    CD E83D        C      	call	dgetpb		;ix:=dpb(ddrive)
  DC8F    28 6B          C      	jr	z,drwerr	;Geraet ex. nicht
                         C       if ramfl
                         C      ;###RAM-Floppy
  DC91    DD CB 0F 7E    C      	bit	dpbfnd,(ix+dpbflg)	;Diskette?
  DC95    C2 E4FA        C      	jp	nz,wrramf	;nein
                         C      ;###
                         C       endif
  DC98    21 DFFB        C      	ld	hl,dflg
  DC9B    CB D6          C      	set	dfwr,(hl)	;Write-Flag setzen
                         C      
                         C      	IF	dbufsz gt 7	;gepufferte Disk E/A
  DC9D    21 DFF2        C      	ld	hl,dbflg
  DCA0    CB C6          C      	set	dfbprr,(hl)	;Annahme preread notwendig
  DCA2    7B             C      	ld	a,e		;A:= Write-Typ
  DCA3    32 E00A        C      	ld	(dwrtyp),a	;merken Write-Typ
  DCA6    FE 02          C      	cp	2		;write to unallocated?
  DCA8    20 17          C      	jr	nz,chkuna	;nein
  DCAA    DD 7E 03       C      	ld	a,(ix+dpbblm)	;Zahl der 128-Sekt. im Block -1
  DCAD    3C             C      	inc	a
  DCAE    32 E004        C      	ld	(unacnt),a	;fuer diese Sekt. kein preread
  DCB1    21 E005        C      	ld	hl,unadev
  DCB4    71             C      	ld	(hl),c
  DCB5    2A DFFD        C      	ld	hl,(dtrack)
  DCB8    22 E006        C      	ld	(unatrk),hl
  DCBB    3A DFFF        C      	ld	a,(dsectr)
  DCBE    32 E008        C      	ld	(unasec),a
  DCC1    21 E004        C      chkuna:	ld	hl,unacnt
  DCC4    7E             C      	ld	a,(hl)
  DCC5    B7             C      	or	a		;noch nicht geschr. Sekt. da?
  DCC6    28 56          C      	jr	z,alloc		;nein
  DCC8    3D             C      	dec	a		;sonst Restzahl -1
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-67


  DCC9    77             C      	ld	(hl),a
  DCCA    23             C      	inc	hl
  DCCB    79             C      	ld	a,c
  DCCC    BE             C      	cp	(hl)		;gleiches Geraet?
  DCCD    20 4F          C      	jr	nz,alloc	;nein
  DCCF    23             C      	inc	hl
  DCD0    3A DFFD        C      	ld	a,(dtrack)
  DCD3    BE             C      	cp	(hl)		;gleiche Spur?
  DCD4    20 48          C      	jr	nz,alloc	;nein
  DCD6    23             C      	inc	hl
