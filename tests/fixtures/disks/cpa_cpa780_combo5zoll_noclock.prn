                         C      	include BIOSTIM
                         C      ;*************************************************************
                         C      ;	Zeitgeberdienst
                         C      ; 15.06.88
                         C      ; - BAB2 als Standard
                         C       IF cpu eq c1715
                         C       ENDIF
                         C      ; - zusaetzliche Laufwerksabschaltung ueber Zeittakt eingefuehrt
                         C      ; - Abfrage von 'synsem' in 1-sec-Interrupt entfernt (kein setbs/setram notw.)
                         C      ; 24.09.88
                         C      ; - Bildschirmpuffer kann ausserhalb des normalen RAM's liegen
                         C      ; 09.10.88
                         C      ; - Pflege der Statuszeile nur bei stzaus=0
                         C      ; 23.12.88
                         C      ; - Einbau der Pflege des Datums
                         C      ; 07.01.89
                         C      ; - Tastaturpolling nur wenn Zugriff zur Statuszeile erlaubt
                         C      ; 20.03.89
                         C      ; - Laufwerksabschaltung ueber Zeittakt nur bei FDC K5120/22 und F1715
                         C      ;*************************************************************
                         C      
                         C       IF1
                         C       ENDIF
                         C      
                         C      ; 5ms/25ms an
  E598                   C      tim5on:
                         C       IF cpu eq c1715
                         C       ENDIF
  E598    3E B1          C      	ld	a,10110001b
                         C      	;int./zeitg./vort.256/pos.flanke/naechst.zykl./keine zk/weiter/1
  E59A    F3             C      tim5ot:	DI
  E59B    D3 0E          C      	out	(sysctc+tim5ct),a
  E59D    FB             C      	EI
  E59E    C9             C      ret:	ret
                         C      
                         C      ; 5ms/25ms aus
  E59F                   C      tim5of:
                         C       IF cpu eq c1715
                         C       ENDIF
  E59F    3E 31          C      	ld	a,00110001b	;kein int./...
  E5A1    18 F7          C      	jr	tim5ot
                         C      
                         C       IF cpu eq c1715
                         C       ELSE
                         C      ; 1s an
  E5A3    3E D1          C      tim1on:	ld	a,11010001b
                         C      	;int./zaehler//pos.flanke//keine zk/weiter/1
  E5A5    F3             C      tim1ot:	DI
  E5A6    D3 0F          C      	out	(sysctc+tim1ct),a
  E5A8    FB             C      	EI
  E5A9    C9             C      	ret
                         C      ; 1s aus
  E5AA    3E 51          C      tim1of:	ld	a,01010001b	;kein int./...
  E5AC    18 F7          C      	jr	tim1ot
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-100


                         C       ENDIF
                         C      
                         C      ; Interr.routine 5ms/25ms
  E5AE                   C      tim5it:
                         C       IF stpvar or monitor
  E5AE    22 E5B6        C      	ld	(t5ihl),hl	;retten hl
  E5B1    21 E6AA        C      	ld	hl,chksp	;Test auf haengende Spezialfktnen
  E5B4    E5             C      	push	hl		;nach const-Aufruf in CTC-Interrupt
  E5B5    21 0000        C      	ld	hl,0		;wiederherstellen hl
  E5B6                   C      t5ihl	equ	$-2
                         C       ENDIF
  E5B8    ED 73 E5D7     C      	ld	(intsp),sp
  E5BC    31 F0B5        C      	ld	sp,intstk
  E5BF    F5             C      	push	af
  E5C0    E5             C      	push	hl
  E5C1    D5             C      	push	de
  E5C2    C5             C      	push	bc
  E5C3    2A 0041        C      	ld	hl,(tim5cn)
  E5C6    23             C      	inc	hl
  E5C7    22 0041        C      	ld	(tim5cn),hl
                         C       IF cpu eq c1715
                         C       ENDIF
  E5CA    3A D13D        C      	ld	a,(synflg)
  E5CD    CB 77          C      	bit	stzaus,a	;Zugriff zur Statuszeile erlaubt?
  E5CF    CC D257        C      intkbd:	call	z,kbdsti	;ja, Tastatur abfragen und puffern
                         C      				;auf 'ld hl,.. .' waehrend Lampen-Ausgabe
  E5D2                   C      intrbc:				;allg. Interr.-ausgang
  E5D2    C1             C      	pop	bc
  E5D3    D1             C      	pop	de
  E5D4                   C      intrhl:				;allg. Interr.-ausgang
  E5D4    E1             C      	pop	hl
  E5D5                   C      intraf:				;allg. Interr.-ausgang
  E5D5    F1             C      	pop	af
  E5D6    31 0000        C      	ld	sp,0
  E5D7                   C      intsp	equ	$-2
  E5D9                   C      intret:				;allg. Interr.-ausgang
  E5D9    FB             C      	ei
  E5DA    ED 4D          C      	reti
                         C      
                         C       IF cpu ne c1715
                         C      ; Interr.routine 1s
  E5DC    ED 73 E5D7     C      tim1it:	ld	(intsp),sp
  E5E0    31 F0B5        C      	ld	sp,intstk
  E5E3    F5             C      	push	af
  E5E4    E5             C      	push	hl
  E5E5    D5             C      	push	de
  E5E6    C5             C      	push	bc
  E5E7    CD E5EC        C      	call	tim1up
  E5EA    18 E6          C      	jr	intrbc
                         C       ENDIF
                         C      
                         C      ; Reaktionsroutine fuer 1 sec Interrupt
  E5EC    2A 0043        C      tim1up:	ld	hl,(tim1cn)
  E5EF    2B             C      	dec	hl
  E5F0    22 0043        C      	ld	(tim1cn),hl
                         C       IF uhrvar
                         C       ENDIF
  E5F3    3A E5CF        C      	ld	a,(intkbd)	;lampen aktiv?
  E5F6    FE 21          C      	cp	021h		;  call-Befehl oder ld hl,...
  E5F8    C4 D3B0        C      	call	nz,lampen	;nein, Aktualisierung Lampen
                         C      
  E5FB    21 E5FE        C      intcrt:	ld	hl,tim1uu	;auf jp,... waehrend conout
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-101


                         C      
                         C       IF cpastz or uhrvar
                         C       ENDIF
                         C       IF uhrvar
                         C       ENDIF
                         C      
                         C       IF cpastz
                         C       ENDIF ;cpastz
                         C      
                         C       IF cpastz or uhrvar
                         C       ENDIF ;cpastz or uhrvar
                         C      
                         C       IF cpastz
                         C       ENDIF ;cpastz
                         C      
                         C       IF cpastz or uhrvar
                         C       ENDIF
                         C      
  E5FE                   C      tim1uu:
                         C       IF disknb ne 0
                         C        IF (fdc eq K5120) or (fdc eq K5122) or (fdc eq f1715)
                         C      ; zusaetzliche Laufwerksabschaltung ueber Zeittakt
  E5FE    3A E2BE        C      	ld	a,(pretx+1)	;Motorabschaltung unterdrueckt?
  E601    B7             C      	or	a
  E602    28 0E          C      	jr	z,t1nmo1	;ja
  E604    3A E2B6        C      	ld	a,(fl.zto)	;pro Sekunde 5 Umdrehungen
  E607    D6 04          C      	sub	4		;noch >= 4* 200ms Zeit?
  E609    30 01          C      	jr	nc,t1nmo2	;ja
  E60B    AF             C      	xor	a
  E60C    32 E2B6        C      t1nmo2:	ld	(fl.zto),a
  E60F    CC E2D0        C      	call	z,headup	;Ueberw.zeit abgelaufen -> Motor aus
  E612                   C      t1nmo1:
                         C        ENDIF
                         C       ENDIF
  E612    2A 0045        C      	ld	hl,(tim1rt)	;Adresse der Nutzerroutine
  E615    E9             C      	jp	(hl)		;1-sec-Nutzerroutine ausfuehren, ret
                         C      
                         C       IF cpastz or uhrvar
                         C       ENDIF
                                
                                 IF	mprot
                                 ENDIF
                                
                                 IF	monitor
                                 ENDIF
                                
                         C      	include BIOSNUC
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                         C      ; Zentrale BIOS-Kompenenten
                         C      ; - rst 38h fuehrt bei Monitor zu seinem Aufruf, sonst Warmstart
                         C      ; - Nachladen CCP aus RAM-Floppy vereinheitlicht (unabh. von RAM-Floppy)
                         C      ; - synflg hinter BIOS-Sprungvektor fuer Modifizierung von aussen
                         C      ; - Verwendung der Interruptsaeule in Generierungsteil verlagert
                         C      ; 25.09.88
                         C      ; - Streichen des Tastaturpuffers in Tastaturstatus
                         C      ; 09.10.88
                         C      ; - Pflege der Statuszeile nur bei stzaus=0
                         C      ; 11.01.89
                         C      ; - Variante wbootv=4 (@CCP.COM) eingefuehrt
                         C      ; 17.05.89
                         C      ; - Generierung ohne LW A moeglich
                         C      ; 05.06.89
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-102


                         C      ; - Unterstuetzung NANOS-RAF
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                         C      
                         C       IF iobvar
                         C      ;Verteiler fuer die 1-Zeichen-Kanaele entsprechend IOBYTE:
                         C      ;=========================================================
                         C      
  E616                   C      const:			; iobyte  00 00 00 xx
  E616    CD E676        C      	call	iodisp
  E619    07             C      	db	7
  E61A    D24F           C      	dw	kbdst		;0 kbd:
  E61C    D24F           C      	dw	kbdst		;1 kbd:
  E61E    E63A           C      	dw	reades		;2 rdr:
  E620    D992           C      	dw	uc1st		;3 uc1: (liefert, ob Z. da)
                         C      
  E622                   C      conin:			; iobyte:  00 00 00 xx
  E622    CD E676        C      	call	iodisp
  E625    07             C      	db	7
  E626    D2E7           C      	dw	kbdi		;0 kbd:
  E628    D2E7           C      	dw	kbdi		;1 kbd:
  E62A    E646           C      	dw	reader		;2 rdr:
  E62C    D9C1           C      	dw	uc1i		;3 uc1: (wartet, bis Z. da)
                         C      
  E62E                   C      conout:			; iobyte:  00 00 00 xx
  E62E    CD E676        C      	call	iodisp
  E631    07             C      	db	7
  E632    D554           C      	dw	crto		;0 crt:
  E634    D232           C      	dw	dumo		;1 dum:
  E636    E652           C      	dw	punch		;2 pun:
  E638    D7EB           C      	dw	uc1o		;3 uc1: (wartet, bis frei)
                         C      
  E63A                   C      reades:			; iobyte:   00 00 xx 00
  E63A    CD E676        C      	call	iodisp
  E63D    01             C      	db	1
  E63E    D24F           C      	dw	kbdst		;0 kbd:
  E640    D22C           C      	dw	dumst		;1 dum:
  E642    D22C           C      	dw	dumst		;2 dum:
  E644    D992           C      	dw	uc1st		;3 uc1: (liefert, ob Z. da)
                         C      
  E646                   C      reader:			; iobyte:   00 00 xx 00
  E646    CD E676        C      	call	iodisp
  E649    01             C      	db	1
  E64A    D2E7           C      	dw	kbdi		;0 kbd:
  E64C    D22F           C      	dw	dumi		;1 dum:
  E64E    D22F           C      	dw	dumi		;2 dum:
  E650    D9C1           C      	dw	uc1i		;3 uc1: (wartet, bis Z. da)
                         C      
                         C      
  E652                   C      punch:			; iobyte:   00 xx 00 00
  E652    CD E676        C      	call	iodisp
  E655    03             C      	db	3
  E656    D554           C      	dw	crto		;0 crt:
  E658    D232           C      	dw	dumo		;1 dum:
  E65A    E66A           C      	dw	list		;2 lst:
  E65C    D7EB           C      	dw	uc1o		;3 uc1: (wartet, bis frei)
                         C      
                         C      
  E65E                   C      listst:			; iobyte:  xx 00 00 00
  E65E    CD E676        C      	call	iodisp
  E661    05             C      	db	5
  E662    D855           C      	dw	ttyst		;0 tty:
  E664    D22C           C      	dw	crtst		;1 crt:
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-103


  E666    D85B           C      	dw	lptst		;2 lpt:
  E668    D22C           C      	dw	dumst		;3 dum:
                         C      
  E66A                   C      list:			; iobyte:  xx 00 00 00
  E66A    CD E676        C      	call	iodisp
  E66D    05             C      	db	5
  E66E    D7DF           C      	dw	ttyo		;0 tty:
  E670    D554           C      	dw	crto		;1 crt:
  E672    D7E5           C      	dw	lpto		;2 lpt:
  E674    D232           C      	dw	dumo		;3 dum:
                         C      
                         C      
                         C      ; IOBYTE-Auswertung - Verteilung auf die physischen Geraete
                         C      ; ---------------------------------------------------------
                         C      ; A,HL werden zerstoert
                         C      ; Anwender-IX wird gerettet, darf von Treiber-Routine zerstoert werden
                         C      ; damit kann Treiber auch aus Interrupt-Routine aufgerufen werden
                         C      
  E676                   C      iodisp:
  E676    E1             C      	pop	hl
  E677    C5             C      	push	bc
  E678    46             C      	ld	b,(hl)
  E679    23             C      	inc	hl
  E67A    3A 0003        C      	ld	a,(iobyte)
  E67D    0F             C      iodis1: rrca
  E67E    10 FD          C      	djnz	iodis1
  E680    E6 06          C      	and	6
  E682    4F             C      	ld	c,a
  E683    09             C      	add	hl,bc
  E684    7E             C      	ld	a,(hl)
  E685    23             C      	inc	hl
  E686    66             C      	ld	h,(hl)
  E687    6F             C      	ld	l,a
  E688    C1             C      	pop	bc
  E689    DD E5          C      	push	ix		;retten Anwender-IX
  E68B    CD E756        C      	call	callhl
  E68E    DD E1          C      	pop	ix		;wiederherstellen Anwender-IX
  E690    C9             C      	ret
                         C      
                         C       ENDIF
                         C      
                         C      ;************************************************************
                         C      ;	Spezialroutinen
                         C      ;************************************************************
                         C      
                         C      	IF	monitor
                         C      	ENDIF
                         C      
                         C      
                         C      ; Arbeit mit asynchronen Sonderaktionen
                         C      ;======================================
                         C      ; Die folgenden beiden Routinen werden vom BIOS immer dann aufgerufen,
                         C      ; wenn wegen zeitkritischer (z.B. Floppy-Bedienung) oder anderer
                         C      ; BIOS-Arbeit (z.B. Bildschirmrollen) keine parallelen Sonderaktionen
                         C      ; erlaubt sind.
                         C      
                         C      ; Reg A bleibt erhalten
  E691    F5             C      delsps: push	af
  E692    2A 004A        C      	ld	hl,(kritbg)	;evtl. Nutzerroutine fuer Beginn krit. BIOS
  E695    CD E756        C      	call	callhl		;aufrufen
  E698    F1             C      	pop	af
  E699    21 D13E        C      	ld	hl,synsem	;Verzoegern Sonderaktionen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-104


  E69C    34             C      	inc	(hl)
  E69D    C9             C      	ret
                         C      
                         C      ; Reg A bleibt erhalten
  E69E    F5             C      delspr: push	af
  E69F    2A 004C        C      	ld	hl,(kriten)	;evtl. Nutzerroutine fuer Ende krit. BIOS
  E6A2    CD E756        C      	call	callhl		;aufrufen
  E6A5    F1             C      	pop	af
  E6A6    21 D13E        C      	ld	hl,synsem	;Zulassen Sonderaktionen
  E6A9    35             C      	dec	(hl)
                         C      
                         C       IF stpvar or monitor
                         C      
                         C      ; Test auf zwischenzeitliche Anforderung von Sonderroutinen
                         C      ;----------------------------------------------------------
                         C      
                         C      ; Diese Routine wird nach dem Lesen eines Tastaturzeichens
                         C      ; als "Ohr" eingeschoben, bevor zur eigentlichen Interrupt-
                         C      ; adresse zurueckgekehrt wird. Sie wird nicht innerhalb der
                         C      ; Interruptroutine ausgefuehrt, um mit offenen Interrupts
                         C      ; arbeiten zu koennen.
                         C      ; maximale Stackbelastung nach RETI von Interruptroutinen:
                         C      ; -	Return-Adresse zum Nutzer
                         C      ; -	AF
  E6AA    F3             C      chksp:	di
  E6AB    F5             C      	push	af		;A und F Reg retten
  E6AC    3A D13E        C      	ld	a,(synsem)
  E6AF    B7             C      	or	a		;asynchr. Routinen zugelassen?
  E6B0    C2 E6C7        C      	jp	nz,chkspx	;nein
  E6B3    3C             C      	inc	a		;weiteren Eintritt verhindern
  E6B4    32 D13E        C      	ld	(synsem),a
  E6B7    FB             C      chkspn: ei
  E6B8    3A D13D        C      	ld	a,(synflg)	;inzw. (neue) Anforderung?
  0000                   C      rqmask	aset	0
                         C       IF monitor
                         C       ENDIF
                         C       IF stpvar
  0010                   C      rqmask	aset	rqmask+(1 shl stoprq)
                         C       IF chdvar
  0018                   C      rqmask	aset	rqmask+(1 shl synlrq)
                         C       ENDIF
                         C       ENDIF
  E6BB    E6 18          C      	and	rqmask
  E6BD    C2 E6CA        C      	jp	nz,chkspd	;ja, ausfuehren
  E6C0    3A D13E        C      	ld	a,(synsem)
  E6C3    3D             C      	dec	a
  E6C4    32 D13E        C      	ld	(synsem),a
  E6C7    F1             C      chkspx: pop	af
  E6C8    FB             C      	ei
  E6C9    C9             C      	ret
                         C      
                         C      ; asynchrone Aktionen ausfuehren
  E6CA                   C      chkspd:
                         C       IF monitor
                         C       ENDIF
                         C      
                         C       IF stpvar
  E6CA    3A D13D        C      	ld	a,(synflg)
  E6CD    CB 67          C      	bit	stoprq,a	;inzwischen Stop-Forderung?
  E6CF    28 10          C      	jr	z,nstpsp	;nein
  E6D1    CB A7          C      	res	stoprq,a
  E6D3    32 D13D        C      	ld	(synflg),a
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-105


  E6D6    F1             C      	pop	af		;Nutzer-Stackbelastung verringern
  E6D7    22 E70F        C      	ld	(asynhl),hl	;HL freimachen
  E6DA    21 E712        C      	ld	hl,stoprt	;Routine
  E6DD    CD E6FB        C      	call	asynrt		;aufrufen mit eigenem Stack
  E6E0    F5             C      	push	af
  E6E1                   C      nstpsp:
                         C      
                         C       IF chdvar
  E6E1    3A D13D        C      	ld	a,(synflg)
  E6E4    CB 5F          C      	bit	synlrq,a	;inzwischen LST:-Synchr.?
  E6E6    28 10          C      	jr	z,nsynlr	;nein
  E6E8    CB 9F          C      	res	synlrq,a
  E6EA    32 D13D        C      	ld	(synflg),a
  E6ED    F1             C      	pop	af
  E6EE    22 E70F        C      	ld	(asynhl),hl
  E6F1    21 D868        C      	ld	hl,lsynch
  E6F4    CD E6FB        C      	call	asynrt
  E6F7    F5             C      	push	af
  E6F8                   C      nsynlr:
                         C       ENDIF
                         C       ENDIF	;stpvar
                         C      
  E6F8    C3 E6B7        C      	jp	chkspn		;Test auf neue Requests
                         C      
                         C       IF stpvar or chdvar
                         C      ; Asynchrone Routine (HL) mit eigenem Stack aufrufen
                         C      ;---------------------------------------------------
                         C      
  E6FB    ED 73 E70C     C      asynrt: ld	(asynsv),sp	;asynchr. Routinen haben
  E6FF    31 F09D        C      	ld	sp,stpstk	;ein eigenes Stack
  E702    F5             C      	push	af
  E703    D5             C      	push	de
  E704    C5             C      	push	bc
  E705    CD E756        C      	call	callhl		;Routine aufrufen
  E708    C1             C      	pop	bc
  E709    D1             C      	pop	de
  E70A    F1             C      	pop	af
  E70B    31 0000        C      	ld	sp,0		;SP wiederherstellen
  E70C                   C      asynsv	equ	$-2
  E70E    21 0000        C      	ld	hl,0		;gerettetes hl wiederherst.
  E70F                   C      asynhl	equ	$-2
  E711    C9             C      	ret
                         C       ENDIF
                         C      
                         C       IF stpvar
                         C      ; Asynchrone Stop-Routine
                         C      ;------------------------
  E712                   C      stoprt:
                         C       IF disknb ne 0
  E712    CD E2D0        C      	call	headup		;Disk-Kopf abheben
                         C       ENDIF
  E715    CD E740        C      stopz:	call	stpchp		;holen naechste phys. Taste
                         C      
                         C       IF umlaut
  E718    FE 75          C      	cp	'u'		;Umlaut-Modus umschalten ?
  E71A    28 04          C      	jr	z,stopzu
  E71C    FE 55          C      	cp	'U'
  E71E    20 08          C      	jr	nz,stopnu	;Nein !
  E720    21 D13D        C      stopzu: ld	hl,synflg	;Umlaute-Flag im Flagbyte
  E723    7E             C      	ld	a,(hl)
  E724    EE 04          C      	xor	1 shl umlflg	;umschalten
  E726    77             C      	ld	(hl),a
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-106


  E727    C9             C      	ret
  E728                   C      stopnu:
                         C       ENDIF
                         C      
                         C       IF chdvar
  E728    FE FB          C      	cp	zblmin		;"- im Ziffernblock": Hardcopy BS -> LIST?
  E72A    CA D71A        C      	jp	z,crthrd	;ja, ausfuehren
  E72D    FE CD          C      	cp	spcins		;"INS": I/O-Byte im LST:Kanal weiterschalten?
  E72F    20 08          C      	jr	nz,stopz2	;nein
  E731    21 0003        C      	ld	hl,iobyte
  E734    7E             C      	ld	a,(hl)
  E735    C6 40          C      	add	a,40h		;Ueberlauf wird ignoriert
  E737    77             C      	ld	(hl),a
  E738    C9             C      	ret
  E739                   C      stopz2:
                         C      
                         C       IF l2bahn
                         C       ENDIF
                         C       ENDIF
                         C      
                         C       IF cpastz or uhrvar
                         C       ENDIF
                         C      
                         C       IF costu
                         C       ENDIF
                         C      
  E739    D6 C7          C      	sub	kcurpd		;"Page down": ^C ?
  E73B    C0             C      	ret	nz		;nein, Stop-Ende
  E73C    32 D13E        C      	ld	(synsem),a	;falls rst 0 nicht in BIOS fuehrt
  E73F    C7             C      	rst	0		;sonst Warmstart
                         C      
                         C      ; Holen naechste Taste physisch
  E740    21 D13D        C      stpchp: ld	hl,synflg
  E743    CB FE          C      	set	phyact,(hl)	;naechste Taste physisch
  E745    E5             C      	push	hl
  E746    CD E74D        C      	call	stopch		;holen naechstes Tastaturz.
  E749    E1             C      	pop	hl
  E74A    CB BE          C      	res	phyact,(hl)	;physisches Lesen beendet
  E74C    C9             C      	ret
                         C      
                         C      ; Holen naechste Taste im Stopzustand
  E74D    CD D6FB        C      stopch: call	swilmp		;Stop-Lampe an
  E750    CD D2E7        C      	call	kbdi		;Warten auf naechstes Zeichen
  E753    C3 D6FB        C      	jp	swilmp		;danach Stop-Lampe aus
                         C      
                         C       ENDIF ;stpvar
                         C       ENDIF ;asynchr. Routinen
                         C      
                         C      ;***************************************************
                         C      ;	Allgemeine BIOS-Hilfsprogramme
                         C      ;***************************************************
                         C      
                         C      ; Aufruf der Routine (HL)
  E756    E9             C      callhl: jp	(hl)
                         C      
                         C      ; Ausgabe Text ab (HL) bis 00h auf CON: und evtl. LST:
  E757    7E             C      putmes: LD	A,(HL)
  E758    B7             C      	OR	A
  E759    C8             C      	RET	Z
  E75A    E5             C      	PUSH	HL
  E75B    4F             C      	LD	C,A
  E75C    CD D10C        C      	CALL	conol
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-107


  E75F    E1             C      	POP	HL
  E760    23             C      	INC	HL
  E761    18 F4          C      	JR	putmes
                         C      
                         C      ; Ausgabe Text ab (HL) mit exakter Laenge "stzbl" in Statuszeile
                         C       IF cpastz
                         C       ELSE
  E757                   C      biosms	equ	putmes	;0dh,0ah,...,07h,00h im Text ergaenzen!!
                         C       ENDIF
                         C      
                         C      ;	Wait 0.01 sec * (B)
                         C      ; Reg HL bleibt erhalten
  E763    C5             C      wait10: push	bc
  E764    0E 0A          C      	ld	c,10		;10* 1ms warten
  E766    06 BD          C      wait2z: ld	b,189		;(189*13)/(256*9600)=0.001
  E768    10 FE          C      wait1z: djnz	wait1z		;1ms warten
  E76A    0D             C      	dec	c
  E76B    20 F9          C      	jr	nz,wait2z
  E76D    C1             C      	pop	bc
  E76E    10 F3          C      	djnz	wait10
  E770    C9             C      	ret
                         C      
                         C      ;************************************************************
                         C      ;	zentral verwendete Rueckkonvertierungsroutinen
                         C      ;************************************************************
                         C      
                         C       IF monitor or errvar or iobvar or uhrvar or mprot
                         C      
                         C      ; Rueckkonvertieren Byte ab (HL) nach (DE)
                         C      ; RET: 2 Zeichen ab (DE), DE zeigt auf naechstes freies Byte
  E771    7E             C      mbreco: ld	a,(hl)
                         C      
                         C      ; Rueckkonvertieren Byte in A nach (DE)
                         C      ; RET: 2 Zeichen ab (DE), DE zeigt auf naechstes freies Byte
  E772    CD E775        C      mrecoa: call	mreca
                         C      
                         C      ; Rueckkonvertieren A in HEX-Ziffern nach (DE)
                         C      ; RET: A um 4 bits nach rechts rotiert
                         C      ;      DE zeigt auf naechstes Byte
  E775                   C      mrecol:
  E775    0F             C      mreca:	rrca			;linkes Halbbyte
  E776    0F             C      	rrca
  E777    0F             C      	rrca
  E778    0F             C      	rrca
  E779                   C      mrecor:				;rechtes Halbbyte
  E779    F5             C      	push	af		;fuer 2. mreca-Aufruf retten
  E77A    E6 0F          C      	and	0fh
  E77C    D6 0A          C      	sub	9+1
  E77E    38 02          C      	jr	c,mrecod	;0..9
  E780    C6 07          C      	add	a,7		;A..F
  E782    C6 3A          C      mrecod: add	a,'0'+10
  E784    12             C      	ld	(de),a
  E785    13             C      	inc	de
  E786    F1             C      	pop	af
  E787    C9             C      	ret
                         C      
                         C       ENDIF
                         C      
                         C       IF monitor or cpastz
                         C       ENDIF
                         C      
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-108


                         C      ;*************************************************************
                         C      ;	wiederholter Kaltstart
                         C      ;*************************************************************
  E788                   C      kalts1:
                         C       IF cpu eq k2521
                         C       ENDIF
                         C       IF (cpu eq k2526) or (cpu eq c1715)
  E788    CD E59F        C      	call	tim5of		;totlegen aller Interruptquellen
                         C        IF cpu eq k2526
  E78B    CD E5AA        C      	call	tim1of
                         C        ENDIF
                         C        IF cpu eq c1715
                         C        ENDIF
  E78E    F3             C      	di
                         C        IF cpu eq k2526
  E78F    3E F7          C      	ld	a,0f7h
  E791    D3 0A          C      	out	(0ah),a		;Lade-ROM zuschalten
                         C        ENDIF
                         C        IF cpu eq c1715
                         C        ENDIF
  E793    C7             C      	rst	0		;RESET
                         C       ENDIF
                         C      
                         C      ;*************************************************************
                         C      ;	Warmstart
                         C      ;*************************************************************
                         C       if1
                         C       endif
                         C      
                         C       IF	wbootv eq 1	;Warmstart=Kaltstart
                         C       ELSE
  E794    31 0080        C      WARMST: LD	SP,tpa-80h
                         C      
                         C         if	wbootv eq 0		;;CCP-Kopie im BIOS
  E797    21 E860        C      	ld	hl,ccpkop	;;CCP von Kopie wiederherst.
  E79A    11 BB00        C      	ld	de,CCP
  E79D    01 0811        C      	ld	bc,ccpkpl+bdskpl
  E7A0    ED B0          C      	ldir
                         C         endif
                         C      
                         C         if	(wbootv eq 2) or (wbootv eq 3) or (wbootv eq 4)
                         C         endif ;(wbootv eq 2) or (wbootv eq 3) or (wbootv eq 4)
                         C      
                         C         if (wbootv eq 0) or (wbootv eq 2) or (wbootv eq 3)
  E7A2    21 BB03        C      	LD	HL,CCP+3	;EINGANG MIT KOMMANDOLOESCHEN
                         C         endif
                         C         if wbootv eq 4
                         C         endif
                         C      	warmin
  E7A5    F3             C+     wbinit: DI
  E7A6    E5             C+     	PUSH	HL
  E7A7    3E F7          C+     	LD	A,high(intvr)
  E7A9    ED 47          C+     	LD	I,A
  E7AB    ED 5E          C+     	im	2
  E7AD    3E C3          C+     	LD	A,0C3H
  E7AF    32 0000        C+     	LD	(REBOOT),A
  E7B2    21 0003'       C+     	LD	HL,BIOS+3
  E7B5    22 0001        C+     	LD	(REBOOT+1),HL
  E7B8    32 0005        C+     	LD	(BDOSJP),A
  E7BB    21 C306        C+     	LD	HL,BDOS+6
  E7BE    22 0006        C+     	LD	(BDOSJP+1),HL
  E7C1    32 0038        C+     	ld	(38h),a		;Breakpoint
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-109


  E7C4    21 0000        C+     	ld	hl,0		;ohne Monitor wie Warmstart
  E7C7    22 0039        C+     	ld	(38h+1),hl
  E7CA    21 D13D        C+     	ld	hl,synflg
  E7CD    36 00          C+     	ld	(hl),0
  E7CF    23             C+     	inc	hl
  E7D0    36 00          C+     	ld	(hl),0		;synsem:=0
  E7D2    21 E59E        C+     	ld	hl,ret
  E7D5    22 004A        C+     	ld	(kritbg),hl	;leere Routine fuer Beginn kritischer BIOS-Teil
  E7D8    22 004C        C+     	ld	(kriten),hl
  E7DB    21 E59E        C+     	ld	hl,ret
  E7DE    22 0045        C+     	ld	(tim1rt),hl
  E7E1    CD E598        C+     	call	tim5on
  E7E4    CD E5A3        C+     	call	tim1on
  E7E7    AF             C+     	xor	a
  E7E8    32 D592        C+     	ld	(desc),a	;evtl. ESCAPE-Modus beenden
  E7EB    0E 82          C+     	ld	c,82h		;Kursor sichtbar machen
  E7ED    CD D554        C+     	call	crto
  E7F0    3A 0040        C+     	ld	a,(lampbf)
  E7F3    E6 B3          C+      and (1 shl lmphcp)+(1 shl lmpb2r)+(1 shl lmpb2b)+(1 shl kbdcpb)+(1 shl kbdcal)
  E7F5    32 0040        C+     	ld	(lampbf),a	;ruecksetzen Lampen
  E7F8    21 D481        C+     	ld	hl,kbdsts	;Standard-Stringtabelle wiederherstellen
  E7FB    22 D13B        C+     	ld	(kbdsst),hl
  E7FE    3E FF          C+     	ld	a,0ffh
  E800    32 DFF3        C+     	ld	(dbdev),a
  E803    21 E56B        C+     	ld	hl,osscd
  E806    11 0020        C+     	ld	de,ossld
  E809    01 000D        C+     	ld	bc,osscdl
  E80C    ED B0          C+     	ldir
  E80E    FB             C+     	EI
  E80F    21 0004        C+     setcld: ld	hl,defaul
  E812    4E             C+     	ld	c,(hl)
  E813    C5             C+     	push	bc
  E814    79             C+     	ld	a,c
  E815    E6 0F          C+     	and	0fh
  E817    4F             C+     	ld	c,a
  E818    AE             C+     	xor	(hl)
  E819    F6 00          C+     	or	0
  E81B    77             C+     	ld	(hl),a
  E81C    CD E83D        C+     	call	dgetpb
  E81F    C1             C+     	pop	bc
  E820    28 ED          C+     	jr	z,setcld
  E822    C9             C+     	ret
                         C       ENDIF	;wbootv ne 1
