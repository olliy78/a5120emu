  D70A    E5             C      crt2zs:	push	hl
  D70B    21 D13D        C      	ld	hl,synflg
  D70E    CB D6          C      	set	umlflg,(hl)
  D710    E1             C      	pop	hl
  D711    C9             C      	ret
                         C      ; Umschalten auf 1. Zeichensatz
  D712    E5             C      crt1zs:	push	hl
