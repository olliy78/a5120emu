  D490    C6 01 04       C+     	db	kcurri,1,'D' and 1fh
  D493    C7 01 03       C+     	db	kcurpd,1,'C' and 1fh
  D496    C8 01 18       C+     	db	kcurdw,1,'X' and 1fh
  D499    E0 01 02       C+     	db	pf0c,1,'B' and 1fh
  D49C    E1 01 07       C+     	db	pf1c,1,'G' and 1fh
  D49F    E2 01 19       C+     	db	pf2c,1,'Y' and 1fh
  D4A2    E3 01 14       C+     	db	pf3c,1,'T' and 1fh
  D4A5    E4 01 16       C+     	db	pf4c,1,'V' and 1fh
