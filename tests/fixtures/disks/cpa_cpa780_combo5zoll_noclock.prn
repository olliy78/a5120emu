                         C        ENDIF
                         C      
                         C       ENDIF
                         C      
                         C      ; gemeinsamer Zweig read/write Floppy
                         C      ;------------------------------------
                         C      
  DD22    3A DFFF        C      drw:	ld	a,(dsectr)	;Sektornummer in 1..dpbspt ?
  DD25    3D             C      	dec	a		;ab 0 zaehlen
  DD26    FA DCFC        C      	jp	m,drwerr	;<0, Fehler
  DD29    DD BE 00       C      	cp	(ix+dpbspt)	;<dpbspt?
  DD2C    30 CE          C      	jr	nc,drwerr	;nein, Fehler
                         C       IF dbufsz gt 7
  DD2E    47             C      	ld	b,a		;retten dsectr-1
                         C       ENDIF
  DD2F    DD 7E 0F       C      	ld	a,(ix+dpbflg)
  DD32    E6 03          C      	and	dpbfsm		;Anzahl der abweich. 128er Spuren
  DD34    5F             C      	ld	e,a
  DD35    16 00          C      	ld	d,0
  DD37    2A DFFD        C      	ld	hl,(dtrack)	;verlangte Spur
  DD3A    B7             C      	or	a
  DD3B    ED 52          C      	sbc	hl,de		;im abweichenden Spurformat?
  DD3D    DA DE2E        C      	jp	c,drwsec	;ja, Sektorlaenge 128
                         C      
                         C       IF dbufsz gt 7	;gepufferte Disk E/A
                         C       IF dbufsz lt 12 ;<2**12 =4K Puffer
  DD40    DD 7E 10       C      	ld	a,(ix+dpbslc)	;phys. Sektorlaenge 128?
  DD43    B7             C      	or	a		;d.h. mit Sektorversatz?
  DD44    CA DE2E        C      	jp	z,drwsec	;ja, keine Pufferung sinnvoll
                         C       ENDIF
  DD47    78             C      	ld	a,b
  DD48    DD 56 11       C      	ld	d,(ix+dpbbfm)	;Puffermaske
  DD4B    A2             C      	and	d		;rel. Sekt.nr. des BDOS-Blocks zum Puff.anf.
  DD4C    F5             C      	push	af		;merken fuer move
  DD4D    A8             C      	xor	b		;a ist Sektornr. des Puff.anf.
  DD4E    CB 3F          C      drwbnr:	srl	a		;ermitteln Puffernr in Spur
  DD50    CB 1A          C      	rr	d		;noch Bits in Puffermaske?
  DD52    20 FA          C      	jr	nz,drwbnr	;ja
                         C      ; Test, ob dieser Puffer da ist
  DD54    F5             C      	push	af		;merken Puffernummer
