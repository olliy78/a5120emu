                         C      ;-------------------------
                         C      ; i E	Stringlaenge -1
                         C      ; i HL	Stringanfang
  D2D9    1C             C      kbdco1:	inc	e
  D2DA    E5             C      kbdco2:	push	hl
  D2DB    D5             C      	push	de
