  D592                   C      desc	equ	$-1
  D593    B7             C      	or	a
  D594    20 62          C      	jr	nz,crto04	;ja
  D596    79             C      crto02:	ld	a,c
  D597    32 D796        C      	ld	(crtcch),a	;merken fuer direkte Ausgabe
  D59A    FE 87          C      	cp	87h		;07h ist bell!, daher 87h<>07h
  D59C    28 39          C      	jr	z,crto09
  D59E    CB BF          C      	res	7,a		;sonst 1xxxxxxxB  = 0xxxxxxxB
  D5A0    FE 20          C      	cp	20h		;steuerzeichen?
  D5A2    38 33          C      	jr	c,crto09	;ja
  D5A4    FE 7F          C      	cp	7fh
  D5A6    30 2F          C      	jr	nc,crto09
                         C       IF umlaut
  D5A8    CD D765        C      	call	crtuml		;evtl. Umlaute umkodieren
                         C       ENDIF
  D5AB                   C      crtobs:
  D5AB    EB             C      	ex	de,hl
                         C       IF crt eq dsy5
                         C       ENDIF
  D5AC                   C      crtsbl:
                         C      	setbs
  D5AC    12             C      	ld	(de),a		;Zeichen in Bildschirmpuffer
                         C      	setram
  D5AD    21 0001        C      crtcur:	ld	hl,0-bsend1
  D5AE                   C      crtm01	equ	$-2
  D5B0    19             C      	add	hl,de		;bs voll?
  D5B1    EB             C      	ex	de,hl
  D5B2    23             C      	inc	hl	
  D5B3    D0             C      	ret	nc
  D5B4    11 FFC0        C      	ld	de,bsend1-bssp1+1
  D5B5                   C      crtm02	equ	$-2
  D5B7    D5             C      crto03:	push	de
  D5B8    21 FC40        C      	ld	hl,bsanf1+bssp1	;aufschieben
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-37


  D5B9                   C      crtm03	equ	$-2
  D5BB    11 FC00        C      	ld	de,bsanf1
  D5BC                   C      crtm04	equ	$-2
  D5BE    01 03C0        C      	ld	bc,bsend1-bsanf1-bssp1+1
  D5BF                   C      crtm05	equ	$-2
                         C      	setbs
  D5C1    ED B0          C      	ldir
  D5C3    2B             C      	dec	hl
