  DE0A    CC DE11        C      dmovew:	call	z,dbtrw		;ja, veraend. Puffer ausgeben
  DE0D    3A E00B        C      	ld	a,(dberrf)	;Ergebnis letztes dbtran
  DE10    C9             C      	ret
