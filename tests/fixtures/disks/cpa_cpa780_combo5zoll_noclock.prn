                         C       ENDIF
  DE2C    18 03          C      	jr	dsktra		;belieb. SektId lesen
                         C      	ENDIF
                         C      
                         C      
                         C      ; gemeinsamer Zweig Read/Write 128-Sektor einzeln
                         C      ;================================================
  DE2E                   C      drwsec:
  DE2E    21 DFFB        C      	ld	hl,dcdb
                         C      
                         C      ; interner Aufruf phys. Diskettentransfer
                         C      ;----------------------------------------
                         C      ; i HL auf CDB
  DE31                   C      dsktra:
                         C       IF dev eq cpd
                         C       ENDIF
                         C      
                         C      ;*********************************************************
                         C      ; Umkleidung des physischer Disketten-Transfers
                         C      ;*********************************************************
                         C      
                         C      ; Parameter: HL auf CDB mit folgender Struktur:
                         C      ; +0: cdbfl	;Flags	(Struktur angepasst an ft.kom)
  0000                   C      diof00	equ	0	;** frei fuer Anw. ** (frueher Verify nach Schreiben)
  0001                   C      diofid	equ	1	;fest	;=1, wenn nur Sektid. zu lesen
  0002                   C      diofwr	equ	2	;fest	;=1, wenn Schreiben
  0003                   C      dioffm	equ	3	;fest	;=1, wenn temporaer FM-Format erzwungen
  0004                   C      dioftr	equ	4		;=1, wenn keine Fehlermeldung (und -behandlg)
  0005                   C      diofhd	equ	5		;=1, wenn Kopf hochnehmen ("headup")
  0006                   C      diofps	equ	6		;=1, wenn trk,sid,sec schon physisch
  0007                   C      diofs1	equ	7	;fest	;=1, wenn Rueckseite
                         C      
                         C      ; ab hier unwichtig bei "diofhd" in cdbfl =1 (headup)
                         C      ; +1: cdbdev	;logisches Geraet 0 .. dphnb-1
                         C      ; +2: cdbtrk	;log./phys. Spur
                         C      ; +3: cdbsid	;bel./phys. Seite
                         C      ; +4: cdbsec	;log./phys. Sektor
                         C      ; +5: cdbslc	;Sektorlaengencode (0=128, 1=256, 2=512, 3=1024)
                         C      ; +6: cdbsnb	;Anz. zu uebertr. ph. Sekt. (wenn =0, so nur position.)
                         C      ; ab hier nur wichtig, wenn "diofid" in cdbfl =0:
                         C      ; +7,8: cdbdma	;Transferadresse
                         C      
                         C      ; Return, falls nicht "diofhd" in cdbfl =1:
                         C      ;	A=0 (ret z) bei fehlerfrei, sonst A=1 (ret nz) bei cdbfl, "dioftr" =0
                         C      ;	oder Returncode phys. Transfer
                         C      ;	E:=trk, D:=sid ,L:=sec, H:=len
                         C      ;	BC,IX unveraendert
                         C      
  DE31                   C      diskio:	;Aufruf ueber Sprungvektor von BIOS-Erweiterung
  DE31    C5             C      	push	bc
  DE32    11 E00C        C      	ld	de,diocdb	;CDB des Nutzers auf internen Hilfsspeicher
  DE35    01 0009        C      	ld	bc,diocdl	;da modifiziert
  DE38    D5             C       	push	de
                         C       IF dev eq cpd
                         C       ELSE
  DE39    ED B0          C      	ldir
                         C       ENDIF
  DE3B    E1             C      diskii:	pop	hl		;hl auf diocdb
  DE3C    C1             C      	pop	bc
                         C      
  DE3D    CB 6E          C      	bit	diofhd,(hl)	;Kopf hochnehmen?
                         C       IF disknb ne 0
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-72


  DE3F    C2 E2D0        C      	jp	nz,headup	;ja, kein Transfer
                         C       ENDIF
  DE42    C5             C      	push	bc
  DE43    DD E5          C      	push	ix
  DE45    E5             C      	push	hl
  DE46    23             C       	inc	hl
  DE47    4E             C      	ld	c,(hl)		;logisches Laufwerk
  DE48    CD E83D        C      	call	dgetpb		;IX auf DPB stellen
  DE4B    E1             C      	pop	hl		;wiederherstellen hl
  DE4C    3E 44          C      	ld	a,'D'		;falls LW nicht ex.
  DE4E    CA DF05        C      	jp	z,dioert	;LW ex. nicht
                         C      
                         C       IF hdsk
                         C       ENDIF
  DE51    CB 76          C      	bit	diofps,(hl)	;trk,sid,sec schon physisch?
  DE53    20 5A          C      	jr	nz,diophy	;ja
                         C       IF dsk8mf
                         C       ENDIF
                         C      ; Track, Side und Sector entpsr. Diskettenformat setzen
  DE55    23             C      	inc	hl
  DE56    23             C      	inc	hl
  DE57    56             C      	ld	d,(hl)		;Track
  DE58    5A             C      	ld	e,d		;merken
  DE59    23             C      	inc	hl
  DE5A    23             C      	inc	hl
  DE5B    4E             C      	ld	c,(hl)		;Sektornummer ab 1
  DE5C    0D             C      	dec	c		;Sektornr. ab 0
  DE5D    DD CB 0F 66    C      	bit	dpbf86,(ix+dpbflg)	;Fortsetzung Dsk. auf Ruecks.?
  DE61    20 0C          C      	jr	nz,diots2	;ja
  DE63    DD CB 0F 6E    C      	bit	dpbfds,(ix+dpbflg)	;ungerade Spuren auf Rueckseite?
  DE67    28 29          C      	jr	z,diotrs	;nein, einseitig
  DE69    CB 3A          C      	srl	d		;Spur halbieren
  DE6B    30 25          C      	jr	nc,diotrs	;gerade Spur, Vorderseite
  DE6D    18 12          C      	jr	diots1		;auf Rueckseite
  DE6F    DD 46 14       C      diots2:	ld	b,(ix+dpbtrk)	;log. Spurzahl
  DE72    CB 38          C      	srl	b		;Spuren auf Vorderseite
  DE74    7A             C      	ld	a,d
  DE75    90             C      	sub	b		;Spur auf Vorderseite?
  DE76    38 1A          C      	jr	c,diotrs	;ja, Spur in d unveraendert lassen
                         C      				;40 ->  0; 41 ->  1; ...; 79 ->  39
                         C      				;77 ->  0; 78 ->  1; ...;153 ->  76
  DE78    DD CB 0F 5E    C      	bit	dpbfsv,(ix+dpbflg)	;Ruecks. von aussen nach innen?
  DE7C    20 02          C      	jr	nz,diots4	;ja
  DE7E    2F             C      	cpl			;40 -> -1; 41 -> -2; ...; 79 -> -40
                         C      				;77 -> -1; 78 -> -2; ...;153 -> -77
  DE7F    80             C      	add	a,b		;40 -> 39; 41 -> 38; ...; 79 ->   0
                         C      				;77 -> 76; 78 -> 75; ...;153 ->   0
  DE80    57             C      diots4:	ld	d,a
  DE81    3A E00C        C      diots1:	ld	a,(diocfl)
  DE84    CB FF          C      	set	diofs1,a	;vermerken Rueckseite
  DE86    32 E00C        C      	ld	(diocfl),a
  DE89    DD 7E 13       C      	ld	a,(ix+dpbsn0)	;Versch. der Sektornr. auf Rueckseite
  DE8C    81             C      	add	a,c		;Sektornr. evtl. weiterzaehlen
                         C      ;;;	cp	c		;Weiternummerierung auf Rueckseite?
  DE8D    4F             C      	ld	c,a
                         C      ;;;	jr	nz,diotrs	;ja, dann side:=0
  DE8E    3E 01          C      	ld	a,1		;side:=1
  DE90    18 01          C      	jr	diotss
  DE92    AF             C      diotrs:	xor	a		;side:=0
  DE93    32 E00F        C      diotss:	ld	(diocsi),a	;phys. Seite setzen
  DE96    7A             C      	ld	a,d
  DE97    32 E00E        C      	ld	(dioctr),a	;phys. Spur setzen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-73


                         C      
  DE9A    7B             C      	ld	a,e		;log. Spurnr. zurueck nach A
  DE9B    DD E5          C      	push	ix
  DE9D    E1             C      	pop	hl
  DE9E    11 0019        C      	ld	de,dpbstr	;d:=0
  DEA1    19             C      	add	hl,de
  DEA2    DD BE 0D       C      	cp	(ix+dpbofs)	;Systemspur?
  DEA5    38 03          C      	jr	c,diossp	;ja, Sektornummern nicht logisch
  DEA7    59             C      	ld	e,c
  DEA8    19             C      	add	hl,de		;HL entspr. Index in dpbstr
  DEA9    4A             C      	ld	c,d		;c:=0
  DEAA    79             C      diossp:	ld	a,c		;phys. Sektornr. ab 0
  DEAB    86             C      	add	a,(hl)		;+echte Sektornr.
  DEAC    32 E010        C      	ld	(diocse),a	;phys. Sektor setzen
  DEAF                   C      diophy:
                         C      
                         C      ; i ret, BC, IX im Stack
                         C      ; i cdb auf diocdb
                         C      ; i IX auf DPB
                         C      
  DEAF                   C      diorty:	;interne Wiederholung diskio
  DEAF    DD E5          C      	push	ix		;retten IX fuer evtl. Wiederholung
  DEB1    21 E00C        C      	ld	hl,diocdb
  DEB4    E5             C      	push	hl
  DEB5    7E             C      	ld	a,(hl)		;side 0/1, -/FM, read/write, -/sectid l.
  DEB6    E6 8E          C       and (1 shl diofs1)+(1 shl dioffm)+(1 shl diofwr)+(1 shl diofid)
  DEB8    47             C      	ld	b,a
  DEB9    DD 7E 18       C      	ld	a,(ix+dpbtyp)	;5"/8", FM/MFM, 40/80, Verify nach Schreiben
  DEBC    E6 78          C       and (1 shl dpbt80)+(1 shl dpbt5z)+(1 shl dpbtdd)+(1 shl dpbtwv) ;aus DPB
  DEBE    A8             C      	xor	b
                         C       IF dsk8mf
                         C       ENDIF
  DEBF    CB 66          C      	bit	dioftr,(hl)	;Fehlerbehandlung unterdruecken?
  DEC1    28 01          C      	jr	z,dionft	;nein
  DEC3    3C             C      	inc	a
  DEC4                   C      dionft:
  DEC4    32 E2ED        C      	ld	(ft.kom),a	
                         C      
  DEC7    23             C      	inc	hl
  DEC8    DD 7E 15       C      	ld	a,(ix+dpbdnr)	;physische LW-Nr.
  DECB    32 E2F0        C      	ld	(ft.lwn),a
                         C      
  DECE    23             C      	inc	hl
  DECF    7E             C      	ld	a,(hl)
  DED0    32 E2F1        C      	ld	(ft.trk),a
  DED3    23             C      	inc	hl
  DED4    7E             C      	ld	a,(hl)
  DED5    32 E2F2        C      	ld	(ft.sid),a
  DED8    23             C      	inc	hl
  DED9    7E             C      	ld	a,(hl)
  DEDA    32 E2F3        C      	ld	(ft.sec),a
  DEDD    23             C      	inc	hl
  DEDE    7E             C      	ld	a,(hl)
  DEDF    32 E2F4        C      	ld	(ft.len),a
  DEE2    23             C      	inc	hl
  DEE3    7E             C      	ld	a,(hl)
  DEE4    32 E2F5        C      	ld	(ft.anz),a
                         C      
  DEE7    DD 7E 12       C      	ld	a,(ix+dpbstp)	;Anzahl der Stepimpulse
  DEEA    32 E2F6        C      	ld	(ft.stp),a
                         C      
  DEED    DD 7E 17       C      	ld	a,(ix+dpbsti)	;Schrittzeit
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-74


  DEF0    32 E2F7        C      	ld	(ft.sti),a
                         C      
  DEF3    2A E013        C      	ld	hl,(diocad)
  DEF6    22 E2EE        C      	ld	(ft.adr),hl
                         C      
                         C       IF stpvar or monitor
  DEF9    CD E691        C      	call	delsps		;Sondertasten verbieten
                         C       ENDIF
                         C       IF hdsk
                         C       ELSE
  DEFC    CD E015        C      	call	floppy		;$$$ phys. Transfer $$$
                         C       ENDIF
                         C       IF stpvar or monitor
  DEFF    CD E69E        C      	call	delspr		;Sondertasten wieder erlauben
                         C       ENDIF
                         C      
  DF02    E1             C      	pop	hl		;HL wieder auf Paramfeld-Adresse
  DF03    DD E1          C      	pop	ix		;IX wieder auf DPB
                         C      
  DF05                   C      dioert:
                         C      ; Fehlerprotokoll
  DF05    CB 66          C      	bit	dioftr,(hl)	;Fehlerprotokoll und -behandlung  unterdr.?
  DF07    20 33          C      	jr	nz,dtrok	;ja
  DF09    B7             C      	or	a		;Returncode
  DF0A    28 30          C      	jr	z,dtrok		; -> fehlerfrei
  DF0C    FE 52          C      	cp	'R'		;not ready?
  DF0E    CA DEAF        C      	jp	z,diorty	;ja, Wiederholung
                         C      
                         C       IF errvar
  DF11    32 DFD2        C      	ld	(derrcd),a	;Fehlercode
  DF14    CB 56          C      	bit	diofwr,(hl)	;war lesen?
  DF16    3E 52          C      	ld	a,'R'
  DF18    28 02          C      	jr	z,derrr		;ja
  DF1A    3E 57          C      	ld	a,'W'
  DF1C    32 DFD1        C      derrr:	ld	(derrrw),a
                         C        IF dev eq cpd
                         C        ELSE
  DF1F    21 E2F1        C      	ld	hl,ft.trk	;phys. Spur
  DF22    11 DFDC        C      	ld	de,derrtr
  DF25    CD E771        C      	call	mbreco
  DF28    21 E2F2        C      	ld	hl,ft.sid	;Seite
  DF2B    CD E771        C      	call	mbreco
  DF2E    21 E2F3        C      	ld	hl,ft.sec	;Sektor
  DF31    CD E771        C      	call	mbreco
                         C        ENDIF
  DF34    21 DFCF        C      	ld	hl,derrms
  DF37    CD E757        C      	call	biosms
                         C       ENDIF
  DF3A    3E 01          C       	ld	a,1		;return mit Fehler
                         C      
  DF3C    B7             C      dtrok:	or	a		;stellen Z-Flag
  DF3D    ED 5B E2F1     C      	ld	de,(ft.trk)	;E:=trk, D:=sid
  DF41    2A E2F3        C      	ld	hl,(ft.sec)	;L:=sec, H:=len
  DF44    DD E1          C      	pop	ix
  DF46    C1             C      	pop	bc
  DF47    C9             C      	ret
                         C      
                         C       IF	format
                         C      
                         C      ; Stellen HL entsprechend Sektorlaengencode in (A)
                         C      ;=================================================
                         C      ; ret nz bei unzulaessigem
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-75


  DF48    B7             C      dtrsla:	or	a
  DF49    21 DF5C        C      	ld	hl,dtrsl0
  DF4C    C8             C      	ret	z		;=0 (128)
  DF4D    3D             C      	dec	a
  DF4E    21 DF70        C      	ld	hl,dtrsl1	;=1 (256)
  DF51    C8             C      	ret	z
  DF52    3D             C      	dec	a
  DF53    21 DF84        C      	ld	hl,dtrsl2	;=2 (512)
  DF56    C8             C      	ret	z
  DF57    3D             C      	dec	a
  DF58    21 DF98        C      	ld	hl,dtrsl3	;=3 (1024)
  DF5B    C9             C      	ret
                         C      
                         C       ENDIF
                         C      
                         C      ;************************************************
                         C      ;	Steuertabellen
                         C      ;************************************************
                         C      
                         C      
                         C       IF	format
                         C      ; Modifizierungstabellen entspr. Sektorlaenge und LW-Typ
                         C      ;-------------------------------------------------------
                         C      
                         C      ; Struktur:
                         C      
  0000                   C      dsltrk	equ	0		;benutzte Spuren
  0001                   C      dslspt	equ	dsltrk+1	;Sektoren/Spur
  0002                   C      dsldir	equ	dslspt+1	;Dir-Eintraege
  0003                   C      dsloff	equ	dsldir+1	;2*offset
                         C      				;[+Flag fuer festes offset]
  0001                   C      dslfo	equ	1		;festes offset
  0000                   C      dslvo	equ	0		;offset =0, falls Directory mgl.
  0004                   C      dslblk	equ	dsloff+1	;rel. Adr. Tab. BDOS-Blockgroesse
  0005                   C      dsll	equ	5		;Laenge eines Eintrags
                         C      
                         C      ; Reihenfolge
                         C      ; 5", 40 Tr, SS
                         C      ; 5", 80 Tr, SS
                         C      ; 5", 40 Tr, DS
                         C      ; 5", 80 Tr, DS
                         C       if	disk8
                         C       endif
                         C      
                         C      ; Zur automatischen Bestimmung des Spurformats wird dasjenige
                         C      ; Format der Spur "dlgint" benutzt, alle folgenden Spuren
                         C      ; muessen das gleiche Format haben!
  0003                   C      dlgint	equ	3	;groesste Anzahl SS-Systemspuren
                         C      
                         C      ; 128
  DF5C                   C      dtrsl0:	
  DF5C    28 1A 3F 04    C      	db	40,26,63,2*2+dslvo,dbl1k-$	;CP/M Standard
  DF60    4C             C      
  DF61    50 1A 7F 04    C      	db	80,26,127,2*2+dslvo,dbl2k-$
  DF65    4A             C      
  DF66    50 1A 7F 01    C      	db	80,26,127,2*0+dslfo,dbl2k-$
  DF6A    45             C      
  DF6B    A0 1A 7F 01    C      	db	160,26,127,2*0+dslfo,dbl2k0-$
  DF6F    43             C      
                         C      
                         C      	if	disk8
                         C      	endif
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-76


                         C      
                         C      ; 256
  DF70                   C      dtrsl1:	
  DF70    28 20 3F 07    C      	db	40,32,63,2*3+dslfo,dbl2k-$	;SCP Hausformat A51xx
  DF74    3B             C      
  DF75    50 20 3F 07    C      	db	80,32,63,2*3+dslfo,dbl2k-$	;SCP
  DF79    36             C      
  DF7A    50 20 7F 09    C      	db	80,32,127,2*4+dslfo,dbl2k-$
  DF7E    31             C      
  DF7F    A0 20 7F 09    C      	db	160,32,127,2*4+dslfo,dbl2k0-$	;SCP Hausformat PC1715
  DF83    2F             C      
                         C      
                         C      	if	disk8
                         C      	endif
                         C      
                         C      ; 512
  DF84                   C      dtrsl2:	
  DF84    28 24 00 01    C      	db	40,36,0,2*0+dslfo,dbl1k-$
  DF88    24             C      
  DF89    50 24 00 01    C      	db	80,36,0,2*0+dslfo,dbl2k-$
  DF8D    22             C      
  DF8E    50 24 00 01    C      	db	80,36,0,2*0+dslfo,dbl2k-$
  DF92    1D             C      
  DF93    A0 24 00 01    C      	db	160,36,0,2*0+dslfo,dbl2k0-$
  DF97    1B             C      
                         C      
                         C      	if	disk8
                         C      	endif
                         C      	
                         C      ; 1024
  DF98                   C      dtrsl3:	
  DF98    28 28 3F 04    C      	db	40,40,63,2*2+dslvo,dbl1k-$	;CP/A Standard A51xx
  DF9C    10             C      
  DF9D    50 28 7F 04    C      	db	80,40,127,2*2+dslvo,dbl2k-$	;CP/A
  DFA1    0E             C      
  DFA2    50 28 7F 00    C      	db	80,40,127,2*0+dslvo,dbl2k-$	;CP/A
  DFA6    09             C      
  DFA7    A0 28 BF 08    C      	db	160,40,191,2*4+dslvo,dbl2k0-$	;CP/A (und SCP)
  DFAB    07             C      
                         C      
                         C      	if	disk8
                         C      	endif
                         C      
                         C      ; Modifizierungstabellen fuer BDOS-Blockgroesse
  DFAC    03 07 00       C      dbl1k:	db	3,7,0		;Bl. Shift, Bl. Mask, Ext. Mask
  DFAF    04 0F 01       C      dbl2k:	db	4,0fh,1
  DFB2    04 0F 00       C      dbl2k0:	db	4,0fh,0		;fuer Kapazitaet >255
                         C      
                         C      ; log. Sektortranslate-Tabelle fuer 26*128
  DFB5    01 07 0D 13    C      xlt:	db	1,7,13,19,25,5,11,17,23,3,9,15,21
  DFB9    19 05 0B 11    C      
  DFBD    17 03 09 0F    C      
  DFC1    15             C      
  DFC2    02 08 0E 14    C      	db	2,8,14,20,26,6,12,18,24,4,10,16,22
  DFC6    1A 06 0C 12    C      
  DFCA    18 04 0A 10    C      
  DFCE    16             C      
                         C      
                         C       ENDIF	;format
                         C      
                         C      	include BIOSDSKW
                         C      ;;***************************************************************
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-77


                         C      ;;	Arbeitsbereiche logischer Floppy-Treiber im System-RAM *
                         C      ;;***************************************************************
                         C      ;; 03.06.89
                         C      
                         C       IF errvar
                         C      ;; Fehlermeldung Disk I/O Error
                         C      ;;=============================
                         C      ;; Genau so lang (kurz), wie in Statuszeile Platz dafuer da ist!
                         C      ;; und das sind 17 Bytes!
  DFCF                   C      derrms:
                         C       IF cpastz
                         C       ELSE
  DFCF    0D 0A          C      	db	0dh,0ah
                         C       ENDIF
  DFD1    58             C      derrrw:	db	'X'
  DFD2    58 3B 54 2C    C      derrcd:	db	'X;T,Si,Se='
  DFD6    53 69 2C 53    C      
  DFDA    65 3D          C      
  DFDC    58 58          C      derrtr:	db	'XX'
  DFDE    58 58          C      derrts:	db	'XX'
  DFE0    58 58          C      derrsc:	db	'XX'
                         C       IF cpastz
                         C       ELSE
  DFE2    07 00          C      	db	07h,0
                         C       ENDIF
                         C      
                         C       ENDIF
                         C      
                         C      ;; CDB's
                         C      ;;======
                         C      
                         C      ;;CDB fuer Bestimmung Laufwerksbereitschaft bei Select Disk
                         C      ;;--------------------------------------------------------
  DFE4                   C      drdcdb:
  DFE4    10             C      drdflg:	db	(1 shl dioftr)	;;Lesen, kein Fehlerprotokoll
  DFE5    FF             C      drddev:	db	0ffh		;;Geraet
  DFE6    0000           C      drdtrk:	dw	0		;;Spur
  DFE8    01             C      	db	1		;;Sektor (bel.)
  DFE9    01             C      	db	1		;;Sektorlaengencode (>0, 1..3)
  DFEA    00             C      	db	0		;;Sektoranzahl=0 -> nur Positionieren
                         C      
                         C      	IF	format
                         C      ;; CDB fuer Bestimmung Spurformat
                         C      ;;------------------------------------
  DFEB                   C      dfrcdb:
  DFEB    12             C      dfrflg:	db	(1 shl diofid)+(1 shl dioftr)
                         C      ;;		Lesen Sektorid., kein Fehlerprotokoll
  DFEC    FF             C      dfrmdv:	db	0ffh		;;Geraet
  DFED    FF             C      dfrmtr:	db	0ffh		;;Spur
  DFEE    FF             C      	db	0ffh		;;Seite (bel.)
  DFEF    01             C      	db	1		;;Sektor (bel.)
  DFF0    01             C      	db	1		;;Sektorlaengencode (>0, 1..3)
  DFF1    01             C      	db	1		;;Sektoranzahl (>0)
                         C      	ENDIF
                         C      
                         C      	IF	format or (dbufsz gt 7)
                         C      ;; Puffer-CDB
                         C      ;;-----------
  DFF2                   C      dbcdb:
  DFF2    00             C      dbflg:	db	0
  0000                   C      dfbprr	equ	diof00		;;=1, wenn Puffer erst gelesen 
                         C      ;;				     werden muss
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-78


  0002                   C      dfbwr	equ	diofwr		;;=1, wenn Puffer durch
                         C      ;;				     Schreiben veraendert
  0004                   C      dfbtr	equ	dioftr		;;=1, wenn mit Fehlerprotokoll
                         C      ;; restliche Bits immer =0
  DFF3    FF             C      dbdev:	db	0ffh
  DFF4    FF             C      dbtrk:	db	0ffh
  DFF5    FF             C      dbsid:	db	0ffh
  DFF6    FF             C      dbsec:	db	0ffh
  DFF7    FF             C      dbslc:	db	0ffh
  DFF8    FF             C      dbsnb:	db	0ffh
                         C      	IF	dbufsz gt 7
  DFF9    F28F           C      dbdma:	dw	dbuf
                         C      	ENDIF
                         C      	ENDIF
                         C      
                         C      ;; CDB fuer ungepufferte E/A
                         C      ;;--------------------------
                         C      
  DFFB                   C      dcdb:
  DFFB    00             C      dflg:	db	0
  0002                   C      dfwr	equ	diofwr 		;;=1, wenn write-Aufruf
                         C      ;; restliche Bits immer =0
  DFFC    00             C      ddrive:	db	0
  DFFD    FF             C      dtrack:	db	0ffh
  DFFE    FF             C      	db	0ffh		;;Seite
  DFFF    FF             C      dsectr:	db	0ffh
  E000    00             C      	db	0		;;128 Bytes Sektorlaenge
  E001    01             C      	db	1		;;immer nur 1 Sektor
  E002    FFFF           C      ddma:	dw	0ffffh
                         C      
                         C       if ramfl
  DFFD                   C      rtrack	equ	dtrack
                         C       endif
                         C      
                         C      ;; Pufferzugriff
                         C       IF @write
                         C       IF dbufsz gt 7
  E004    00 FF FF FF    C      unacnt:	db	0,0ffh,0ffh,0ffh,0
  E008    00             C      
  E005                   C      unadev	equ	unacnt+1
  E006                   C      unatrk	equ	unacnt+2
  E008                   C      unasec	equ	unacnt+4
                         C       ENDIF
                         C       ENDIF
                         C       IF dbufsz gt 7
  E009    FF             C      dbnb:	db	0ffh
  E00A    FF             C      dwrtyp:	db	0ffh
  E00B    00             C      dberrf:	db	0		;;Ergebnisflag letztes dbtran
                         C       ENDIF
                         C      	include BIOSDSKB
                         C      ;;***************************************************************
                         C      ;;	Arbeitsbereiche logischer Floppy-Treiber im BIOS-RAM   *
                         C      ;;***************************************************************
                         C       IF dev eq cpd
                         C       ELSE
  E00C                   C      diocdb:	ds	9,0ffh
                         C       ENDIF
  E00C                   C      diocfl	equ	diocdb+0
  E00D                   C      diocde	equ	diocdb+1
  E00E                   C      dioctr	equ	diocdb+2
  E00F                   C      diocsi	equ	diocdb+3
  E010                   C      diocse	equ	diocdb+4
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-79


  E011                   C      diocsl	equ	diocdb+5
  E012                   C      diocsn	equ	diocdb+6
  E013                   C      diocad	equ	diocdb+7
  0009                   C      diocdl	equ	9		;;Anzahl der Bytes
                         C      
                         C       IF dev eq cpd
                         C       ELSE
                         C        IF disknb eq 0
                         C        ENDIF
                         C       ENDIF
                                 IF disknb ne 0
                         C      	include BIOSDSKT
                         C      ;*********************************************************
                         C      ; physischer Disketten-Transfer
                         C      ; Aenderungen:
                         C      ; - Es koennen 9 statt bisher 4 phys. Sektoren auf einmal gelesen werden
                         C      ;!-!Schnittstellenaenderung bei SektId lesen:
                         C      ;   ft.anz muss <>0 sein (zuvor beliebig, bei =0 kein Transfer)
                         C      ;   ft.len muss 0..3 sein (zuvor beliebig, bei >3 fehlerhafte Tabellenmodif.)
                         C      ;   ft.kom, Bit 7 eingefuehrt: =0 Vorderseite, =1 Rueckseite
                         C      ;   ft.kom, Bit 0 (Verify nach Schreiben) auf Bit 6 verlegt
                         C      ;   ft.kom, Bit 0 =1 bedeutet "keine Fehlerwiederholung"
                         C      ; - Floppy-Treiber auch fuer Variante K5120/22 generierbar
                         C      ; 06.07.88
                         C      ; - Motor-Start-Wait von 254 auf 252 veraendert (2.5 Umdrehungen)
                         C      ;   (ist bei einigen Laufwerken wegen PreReady notwendig)
                         C      ; 03.11.22
                         C      ; - Variante K5122 eingefuegt
                         C      ; 25.09.89
                         C      ; - bei MFS 1.2 bei Mehr-Sektor-Transfer "Fault reset" zwischen den Sektoren
                         C      ;*********************************************************
                         C      
                         C      ; Aufruf:
                         C      ; -------
                         C      ; Bereitstellung der Parameter auf den Bytes:
                         C      
                         C      ;       ft.kom:	db	0	; bit0 - =1 ohne Fehlerwiederholung
                         C      ;				     1 - =1 lesen ft.len von beliebigem Sektor
                         C      ;				     2 - =0 lesen ; =1 schreiben Sektor(en)
                         C      ;				     3 - =0-FM; =1-MFM   (5"FM nur bei PC1715)
                         C      ;				     4 - =0-8"; =1-5"
                         C      ;				     5 - =0- 40-Spur-Laufwerk; =1- 80-Spur-LW
                         C      ;				     6 - =1 bei verify nach schreiben
                         C      ;				     7 - =0 Vorderseite, =1 Rueckseite
                         C      ;	ft.adr: dw	0	; Transferadresse
                         C      ;	ft.lwn: db	0	; 0..3 phys. Laufwerksnummer
                         C      ;	ft.trk: db	0	; 0..  track
                         C      ;	ft.sid: db	0	; 0..ff side (side=0 auf Rueckseite moeglich!)
                         C      ;	ft.sec: db	0	; 0..  sector (beliebig bei SektId lesen)
                         C      ;	ft.len: db	0	; 0..3 Sektorlaenge (auch 0..3 bei SektId les.)
                         C      ;	ft.anz: db	0	; 0..9 Anzahl der zu uebertragenden Sektoren
                         C      ;				;      =0: nur Positionieren
                         C      ;				;      (<>0 bei SektId lesen)
                         C      ;       ft.stp: db	0	;      Anzahl der Stepimpulse von Spur zu Spur
                         C      ;	ft.sti: db	0	;      Schrittzeit von Spur zu Spur
                         C      ;				;      in 0,1ms Einheiten
                         C      ;
                         C      ;	call	floppy
                         C      ;       ...			; in A steht Ergebniskode
                         C      ;				; alle Register (auch IX) undef.
                         C      ;
                         C      ; Ergebniskode (in Reg. A):
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-80


                         C      ;	00h kein Fehler (Z-Flag nicht von floppy gesetzt)
                         C      ;	'C' CRC-Fehler
                         C      ;	'D' LW nicht existent
                         C      ;	'R' Geraet nicht bereit, aber existent
                         C      ;	'L' unzulaessige Transferlaenge
                         C      ;	'S' Sektor nicht gefunden
                         C      ;	'T' Spurnummer zu gross
                         C      ;	'U' keine Marke gefunden
                         C      ;	'W' Diskette schreibgeschuetzt
                         C      
                         C      ; Paramfeld wird an folgenden Stellen veraendert:
                         C      ;  Komm. "Lesen Sekt,Id.":	ft.trk .. ft.len gestellt
                         C      ;  Komm. "Schreiben mit Verify":ft.kom, bit 2 geloescht
                         C      ;**************************************************
                         C      
  0004                   C      maxlw	equ	4		; Anzahl der Laufwerke (1..4)
                         C      
                         C      ; Adressen der Floppy-Karte
                         C      ;==========================
                         C      
                         C       IF (fdc eq k5120) or (fdc eq k5122)
                         C      ;Steuer-PIO
  0010                   C      flcoad    equ  10h  ;PORT A
  0011                   C      flcoac    equ  11h
  0012                   C      flcobd    equ  12h  ;PORT B
  0013                   C      flcobc    equ  13h
                         C      
                         C      ;Daten-PIO
  0014                   C      fldaad    equ  14h  ;Port A Schreib-Daten
  0015                   C      fldaac    equ  15h
  0016                   C      fldabd    equ  16h  ;Port B Lese-Daten
  0017                   C      fldabc    equ  17h
                         C      
                         C      ;Select-Latch
  0018                   C      flsel     equ  18h  ;Bit 7..4 /Sel LW3..0;Bit 3..0  /LCK  LW 3..0
                         C      ;
                         C       ENDIF
                         C      
                         C       IF (fdc eq f1715)
                         C       ENDIF
                         C      
                         C      ;; Legende AMF:
                         C      ;;   Port A
                         C      ;;  | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |
                         C      ;;    |   |   |   |   |   |   |   |__ A  /WE  0-Schreiben ein
                         C      ;;    |   |   |   |   |   |   |______ A   MK  lesen  0-MFM-A1 Erkennung
                         C      ;;    |   |   |   |   |   |                          1-FM-Mark., MFM-C2 Erkenn.
                         C      ;;    |   |   |   |   |   |               schreiben  0-Takt fuer MFM
                         C      ;;    |   |   |   |   |   |                          1-Marken FM und A1 MFM
                         C      ;;    |   |   |   |   |   |__________ A  /SIDE 0-Kopf Seite 1; 1-Kopf Seite 0
                         C      ;;    |   |   |   |   |        oder   A  /FR   0-Fault reset;  1-kein FR
                         C      ;;    |   |   |   |   |______________ A  /STR 0-AMF aktiv
                         C      ;;    |   |   |   |                           1-AMF ausgeschaltet
                         C      ;;    |   |   |   |__________________ A   MK1 lesen  0-Informationen einlesen
                         C      ;;    |   |   |                                      1-nur 1 einlesen
                         C      ;;    |   |   |                           schreiben  0-FM-Daten schreiben
                         C      ;;    |   |   |                                      1-MFM und FM-Marken schr.
                         C      ;;    |   |   |______________________ A   MR, SD     0-steppen Richtung aussen
                         C      ;;    |   |                                          1-Marke-erkannt loeschen
                         C      ;;    |   |                                            steppen Richtung innen
                         C      ;;    |   |__________________________ A  /HL         0-Kopf geladen
                         C      ;;    |                                              1-Kopf entladen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-81


                         C      ;;    |______________________________ A  /ST         0-Stepsignal an LW ein
                         C      ;;                                                   1-Stepsignal an LW aus
                         C      ;;
                         C      ;;  Port B
                         C      ;;  | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |
                         C      ;;    |   |   |   |   |   |   |   |__ E  /RDY  0-Laufwerk bereit
                         C      ;;    |   |   |   |   |   |   |                1-Laufwerk nicht bereit
                         C      ;;    |   |   |   |   |   |   |______ E  /MKE  0-Marke erkannt
                         C      ;;    |   |   |   |   |   |                    1-Marke noch nicht erkannt
                         C      ;;    |   |   |   |   |	 oder PC1715  E   MKE  1-Marke erkannt
                         C      ;;    |   |   |   |   |   | u.K5122            0-Marke noch nicht erkannt
                         C      ;;    |   |   |   |   |   |__________ E  /SYN  ???? (K5120)
                         C      ;;    |   |   |   |   |  oder K5122   A  /HF   0-Takt fuer 8" MFM
                         C      ;;    |   |   |   |   |                        1-Takt fuer 5" MFM und 8" FM
                         C      ;;    |   |   |   |   |  oder PC1715: A   MFM  0-FM-Aufzeichnung
                         C      ;;    |   |   |   |   |                        1-MFM-Aufzeichnung
                         C      ;;    |   |   |   |   |______________ A   PRE  0-schreiben ohne Prekompensation
                         C      ;;    |   |   |   |                            1-schreiben mit         "
                         C      ;;    |   |   |   |__________________ E  /FA   0-Fehler in der AMF aufgetreten
                         C      ;;    |   |   |                                1-kein Fehler aufgetreten
                         C      ;;    |   |   |          oder PC1715: A   FO   0-5"-Disketten
                         C      ;;    |   |   |                                1-8"-Disketten
                         C      ;;    |   |   |______________________ E  /WP   0-Schreibschutz ist ein
                         C      ;;    |   |                                    1-kein Schreibschutz
                         C      ;;    |   |__________________________ E  /FW   0-Laufwerk meldete Schreibfehler
                         C      ;;    |                                        1-Laufwerk meldete keinen Fehler
                         C      ;;    |______________________________ E  /T0   0-Kopf steht auf Spur 0
                         C      ;;                                             1-Kopf steht nicht auf Spur 0
                         C      
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                         C      ;	FLOPPY-Treiber
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
  E015                   C      floppy:
                         C      
                         C      ; Anfangswerte stellen
  E015    3A E2ED        C      	ld	a,(ft.kom)
  E018    E6 01          C      	and	1		;Fehlerwiederholung?
  E01A    20 02          C      	jr	nz,setecr	;nein, A=0+1 (keine Wiederholung)
  E01C    3E 10          C      	ld	a,15+1
  E01E    32 E313        C      setecr:	ld	(crerc),a	; Fehlerzaehler fuer CRC-Fehlerwiederholungen
  E021    20 02          C      	jr	nz,setesp
  E023    3E 05          C      	ld	a,4+1		; Fehlerzaehler fuer Spurfindewiederholungen
  E025    32 E314        C      setesp:	ld	(sperc),a
                         C      
                         C      ; Laufwerksnummer pruefen
  E028    3A E2F0        C      	ld	a,(ft.lwn)	; LW
                         C      ;	cp	maxlw		; LW < groesster LW-Nr.?
                         C      ;	jr	nc,nolw		; -> nein, Fehler: LW nicht existent
  E02B    4F             C      	ld	c,a		; merken LW fuer Motor-an-Test
  E02C    47             C      	ld	b,a		; fuer djnz
  E02D    B7             C      	or	a		; LW=0?
  E02E    3A E316        C      	ld	a,(lwexis)
  E031    28 04          C      	jr	z,drv0		; ->ja
  E033    0F             C      sp13: 	rrca
  E034    0F             C      	rrca
  E035    10 FC          C      	djnz	sp13
  E037    E6 03          C      drv0: 	and	3
  E039    20 05          C      	jr	nz,drv0a
                         C      
  E03B    3E 44          C      nolw: 	ld	a,'D'		; LW nicht existent
  E03D    C3 E1E9        C      	jp	fehret		; -> Fehler
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-82


  E040                   C      drv0a:
                         C      ; LW selektieren und Motor einschalten
  E040    AF             C      	xor	a
  E041    32 E2BE        C      	ld	(pretx+1),a	;Motorabschaltung verhindern
  E044    3D             C      	dec	a		;A:=255
  E045    CD E2A5        C      	call	fl.sto		;Index-Ueberwachung ein
  E048    CB D9          C      	set	3,c		; Motor-an-Bit setzen
  E04A    21 E317        C      	ld	hl,alwnr
  E04D    7E             C      	ld	a,(hl)
  E04E    B9             C      	cp	c		; ist es das richtige LW und Motor an?
  E04F    3E 6A          C      	ld	a,+pvrw2-(xpvrw+2) ; jr z,pvrw2 (keine Vertikalstab.)
  E051    28 42          C      	jr	z,dskmon	; ->ja, Kopf ist noch aufgesetzt
                         C      ; falsches LW oder Motor des LW aus
  E053    CD E2D8        C      	call	flres		; alte Spurnr. merken
                         C      
                         C      ; neues LW anwaehlen, Motor einschalten und alte Spurnr. holen
  E056    71             C      	ld	(hl),c		; neues LW, Motor-an-Bit
  E057    EB             C      	ex	de,hl		;merken ^alwnr
  E058    CB 99          C      	res	3,c		; alte Spurnr. holen
  E05A    06 00          C      	ld	b,0
  E05C    21 E319        C      	ld	hl,spnrl
  E05F    09             C      	add	hl,bc
  E060    7E             C      	ld	a,(hl)
  E061    32 E318        C      	ld	(aspnr),a
  E064    41             C      	ld	b,c
  E065    04             C      	inc	b
  E066    3E 77          C      	ld	a,077h		; LW-Anwahlbyte bilden (mit Lock)
  E068    07             C      nfdei2: rlca
  E069    10 FD          C      	djnz	nfdei2
  E06B    D3 18          C      	out	(flsel),a	; Laufwerk selektieren (und evtl. Motor ein)
                         C       IF fdc eq f1715
                         C       ENDIF
  E06D    3E A9          C      	ld	a,10101001b	; Kopf laden, Fault reset
  E06F    D3 10          C      	out	(flcoad),a
                         C      
                         C      ; Motor-Start
  E071    2E FD          C      	ld	l,252+1		;von 255 auf 252, d.h. mind 2 Umdrehungen?
  E073    3A E2ED        C      	ld	a,(ft.kom)
  E076    CB 67          C      	bit	4,a		;5"?
  E078    28 06          C      	jr	z,dskmo1	;nein
  E07A    CB 6F          C      	bit	5,a		;5" 40 Spur?
  E07C    20 02          C      	jr	nz,dskmo1	;nein
  E07E    2E FB          C      	ld	l,250+1		;von 255 auf 250,
                         C      				; d.h. mind. 4 volle Umdrehungen?
                         C      				;(bei MFS 1.2 kommt evtl. ready zu frueh)
  E080                   C      dskmo1:
  E080    3A E2B6        C      dskdaw:	ld	a,(fl.zto)	;Index-Interrupt-Zaehler
  E083    BD             C      	cp	l		;entprechend viele Umdrehungen vorbei?
  E084    38 0D          C      	jr	c,dskda		;ja
  E086    0D             C      	dec	c		; warten, bis Diskette eingeschoben
  E087    20 F7          C      	jr	nz,dskdaw
  E089    10 F5          C      	djnz	dskdaw
  E08B    EB             C      	ex	de,hl
  E08C    CB 9E          C      	res	3,(hl)		;loeschen Motor an Bit
  E08E    3E 52          C      	ld	a,'R'		;LW nicht bereit
  E090    C3 E1E9        C      	jp	fehret
  E093    3E 61          C      dskda:	ld	a,+pvrw1-(xpvrw+2) ; jr z,pvrw1 (mit Vertikal-Stabil.)
  E095                   C      dskmon:
  E095    32 E0DD        C      	ld	(xpvrw+1),a	; Vertikal-Stabilisierung ein/aus
                         C      
                         C      
                         C       IF dsk8fm+dsk8mf+dsk5fm; Standard ist 5"MFM
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-83


                         C       ELSE
                         C       IF @write
  E098    21 E4AD        C      	ld	hl,diwmfm
  E09B    22 E412        C      	ld	(dioop),hl	;Schreiben einstellen (falls Lesen war)
                         C       ENDIF
                         C       ENDIF
                         C       if dsk80
  E09E    3A E2ED        C      	ld	a,(ft.kom)
                         C       if dsk8fm+dsk8mf
                         C       endif
  E0A1    CB 6F          C      	bit	5,a		;80-Spur-LW?
  E0A3    3E 19          C      	ld	a,25		;Spur, ab der mit Praekomp.
  E0A5    28 02          C      	jr	z,dprec2	;nein
  E0A7    3E 29          C      	ld	a,41
  E0A9    32 E163        C      dprec2:	ld	(dpretr),a
  E0AC                   C      dprecn:
                         C       endif
                         C      
                         C      ; modifizieren entspr. phys. Sektorlaenge
  E0AC    3A E2F4        C      	ld	a,(ft.len)
  E0AF    32 E3C1        C      	ld	(sidlen),a
  E0B2    21 E327        C      	ld	hl,dsln0-dslnl
  E0B5    47             C      	ld	b,a
  E0B6    04             C      	inc	b
  E0B7    11 0009        C      	ld	de,dslnl
  E0BA    19             C      dtrsll:	add	hl,de
  E0BB    10 FD          C      	djnz	dtrsll
  E0BD    EB             C      	ex	de,hl
  E0BE    21 E31D        C      	ld	hl,dslnmt	;Tabelle der Modif.adr.
  E0C1    CD E246        C      	call	flmodf
                         C      
                         C      ; Kopf positionieren
  E0C4    21 E2F1        C      	ld	hl,ft.trk	; gewuenschte Spur
  E0C7    7E             C      	ld	a,(hl)
  E0C8    B7             C      	or	a		;Spur 0?
  E0C9    20 0D          C      	jr	nz,npost0	;nein
  E0CB    3A E2F5        C      	ld	a,(ft.anz)	;Sektorzahl
  E0CE    B7             C      	or	a		;nur positionieren auf Spur 0 (FORMAT-Progr.)
  E0CF    28 4F          C      	jr	z,trk0		;ja, Spur 0 immer ueber Recalibrate
  E0D1    3A E2ED        C      	ld	a,(ft.kom)
  E0D4    CB 4F          C      	bit	1,a		;Lesen Sekt.id Spur 0?
  E0D6    20 53          C      	jr	nz,trk0s	;ja, Lesen Sektid Spur 0 ueber Recalibrate
  E0D8    3A E318        C      npost0:	ld	a,(aspnr)	; stimmt Spur?
  E0DB    BE             C      	cp	(hl)
  E0DC    28 61          C      xpvrw:	jr	z,pvrw1		; -> ja, Kopf evtl. vertikal stabilisieren
                         C      				; auf jr z,pvrw2, wenn Kopf noch aufgesetzt
  E0DE                   C      spprty:				;Wiederholung bei fehlerhafter Spur
                         C      ; Positionierung auf ft.trk
  E0DE    3A E2F1        C      spe: 	ld	a,(ft.trk)
  E0E1    06 8F          C      	ld	b,08fh		; stepout-Befehl
  E0E3    21 E318        C      	ld	hl,aspnr
  E0E6    BE             C      	cp	(hl)		; auf richtiger Spur angekommen?
  E0E7    28 56          C      	jr	z,phrw		; -> ja, Kopf horizontal stabilisieren
  E0E9    38 0D          C      	jr	c,spre		; -> stepout
  E0EB    FE 55          C      xmaxtr: cp	85		; Spur zu gross?
  E0ED    38 05          C      	jr	c,spve		; -> nein, stepin
  E0EF    3E 54          C      	ld	a,'T'		; Fehler: Spurnr. zu gross
  E0F1    C3 E1E9        C      	jp	fehret
                         C      
                         C      ; stepin
  E0F4    06 AF          C      spve:	ld	b,0afh		; stepin-Befehl
  E0F6    34             C      	inc	(hl)		; alte Spurnr. erhoehen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-84


  E0F7    34             C      	inc	(hl)		; wegen stepout-dec
                         C      
                         C      ; stepout
  E0F8    35             C      spre: 	dec	(hl)		; alte Spurnr. verringern
  E0F9    CD E0FE        C      	call	step
  E0FC    18 E0          C      	jr	spe
                         C      
                         C      ; steppen
  E0FE    3A E2F6        C      step: 	ld	a,(ft.stp)	; Anzahl der Stepimpulse pro Step
  E101    0E 10          C      step0: 	ld	c,flcoad
  E103    ED 41          C      	out	(c),b		; select direction
                         C      ;;;	push	bc
                         C      ;;;	ld	b,0
                         C      ;;;step1: 	djnz	step1		; 1,3ms warten
                         C      ;;;	pop	bc
  E105    C5             C      step2: 	push	bc
  E106    CB B8          C      	res	7,b
  E108    F3             C      	di			;verhindern Unterbrechung
  E109    ED 41          C      	out	(c),b
  E10B    CB F8          C      	set	7,b
  E10D    ED 41          C      	out	(c),b		; step
  E10F    FB             C      	ei
  E110    ED 4B E2F7     C      	ld	bc,(ft.sti)	; 13,2 / 11,6 / 3,0 ms Schrittzeit
  E114    06 13          C      stepw1: ld	b,19		;(19*13)/(256*9600)=0.0001
  E116    10 FE          C      stepw: 	djnz	stepw		;0.1 ms warten
  E118    0D             C      	dec	c
  E119    20 F9          C      	jr	nz,stepw1
  E11B    C1             C      	pop	bc
  E11C    3D             C      	dec	a
  E11D    20 E6          C      	jr	nz,step2
  E11F    C9             C      	ret
                         C      
                         C      ; Spur 0 anfahren (Recalibrate)
  E120    06 02          C      trk0:	ld	b,2		; nach innen, falls auf Spur -1
  E122    C5             C      trk0i:	push	bc
  E123    06 AF          C      	ld	b,0afh	 	; stepin
  E125    CD E0FE        C      	call	step
  E128    C1             C      	pop	bc
  E129    10 F7          C      	djnz	trk0i
  E12B    DB 12          C      trk0s:	in	a,(flcobd)
  E12D    07             C      	rlca			; Spur 0 erreicht?
  E12E    30 09          C      	jr	nc,trk0f	; -> ja
  E130    06 8F          C      	ld	b,08fh		; stepout-Befehl
  E132    3E 01          C      	ld	a,1		; in phys. Schritten
  E134    CD E101        C      	call	step0
  E137    18 F2          C      	jr	trk0s
  E139    AF             C      trk0f: 	xor	a
  E13A    32 E318        C      	ld	(aspnr),a	; aktuelle Spurnr ist 0
  E13D    18 9F          C      	jr	spprty
                         C      
                         C      
                         C      ; Kopf stabilisieren (horizontal und vertikal)
  E13F                   C      pvrw1:	; Kopf vertikal stabilisieren
  E13F                   C      phrw:	; Kopf horizontal (und evtl. auch vertikal) stabilisieren
  E13F    3E 32          C      	ld	a,50		; 50 ms (fuer alle Laufwerkstypen)
  E141    06 BD          C      phrww1: ld	b,189		; (189*13)/(256*9600)=0.001
  E143    10 FE          C      phrww: 	djnz	phrww		; 1 ms warten
  E145    3D             C      	dec	a
  E146    20 F9          C      	jr	nz,phrww1
  E148                   C      pvrw2:	; Kopf war aufgesetzt und Spur stimmte auch - keine Stabilis.
                         C      
  E148                   C      rdwr:
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-85


                         C      ; Anfangswerte fuer Transfer der physischen Sektoren
  E148    3A E2F5        C      	ld	a,(ft.anz)	; Anzahl der zu uebertragenden phys. Sektoren
  E14B    32 E3B6        C      	ld	(secan1),a
  E14E    32 E258        C      	ld	(secanz),a	; fuer CRC-Berechnung
                         C      
  E151    3A E2F1        C      	ld	a,(ft.trk)	; Spur
  E154    32 E3BD        C      	ld	(sidtr),a
  E157    21 E2F6        C      	ld	hl,ft.stp
  E15A    CB 46          C      	bit	0,(hl)		;Doppelschritte?
  E15C    28 01          C      	jr	z,dprec1	;nein
  E15E    87             C      	add	a,a		;sonst phys. Spur verdoppeln
  E15F                   C      dprec1:
                         C      ; evtl. Precompensation einschalten
  E15F    01 0412        C      	ld	bc,00000100b*256+flcobd
  E161                   C      dfrcod	equ	$-1		; Frequenzcode
  E162    FE 19          C      	cp	25		; Spur ab der mit writeprecomp.
  E163                   C      dpretr	equ	$-1
  E164    38 02          C      	jr	c,prec		; <, ohne Precompensation
  E166    CB D8          C      	set	3,b		; >= , mit
  E168    ED 41          C      prec: 	out	(c),b
                         C      
  E16A    3A E2F3        C      	ld	a,(ft.sec)	; erste zu uebertr. Sektornr.
  E16D    32 E3C0        C      	ld	(sidsec),a
  E170    3A E2F2        C      	ld	a,(ft.sid)
  E173    32 E3BE        C      	ld	(sidsid),a
                         C      
                         C       IF dskds ; double sided
                         C      ; evtl. side 1 anwaehlen vorbereiten
  E176    3A E2ED        C      	ld	a,(ft.kom)
  E179    21 E354        C      	ld	hl,dsidmt
  E17C    46             C      	ld	b,(hl)
  E17D    23             C      dsidmz:	inc	hl
  E17E    5E             C      	ld	e,(hl)
  E17F    23             C      	inc	hl
  E180    56             C      	ld	d,(hl)
  E181    EB             C      	ex	de,hl
  E182    CB 7F          C      	bit	7,a		; side 0?
  E184    28 04          C      	jr	z,pside0	; ja
  E186    CB 96          C      	res	2,(hl)		; side 1 einstellen
  E188    18 02          C      	jr 	pside1
  E18A    CB D6          C      pside0:	set	2,(hl)
  E18C    EB             C      pside1:	ex	de,hl
  E18D    10 EE          C      	djnz	dsidmz
  E18F    CB 6F          C      	bit	5,a		;40-Spur LW?
  E191    20 03          C      	jr	nz,pside2	;nein
  E193    EB             C      	ex	de,hl		;diom11
  E194    CB 96          C      	res	2,(hl)		;fault reset zwischen den Sektoren
  E196                   C      pside2:
                         C       ENDIF
                         C      
                         C      ; evtl. nur Lesen Sektor-Id.
  E196    3A E2ED        C      	ld	a,(ft.kom)
  E199    CB 4F          C      	bit	1,a		; Lesen Sekt.Id?
  E19B    21 E3AE        C      	ld	hl,dio
  E19E    28 03          C      	jr	z,srdsid	; -> nein
  E1A0    21 E414        C      	ld	hl,diotsr
  E1A3    22 E36E        C      srdsid:	ld	(diortn),hl
                         C      
                         C       IF @write
  E1A6    3A E2ED        C      	ld	a,(ft.kom)	; Schreiben?
  E1A9    CB 57          C      	bit	2,a
  E1AB    20 08          C      	jr	nz,writpt	; -> ja, Schreibroutine steht auf dioop
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-86


                         C       ENDIF
  E1AD    21 E469        C      	ld	hl,diord
  E1B0    22 E412        C      	ld	(dioop),hl	; read einstellen
                         C      
                         C       IF @write
  E1B3    18 22          C      	jr	dtrdyt
  E1B5                   C      writpt:		; pruefen, ob Schreiben erlaubt ist
  E1B5    DB 12          C      	in	a,(flcobd)
  E1B7    CB 6F          C      	bit	5,a		; /WP
  E1B9    3E 57          C      	ld	a,'W'		; Fehler: write protected
  E1BB    CA E1E9        C      	jp	z,fehret
                         C      
                         C      ; CRC-Zeichen der zu schreibenden Daten berechnen und in crcber ablegen
  E1BE    2A E2EE        C      	ld	hl,(ft.adr)
  E1C1    DD 21 E2F8     C      	ld	ix,crcber	; Pointer auf 1. Daten-CRC stellen
  E1C5    DD 36 00 FB    C      crcbes: ld	(ix),0fbh	; Datenbeginn
  E1C9    CD E268        C      	call	crcbd		; CRC eines phys. Sektors berechnen
  E1CC    DD 72 00       C      	ld	(ix+0),d
  E1CF    DD 73 01       C      	ld	(ix+1),e	; ... und ablegen
  E1D2    CD E253        C      	call	crcnb		; weiterer phys. Sektor?
  E1D5    20 EE          C      	jr	nz,crcbes	; -> ja
                         C       ENDIF ;@write
                         C      
                         C      
                         C      ; Disk inzwischen ready?
                         C      
  E1D7                   C      dtrdyt:
  E1D7    DB 12          C      dtrdyz:	IN	A,(flcobd)
  E1D9    1F             C      	RRA			;ready-bit =0?
  E1DA    38 FB          C      dtrdyw:	JR	C,dtrdyz	;nein, 5" Disk not ready
                         C      				;auf jr c,$+2 modif bei 8"
                         C      
  E1DC    3E 05          C      	ld	a,5
  E1DE    CD E2A5        C      	call	fl.sto		;bei evtl. Fehlerwiederholung
                         C      				; timeout-Wert wieder hochstellen
                         C      				; fuer Ueberwachung auf fehlende Marke
  E1E1    3A E2F5        C      	ld	a,(ft.anz)	;Sektorzahl
  E1E4    B7             C      	or	a		; nur positionieren?
  E1E5    C2 E367        C      	jp	nz,diorun	; -> nein, Start des Transfers
                         C      
                         C      ; kein Fehler aufgetreten
  E1E8    AF             C      noerr:	xor	a
                         C      
                         C      ; Fertigmelden, Ergebnis in A
  E1E9    F5             C      fehret:	push	af
  E1EA    21 E2BE        C      	ld	hl,pretx+1	;Motorabschaltung ueber Index-Interrupt
  E1ED    36 0B          C      	ld	(hl),pret3-pret4;jr pret4
  E1EF    3E 14          C      	ld	a,20		;nach 20*200ms = 4 sec
  E1F1    CD E2A5        C      	call	fl.sto
  E1F4    F1             C      	pop	af
  E1F5    C9             C      	ret
                         C      
                         C      ; normale Beendigung
                         C      ;===================
                         C      
                         C      ; Schreiben
  E1F6    21 E2ED        C      dtrwre:	ld	hl,ft.kom
  E1F9    CB 76          C      	bit	6,(hl)		;Kontrollesen?
  E1FB    28 EB          C      	jr	z,noerr		;nein, fertig
  E1FD    CB 96          C      	res	2,(hl)		;sonst schreiben loeschen (d.h. auf lesen)
  E1FF    C3 E148        C      	jp	rdwr		;und auf gleichen Puffer zuruecklesen
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-87


                         C      ; Lesen
  E202    2A E2EE        C      dtrrde:	ld	hl,(ft.adr)
  E205    DD 21 E2F8     C      	ld	ix,crcber
  E209    CD E268        C      crcbel:	call	crcbd		;CRC bilden
  E20C    CD E25E        C      	call	crcvgl		; und vergleichen
  E20F    20 07          C      	jr	nz,crcerx	; -> Fehler
  E211    CD E253        C      	call	crcnb		;noch ein Sektor?
  E214    20 F3          C      	jr	nz,crcbel	;ja
  E216    18 D0          C      	jr	noerr
                         C      
                         C      ; Fehlerbehandlung
                         C      ;=================
                         C      ; blieb weiterer Versuch, Sektor CRC-richtig reinzubekommen?
  E218    21 E313        C      crcerx: ld	hl,crerc
  E21B    35             C      	dec	(hl)
  E21C    C2 E148        C      	jp	nz,rdwr		; -> ja, alles noch mal
  E21F    3E 43          C      	ld	a,'C'		; Fehler: CRC-Zeichen falsch
  E221    18 C6          C      	jr	fehret
                         C      
                         C      ; Sektor nicht gefunden, evtl. falsche Spur
  E223                   C      serrx:
                         C      ; blieb weiterer Versuch, die richtige Spur zu finden?
  E223    21 E314        C      	ld	hl,sperc
  E226    35             C      	dec	(hl)
  E227    28 15          C      	jr	z,sperr2	; Wiederhlg. abgelaufen
  E229    3E 02          C      	ld	a,2
  E22B    BE             C      	cp	(hl)		;> 2 Wiederhlg?
  E22C    DA E120        C      	jp	c,trk0		;ja, Spur neu anfahren
  E22F    06 8F          C      	ld	b,08fh		;stepout
  E231    28 05          C      	jr	z,sperr4	;=2 Wiederhlg., stepout
  E233    06 AF          C      	ld	b,0afh		;stepin
  E235    CD E0FE        C      	call	step		;2 mal (zuvor war stepout)
  E238    CD E0FE        C      sperr4:	call	step
  E23B    C3 E13F        C      	jp	phrw		;Wiederholung
                         C      
  E23E    3E 53          C      sperr2:	ld	a,'S'		; Fehler: Sektor ist nicht zu finden
  E240    18 A7          C      	jr	fehret
                         C      
                         C      
  E242                   C      fl.to1: ; keine Sektor-Marke gefunden
  E242    3E 55          C      	ld	a,'U'		; time-out (undefind)
  E244    18 A3          C      	jr	fehret
                         C      
                         C      ; Modifizierung entsprechend Steuertabelle
                         C      ;=========================================
                         C      ; i HL	Tabelle der Modifizierungsadressen (wohin)
                         C      ; i DE	Tabelle der Modifizierungsbytes    (was)
  E246    46             C      flmodf:	ld	b,(hl)		;Anzahl der Adressen
  E247    23             C      dslnmz:	inc	hl
  E248    C5             C      	push	bc
  E249    4E             C      	ld	c,(hl)
  E24A    23             C      	inc	hl
  E24B    46             C      	ld	b,(hl)		;bc:=wohin
  E24C    1A             C      	ld	a,(de)		;a:=was
  E24D    13             C      	inc	de
  E24E    02             C      	ld	(bc),a
  E24F    C1             C      	pop	bc
  E250    10 F5          C      	djnz	dslnmz
  E252    C9             C      	ret
                         C      
                         C      ; CRC-Berechnung
                         C      ;===============
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-88


                         C      
                         C      ; von weiterem Sektor CRC-Zeichen berechnen?
                         C      ; IX wird weitergestellt
  E253    DD 23          C      crcnb: 	inc	ix		; CRC-Pointer erhoehen
  E255    DD 23          C      	inc	ix
  E257    3E FF          C      	ld	a,0ffh
  E258                   C      secanz	equ	$-1
  E259    3D             C      	dec	a
  E25A    32 E258        C      	ld	(secanz),a
  E25D    C9             C      	ret
                         C      
                         C      ; CRC-Vergleich DE mit (IX)
  E25E    DD 7E 00       C      crcvgl: ld	a,(ix+0)
  E261    BA             C      	cp	d
  E262    C0             C      	ret	nz
  E263    DD 7E 01       C      	ld	a,(ix+1)
  E266    BB             C      	cp	e
  E267    C9             C      	ret
                         C      
                         C      ; von einem phys. Sektor ab HL die CRC-Zeichen berechnen
                         C      ; HL wird weitergestellt
  E268    11 CDB4        C      crcbd:	ld	de,0cdb4h	;CRC Anfangswert
  E269                   C      crcbeg	equ	$-2
  E26B    DD E5          C      	push	ix
  E26D    E3             C      	ex	(sp),hl		;hl:= ^Datenbeginn-Byte
  E26E    06 01          C      	ld	b,1
  E270    CD E282        C      	call	bercrc		;CRC ueber Datenbeginn-Byte
  E273    E3             C      	ex	(sp),hl
  E274    DD E1          C      	pop	ix
  E276    06 01          C      	ld	b,1
  E277                   C      fl.tsb	equ	$-1		; Zahl der 128er Bloecke
  E278    C5             C      sp74: 	push	bc
  E279    06 80          C      	ld	b,128
  E27B    CD E282        C      	call	bercrc
  E27E    C1             C      	pop	bc
  E27F    10 F7          C      	djnz	sp74
  E281    C9             C      	ret
                         C      
                         C      ; von HL an B Zeichen auf DE als CRC-Polynom draufrechnen
  E282    7E             C      bercrc: ld	a,(hl)
  E283    AA             C      	xor	d
  E284    57             C      	ld	d,a
  E285    0F             C      	rrca
  E286    0F             C      	rrca
  E287    0F             C      	rrca
  E288    0F             C      	rrca
  E289    E6 0F          C      	and	0fh
  E28B    AA             C      	xor	d
  E28C    57             C      	ld	d,a
  E28D    0F             C      	rrca
  E28E    0F             C      	rrca
  E28F    0F             C      	rrca
  E290    4F             C      	ld	c,a
  E291    E6 1F          C      	and	1fh
  E293    AB             C      	xor	e
  E294    5F             C      	ld	e,a
  E295    79             C      	ld	a,c
  E296    0F             C      	rrca
  E297    E6 F0          C      	and	0f0h
  E299    AB             C      	xor	e
  E29A    5F             C      	ld	e,a
  E29B    79             C      	ld	a,c
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-89


  E29C    E6 E0          C      	and	0e0h
  E29E    AA             C      	xor	d
  E29F    53             C      	ld	d,e
  E2A0    5F             C      	ld	e,a
  E2A1    23             C      	inc	hl
  E2A2    10 DE          C      	djnz	bercrc
  E2A4    C9             C      	ret
                         C      
                         C      ; Aktivieren Indexpunktueberwachung
                         C      ; i A	Zaehler (wird bis 0 runtergezaehlt)
                         C      ; nur Reg. A zerstoert
                         C      
  E2A5    32 E2B6        C      fl.sto:	ld	(fl.zto),a	;Setzen Zaehler fuer Indexpunkte
  E2A8    3E 83          C      	ld	a,83h		;zulassen Indexinterrupt
  E2AA    D3 11          C      	out	(flcoac),a
  E2AC    C9             C      	ret
                         C      
                         C      ; Interruptbehandlungsroutine: time-out-Zeit abgelaufen
                         C      ; ausgeloest durch Index-Interrupt
  E2AD    ED 73 E5D7     C      itimeo: ld	(intsp),sp
  E2B1    31 F0B5        C      	ld	sp,intstk
  E2B4    F5             C      	push	af
  E2B5    3E 00          C      	ld	a,0		; Zaehler fuer time-out Takte
  E2B6                   C      fl.zto	equ	$-1
  E2B7    3D             C      	dec	a		; time-out -1
  E2B8    32 E2B6        C      	ld	(fl.zto),a
  E2BB    20 10          C      	jr	nz,pret1	;-> nicht abgelaufen
  E2BD    18 0B          C      pretx:	jr	pret3		;modif. auf "jr pret4" waehrend Transfer
  E2BF                   C      pret4:
                         C       IF cpu eq k2526
  E2BF    3E A9          C      	ld	a,10101001b	;Time out waehrend Transfer
  E2C1    D3 10          C      	out	(flcoad),a	;CPU 2 stoppen
  E2C3    3E 00          C      	ld	a,dtrtor-dtrwjr
  E2C5    32 E39E        C      	ld	(dtrret),a	;Reaktionsroutine "keine Marke gefunden"
                         C       ENDIF
  E2C8    18 03          C      	jr	pret1
  E2CA    CD E2D0        C      pret3:	call	headup
  E2CD    C3 E5D5        C      pret1: 	jp	intraf		; allg. Ausgang Interruptroutinen
                         C      
                         C      ; Motor-Abschaltung von aussen her
                         C      ; nur Reg. AF zerstoert
  E2D0    3E 03          C      headup:	ld	a,3		; Indexinterrupt sperren
  E2D2    D3 11          C      	out	(flcoac),a
  E2D4    3E FF          C      	ld	a,0ffh		; Motor aus
  E2D6    D3 18          C      	out	(flsel),a
                         C       IF fdc eq f1715
                         C       ENDIF
                         C      ; Motor aus und alte Spurnummer merken
  E2D8    E5             C      flres: 	push	hl
  E2D9    C5             C      	push	bc
  E2DA    21 E317        C      	ld	hl,alwnr
  E2DD    CB 9E          C      	res	3,(hl)		; Motor aus vermerken
  E2DF    4E             C      	ld	c,(hl)
  E2E0    06 00          C      	ld	b,0
  E2E2    21 E319        C      	ld	hl,spnrl	; alte Spurnr. in Tabelle merken
  E2E5    09             C      	add	hl,bc
  E2E6    3A E318        C       	ld	a,(aspnr)
  E2E9    77             C      	ld	(hl),a
  E2EA    C1             C      	pop	bc
  E2EB    E1             C      	pop	hl
  E2EC    C9             C      	ret
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-90


                         C      
                         C      ;*****************************************************
                         C      ;	Arbeitsbereiche phys. Floppy-Treiber
                         C      ;*****************************************************
                         C      
                         C      ; Parameterfeld
                         C      ;==============
  E2ED    00             C      ft.kom: db	0	; Kommando
  E2EE    0000           C      ft.adr: dw	0	; Transferadresse
  E2F0    00             C      ft.lwn: db	0	; Laufwerksnummer 0..3
  E2F1    00             C      ft.trk: db	0	; Spurnummer   0..
  E2F2    00             C      ft.sid: db	0	; side-Nr.     0..1
  E2F3    00             C      ft.sec: db	0	; Sektornummer
  E2F4    00             C      ft.len: db	0	; Sektorlaenge 0..3
  E2F5    00             C      ft.anz: db	0	; Anz. phys. Sektoren
  E2F6    00             C      ft.stp: db	0	; Anzahl der Stepimpulse pro Spur
  E2F7    00             C      ft.sti: db	0	; Schrittzeit von Spur zu Spur
                         C      
  E2F8                   C      crcber: ds	3*9,0ffh; Ber. zum Ablegen der gelesenen/zu schreibenden CRC-Z.
                         C      			; reicht fuer 9 physische Sektoren pro Transfer
                         C      ; Fehler-Wiederholungszaehler
  E313    00             C      crerc: 	db	0	; CRC-Fehler
  E314    00             C      sperc: 	db	0	; Spur nicht gefunden
  E315    00             C      seerc: 	db	0	; Sektor nicht gefunden
  E316    00             C      lwexis: db	0	; Anzeigebyte fuer vorhandene Laufwerke
                         C      			; bit 0 = 1 LW 0 vorhanden
                         C      			; bit 2 = 1 LW 1 vorhanden
                         C      			; bit 4 = 1 LW 2 vorhanden
                         C      			; bit 6 = 1 LW 3 vorhanden
                         C      
  E317    00             C      alwnr: 	db	0	; alte Laufwerksnummer vom vergangenen Zugriff
                         C      			; bit 0-2 LW-Nr., bit 3 = 1 Motor laeuft noch
                         C      
  E318    00             C      aspnr:	db	0	; aktuelle Spur des durch alwnr bezeichneten LW
  E319    00 00 00 00    C      spnrl: 	db	0,0,0,0	; Tabelle der alten Spurnummern
                         C      
                         C       IF dsk8fm+dsk8mf+dsk5fm
                         C       ENDIF ;nicht nur 5" MFM
                         C      
                         C      ; Modifizierungstabelle entspr. Sektorlaenge
                         C      
  E31D    09             C      dslnmt:	db	dslnl		;Tabellenlaenge
  E31E    E277           C      	dw	fl.tsb		;Anzahl der 128er Bloecke
  E320    E47A           C      	dw	diosl1		;Laenge erstes INIR
                         C       IF cpu eq k2526
  E322    E486           C      	dw	dini1+1		;INI oder INIR
  E324    E489           C      	dw	dini2+1
  E326    E48C           C      	dw	dini3+1
                         C       ENDIF
                         C       if @write
  E328    E4DA           C      	dw	diosl2		;Laenge erstes OTIR
                         C        IF cpu eq k2526
  E32A    E4DD           C      	dw	doti1+1		;OUTI oder OTIR
  E32C    E4DF           C      	dw	doti2+1
  E32E    E4E1           C      	dw	doti3+1
                         C        ENDIF
                         C       endif
  0009                   C      dslnl	equ	($-dslnmt-1)/2	;Tabellenlaenge
                         C      
                         C      ; 128
  E330    01             C      dsln0:	db	1
                         C       IF cpu eq k2526
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-91


  E331    80 A2 A2 A2    C      	db	128,0a2h,0a2h,0a2h
                         C       ENDIF
                         C       if @write
                         C        IF cpu eq k2526
  E335    80 A3 A3 A3    C      	db	128,0a3h,0a3h,0a3h
                         C        ENDIF
                         C       endif
                         C      
                         C      ; 256
  E339    02             C      dsln1:	db	2
                         C       IF cpu eq k2526
  E33A    00 A2 A2 A2    C      	db	0,0a2h,0a2h,0a2h
                         C       ENDIF
                         C       if @write
                         C        IF cpu eq k2526
  E33E    00 A3 A3 A3    C      	db	0,0a3h,0a3h,0a3h
                         C        ENDIF
                         C       endif
                         C      
                         C      ; 512
  E342    04             C      dsln2:	db	4
                         C       IF cpu eq k2526
  E343    00 A2 A2 B2    C      	db	0,0a2h,0a2h,0b2h
                         C       ENDIF
                         C       if @write
                         C        IF cpu eq k2526
  E347    00 A3 A3 B3    C      	db	0,0a3h,0a3h,0b3h
                         C        ENDIF
                         C       endif
                         C      
                         C      ; 1024
  E34B    08             C      dsln3:	db	8
                         C       IF cpu eq k2526
  E34C    00 B2 B2 B2    C      	db	0,0b2h,0b2h,0b2h
                         C       ENDIF
                         C       if @write
                         C        IF cpu eq k2526
  E350    00 B3 B3 B3    C      	db	0,0b3h,0b3h,0b3h
                         C        ENDIF
                         C       endif
                         C      
                         C       IF dskds
                         C      ; Modifizierungsadressen fuer Seitenauswahl
  E354    09             C      dsidmt:	db	dsidtl		; MFM		 FM
  E355    E3DF           C      	dw	diom01		;85/81		87/83
                         C       IF cpu eq k2526
  E357    E38B           C      	dw	diom02		;a5/a1		a5/a1
  E359    E3DB           C       	dw	diom03		;b5/b1		b5/b1
  E35B    E3CB           C      	dw	diom13		;bd/b9		bd/b9
                         C       ENDIF
                         C       if @write
                         C        IF dsk8fm+dsk5fm
                         C        ENDIF
  E35D    E4B3           C      	dw	diom07		;b4/b0		 -
  E35F    E4C5           C      	dw	diom08		;b6/b2		 -
  E361    E4CF           C      	dw	diom09		;b4/b0		 -
                         C       endif
  E363    E472           C      	dw	diom10		;b5/b1		b5/b1
                         C      ;;diom11 muss letztes Byte in der Tabelle sein
  E365    E4F1           C      	dw	diom11		;b5/b1		b5/b1
  0009                   C      dsidtl	equ	($-dsidmt-1)/2
                         C       ENDIF
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-92


                         C      	include BIOSDSKP
                         C      ;****************************************************************
                         C      ; Treiber fuer Ansteuerung K5120/K5122 ueber K2526 (mit Hilfsprozessor)
                         C      ; 04.06.87
                         C      ; - Fehlerkorrektur 8" MFM (Taktzeiten)
                         C      ; 25.09.89
                         C      ; - wegen MFS 1.2 nach Transfer b1 (= fault reset) als Standardwert
                         C      ;****************************************************************
                         C      
  E367                   C      diorun:
  E367    2A E2EE        C      	ld	hl,(ft.adr)
  E36A    22 E3B3        C      	ld	(diodma),hl
                         C      
                         C      ; physischen Transfer ueber CPU 2 starten
                         C      
  E36D    21 E3AE        C      	ld	hl,dio
  E36E                   C      diortn	equ	$-2
  E370    ED 4B 0001     C      	ld	bc,(1)		;retten HS 1
  E374    22 0001        C      	ld	(1),hl		;CPU 2 -Routine
  E377    3E FE          C      	ld	a,0feh
  E379    32 E39E        C      	ld	(dtrret),a	;stellen Warte-Reaktion
  E37C    AF             C      	XOR	A
  E37D    D3 14          C      	OUT	(fldaad),A
  E37F    D3 04          C      	OUT	(04H),A		;reset CPU 2
  E381    3D             C      	dec	a		;Mode 3 (Bit E/A)
  E382    D3 17          C      	OUT	(fldabc),A
  E384    D3 17          C      	OUT	(fldabc),A	;alles Input
  E386    3E B9          C      	ld	a,10111001b	;AMF aus, Fault reset
  E388    D3 10          C      	out	(flcoad),a
  E38A    3E A5          C      	LD	A,10100101b	;Seite einstellen, Mark reset, AMF aktiv
  E38B                   C      diom02	equ	$-1		;a5/a1
  E38C    D3 10          C      	OUT	(flcoad),A
  E38E    3E 7F          C      	LD	A,7FH		;Mode 1
  E390    D3 17          C      	OUT	(fldabc),A
  E392    DB 16          C      	IN	A,(fldabd)	;CPU2 starten (ueber BUSRQ)
                         C      ; durch die Anfangsinitialisierung der CPU2 vergehen die notwendigen
                         C      ; 100 Mikrosek. fuer Seitenumschaltung
  E394    ED 43 0001     C      	ld	(1),bc		;HS 1 wiederherst.
  E398    3A E3DF        C      	LD	A,(diom01)	;Lesen Marke
  E39B    D3 10          C      	OUT	(flcoad),A	;weiter bei CPU2 nach Anfangsinit.
                         C      ; Achtung!! Zur Synchronisation CPU1 und CPU2 keine 2-Byte-Werte
                         C      ; (Adressen) verwenden, da dazwischen BUSRQ auftreten kann und dann
                         C      ; nur ein Byte gesetzt wurde!!
  E39D    18 FE          C      	jr	$		;auf CPU 2 Ende warten
  E39E                   C      dtrret	equ	$-1
  E39F                   C      dtrwjr:
  E39F    C3 E242        C      dtrtor:	jp	fl.to1		;time out
  E3A2    C3 E1E8        C      dtrner:	jp	noerr		;fehlerfrei (Sekt.id)
  E3A5    C3 E223        C      dtrnsr:	jp	serrx		;Sektor nicht gefunden
  E3A8    C3 E202        C      dtrrdr:	jp	dtrrde		;Read Ende
  E3AB    C3 E1F6        C      dtrwrr:	jp	dtrwre		;Write Ende
                         C      ;--------------------------
                         C      
                         C      
                         C      ; Code CPU 2 fuer phys. Diskettentransfer
                         C      ;========================================
                         C      ; Zeitbedingungen fuer 8" MFM:
                         C      ; 6 Umdrehungen pro Sec bei 2*5208 Bytes pro Spur bedeutet
                         C      ; 1/(6*2*5208), d.h. 16 Mikrosec pro Byte!!
                         C      ; Bei einer Taktfrequenz von (9600*256)=2457600 Hz sind das
                         C      ; (9600*256)/(6*2*5208) Takte, d.h. max. 39 Takte pro Byte!!
                         C      ; Wegen BUSRQ/BUSAK muss davon der laengste Maschinenzyklus
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-93


                         C      ; der CPU 1 abgezogen werden, d.h. 6 Takte (Interruptannahme),
                         C      ; weiterhin je ein Takt fuer BUSRQ/BUSAK-Umschaltung,
                         C      ; es verbleiben 31 Takte zwischen den E/A-Maschinenzyklen!!
                         C      
                         C      ; normaler Entry in phys. Diskettentransfer
                         C      ;==========================================
  E3AE                   C      dio:	
  E3AE    AF             C      	xor	a		;wiederherstellen 'jr diokl'
  E3AF    32 E3E7        C      	ld	(diomd1+1),a
  E3B2    21 0000        C      	ld	hl,0
  E3B3                   C      diodma	equ	$-2		;Transferadresse
  E3B5    3E 00          C      	ld	a,0
  E3B6                   C      secan1	equ	$-1		;a':=Zahl zu transfer. phys. Sekt.
  E3B7    08             C      	ex	af,af'
  E3B8    11 E2F8        C      	ld	de,crcber	;auf Beginn Datenbyte-/CRC-Vektor
  E3BB    D9             C      dio2:	exx
  E3BC    01 00FF        C      	ld	bc,000ffh	;bc':= Spur, Seite
  E3BD                   C      sidtr	equ	$-2
  E3BE                   C      sidsid	equ	$-1
  E3BF    21 FFFF        C      	ld	hl,0ffffh	;hl':= Sektor, Sektlngflag
  E3C0                   C      sidsec	equ	$-2
  E3C1                   C      sidlen	equ	$-1
  E3C2    11 FEA1        C      	ld	de,0fea1h	;de':= Sektorid-Byte, Kluftbyte
  E3C5    3E 3C          C      	ld	a,60		;Wiederholungszaehler falscher Sektid.
  E3C7    32 E315        C      	ld	(seerc),a	;fuer ersten Sektor stellen
  E3CA    3E BD          C      diostp:	ld	a,10111101b	;bd/b9, AMF aus, Seite bleibt (>=100 Mikros.)
  E3CB                   C      diom13	equ	$-1
  E3CC    D3 10          C      	out	(flcoad),a	;Ende CPU2
  E3CE    18 12          C      	jr	diogo		;Fortsetzung nach Anfangsinit
                         C      
  E3D0                   C      dionss:
  E3D0    3E 3C          C      	ld	a,60		;Wiederholungszaehler falscher Sektid.
  E3D2    32 E315        C      	ld	(seerc),a	;fuer naechsten Sektor setzen
  E3D5                   C      diomr:
  E3D5    3E 05          C      	ld	a,5		;verhindern unendl. Schleife
  E3D7    32 E2B6        C      	ld	(fl.zto),a	;bei fehlender Sektor-Marke
  E3DA    3E B5          C      diomrk:	ld	a,10110101b	;b5/b1 MFM; b5/b1 FM
  E3DB                   C      diom03	equ	$-1		;Mark reset, lesen 1
  E3DC    D3 10          C      	out	(flcoad),a
  E3DE    3E 85          C      	ld	a,10000101b	;85/81 MFM; 87/83 FM
  E3DF                   C      diom01	equ	$-1		;Lesen Marke entspr. Aufzverf.
  E3E0    D3 10          C      	out	(flcoad),a
  E3E2    DB 16          C      diogo:	in	a,(fldabd)
  E3E4    D3 14          C      	out	(fldaad),a
  E3E6    18 00          C      diomd1:	jr	diomd1+2	;wird modifiziert mit 'jr diotrr',
                         C      				;wenn Sektorid zu lesen
  E3E8    DB 16          C      diokl:	in	a,(fldabd)
  E3EA    BB             C      	cp	e		;'A1', d.h. noch in Kluft?
  E3EB    28 FB          C      	jr	z,diokl		;ja
  E3ED    BA             C      	cp	d		;'FE', d.h. Sektorbeginn?
  E3EE    DB 16          C      	in	a,(fldabd)
  E3F0    20 E8          C      	jr	nz,diomrk	;nein, weitersuchen
  E3F2    B9             C      	cp	c		;Spur ok?
  E3F3    DB 16          C      	in	a,(fldabd)
  E3F5    20 5D          C      	jr	nz,serr		;nein, falscher Sektid.
  E3F7    B8             C      	cp	b		;Seite ok?
  E3F8    DB 16          C      	in	a,(fldabd)
  E3FA    20 58          C      	jr	nz,serr		;nein, falscher Sektid.
  E3FC    BD             C      	cp	l		;Sektor ok?
  E3FD    DB 16          C      	in	a,(fldabd)
  E3FF    20 53          C      	jr	nz,serr		;nein, falscher Sektid.
  E401    BC             C      	cp	h		;Sekt-Laengencode?
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-94


  E402    DB 16          C      	in	a,(fldabd)	;**ignorieren CRC Sektid**
  E404    20 4E          C      	jr	nz,serr		;nein, falscher Sektid.
  E406    D9             C      	exx
  E407    DB 16          C      	in	a,(fldabd)	;**ignorieren CRC Sektid**
  E409    06 11          C      	ld	b,17		;Zahl zu uebergeh. Bytes
  E40A                   C      diomd2	equ	$-1		;bei DD auf 17, bei SD auf 6
  E40B    DB 16          C      diosyn:	in	a,(fldabd)	;Bytes ignorieren
  E40D    10 FC          C      	djnz	diosyn
  E40F    DB 16          C      	in	a,(fldabd)
  E411    C3 E469        C      	jp	diord
  E412                   C      dioop	equ	$-2		;wird modifiziert entspr. Oper.
                         C      ;				 mit diord, diwmfm, diowfm
                         C      
                         C      ; Entry fuer phys. Treiber zum Lesen Sekt.-Id. auf akt. Spur
                         C      ;===========================================================
  E414    3E 39          C      diotsr:	ld	a,diotrr-(diomd1+2)	;jr diotrr
  E416    32 E3E7        C      	ld	(diomd1+1),a	;modifizieren
  E419    01 0316        C      	ld	bc,3*256+fldabd	;Lesen 3 Bytes Sektorid
  E41C    21 E2F2        C      	ld	hl,ft.trk+1	;dorthin Sektorid hinterlegen
  E41F    18 9A          C      	jr	dio2		;Einsprung in phys. Treiber
  E421                   C      diotrr:
  E421    DB 16          C      diotr0:	in	a,(fldabd)
  E423    BB             C      	cp	e		;'A1', d.h. noch in Kluft?
  E424    28 FB          C      	jr	z,diotr0	;ja
  E426    BA             C      	cp	d		;'FE', d.h. Sektorbeginn?
  E427    DB 16          C      	in	a,(fldabd)	;wenn ja, so ist das die Spur
  E429    20 AF          C      	jr	nz,diomrk	;nein, weitersuchen
  E42B    D9             C      	exx
  E42C    ED B2          C      	inir			;Sektorid lesen
  E42E    D9             C      	exx
  E42F    6F             C      	ld	l,a		;Spur retten
  E430    3A E3DB        C      	ld	a,(diom03)
  E433    D3 10          C      	out	(flcoad),a	;Lesen 1
  E435    7D             C      	ld	a,l
  E436    B9             C      	cp	c		;richtige Spur?
  E437    28 09          C      	jr	z,diotr1	;ja
  E439    3A E2F2        C      	ld	a,(ft.sid)
  E43C    90             C      	sub	b		;stimmt side?
  E43D    20 0B          C      	jr	nz,diotre	;nein, dies ist kein Sektid.
  E43F    B9             C      	cp	c		;war Spur 0 gefordert?
  E440    28 23          C      	jr	z,serr2		;ja, nachjustieren (ft.trk steht noch)
  E442    7D             C      diotr1:	ld	a,l
  E443    32 E2F1        C      	ld	(ft.trk),a	;(tatsaechliche) Spur aus Sekt.Id.
  E446    3E 03          C      	ld	a,dtrner-dtrwjr	;Reaktionsroutine
  E448    18 5D          C      	jr	dioend		;Abschlussbehandlung
  E44A    D9             C      diotre:	exx
  E44B    01 0316        C      	ld	bc,3*256+fldabd	;Lesen 3 Bytes Sektorid
  E44E    21 E2F2        C      	ld	hl,ft.trk+1	;dorthin Sektorid hinterlegen
  E451    D9             C      	exx
  E452    18 07          C      	jr	serr1
                         C      ;---------------------------
                         C      
                         C      ; Fehlerausgaenge
                         C      ;----------------
                         C      ; falscher Sektorid.
  E454    DB 16          C      serr:	in	a,(fldabd)
  E456    3A E3DB        C      	ld	a,(diom03)	;Lesen 1
  E459    D3 10          C      	out	(flcoad),a
  E45B    3A E315        C      serr1:	ld	a,(seerc)
  E45E    3D             C      	dec	a		;blieb weiterer Versuch?
  E45F    32 E315        C      	ld	(seerc),a
  E462    C2 E3D5        C      	jp	nz,diomr	;ja
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-95


  E465    3E 06          C      serr2:	ld	a,dtrnsr-dtrwjr	;Sektor nicht gefunden
  E467    18 3E          C      	jr	dioend
                         C      
                         C      ; Lesen
                         C      ;-------
  E469    DB 16          C      diord:	in	a,(fldabd)
  E46B    06 06          C      	ld	b,6
  E46D    DB 16          C      diords:	in	a,(fldabd)	;uebergehen Synchron-Bytes
  E46F    10 FC          C      	djnz	diords
  E471    3E B5          C      	ld	a,10110101b	;b5/b1
  E472                   C      diom10	equ	$-1
  E473    D3 10          C      	out	(flcoad),a	;Lesen 1
  E475    3A E3DF        C      	ld	a,(diom01)	;85/81 MFM; 87/83 FM
  E478    01 8016        C      	ld	bc,128*256+fldabd ;b:=inir-Laenge
  E47A                   C      diosl1	equ	$-1		  ;   128 bei Sektl 128, sonst =0
  E47B    D3 10          C      	out	(flcoad),a	;Lesen Marke
  E47D    DB 16          C      	in	a,(fldabd)	;ignorieren evtl. anstehenden Muell
  E47F    DB 16          C      diorkl:	in	a,(fldabd)
  E481    FE A1          C      	cp	0a1h		;noch in Kluft?
  E483    28 FA          C      	jr	z,diorkl	;ja
  E485    ED A2          C      dini1:	ini			;Daten lesen
  E487    12             C      	ld	(de),a		;Datenbeginn-Byte hinterlegen
  E488    ED A2          C      dini2:	ini
  E48A    13             C      	inc	de
  E48B    ED A2          C      dini3:	ini
  E48D    ED B2          C      	inir
  E48F    EB             C      	ex	de,hl
  E490    ED A2          C      	ini			;CRC Daten
  E492    ED A2          C      	ini
  E494    3A E4F1        C      	ld	a,(diom11)	;b1 fuer MFS 1.2 Fault reset, sonst b5/b1
  E497    D3 10          C      	out	(flcoad),a	;Lesen 1
  E499    EB             C      	ex	de,hl
  E49A    3E 09          C      	ld	a,dtrrdr-dtrwjr	;Reaktionsroutine Read Ende
                         C      
                         C      ; naechsten Sektor behandeln
                         C      ;---------------------------
  E49C    08             C      dions:	ex	af,af'		;Zahl zu uebertr. Sektoren
  E49D    3D             C      	dec	a
  E49E    28 06          C      	jr	z,dionse	;=0, fertig
  E4A0    08             C      	ex	af,af'
  E4A1    D9             C      	exx
  E4A2    2C             C      	inc	l		;Sektor+1
  E4A3    C3 E3D0        C      	jp	dionss
  E4A6    08             C      dionse:	ex	af,af'
                         C      
                         C      ; Abschlussbehandlung
                         C      ;--------------------
  E4A7                   C      dioend:
  E4A7    32 E39E        C      	ld	(dtrret),a	;Reaktionsroutine hinterlegen
  E4AA    C3 E3CA        C      	jp	diostp		;Stop CPU2
                         C      
                         C       IF @write
                         C      
                         C       IF dsk8fm+dsk8mf+dsk5fm
                         C       ENDIF
                         C      
                         C      
                         C      ; Schreiben  MFM
                         C      ;---------------
  E4AD    DB 16          C      diwmfm:	in	a,(fldabd)
  E4AF    DB 16          C      	in	a,(fldabd)
  E4B1    01 B410        C      	ld	bc,10110100b*256+flcoad
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-96


  E4B3                   C      diom07	equ	$-1		;b4/b0
  E4B4    DB 16          C      	in	a,(fldabd)
  E4B6    ED 41          C      	out	(c),b		;Schreiben MFM normal
  E4B8    DB 16          C      	in	a,(fldabd)
  E4BA    AF             C      	xor	a
  E4BB    D3 14          C      	out	(fldaad),a	; 1*'00'
  E4BD    01 0A14        C      	ld	bc,10*256+fldaad
  E4C0    D3 14          C      diwmfs:	out	(fldaad),a	;10*'00'
  E4C2    10 FC          C      	djnz	diwmfs
  E4C4    3E B6          C      	ld	a,10110110b
  E4C5                   C      diom08	equ	$-1		;b6/b2
  E4C6    ED 41          C      	out	(c),b		; 1*'00'
  E4C8    D3 10          C      	out	(flcoad),a	;Schreiben MFM Marke
  E4CA    06 A1          C      	ld	b,0a1h
  E4CC    ED 41          C      	out	(c),b		;3*'A1'
  E4CE    3E B4          C      	ld	a,10110100b
  E4CF                   C      diom09	equ	$-1		;b4/b0
  E4D0    ED 41          C      	out	(c),b
  E4D2    EB             C      	ex	de,hl
  E4D3    ED 41          C      	out	(c),b
  E4D5    D3 10          C      	out	(flcoad),a	;Schreiben MFM normal
  E4D7    ED A3          C      	outi			;'FB'
                         C      
  E4D9    06 80          C      diowrt:	ld	b,128		;Laenge erster OTIR-Block
  E4DA                   C      diosl2	equ	$-1		;128 bei Sektl 128, sonst 0
  E4DB    EB             C      	ex	de,hl
  E4DC    ED A3          C      doti1:	outi			;Daten ausgeben
  E4DE    ED A3          C      doti2:	outi
  E4E0    ED A3          C      doti3:	outi
  E4E2    ED B3          C      	otir
  E4E4    EB             C      	ex	de,hl
  E4E5    ED A3          C      	outi			;CRC Daten
  E4E7    AF             C      	xor	a
  E4E8    ED A3          C      	outi
  E4EA    06 14          C      diowm1:	ld	b,20		;Anzahl der Nach-Null-Bytes
                         C      				;5" MFM/FM: 20; 8" MFM/FM: 2
  E4EC    D3 14          C      diow00:	out	(fldaad),a	;'00'
  E4EE    10 FC          C      	djnz	diow00
  E4F0    3E B1          C      	ld	a,10110001b	;b1 fuer MFS 1.2 Fault reset, sonst b5/b1
  E4F1                   C      diom11	equ	$-1
  E4F2    D3 10          C      	out	(flcoad),a	;Schreiben aus, Lesen 1
  E4F4    EB             C      	ex	de,hl
  E4F5    3E 0C          C      	ld	a,dtrwrr-dtrwjr	;Schreiben OK Reaktion
  E4F7    C3 E49C        C      	jp	dions		;naechster Sektor
                         C      
                         C      	ENDIF	;@write
                                 ENDIF
                                 IF hdsk
                                 ENDIF
                                 IF oss
                         C      	include BIOSROS		;RAM-Floppy mit OSS
                         C      ;********************************************************
                         C      ;	RAM-Floppy auf Basis OSS (48k Speichererweiterung)
                         C      ; Version 15.05.87
                         C      ;********************************************************
                         C      
                         C       if1
                         C       endif ;if1
                         C      
                         C      
                         C      ;**************************************************************
                         C      ;	Schreiben RAM-Floppy
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-97


                         C      ;**************************************************************
  E4FA                   C      wrramf:
  E4FA    CD E534        C      	call	osswri
  E4FD    38 19          C      	jr	c,osswru	;dma -> oss direkt
  E4FF    D5             C      	push	de
  E500    11 0080        C      	ld	de,ossbuf
  E503    D5             C      	push	de
  E504    ED B0          C      	ldir			;dma -> ossbuf
  E506    E1             C      	pop	hl
  E507    D1             C      	pop	de
  E508    0E 80          C      	ld	c,128
  E50A    CD 0020        C      	call	ossld		;ossbuf -> oss
  E50D    21 F20F        C      ossrw:	ld	hl,ossbf1
  E510    11 0080        C      	ld	de,ossbuf
  E513    0E 80          C      	ld	c,128
  E515    ED B0          C      	ldir			;ossbuf wiederherstellen
  E517    EB             C      ossrdu:	ex	de,hl		;oss -> dma
  E518    DC 0020        C      osswru:	call	c,ossld		;dma -> oss
  E51B    AF             C      ossrwo:	xor	a		;Transfer fehlerfrei
  E51C    C9             C      	ret
                         C      
                         C      ;**************************************************************
                         C      ;	Lesen RAM-Floppy
                         C      ;**************************************************************
                         C      
  E51D                   C      rdramf:
  E51D    CD E534        C      	call	osswri
  E520    DA E517        C      	jp	c,ossrdu	;oss -> dma direkt
  E523    E5             C      	push	hl
  E524    EB             C      	ex	de,hl
  E525    11 0080        C      	ld	de,ossbuf
  E528    D5             C      	push	de
  E529    CD 0020        C      	call	ossld		;oss -> ossbuf
  E52C    E1             C      	pop	hl
  E52D    D1             C      	pop	de
  E52E    0E 80          C      	ld	c,128
  E530    ED B0          C      	ldir			;ossbuf -> dma
  E532    18 D9          C      	jr	ossrw		;Rest wie write
                         C      
                         C      ;********************************************************************
                         C      ;	Unterprogramme fuer RAM-Floppy
                         C      ;********************************************************************
                         C      
                         C      ; oss-Arbeit vorbereiten
                         C      ; bc: 128; de: oss-Adresse; hl: dma-Adresse
                         C      ; ret c: dma < ossadr-256; ret nc: ossbuf ist gerettet
  E534    01 0080        C      osswri:	ld	bc,128
  E537    CD E551        C      	call	ossmad		;hl:=oss-Adresse
  E53A    EB             C      	ex	de,hl
  E53B    2A E002        C      	ld	hl,(ddma)	;hl:=dma-Adresse
  E53E    7C             C      	ld	a,h
  E53F    FE 3F          C      	cp	((ossadr-256) shr 8);dma komplett vor ossadr?
  E541    D8             C      	ret	c		;ja
  E542    D5             C      	push	de
  E543    E5             C      	push	hl
  E544    21 0080        C      	ld	hl,ossbuf
  E547    11 F20F        C      	ld	de,ossbf1
  E54A    ED B0          C      	ldir
  E54C    E1             C      	pop	hl
  E54D    D1             C      	pop	de
  E54E    0E 80          C      	ld	c,128
  E550    C9             C      	ret
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-98


                         C      
                         C      ; Adresse in OSS entspr. Track, Sector berechnen nach HL
  E551    2A DFFD        C      ossmad:	ld	hl,(dtrack)
  E554    26 00          C      	ld	h,0
  E556    29             C      	add	hl,hl		;track*8 (8 Sektoren pro Spur)
  E557    29             C      	add	hl,hl
  E558    29             C      	add	hl,hl
  E559    3A DFFF        C      	ld	a,(dsectr)	;Sektor 1..8
  E55C    3D             C      	dec	a
  E55D    B5             C      	or	l
  E55E    6F             C      	ld	l,a
  E55F    29             C      	add	hl,hl		;(track*8+(sector-1))*128
  E560    29             C      	add	hl,hl
  E561    29             C      	add	hl,hl
  E562    29             C      	add	hl,hl
  E563    29             C      	add	hl,hl
  E564    29             C      	add	hl,hl
  E565    29             C      	add	hl,hl
  E566    11 4000        C      	ld	de,ossrbg
  E569    19             C      	add	hl,de
  E56A    C9             C      	ret
                         C      
                         C      ; Transfer RAM <-> OSS entsprechend ldir-Parmameter
                         C      ; Routine steht auf Adresse ossld (nach jedem Warmstart)
  E56B    F3             C      osscd:	di
  E56C    3E 3C          C      	ld	a,3ch
  E56E    D3 EE          C      	out	(0eeh),a
  E570    ED B0          C      	ldir
  E572    3E 00          C      	ld	a,0
  E574    D3 EE          C      	out	(0eeh),a
  E576    FB             C      	ei
  E577    C9             C      	ret
  000D                   C      osscdl	equ	$-osscd
                         C      
                         C      ;*************************************************************
                         C      ; Steuertabellen fuer RAM-Floppy
                         C      ;*************************************************************
                         C      
  E578                   C      dphoss:
  E578    0000           C      dphm:	dw	0		;kein Sector-Versatz
  E57A    0000 0000      C      	dw	0,0,0
  E57E    0000           C      
  E580    F0B5           C      	dw	dirbuf
  E582    E588 0000      C      	dw	dpboss,0,alvoss
  E586    F209           C      
                         C      
  002E                   C      @dpbmk	equ	(ossren-ossrbg) shr 10 ;Groesse OSS-RAM-Floppy
  E588                   C      dpboss:
  E588    0008           C      dpbm:	dw	1024/128	;1K pro Spur
  E58A    03 07 00       C      	db	3,7,0		;1K Blockgroesse BDOS
  E58D    002D           C      	dw	@dpbmk-1	;Kapazitaet in 1K Bloecken
  E58F    001F           C      	dw	32-1		;Dir-Entries 0..31
  E591    80 00          C      	db	80h,0		;Dir-Alloc
  E593    0000           C      	dw	0		;kein check
  E595    0000           C      	dw	0		;offset, keine Syst.spuren
  E597    80             C      	db	80h		;kein Disketten-DPB
                         C      
  E578                   C      dpham	aset	dphm		;definieren LW "M:"
                                 ENDIF
