  D2DD    CD D2C2        C      	call	kbdput		;Zeichen in Puffer
  D2E0    D1             C      	pop	de
  D2E1    E1             C      	pop	hl
  D2E2    23             C      	inc	hl
  D2E3    1D             C      	dec	e
