  D2EF    06 64          C      	ld	b,100		;fuer dauerfunktion
  D2F0                   C      kbdwt	equ	$-1
  D2F1    36 0A          C      	ld	(hl),10		;auf 10*0,01sec fuer
                         C      				;gleiche taste
