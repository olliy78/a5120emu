  DDA9    10 FC          C      	djnz	dbsecm
  DDAB    93             C      	sub	e		;Restsektorzahl auf Spur
  DDAC    BA             C      	cp	d		;>= Zahl zu transferierender?
  DDAD    30 01          C      	jr	nc,dbseco	;ja
  DDAF    57             C      	ld	d,a		;sonst nur Restsektorzahl
  DDB0    1C             C      dbseco:	inc	e		;Sektoren zaehlen ab 1
  DDB1    7B             C      	ld	a,e
