  DCE7    38 0A          C      	jr	c,unatr1	;nein
  DCE9    2B             C      	dec	hl
  DCEA    56             C      	ld	d,(hl)
  DCEB    2B             C      	dec	hl
  DCEC    5E             C      	ld	e,(hl)
  DCED    13             C      	inc	de		;unatrk +1
  DCEE    73             C      	ld	(hl),e
  DCEF    23             C      	inc	hl
  DCF0    72             C      	ld	(hl),d
