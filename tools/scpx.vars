# SCPX 1526 — Handshake-/Read-Dashboard für `vars -f` (§16)
#
# Laden:  vars -f tools/scpx.vars   (dann zeigt `vars` diese Zellen)
# Format: <name>  <addr>  [w]     (w = 16-Bit-Wort little-endian; sonst Byte)
# Adressen aus doc/analyse_scpx_com_load.md §7 (ZVE1↔ZVE2-Laufzeit-Read).

warmstart_vec   0x0000  w   # [0000..0002] = C3 lo hi: JP-Vektor (E9C8 Read-Koroutine vs DE03 Warmstart)
coro_lo         0x0001  w   # Ziel des JP an [0000] (Read-Koroutine gepoist / restauriert)
handshake       0xEC0B  w   # ZVE1↔ZVE2-Handshake (Poll-Wait E8B5 wartet hierauf)
ministack_sp    0xEC0D  w   # Mini-Stack-SP (LD SP,EC0D) — Korruptionsziel Schicht 2
track_reg       0xEBFA  w   # Spurregister (per Laufwerk, aus IX+2/+3; Seek @E706)
tpl_mark        0xEC00      # Template: FE (IDAM-Marke)
tpl_cyl         0xEC01      # Template Soll-Zylinder (Matcher E9FD: CP C)
tpl_head        0xEC02      # Template Soll-Kopf   (EA02)
tpl_sec         0xEC03      # Template Soll-Sektor (EA07)
tpl_size        0xEC04      # Template Soll-Größe  (EA0C)
tpl_crc         0xEC05  w   # Template IDAM-CRC (Matcher EA12/EA17 gegen Stream)
done_flag       0x03F8      # CP/A-Boot-Done-Flag (0=läuft 1=Timeout 3=fertig)
