# k1520DiskTool — Angaben zu 'SYL1'.
# Sie stehen NICHT in der Datei selbst.  Beim Einfuegen (`put`) werden sie
# wieder uebernommen.
# Ohne sie kann das Werkzeug nicht wissen, was fuer eine Datei das ist —
# aus einem Programm wuerde eine Binaerdatei, die nicht laeuft.
# Loeschen schadet nur dieser einen Datei; die Zeilenform ist dieselbe wie in
# udos-dateiangaben.txt bzw. cpm-dateiangaben.txt.
fs=udos
name=SYL1
typ=P
eig=WES
start=0000
satz=128
block=128
rest=128
segment=0400:684
mem=0000:06FF:0080
zusatz=0
erst=V_4.0
geaend=891031
