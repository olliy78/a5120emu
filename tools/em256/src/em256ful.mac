; =============================================================================
; U8001-FIRMWARE-BLOECKE (fw_*.s, z8kasm - build.py setzt die DB-Zeilen ein)
; Jedes Abbild beginnt bei Zelle 0 von Segment 0 (Resetvektor).
; =============================================================================

; --- C1: Addition ---
FW_ADD_CODE:
;%INCLUDE fw_add.inc
FW_ADD_END:
FW_ADD_CODE_LEN EQU FW_ADD_END-FW_ADD_CODE

; --- C2: Subtraktion ---
FW_SUB_CODE:
;%INCLUDE fw_sub.inc
FW_SUB_END:
FW_SUB_CODE_LEN EQU FW_SUB_END-FW_SUB_CODE

; --- C3: Logik ---
FW_LOGIC_CODE:
;%INCLUDE fw_logic.inc
FW_LOGIC_END:
FW_LOGIC_CODE_LEN EQU FW_LOGIC_END-FW_LOGIC_CODE

; --- C4: Speicher R/W ---
FW_MEMRW_CODE:
;%INCLUDE fw_memrw.inc
FW_MEMRW_END:
FW_MEMRW_CODE_LEN EQU FW_MEMRW_END-FW_MEMRW_CODE

; --- C5: Schleife ---
FW_LOOP_CODE:
;%INCLUDE fw_loop.inc
FW_LOOP_END:
FW_LOOP_CODE_LEN EQU FW_LOOP_END-FW_LOOP_CODE

; --- C6: Stapel ---
FW_STACK_CODE:
;%INCLUDE fw_stack.inc
FW_STACK_END:
FW_STACK_CODE_LEN EQU FW_STACK_END-FW_STACK_CODE

; --- C7: 32-Bit ---
FW_ADD32_CODE:
;%INCLUDE fw_add32.inc
FW_ADD32_END:
FW_ADD32_CODE_LEN EQU FW_ADD32_END-FW_ADD32_CODE

; --- C8: Byte-Ops ---
FW_BYTE_CODE:
;%INCLUDE fw_byte.inc
FW_BYTE_END:
FW_BYTE_CODE_LEN EQU FW_BYTE_END-FW_BYTE_CODE

; --- D1: March-C ---
FW_MARCH_CODE:
;%INCLUDE fw_march.inc
FW_MARCH_END:
FW_MARCH_CODE_LEN EQU FW_MARCH_END-FW_MARCH_CODE

; =============================================================================
; VARIABLEN
; =============================================================================
SAVED_SP:	DW	0
SAVE_WORD:	DW	0
TMP_BYTE:	DB	0
TMP_WORD:	DW	0
TMP_WORD2:	DW	0
EM256_OK:	DB	0
DET_SEGS:	DB	0
