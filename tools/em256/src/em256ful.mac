; Mailbox-Ergebnispuffer (vom EM256-RAM gelesen)
MB_STATUS_HI:	DB	0
MB_STATUS_LO:	DB	0
MB_RES1_HI:	DB	0
MB_RES1_LO:	DB	0
MB_RES2_HI:	DB	0
MB_RES2_LO:	DB	0
MB_RES3_HI:	DB	0
MB_RES3_LO:	DB	0
MB_RES4_HI:	DB	0
MB_RES4_LO:	DB	0

; Statistik
PASS_CNT:	DB	0
FAIL_CNT:	DB	0
INFO_CNT:	DB	0
TOTAL_CNT:	DB	0
GRP_PASS:	DB	0
GRP_FAIL:	DB	0
GRP_TOTAL:	DB	0
