	TITLE	'LBPUNCH - Lochband stanzen (K6022 / SIF1000)'
	.Z80
;
; lbpunch.mac - stanzt eine CP/M-Datei auf dem Lochbandstanzer (daro 1215) an der
;               ADA K6022 (SIF1000).  Unter CP/A und SCPX (BDOS-Aufrufe), am A5120,
;               A5120.16, K8915 und PRG 710/710-1.  Gegenstueck zu LBREAD.
;
;   LBPUNCH datei [/A] [/K]
;
;     /A   ASCII-Band: Bit 7 = gerade Paritaet, die Datei endet am ersten 1AH
;     /K   ohne Vor- und Nachlauf (sonst je 16 Nullbytes)
;
; Stanzer an der K6022: PIO E0H Daten A, E1H Daten B, E2H Steuer A, E3H Steuer B.
; Tor A Betriebsart 0 (Ausgabe, Vektor EEH, Interrupt), Tor B Bitbetrieb D0-D3 aus
; (KOM = 01H), D4-D7 ein (STA).  Ein Byte: OUT (E0H) setzt RUF, der Stanzer
; quittiert mit END (Interrupt) — wie PTAPE.6022 (doc/merkposten/prg710.md).
; Interruptumgebung und Vektoreintrag wie bei LBREAD (IM 2, Platz EEH frei).
;
; Lizenz: MIT
;

BDOS	EQU	0005H
WBOOT	EQU	0000H
FCB	EQU	005CH
TAIL	EQU	0080H

F_PRINT	EQU	9
F_OPEN	EQU	15
F_READ	EQU	20
F_DMA	EQU	26

ST_DAT	EQU	0E0H
ST_KOM	EQU	0E1H
ST_CTA	EQU	0E2H
ST_CTB	EQU	0E3H
VEC_ST	EQU	0EEH

OPT_A	EQU	01H
OPT_K	EQU	02H

	ORG	100H

START:
	LD	(OLDSP), SP
	LD	SP, STACK
	CALL	OPTION
	LD	A, (FCB+1)
	CP	' '
	JP	Z, USAGE

	LD	A, I
	OR	A
	LD	DE, M_NOIM2
	JP	Z, FAIL
	LD	H, A
	LD	L, VEC_ST
	LD	(SLOT), HL
	LD	A, (HL)
	LD	(OLD0), A
	INC	HL
	LD	B, (HL)
	LD	A, B
	LD	(OLD1), A
	LD	A, (OLD0)
	CP	B
	LD	DE, M_SLOT
	JP	NZ, FAIL

	XOR	A
	LD	(FCB+12), A
	LD	(FCB+32), A
	LD	DE, FCB
	LD	C, F_OPEN
	CALL	BDOS
	INC	A
	LD	DE, M_NOFILE
	JP	Z, FAIL
	LD	DE, BUF
	LD	C, F_DMA
	CALL	BDOS

	DI
	LD	HL, (SLOT)
	LD	DE, ISR
	LD	(HL), E
	INC	HL
	LD	(HL), D
	LD	A, 1
	LD	(INST), A
	XOR	A
	LD	(FLAGST), A
	LD	A, 0FFH			; Tor B: Bitbetrieb, D4-D7 Eingaenge
	OUT	(ST_CTB), A
	LD	A, 0F0H
	OUT	(ST_CTB), A
	LD	A, VEC_ST
	OUT	(ST_CTA), A
	LD	A, 0FH			; Betriebsart 0 (Ausgabe)
	OUT	(ST_CTA), A
	LD	A, 83H			; Interrupt frei
	OUT	(ST_CTA), A
	LD	A, 01H			; KOM
	OUT	(ST_KOM), A
	EI

	LD	A, (FLAGS)
	AND	OPT_K
	JR	NZ, NOLEAD
	LD	B, 16
LEAD1:	XOR	A
	PUSH	BC
	CALL	PUNCH
	POP	BC
	JP	C, TIMEOUT
	DJNZ	LEAD1
NOLEAD:
RLOOP:	LD	DE, FCB
	LD	C, F_READ
	CALL	BDOS
	OR	A
	JR	NZ, DONE		; Dateiende
	LD	HL, BUF
	LD	B, 128
BLOOP:	LD	A, (HL)
	INC	HL
	PUSH	HL
	PUSH	BC
	LD	C, A
	LD	A, (FLAGS)
	AND	OPT_A
	LD	A, C
	JR	Z, BRAW
	CP	1AH
	JR	Z, BEND
	CALL	PARITY
BRAW:	CALL	PUNCH
	POP	BC
	POP	HL
	JP	C, TIMEOUT
	LD	A, (CNT)		; Zaehler
	INC	A
	LD	(CNT), A
	JR	NZ, BNEXT
	LD	A, (CNT+1)
	INC	A
	LD	(CNT+1), A
BNEXT:	DJNZ	BLOOP
	JR	RLOOP
BEND:	POP	BC
	POP	HL
DONE:
	LD	A, (FLAGS)
	AND	OPT_K
	JR	NZ, FIN
	LD	B, 16
TRAIL:	XOR	A
	PUSH	BC
	CALL	PUNCH
	POP	BC
	JP	C, TIMEOUT
	DJNZ	TRAIL
FIN:	CALL	CLEAN
	LD	HL, (CNT)
	CALL	PRDEC
	LD	DE, M_OK
	CALL	PUTS
	JP	EXIT

TIMEOUT:
	CALL	CLEAN
	LD	DE, M_NOPUNCH
	JP	FAIL
USAGE:
	LD	DE, M_USAGE
FAIL:	CALL	PUTS
EXIT:	LD	SP, (OLDSP)
	JP	WBOOT

; PUNCH - Byte A stanzen und auf END warten; CY = Zeitablauf (ca. 1 s)
PUNCH:
	PUSH	AF
	XOR	A
	LD	(FLAGST), A
	POP	AF
	OUT	(ST_DAT), A
	LD	BC, 0FFFFH
PU1:	LD	A, (FLAGST)
	OR	A
	RET	NZ			; CY = 0 durch OR
	DEC	BC
	LD	A, B
	OR	C
	JR	NZ, PU1
	SCF
	RET

; PARITY - A: Bit 7 so setzen, dass die Zahl der Einsen gerade ist
PARITY:
	AND	7FH
	LD	C, A
	OR	A			; PE = gerade Paritaet
	LD	A, C
	RET	PE
	OR	80H
	RET

CLEAN:
	LD	A, (INST)
	OR	A
	RET	Z
	DI
	LD	A, 03H
	OUT	(ST_CTA), A
	LD	HL, (SLOT)
	LD	A, (OLD0)
	LD	(HL), A
	INC	HL
	LD	A, (OLD1)
	LD	(HL), A
	XOR	A
	LD	(INST), A
	EI
	RET

ISR:
	PUSH	AF
	LD	A, 1
	LD	(FLAGST), A
	POP	AF
	EI
	RETI

OPTION:
	XOR	A
	LD	(FLAGS), A
	LD	HL, TAIL
	LD	B, (HL)
	INC	HL
OP1:	LD	A, B
	OR	A
	RET	Z
	LD	A, (HL)
	INC	HL
	DEC	B
	CP	'/'
	JR	NZ, OP1
OP2:	LD	A, B
	OR	A
	RET	Z
	LD	A, (HL)
	AND	5FH
	LD	C, OPT_A
	CP	'A'
	JR	Z, OP3
	LD	C, OPT_K
	CP	'K'
	JR	NZ, OP1
OP3:	LD	A, (FLAGS)
	OR	C
	LD	(FLAGS), A
	INC	HL
	DEC	B
	JR	OP2

PUTS:
	LD	C, F_PRINT
	JP	BDOS

; HL dezimal ausgeben
PRDEC:
	LD	DE, 10000
	CALL	PD1
	LD	DE, 1000
	CALL	PD1
	LD	DE, 100
	CALL	PD1
	LD	DE, 10
	CALL	PD1
	LD	DE, 1
PD1:	LD	C, '0'
PD2:	OR	A
	SBC	HL, DE
	JR	C, PD3
	INC	C
	JR	PD2
PD3:	ADD	HL, DE
	PUSH	HL
	PUSH	DE
	LD	E, C
	LD	C, 2
	CALL	BDOS
	POP	DE
	POP	HL
	RET

M_USAGE:
	DB	'LBPUNCH - Lochband stanzen (K6022/SIF1000)', 0DH, 0AH
	DB	'  LBPUNCH datei [/A] [/K]', 0DH, 0AH
	DB	'  /A ASCII (gerade Paritaet, Ende bei 1AH)  /K ohne Vor-/Nachlauf', 0DH, 0AH, '$'
M_NOIM2:
	DB	'FEHLER: Betriebssystem laeuft nicht im Interruptmodus 2.', 0DH, 0AH, '$'
M_SLOT:
	DB	'FEHLER: Vektorplatz EEH in der Interrupttabelle ist belegt.', 0DH, 0AH, '$'
M_NOFILE:
	DB	'FEHLER: Datei nicht gefunden.', 0DH, 0AH, '$'
M_NOPUNCH:
	DB	'FEHLER: Stanzer antwortet nicht (K6022 gesteckt? Stanzer an?).', 0DH, 0AH, '$'
M_OK:	DB	' Byte gestanzt.', 0DH, 0AH, '$'

OLDSP:	DW	0
SLOT:	DW	0
OLD0:	DB	0
OLD1:	DB	0
INST:	DB	0
FLAGS:	DB	0
FLAGST:	DB	0
CNT:	DW	0
BUF:	DS	128
	DS	96
STACK	EQU	$

	END	START
