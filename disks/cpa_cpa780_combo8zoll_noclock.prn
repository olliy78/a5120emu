                         C       endif
                         C       if kbds5i+kbds5s+kbds5t
  04A3    FE 05          C      	cp	5		;;war schon 5?
  04A5    30 13          C      	jr	nc,coits5	;;ja
  04A7    3E 4E          C      	ld	a,kbds5i
  04A9    32 04C3        C      	ld	(kbdsmi),a
  04AC    3E 4F          C      	ld	a,kbds5s
  04AE    32 04C4        C      	ld	(kbdsms),a
  04B1    3E 4A          C      	ld	a,kbds5t
  04B3    32 04C2        C      	ld	(kbdsmt),a
