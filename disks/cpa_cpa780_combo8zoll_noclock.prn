  DEB9    B9             C      	cp	c		;richtiges Geraet?
  DEBA    28 6C          C      	jr	z,dbmat		;ja, Sektor steht im Puffer
                         C      
  DEBC    C5             C      dbn:	push	bc		;retten ddrive
  DEBD    CD DF60        C      	call	dbtrw		;veraenderten Puffer ausgeben
  DEC0    C1             C      	pop	bc		;c:=ddrive
  DEC1    21 E19A        C      	ld	hl,dbdev
  DEC4    71             C      	ld	(hl),c
  DEC5    2A E1A4        C      	ld	hl,(dtrack)
