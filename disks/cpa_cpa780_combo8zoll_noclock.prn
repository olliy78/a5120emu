  DF52    28 05          C      	jr	z,dmovew	;ja, Puffer ausgeben
  DF54    3A E1B1        C      	ld	a,(dwrtyp)
  DF57    FE 01          C      	cp	1		;write to directory?
  DF59    CC DF60        C      dmovew:	call	z,dbtrw		;ja, veraend. Puffer ausgeben
  DF5C    3A E1B2        C      	ld	a,(dberrf)	;Ergebnis letztes dbtran
  DF5F    C9             C      	ret
