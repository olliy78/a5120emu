  DE92    B7             C      	or	a		;d.h. mit Sektorversatz?
  DE93    CA DF90        C      	jp	z,drwsec	;ja, keine Pufferung sinnvoll
                         C       ENDIF
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-68


  DE96    78             C      	ld	a,b
