                         C      	include BIOSCRT
                         C      ;************************************************************
                         C      ; Bildschirm-Ausgabe K7023, K7024, DSY5 u.ae.
                         C      ; - Fehlerkorrektur Steuerzeichen 18h (es wurden nur 79 Zeichen gel.)
                         C      ; - bei Tastenumdefinition auch chr(253) als Begrenzer (dbase)
                         C      ; - BAB2 als Standardvariante
                         C      ; - 17h (insline) und 19h (delline) eingefuehrt fuer TURBO-PASCAL-Editor
                         C      ; - Realisierung der SCP1715-Steuerzeichen 1b 5e xx (Feldattribut)
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-34


                         C      ;   und 1b 5f xx (Spezialzeichen)
                         C      ;   Diese ESC-Folgen fueren beim Buerocomputer i.a. auf '^' (unzulaessig),
                         C      ;   ausser Feldattribute invers und hell (Reaktion wie Steuerz. 84..87)
                         C      ; - Einfuehrung Umlaut-Umkodierung fuer deutschen Zeichensatz
                         C      ;   einschl. SCP1715-Steuerzeichen 0Eh und 0Fh
                         C      ; - Einfuehrung MACROS "setbs" und "setram" zum Hin- und Rueckschalten
                         C      ;   des Bildschirmpuffers
                         C      ; 17.06.88
                         C      ; - Zugriff zum Bildschirm aus Interruptroutinen unterdrueckt
                         C      ; - Unterstuetzung von Karten mit Bit 7 invers (z.B. DSY5)
                         C      ; - Unterst. einer weiteren Variante fuer dtsch. Zeichens. auf 00..1f (ZSIBM)
                         C      ; 23.09.88
                         C      ; - Einfuehrung der Macros 'crton' und 'crtoff'
                         C      ; - di/ei waehrend Bildschirmumschaltung eingefuehrt
                         C      ;************************************************************
                         C      
                         C       if1
                         C       endif	;if1
                         C      
                         C       IF crtbfl eq 0
                         C       ELSE ;crtbfl ne 0
                         C        IF1
                         C        ENDIF
                         C       ENDIF
                         C      
                         C      
                         C      ;**************************************************************************
  D346                   C      crtst	equ	dumst		;CRT:-Status immer ready
                         C      
  D66E                   C      crto:
  D66E    3E C3          C      	ld	a,0c3h		;jp ...
  D670    32 E77C        C      	ld	(intcrt),a	;waehrend Bildaufbau Interrupt-Zugriff verb.
  D673    C5             C      	push	bc		;merken zeichen in c
  D674    2A D238        C      	ld	hl,(crtcps)	;Kursorposition	
                         C      	setbs
  D677    CB BE          C      	res	7,(hl)		;loeschen Kursor
                         C      	setram
  D679    CD D6AB        C      	call	crtoti		;Zeichen ausgeben
                         C      ;				 HL danach auf neuer Kursorpositon
                         C      
                         C      ; Setzen Kursor auf (HL)
                         C      
  D67C    22 D238        C      	ld	(crtcps),hl	;cursorposition
                         C      	setbs
  D67F    3E 80          C      	ld	a,80h
  D680                   C      dcurs	equ	$-1
  D681    B6             C      	or	(hl)		;Kursor setzen
  D682    77             C      	ld	(hl),a
                         C      	setram
  D683    C1             C      crtonc:	pop	bc		;wiederherstellen c-reg
                         C      
  D684    3E 21          C      	ld	a,021h		;ld hl,...
  D686    32 E77C        C      	ld	(intcrt),a	;wiederzulassen Zugriff aus Interruptrtn
                         C      
                         C       if (stpvar ne 0)  and (chdvar ne 0)
                         C      ; Hardcopy realisieren
                         C      
  D689    3A 0040        C      	ld	a,(lampbf)
  D68C    CB 7F          C      	bit	lmphcp,a	;Hardcopy?
  D68E    C8             C      	ret	z		;nein
  D68F    79             C      	ld	a,c
  D690    E6 7F          C      	and	7fh
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-35


  D692    FE 20          C      	cp	20h		;Steuerzeichen?
  D694    38 03          C      	jr	c,crtoe1	;ja
  D696    FE 7F          C      	cp	7fh
  D698    D8             C      	ret	c
  D699    C5             C      crtoe1:	push	bc
  D69A    21 D6A7        C      	ld	hl,crtlc	;zugelassene Steuerzeichen
  D69D    01 0004        C      	ld	bc,crtlcl
  D6A0    ED B1          C      	cpir			;erlaubt?
  D6A2    C1             C      	pop	bc
  D6A3    C8             C      	ret	z		;ja
  D6A4    0E 5E          C      	ld	c,'^'		;sonst Spezialzeichen
  D6A6    C9             C      	ret
                         C      
                         C      ; bei Hardcopy Bildschirm -> Drucker zugelassene Steuerzeichen
                         C      
  D6A7    08 0A 0C 0D    C      crtlc:	db	08h,0ah,0ch,0dh
  0004                   C      crtlcl	equ	$-crtlc
                         C      
                         C       endif	;stpvar and chdvar
                         C      
                         C      
                         C      ;========================================================
                         C      ; interner Aufruf Bildschirmtreiber
                         C      ; i HL	Zeiger in Bildschirmpuffer auf Kursorposition
                         C      ; o HL	neuer Zeiger auf Kursorposition
                         C      ;========================================================
                         C      
  D6AB                   C      crtoti:
  D6AB    3E 00          C      	ld	a,0		;escape mode
  D6AC                   C      desc	equ	$-1
  D6AD    B7             C      	or	a
  D6AE    20 62          C      	jr	nz,crto04	;ja
  D6B0    79             C      crto02:	ld	a,c
  D6B1    32 D8B0        C      	ld	(crtcch),a	;merken fuer direkte Ausgabe
  D6B4    FE 87          C      	cp	87h		;07h ist bell!, daher 87h<>07h
  D6B6    28 39          C      	jr	z,crto09
  D6B8    CB BF          C      	res	7,a		;sonst 1xxxxxxxB  = 0xxxxxxxB
  D6BA    FE 20          C      	cp	20h		;steuerzeichen?
  D6BC    38 33          C      	jr	c,crto09	;ja
  D6BE    FE 7F          C      	cp	7fh
  D6C0    30 2F          C      	jr	nc,crto09
                         C       IF umlaut
  D6C2    CD D87F        C      	call	crtuml		;evtl. Umlaute umkodieren
                         C       ENDIF
  D6C5                   C      crtobs:
  D6C5    EB             C      	ex	de,hl
                         C       IF crt eq dsy5
                         C       ENDIF
  D6C6                   C      crtsbl:
                         C      	setbs
  D6C6    12             C      	ld	(de),a		;Zeichen in Bildschirmpuffer
                         C      	setram
  D6C7    21 0001        C      crtcur:	ld	hl,0-bsend1
  D6C8                   C      crtm01	equ	$-2
  D6CA    19             C      	add	hl,de		;bs voll?
  D6CB    EB             C      	ex	de,hl
  D6CC    23             C      	inc	hl	
  D6CD    D0             C      	ret	nc
  D6CE    11 FFC0        C      	ld	de,bsend1-bssp1+1
  D6CF                   C      crtm02	equ	$-2
  D6D1    D5             C      crto03:	push	de
  D6D2    21 FC40        C      	ld	hl,bsanf1+bssp1	;aufschieben
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-36


  D6D3                   C      crtm03	equ	$-2
  D6D5    11 FC00        C      	ld	de,bsanf1
  D6D6                   C      crtm04	equ	$-2
  D6D8    01 03C0        C      	ld	bc,bsend1-bsanf1-bssp1+1
  D6D9                   C      crtm05	equ	$-2
                         C      	setbs
  D6DB    ED B0          C      	ldir
  D6DD    2B             C      	dec	hl
  D6DE    36 20          C      	ld	(hl),' '	;letzte zeile loeschen
  D6E0    11 FFFE        C      	ld	de,bsend1-1
  D6E1                   C      crtm06	equ	$-2
  D6E3    01 003F        C      	ld	bc,bssp1-1
  D6E4                   C      crtm07	equ	$-2
  D6E6    ED B8          C      	lddr
                         C      	setram
  D6E8    E1             C      	pop	hl
  D6E9    C9             C      	ret
