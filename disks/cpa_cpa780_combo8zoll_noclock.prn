                         C      ; i HL	Stringanfang
  D3F3    1C             C      kbdco1:	inc	e
  D3F4    E5             C      kbdco2:	push	hl
  D3F5    D5             C      	push	de
  D3F6    7E             C      	ld	a,(hl)
  D3F7    CD D3DC        C      	call	kbdput		;Zeichen in Puffer
  D3FA    D1             C      	pop	de
  D3FB    E1             C      	pop	hl
  D3FC    23             C      	inc	hl
  D3FD    1D             C      	dec	e
