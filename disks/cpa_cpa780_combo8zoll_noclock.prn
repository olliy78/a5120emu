  D42E    CD D369        C      kbdwb:	call	kbdst		;abwarten tastendruck
  D431    28 FB          C      	jr	z,kbdwb
  D433    21 D40A        C      kbdwe:	ld	hl,kbdwt	;bei neuer taste
  D436    36 64          C      	ld	(hl),100	;100*0.01 sec warten
