  0483    3E 5A          C      	ld	a,kbds3t
  0485    32 04C2        C      	ld	(kbdsmt),a
  0488    E1             C      	pop	hl		;;return-Adresse vergessen
  0489    C3 03BF        C      	jp	ciisrt	
  048C                   C      coits3:
                         C       endif
                         C       if kbds4i+kbds4s+kbds4t
  048C    FE 04          C      	cp	4		;;war schon 4?
  048E    30 13          C      	jr	nc,coits4	;;ja
  0490    3E 52          C      	ld	a,kbds4i
  0492    32 04C3        C      	ld	(kbdsmi),a
  0495    3E 53          C      	ld	a,kbds4s
