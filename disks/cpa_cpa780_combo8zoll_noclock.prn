                         C      
                         C       IF @write
                         C      
                         C       IF dsk8fm+dsk8mf+dsk5fm
                         C      
                         C      ; Schreiben FM
                         C      ;-------------
  E6A6    DB 16          C      diowfm:	in	a,(fldabd)
  E6A8    EB             C      	ex	de,hl
  E6A9    DB 16          C      	in	a,(fldabd)
  E6AB    01 A410        C      	ld	bc,10100100b*256+flcoad
  E6AD                   C      diom04	equ	$-1		;a4/a0
  E6AE    DB 16          C      	in	a,(fldabd)
  E6B0    ED 41          C      	out	(c),b		;Schreiben FM Daten ein
  E6B2    DB 16          C      	in	a,(fldabd)
  E6B4    AF             C      	xor	a
  E6B5    D3 14          C      	out	(fldaad),a	;6*'00'
  E6B7    01 0414        C      	ld	bc,4*256+fldaad
  E6BA    D3 14          C      diowfs:	out	(fldaad),a
  E6BC    10 FC          C      	djnz	diowfs
  E6BE    3E B6          C      	ld	a,10110110b
  E6BF                   C      diom05	equ	$-1		;b6/b2
  E6C0    ED 41          C      	out	(c),b
  E6C2    D3 10          C      	out	(flcoad),a	;schreiben FM Marke ein
  E6C4    3E A4          C      	ld	a,10100100b
  E6C5                   C      diom06	equ	$-1		;a4/a0
  E6C6    ED A3          C      	outi			;'FB'	
  E6C8    D3 10          C      	out	(flcoad),a	;schreiben FM Daten ein
  E6CA    18 2C          C      	jr	diowrt
                         C       ENDIF
                         C      
                         C      
                         C      ; Schreiben  MFM
                         C      ;---------------
  E6CC    DB 16          C      diwmfm:	in	a,(fldabd)
  E6CE    DB 16          C      	in	a,(fldabd)
  E6D0    01 B410        C      	ld	bc,10110100b*256+flcoad
  E6D2                   C      diom07	equ	$-1		;b4/b0
  E6D3    DB 16          C      	in	a,(fldabd)
  E6D5    ED 41          C      	out	(c),b		;Schreiben MFM normal
  E6D7    DB 16          C      	in	a,(fldabd)
  E6D9    AF             C      	xor	a
  E6DA    D3 14          C      	out	(fldaad),a	; 1*'00'
  E6DC    01 0A14        C      	ld	bc,10*256+fldaad
  E6DF    D3 14          C      diwmfs:	out	(fldaad),a	;10*'00'
  E6E1    10 FC          C      	djnz	diwmfs
  E6E3    3E B6          C      	ld	a,10110110b
  E6E4                   C      diom08	equ	$-1		;b6/b2
  E6E5    ED 41          C      	out	(c),b		; 1*'00'
  E6E7    D3 10          C      	out	(flcoad),a	;Schreiben MFM Marke
  E6E9    06 A1          C      	ld	b,0a1h
  E6EB    ED 41          C      	out	(c),b		;3*'A1'
  E6ED    3E B4          C      	ld	a,10110100b
  E6EE                   C      diom09	equ	$-1		;b4/b0
  E6EF    ED 41          C      	out	(c),b
  E6F1    EB             C      	ex	de,hl
  E6F2    ED 41          C      	out	(c),b
  E6F4    D3 10          C      	out	(flcoad),a	;Schreiben MFM normal
  E6F6    ED A3          C      	outi			;'FB'
                         C      
  E6F8    06 80          C      diowrt:	ld	b,128		;Laenge erster OTIR-Block
  E6F9                   C      diosl2	equ	$-1		;128 bei Sektl 128, sonst 0
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-99


  E6FA    EB             C      	ex	de,hl
  E6FB    ED A3          C      doti1:	outi			;Daten ausgeben
  E6FD    ED A3          C      doti2:	outi
  E6FF    ED A3          C      doti3:	outi
  E701    ED B3          C      	otir
  E703    EB             C      	ex	de,hl
