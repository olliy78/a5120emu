  D48B    4E             C      kbdrc3:	ld	c,(hl)		;phys. Tastencode
  D48C    0C             C      	inc	c
  D48D    0D             C      	dec	c		;TabEnde?
  D48E    28 07          C      	jr	z,kbdrc1	;ja
  D490    B9             C      	cp	c		;Umcodieren ?
  D491    23             C      	inc	hl
  D492    28 07          C      	jr	z,kbdrc2	;ja
  D494    23             C      	inc	hl
  D495    18 F4          C      	jr	kbdrc3		;weiter in Tab
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-28


  D497    FE 80          C      kbdrc1:	cp	80h		;Sonderzeichen, das nicht in Tabelle?
  D499    38 01          C      	jr	c,kbdrc6	;nein; sonst A=00, d.h. Zeichen ignorieren
  D49B    7E             C      kbdrc2:	ld	a,(hl)		;virtueller Tastencode
  D49C                   C      kbdrc6:	
                         C      
  D49C                   C      cocpm2:
  D49C    21 D23D        C      	ld	hl,synflg
  D49F    FE 20          C      	cp	20h		;Sondertaste?
  D4A1    38 0D          C      	jr	c,kbdrc5	;<20h, ja
  D4A3    FE 80          C      	cp	80h		
  D4A5    38 04          C      	jr	c,kbdrc4	;nein
                         C      ; virtueller Code 80..ff
  D4A7    E6 FF          C      	and	0ffh
  D4A8                   C      kbdlcs	equ	$-1		;auf bfh, wenn Taste mit Control/Shift
  D4A9    18 05          C      	jr	kbdrc5
                         C      ; normale Taste 20..7f
  D4AB    CB 46          C      kbdrc4:	bit	ctrlst,(hl)	;norm. Taste mit Control?
  D4AD    C8             C      	ret	z
  D4AE    E6 1F          C      	and	1fh		;CTRL realisieren
  D4B0    CB 86          C      kbdrc5:	res	ctrlst,(hl)
  D4B2    C9             C      	ret
                         C      
                         C      ; Suchen, ob Taste (A) umzukodieren entspr. Stringtab ab (HL)
                         C      ; ret z:	nicht gefunden, A unveraendert
                         C      ; ret nz:	gefunden, A unveraendert
                         C      ;		E Stringlaenge +1
                         C      ;		HL Stringanfang (nur gueltig falls E>1!)
  D4B3    16 00          C      costr:	ld	d,0
  D4B5    4E             C      costr0:	ld	c,(hl)		;Tastencode o. Tabende
  D4B6    0C             C      	inc	c		;Tabende?
  D4B7    C8             C      	ret	z		;ja, nicht gefunden
  D4B8    23             C      	inc	hl
  D4B9    5E             C      	ld	e,(hl)		;Stringlaenge
  D4BA    1C             C      	inc	e		;+1
  D4BB    0D             C      	dec	c		;Tastencode wiederherstellen
  D4BC    B9             C      	cp	c		;Zeichen umkodieren?
  D4BD    28 03          C      	jr	z,costr1	;ja
  D4BF    19             C      	add	hl,de		;String uebergehen
  D4C0    18 F3          C      	jr	costr0
  D4C2                   C      costr1:
  D4C2    23             C      	inc	hl
  D4C3    14             C      	inc	d		;ret nz
  D4C4    C9             C      	ret
                         C      
                         C       IF costu
                         C       ENDIF
                         C      
                         C      ; Tastatur-Lampe umschalten
                         C      ;==========================
  D4C5    21 0040        C      kbdslm:	ld	hl,lampbf
  D4C8    AE             C      	xor	(hl)		;Lampe ein/aus
  D4C9    77             C      	ld	(hl),a
                         C      
                         C      ; Tastatur-Lampen ein/aus
                         C      ;========================
                         C      ; Achtung! Diese Routine wird auch aus Interrupt-Routine
                         C      ; aufgerufen (EI/DI darf hier nicht auftreten!!)
  D4CA                   C      lampen:
                         C      
  D4CA                   C      kbdmd2:		;Routine fuer K7637,
                         C      ;		 wird modifiziert bei K7604/06/34/36
  D4CA    3A 0040        C      lampen:	ld	a,(lampbf)
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-29


  D4CD    EE 00          C      	xor	00h		;ermitteln veraenderte Bits
  D4CE                   C      lamplt	equ	$-1		;Kopie Lampen-Puffer
  D4CF    C8             C      	ret	z		;unveraendert
  D4D0    21 E750        C      	ld	hl,intkbd
  D4D3    36 21          C      	ld	(hl),21h	;call ... -> ld hl,...
                         C      				;d.h. 5ms Tastaturabfrage verbieten
  D4D5    26 55          C      	ld	h,55h		;Standard-Vorbyte
  D4D7    6F             C      	ld	l,a
  D4D8    CB 7D          C      	bit	7,l		;INS-MODE ?
  D4DA    28 06          C      	jr	z,lampb6	;nein
  D4DC    7C             C      	ld	a,h
  D4DD    D3 5C          C      	out	(kbdsci),a
  D4DE                   C      k37dm3	equ	$-1		;modfiziert bei Digitalisier-AP
  D4DF    CD D524        C      	call	lmpout
  D4E2    CB 75          C      lampb6:	bit	6,l		;Fehlerlampe ?
  D4E4    28 05          C      	jr	z,lampb3	;nein
  D4E6    3E 20          C      	ld	a,20h
  D4E8    CD D524        C      	call	lmpout
  D4EB    CB 5D          C      lampb3:	bit	3,l		;Sel3?
  D4ED    28 08          C      	jr	z,lampb2
  D4EF    7C             C      	ld	a,h
  D4F0    D3 5C          C      	out	(kbdsci),a
  D4F1                   C      k37dm4	equ	$-1		;modfiziert bei Digitalisier-AP
  D4F2    3E 52          C      	ld	a,52h
  D4F4    CD D524        C      	call	lmpout
  D4F7    CB 55          C      lampb2:	bit	2,l		;Sel2?
  D4F9    28 08          C      	jr	z,lampb1
  D4FB    7C             C      	ld	a,h
  D4FC    D3 5C          C      	out	(kbdsci),a
  D4FD                   C      k37dm5	equ	$-1		;modfiziert bei Digitalisier-AP
  D4FE    3E 44          C      	ld	a,44h
  D500    CD D524        C      	call	lmpout
  D503    CB 4D          C      lampb1:	bit	1,l
  D505    28 08          C      	jr	z,lampb0
  D507    7C             C      	ld	a,h
  D508    D3 5C          C      	out	(kbdsci),a
  D509                   C      k37dm6	equ	$-1		;modfiziert bei Digitalisier-AP
  D50A    3E 20          C      	ld	a,20h
  D50C    CD D524        C      	call	lmpout
  D50F    CB 45          C      lampb0:	bit	0,l
  D511    28 05          C      	jr	z,lampbn
  D513    3E 52          C      	ld	a,52h
  D515    CD D524        C      	call	lmpout
  D518    3A 0040        C      lampbn:	ld	a,(lampbf)
  D51B    32 D4CE        C      	ld	(lamplt),a	;neuen Zustand merken
  D51E    21 E750        C      	ld	hl,intkbd
  D521    36 CC          C      	ld	(hl),0cch	;ld hl,... -> call z,...
  D523    C9             C      	ret
                         C      
  D524    E5             C      lmpout:	push	hl
  D525    D3 5C          C      	out	(kbdsci),a
  D526                   C      k37dm7	equ	$-1		;modfiziert bei Digitalisier-AP
  D527    CD D44D        C      lmpow:	call	kbdst1		;warten auf Antwort
  D52A    28 FB          C      	jr	z,lmpow
  D52C    DB 5C          C      	in	a,(kbdsci)
  D52D                   C      k37dm8	equ	$-1		;modfiziert bei Digitalisier-AP
  D52E    E6 F0          C      	and	0f0h
  D530    FE 80          C      	cp	typc37		;Antwort da?
  D532    20 F3          C      	jr	nz,lmpow	;nein
  D534    E1             C      	pop	hl
  D535    C9             C      	ret
