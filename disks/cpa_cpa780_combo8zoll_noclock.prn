BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-70


                         C      	ENDIF	;dbufsz gt 7
                         C      
                         C      	IF	format or (dbufsz gt 7)
                         C      ; gemeinsamer Zweig Lesen/Schreiben Puffer
                         C      ;=========================================
  DF66                   C      dbtran:	
  DF66    21 E199        C      	ld	hl,dbcdb
                         C      	IF	dbufsz gt 7
  DF69    CD DF93        C      	call	dsktra
  DF6C    32 E1B2        C      	ld	(dberrf),a	;Fehlerflag stellen
  DF6F    21 E199        C      	ld	hl,dbflg
  DF72    CB 96          C      	res	dfbwr,(hl)	;Puffer ist nicht beschrieben
  DF74    C9             C      	ret
                         C      	ENDIF
                         C      
                         C      	ENDIF
                         C      
                         C      	IF	format
                         C      ; Lesen beliebigen Sektor-Id.
                         C      ;===========================
  DF75    32 E194        C      dsidtt:	ld	(dfrmtr),a	;Eingang fuer Spur in A
  DF78                   C      dsidtr:
  DF78    21 E192        C      	ld	hl,dfrcdb
                         C       IF dsk8mf
  DF7B    CB 9E          C      	res	dioffm,(hl)	;nicht temporaer umschalten
  DF7D    CD DF93        C      	call	dsktra		;beliebigen Sektorid lesen
  DF80    C8             C      	ret	z		;ok
  DF81    DD 7E 18       C      	ld	a,(ix+dpbtyp)
  DF84    E6 18          C      	and	(1 shl dpbt5z)+(1 shl dpbtdd)	;8"/5" und FM/MFM
  DF86    EE 08          C      	xor	1 shl dpbtdd	;8" MFM ?
  DF88    C0             C      	ret	nz		;nein, Fehler
  DF89    21 E192        C      	ld	hl,dfrcdb
  DF8C    CB DE          C      	set	dioffm,(hl)	;temporaer auf FM umschalten
                         C       ENDIF
  DF8E    18 03          C      	jr	dsktra		;belieb. SektId lesen
                         C      	ENDIF
                         C      
                         C      
                         C      ; gemeinsamer Zweig Read/Write 128-Sektor einzeln
                         C      ;================================================
  DF90                   C      drwsec:
  DF90    21 E1A2        C      	ld	hl,dcdb
                         C      
                         C      ; interner Aufruf phys. Diskettentransfer
                         C      ;----------------------------------------
                         C      ; i HL auf CDB
  DF93                   C      dsktra:
                         C       IF dev eq cpd
                         C       ENDIF
                         C      
                         C      ;*********************************************************
                         C      ; Umkleidung des physischer Disketten-Transfers
                         C      ;*********************************************************
                         C      
                         C      ; Parameter: HL auf CDB mit folgender Struktur:
                         C      ; +0: cdbfl	;Flags	(Struktur angepasst an ft.kom)
  0000                   C      diof00	equ	0	;** frei fuer Anw. ** (frueher Verify nach Schreiben)
  0001                   C      diofid	equ	1	;fest	;=1, wenn nur Sektid. zu lesen
  0002                   C      diofwr	equ	2	;fest	;=1, wenn Schreiben
  0003                   C      dioffm	equ	3	;fest	;=1, wenn temporaer FM-Format erzwungen
  0004                   C      dioftr	equ	4		;=1, wenn keine Fehlermeldung (und -behandlg)
  0005                   C      diofhd	equ	5		;=1, wenn Kopf hochnehmen ("headup")
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-71


  0006                   C      diofps	equ	6		;=1, wenn trk,sid,sec schon physisch
  0007                   C      diofs1	equ	7	;fest	;=1, wenn Rueckseite
                         C      
                         C      ; ab hier unwichtig bei "diofhd" in cdbfl =1 (headup)
                         C      ; +1: cdbdev	;logisches Geraet 0 .. dphnb-1
                         C      ; +2: cdbtrk	;log./phys. Spur
                         C      ; +3: cdbsid	;bel./phys. Seite
                         C      ; +4: cdbsec	;log./phys. Sektor
                         C      ; +5: cdbslc	;Sektorlaengencode (0=128, 1=256, 2=512, 3=1024)
                         C      ; +6: cdbsnb	;Anz. zu uebertr. ph. Sekt. (wenn =0, so nur position.)
                         C      ; ab hier nur wichtig, wenn "diofid" in cdbfl =0:
                         C      ; +7,8: cdbdma	;Transferadresse
                         C      
                         C      ; Return, falls nicht "diofhd" in cdbfl =1:
                         C      ;	A=0 (ret z) bei fehlerfrei, sonst A=1 (ret nz) bei cdbfl, "dioftr" =0
                         C      ;	oder Returncode phys. Transfer
                         C      ;	E:=trk, D:=sid ,L:=sec, H:=len
                         C      ;	BC,IX unveraendert
                         C      
  DF93                   C      diskio:	;Aufruf ueber Sprungvektor von BIOS-Erweiterung
  DF93    C5             C      	push	bc
  DF94    11 E1B3        C      	ld	de,diocdb	;CDB des Nutzers auf internen Hilfsspeicher
  DF97    01 0009        C      	ld	bc,diocdl	;da modifiziert
  DF9A    D5             C       	push	de
                         C       IF dev eq cpd
                         C       ELSE
  DF9B    ED B0          C      	ldir
                         C       ENDIF
  DF9D    E1             C      diskii:	pop	hl		;hl auf diocdb
  DF9E    C1             C      	pop	bc
                         C      
  DF9F    CB 6E          C      	bit	diofhd,(hl)	;Kopf hochnehmen?
                         C       IF disknb ne 0
  DFA1    C2 E490        C      	jp	nz,headup	;ja, kein Transfer
                         C       ENDIF
  DFA4    C5             C      	push	bc
  DFA5    DD E5          C      	push	ix
  DFA7    E5             C      	push	hl
  DFA8    23             C       	inc	hl
  DFA9    4E             C      	ld	c,(hl)		;logisches Laufwerk
  DFAA    CD E99F        C      	call	dgetpb		;IX auf DPB stellen
  DFAD    E1             C      	pop	hl		;wiederherstellen hl
  DFAE    3E 44          C      	ld	a,'D'		;falls LW nicht ex.
  DFB0    CA E083        C      	jp	z,dioert	;LW ex. nicht
                         C      
                         C       IF hdsk
                         C       ENDIF
  DFB3    CB 76          C      	bit	diofps,(hl)	;trk,sid,sec schon physisch?
  DFB5    20 6E          C      	jr	nz,diophy	;ja
                         C       IF dsk8mf
  DFB7    DD CB 18 7E    C      	bit	dpbt52,(ix+dpbtyp)	;8" MFM?
  DFBB    28 0E          C      	jr	z,drwnsp	;nein
  DFBD    DD 7E 0F       C      	ld	a,(ix+dpbflg)
  DFC0    E6 03          C      	and	dpbfsm		;Zahl der abweichenden 128er Sektoren
  DFC2    57             C      	ld	d,a
  DFC3    3A E1B5        C      	ld	a,(dioctr)	;verlangte Spur
  DFC6    BA             C      	cp	d		;im abweichenden Format?
  DFC7    30 02          C      	jr	nc,drwnsp	;nein
  DFC9    CB DE          C      	set	dioffm,(hl)	;sonst temporaer FM erzwingen
  DFCB                   C      drwnsp:
                         C       ENDIF
                         C      ; Track, Side und Sector entpsr. Diskettenformat setzen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-72


  DFCB    23             C      	inc	hl
  DFCC    23             C      	inc	hl
  DFCD    56             C      	ld	d,(hl)		;Track
  DFCE    5A             C      	ld	e,d		;merken
  DFCF    23             C      	inc	hl
  DFD0    23             C      	inc	hl
  DFD1    4E             C      	ld	c,(hl)		;Sektornummer ab 1
  DFD2    0D             C      	dec	c		;Sektornr. ab 0
  DFD3    DD CB 0F 66    C      	bit	dpbf86,(ix+dpbflg)	;Fortsetzung Dsk. auf Ruecks.?
  DFD7    20 0C          C      	jr	nz,diots2	;ja
  DFD9    DD CB 0F 6E    C      	bit	dpbfds,(ix+dpbflg)	;ungerade Spuren auf Rueckseite?
  DFDD    28 29          C      	jr	z,diotrs	;nein, einseitig
  DFDF    CB 3A          C      	srl	d		;Spur halbieren
  DFE1    30 25          C      	jr	nc,diotrs	;gerade Spur, Vorderseite
  DFE3    18 12          C      	jr	diots1		;auf Rueckseite
  DFE5    DD 46 14       C      diots2:	ld	b,(ix+dpbtrk)	;log. Spurzahl
  DFE8    CB 38          C      	srl	b		;Spuren auf Vorderseite
  DFEA    7A             C      	ld	a,d
  DFEB    90             C      	sub	b		;Spur auf Vorderseite?
  DFEC    38 1A          C      	jr	c,diotrs	;ja, Spur in d unveraendert lassen
                         C      				;40 ->  0; 41 ->  1; ...; 79 ->  39
                         C      				;77 ->  0; 78 ->  1; ...;153 ->  76
  DFEE    DD CB 0F 5E    C      	bit	dpbfsv,(ix+dpbflg)	;Ruecks. von aussen nach innen?
  DFF2    20 02          C      	jr	nz,diots4	;ja
  DFF4    2F             C      	cpl			;40 -> -1; 41 -> -2; ...; 79 -> -40
                         C      				;77 -> -1; 78 -> -2; ...;153 -> -77
  DFF5    80             C      	add	a,b		;40 -> 39; 41 -> 38; ...; 79 ->   0
                         C      				;77 -> 76; 78 -> 75; ...;153 ->   0
  DFF6    57             C      diots4:	ld	d,a
  DFF7    3A E1B3        C      diots1:	ld	a,(diocfl)
  DFFA    CB FF          C      	set	diofs1,a	;vermerken Rueckseite
  DFFC    32 E1B3        C      	ld	(diocfl),a
  DFFF    DD 7E 13       C      	ld	a,(ix+dpbsn0)	;Versch. der Sektornr. auf Rueckseite
  E002    81             C      	add	a,c		;Sektornr. evtl. weiterzaehlen
                         C      ;;;	cp	c		;Weiternummerierung auf Rueckseite?
  E003    4F             C      	ld	c,a
                         C      ;;;	jr	nz,diotrs	;ja, dann side:=0
  E004    3E 01          C      	ld	a,1		;side:=1
  E006    18 01          C      	jr	diotss
  E008    AF             C      diotrs:	xor	a		;side:=0
  E009    32 E1B6        C      diotss:	ld	(diocsi),a	;phys. Seite setzen
  E00C    7A             C      	ld	a,d
  E00D    32 E1B5        C      	ld	(dioctr),a	;phys. Spur setzen
                         C      
  E010    7B             C      	ld	a,e		;log. Spurnr. zurueck nach A
  E011    DD E5          C      	push	ix
  E013    E1             C      	pop	hl
  E014    11 0019        C      	ld	de,dpbstr	;d:=0
  E017    19             C      	add	hl,de
  E018    DD BE 0D       C      	cp	(ix+dpbofs)	;Systemspur?
  E01B    38 03          C      	jr	c,diossp	;ja, Sektornummern nicht logisch
  E01D    59             C      	ld	e,c
  E01E    19             C      	add	hl,de		;HL entspr. Index in dpbstr
  E01F    4A             C      	ld	c,d		;c:=0
  E020    79             C      diossp:	ld	a,c		;phys. Sektornr. ab 0
  E021    86             C      	add	a,(hl)		;+echte Sektornr.
  E022    32 E1B7        C      	ld	(diocse),a	;phys. Sektor setzen
  E025                   C      diophy:
                         C      
                         C      ; i ret, BC, IX im Stack
                         C      ; i cdb auf diocdb
                         C      ; i IX auf DPB
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-73


                         C      
  E025                   C      diorty:	;interne Wiederholung diskio
  E025    DD E5          C      	push	ix		;retten IX fuer evtl. Wiederholung
  E027    21 E1B3        C      	ld	hl,diocdb
  E02A    E5             C      	push	hl
  E02B    7E             C      	ld	a,(hl)		;side 0/1, -/FM, read/write, -/sectid l.
  E02C    E6 8E          C       and (1 shl diofs1)+(1 shl dioffm)+(1 shl diofwr)+(1 shl diofid)
  E02E    47             C      	ld	b,a
  E02F    DD 7E 18       C      	ld	a,(ix+dpbtyp)	;5"/8", FM/MFM, 40/80, Verify nach Schreiben
  E032    E6 78          C       and (1 shl dpbt80)+(1 shl dpbt5z)+(1 shl dpbtdd)+(1 shl dpbtwv) ;aus DPB
  E034    A8             C      	xor	b
                         C       IF dsk8mf
  E035    DD CB 0F 56    C      	bit	dpbffm,(ix+dpbflg)	;Diskette permanent FM?
  E039    28 02          C      	jr	z,dionfm	;nein
  E03B    CB 9F          C      	res	dpbtdd,a		;erzwingen FM-Format
  E03D                   C      dionfm:
                         C       ENDIF
  E03D    CB 66          C      	bit	dioftr,(hl)	;Fehlerbehandlung unterdruecken?
  E03F    28 01          C      	jr	z,dionft	;nein
  E041    3C             C      	inc	a
  E042                   C      dionft:
  E042    32 E4AD        C      	ld	(ft.kom),a	
                         C      
  E045    23             C      	inc	hl
  E046    DD 7E 15       C      	ld	a,(ix+dpbdnr)	;physische LW-Nr.
  E049    32 E4B0        C      	ld	(ft.lwn),a
                         C      
  E04C    23             C      	inc	hl
  E04D    7E             C      	ld	a,(hl)
  E04E    32 E4B1        C      	ld	(ft.trk),a
  E051    23             C      	inc	hl
  E052    7E             C      	ld	a,(hl)
  E053    32 E4B2        C      	ld	(ft.sid),a
  E056    23             C      	inc	hl
  E057    7E             C      	ld	a,(hl)
  E058    32 E4B3        C      	ld	(ft.sec),a
  E05B    23             C      	inc	hl
  E05C    7E             C      	ld	a,(hl)
  E05D    32 E4B4        C      	ld	(ft.len),a
  E060    23             C      	inc	hl
  E061    7E             C      	ld	a,(hl)
  E062    32 E4B5        C      	ld	(ft.anz),a
                         C      
  E065    DD 7E 12       C      	ld	a,(ix+dpbstp)	;Anzahl der Stepimpulse
  E068    32 E4B6        C      	ld	(ft.stp),a
                         C      
  E06B    DD 7E 17       C      	ld	a,(ix+dpbsti)	;Schrittzeit
  E06E    32 E4B7        C      	ld	(ft.sti),a
                         C      
  E071    2A E1BA        C      	ld	hl,(diocad)
  E074    22 E4AE        C      	ld	(ft.adr),hl
                         C      
                         C       IF stpvar or monitor
  E077    CD E812        C      	call	delsps		;Sondertasten verbieten
                         C       ENDIF
                         C       IF hdsk
                         C       ELSE
  E07A    CD E1BC        C      	call	floppy		;$$$ phys. Transfer $$$
                         C       ENDIF
                         C       IF stpvar or monitor
  E07D    CD E81F        C      	call	delspr		;Sondertasten wieder erlauben
                         C       ENDIF
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-74


                         C      
  E080    E1             C      	pop	hl		;HL wieder auf Paramfeld-Adresse
  E081    DD E1          C      	pop	ix		;IX wieder auf DPB
                         C      
  E083                   C      dioert:
                         C      ; Fehlerprotokoll
  E083    CB 66          C      	bit	dioftr,(hl)	;Fehlerprotokoll und -behandlung  unterdr.?
  E085    20 33          C      	jr	nz,dtrok	;ja
  E087    B7             C      	or	a		;Returncode
  E088    28 30          C      	jr	z,dtrok		; -> fehlerfrei
  E08A    FE 52          C      	cp	'R'		;not ready?
  E08C    CA E025        C      	jp	z,diorty	;ja, Wiederholung
                         C      
                         C       IF errvar
  E08F    32 E179        C      	ld	(derrcd),a	;Fehlercode
  E092    CB 56          C      	bit	diofwr,(hl)	;war lesen?
  E094    3E 52          C      	ld	a,'R'
  E096    28 02          C      	jr	z,derrr		;ja
  E098    3E 57          C      	ld	a,'W'
  E09A    32 E178        C      derrr:	ld	(derrrw),a
                         C        IF dev eq cpd
                         C        ELSE
  E09D    21 E4B1        C      	ld	hl,ft.trk	;phys. Spur
  E0A0    11 E183        C      	ld	de,derrtr
  E0A3    CD E8F2        C      	call	mbreco
  E0A6    21 E4B2        C      	ld	hl,ft.sid	;Seite
  E0A9    CD E8F2        C      	call	mbreco
  E0AC    21 E4B3        C      	ld	hl,ft.sec	;Sektor
  E0AF    CD E8F2        C      	call	mbreco
                         C        ENDIF
  E0B2    21 E176        C      	ld	hl,derrms
  E0B5    CD E8D8        C      	call	biosms
                         C       ENDIF
  E0B8    3E 01          C       	ld	a,1		;return mit Fehler
                         C      
  E0BA    B7             C      dtrok:	or	a		;stellen Z-Flag
  E0BB    ED 5B E4B1     C      	ld	de,(ft.trk)	;E:=trk, D:=sid
  E0BF    2A E4B3        C      	ld	hl,(ft.sec)	;L:=sec, H:=len
  E0C2    DD E1          C      	pop	ix
  E0C4    C1             C      	pop	bc
  E0C5    C9             C      	ret
                         C      
                         C       IF	format
                         C      
                         C      ; Stellen HL entsprechend Sektorlaengencode in (A)
                         C      ;=================================================
                         C      ; ret nz bei unzulaessigem
  E0C6    B7             C      dtrsla:	or	a
  E0C7    21 E0DA        C      	ld	hl,dtrsl0
  E0CA    C8             C      	ret	z		;=0 (128)
  E0CB    3D             C      	dec	a
  E0CC    21 E0F8        C      	ld	hl,dtrsl1	;=1 (256)
  E0CF    C8             C      	ret	z
  E0D0    3D             C      	dec	a
  E0D1    21 E117        C      	ld	hl,dtrsl2	;=2 (512)
  E0D4    C8             C      	ret	z
  E0D5    3D             C      	dec	a
  E0D6    21 E135        C      	ld	hl,dtrsl3	;=3 (1024)
  E0D9    C9             C      	ret
                         C      
                         C       ENDIF
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-75


                         C      ;************************************************
                         C      ;	Steuertabellen
                         C      ;************************************************
                         C      
                         C      
                         C       IF	format
                         C      ; Modifizierungstabellen entspr. Sektorlaenge und LW-Typ
                         C      ;-------------------------------------------------------
                         C      
                         C      ; Struktur:
                         C      
  0000                   C      dsltrk	equ	0		;benutzte Spuren
  0001                   C      dslspt	equ	dsltrk+1	;Sektoren/Spur
  0002                   C      dsldir	equ	dslspt+1	;Dir-Eintraege
  0003                   C      dsloff	equ	dsldir+1	;2*offset
                         C      				;[+Flag fuer festes offset]
  0001                   C      dslfo	equ	1		;festes offset
  0000                   C      dslvo	equ	0		;offset =0, falls Directory mgl.
  0004                   C      dslblk	equ	dsloff+1	;rel. Adr. Tab. BDOS-Blockgroesse
  0005                   C      dsll	equ	5		;Laenge eines Eintrags
                         C      
                         C      ; Reihenfolge
                         C      ; 5", 40 Tr, SS
                         C      ; 5", 80 Tr, SS
                         C      ; 5", 40 Tr, DS
                         C      ; 5", 80 Tr, DS
                         C       if	disk8
                         C      ; 8", 77 Tr, SS, SD
                         C        if dsk8mf
                         C      ; 8", 77 Tr, SS, DD
                         C        endif
                         C       endif
                         C      
                         C      ; Zur automatischen Bestimmung des Spurformats wird dasjenige
                         C      ; Format der Spur "dlgint" benutzt, alle folgenden Spuren
                         C      ; muessen das gleiche Format haben!
  0003                   C      dlgint	equ	3	;groesste Anzahl SS-Systemspuren
                         C      
                         C      ; 128
  E0DA                   C      dtrsl0:	
  E0DA    28 1A 3F 04    C      	db	40,26,63,2*2+dslvo,dbl1k-$	;CP/M Standard
  E0DE    75             C      
  E0DF    50 1A 7F 04    C      	db	80,26,127,2*2+dslvo,dbl2k-$
  E0E3    73             C      
  E0E4    50 1A 7F 01    C      	db	80,26,127,2*0+dslfo,dbl2k-$
  E0E8    6E             C      
  E0E9    A0 1A 7F 01    C      	db	160,26,127,2*0+dslfo,dbl2k0-$
  E0ED    6C             C      
                         C      
                         C      	if	disk8
  E0EE    4D 1A 3F 04    C      	db	77,26,63,2*2+dslvo,dbl1k-$	;CP/M Standard
  E0F2    61             C      
                         C      	if	dsk8mf
  E0F3    4D 28 7F 04    C      	db	77,40,127,2*2+dslvo,dbl2k-$
  E0F7    5F             C      
                         C      	endif
                         C      	endif
                         C      
                         C      ; 256
  E0F8                   C      dtrsl1:	
  E0F8    28 20 3F 07    C      	db	40,32,63,2*3+dslfo,dbl2k-$	;SCP Hausformat A51xx
  E0FC    5A             C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-76


  E0FD    50 20 3F 07    C      	db	80,32,63,2*3+dslfo,dbl2k-$	;SCP
  E101    55             C      
  E102    50 20 7F 09    C      	db	80,32,127,2*4+dslfo,dbl2k-$
  E106    50             C      
  E107    A0 20 7F 09    C      	db	160,32,127,2*4+dslfo,dbl2k0-$	;SCP Hausformat PC1715
  E10B    4E             C      
                         C      
                         C      	if	disk8
  E10C    4D 20 3F 07    C      	db	77,32,63,2*3+dslfo,dbl2k-$
  E110    46             C      
                         C      	if	dsk8mf
  E111    4D 34 7F 04    C      	db	77,52,127,2*2,dslfo,dbl2k-$
  E115    01 40          C      
                         C      	endif
                         C      	endif
                         C      
                         C      ; 512
  E117                   C      dtrsl2:	
  E117    28 24 00 01    C      	db	40,36,0,2*0+dslfo,dbl1k-$
  E11B    38             C      
  E11C    50 24 00 01    C      	db	80,36,0,2*0+dslfo,dbl2k-$
  E120    36             C      
  E121    50 24 00 01    C      	db	80,36,0,2*0+dslfo,dbl2k-$
  E125    31             C      
  E126    A0 24 00 01    C      	db	160,36,0,2*0+dslfo,dbl2k0-$
  E12A    2F             C      
                         C      
                         C      	if	disk8
  E12B    4D 24 7F 04    C      	db	77,36,127,2*2+dslvo,dbl2k-$	;Hausformat IH Mittweida
  E12F    27             C      
                         C      	if	dsk8mf
  E130    4D 40 7F 04    C      	db	77,64,127,2*2+dslvo,dbl2k0-$
  E134    25             C      
                         C      	endif
                         C      	endif
                         C      	
                         C      ; 1024
  E135                   C      dtrsl3:	
  E135    28 28 3F 04    C      	db	40,40,63,2*2+dslvo,dbl1k-$	;CP/A Standard A51xx
  E139    1A             C      
  E13A    50 28 7F 04    C      	db	80,40,127,2*2+dslvo,dbl2k-$	;CP/A
  E13E    18             C      
  E13F    50 28 7F 00    C      	db	80,40,127,2*0+dslvo,dbl2k-$	;CP/A
  E143    13             C      
  E144    A0 28 BF 08    C      	db	160,40,191,2*4+dslvo,dbl2k0-$	;CP/A (und SCP)
  E148    11             C      
                         C      
                         C      	if	disk8
  E149    4D 20 3F 06    C      	db	77,32,63,2*3+dslvo,dbl2k-$	;CP/A und SCP
  E14D    09             C      
                         C      	if	dsk8mf
  E14E    4D 40 7F 04    C      	db	77,64,127,2*2+dslvo,dbl2k0-$	;CP/A und SCP
  E152    07             C      
                         C      	endif
                         C      	endif
                         C      
                         C      ; Modifizierungstabellen fuer BDOS-Blockgroesse
  E153    03 07 00       C      dbl1k:	db	3,7,0		;Bl. Shift, Bl. Mask, Ext. Mask
  E156    04 0F 01       C      dbl2k:	db	4,0fh,1
  E159    04 0F 00       C      dbl2k0:	db	4,0fh,0		;fuer Kapazitaet >255
                         C      
                         C      ; log. Sektortranslate-Tabelle fuer 26*128
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-77


  E15C    01 07 0D 13    C      xlt:	db	1,7,13,19,25,5,11,17,23,3,9,15,21
  E160    19 05 0B 11    C      
  E164    17 03 09 0F    C      
  E168    15             C      
  E169    02 08 0E 14    C      	db	2,8,14,20,26,6,12,18,24,4,10,16,22
  E16D    1A 06 0C 12    C      
  E171    18 04 0A 10    C      
  E175    16             C      
                         C      
                         C       ENDIF	;format
                         C      
                         C      	include BIOSDSKW
                         C      ;;***************************************************************
                         C      ;;	Arbeitsbereiche logischer Floppy-Treiber im System-RAM *
                         C      ;;***************************************************************
                         C      ;; 03.06.89
                         C      
                         C       IF errvar
                         C      ;; Fehlermeldung Disk I/O Error
                         C      ;;=============================
                         C      ;; Genau so lang (kurz), wie in Statuszeile Platz dafuer da ist!
                         C      ;; und das sind 17 Bytes!
  E176                   C      derrms:
                         C       IF cpastz
                         C       ELSE
  E176    0D 0A          C      	db	0dh,0ah
                         C       ENDIF
  E178    58             C      derrrw:	db	'X'
  E179    58 3B 54 2C    C      derrcd:	db	'X;T,Si,Se='
  E17D    53 69 2C 53    C      
  E181    65 3D          C      
  E183    58 58          C      derrtr:	db	'XX'
  E185    58 58          C      derrts:	db	'XX'
  E187    58 58          C      derrsc:	db	'XX'
                         C       IF cpastz
                         C       ELSE
  E189    07 00          C      	db	07h,0
                         C       ENDIF
                         C      
                         C       ENDIF
                         C      
                         C      ;; CDB's
                         C      ;;======
                         C      
                         C      ;;CDB fuer Bestimmung Laufwerksbereitschaft bei Select Disk
                         C      ;;--------------------------------------------------------
  E18B                   C      drdcdb:
  E18B    10             C      drdflg:	db	(1 shl dioftr)	;;Lesen, kein Fehlerprotokoll
  E18C    FF             C      drddev:	db	0ffh		;;Geraet
  E18D    0000           C      drdtrk:	dw	0		;;Spur
  E18F    01             C      	db	1		;;Sektor (bel.)
  E190    01             C      	db	1		;;Sektorlaengencode (>0, 1..3)
  E191    00             C      	db	0		;;Sektoranzahl=0 -> nur Positionieren
                         C      
                         C      	IF	format
                         C      ;; CDB fuer Bestimmung Spurformat
                         C      ;;------------------------------------
  E192                   C      dfrcdb:
  E192    12             C      dfrflg:	db	(1 shl diofid)+(1 shl dioftr)
                         C      ;;		Lesen Sektorid., kein Fehlerprotokoll
  E193    FF             C      dfrmdv:	db	0ffh		;;Geraet
  E194    FF             C      dfrmtr:	db	0ffh		;;Spur
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-78


  E195    FF             C      	db	0ffh		;;Seite (bel.)
  E196    01             C      	db	1		;;Sektor (bel.)
  E197    01             C      	db	1		;;Sektorlaengencode (>0, 1..3)
  E198    01             C      	db	1		;;Sektoranzahl (>0)
                         C      	ENDIF
                         C      
                         C      	IF	format or (dbufsz gt 7)
                         C      ;; Puffer-CDB
                         C      ;;-----------
  E199                   C      dbcdb:
  E199    00             C      dbflg:	db	0
  0000                   C      dfbprr	equ	diof00		;;=1, wenn Puffer erst gelesen 
                         C      ;;				     werden muss
  0002                   C      dfbwr	equ	diofwr		;;=1, wenn Puffer durch
                         C      ;;				     Schreiben veraendert
  0004                   C      dfbtr	equ	dioftr		;;=1, wenn mit Fehlerprotokoll
                         C      ;; restliche Bits immer =0
  E19A    FF             C      dbdev:	db	0ffh
  E19B    FF             C      dbtrk:	db	0ffh
  E19C    FF             C      dbsid:	db	0ffh
  E19D    FF             C      dbsec:	db	0ffh
  E19E    FF             C      dbslc:	db	0ffh
  E19F    FF             C      dbsnb:	db	0ffh
                         C      	IF	dbufsz gt 7
  E1A0    F395           C      dbdma:	dw	dbuf
                         C      	ENDIF
                         C      	ENDIF
                         C      
                         C      ;; CDB fuer ungepufferte E/A
                         C      ;;--------------------------
                         C      
  E1A2                   C      dcdb:
  E1A2    00             C      dflg:	db	0
  0002                   C      dfwr	equ	diofwr 		;;=1, wenn write-Aufruf
                         C      ;; restliche Bits immer =0
  E1A3    00             C      ddrive:	db	0
  E1A4    FF             C      dtrack:	db	0ffh
  E1A5    FF             C      	db	0ffh		;;Seite
  E1A6    FF             C      dsectr:	db	0ffh
  E1A7    00             C      	db	0		;;128 Bytes Sektorlaenge
  E1A8    01             C      	db	1		;;immer nur 1 Sektor
  E1A9    FFFF           C      ddma:	dw	0ffffh
                         C      
                         C       if ramfl
                         C       endif
                         C      
                         C      ;; Pufferzugriff
                         C       IF @write
                         C       IF dbufsz gt 7
  E1AB    00 FF FF FF    C      unacnt:	db	0,0ffh,0ffh,0ffh,0
  E1AF    00             C      
  E1AC                   C      unadev	equ	unacnt+1
  E1AD                   C      unatrk	equ	unacnt+2
  E1AF                   C      unasec	equ	unacnt+4
                         C       ENDIF
                         C       ENDIF
                         C       IF dbufsz gt 7
  E1B0    FF             C      dbnb:	db	0ffh
  E1B1    FF             C      dwrtyp:	db	0ffh
  E1B2    00             C      dberrf:	db	0		;;Ergebnisflag letztes dbtran
                         C       ENDIF
                         C      	include BIOSDSKB
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-79


                         C      ;;***************************************************************
                         C      ;;	Arbeitsbereiche logischer Floppy-Treiber im BIOS-RAM   *
                         C      ;;***************************************************************
                         C       IF dev eq cpd
                         C       ELSE
  E1B3                   C      diocdb:	ds	9,0ffh
                         C       ENDIF
  E1B3                   C      diocfl	equ	diocdb+0
  E1B4                   C      diocde	equ	diocdb+1
  E1B5                   C      dioctr	equ	diocdb+2
  E1B6                   C      diocsi	equ	diocdb+3
  E1B7                   C      diocse	equ	diocdb+4
  E1B8                   C      diocsl	equ	diocdb+5
  E1B9                   C      diocsn	equ	diocdb+6
  E1BA                   C      diocad	equ	diocdb+7
  0009                   C      diocdl	equ	9		;;Anzahl der Bytes
                         C      
                         C       IF dev eq cpd
                         C       ELSE
                         C        IF disknb eq 0
                         C        ENDIF
                         C       ENDIF
                                 IF disknb ne 0
                         C      	include BIOSDSKT
                         C      ;*********************************************************
                         C      ; physischer Disketten-Transfer
                         C      ; Aenderungen:
                         C      ; - Es koennen 9 statt bisher 4 phys. Sektoren auf einmal gelesen werden
                         C      ;!-!Schnittstellenaenderung bei SektId lesen:
                         C      ;   ft.anz muss <>0 sein (zuvor beliebig, bei =0 kein Transfer)
                         C      ;   ft.len muss 0..3 sein (zuvor beliebig, bei >3 fehlerhafte Tabellenmodif.)
                         C      ;   ft.kom, Bit 7 eingefuehrt: =0 Vorderseite, =1 Rueckseite
                         C      ;   ft.kom, Bit 0 (Verify nach Schreiben) auf Bit 6 verlegt
                         C      ;   ft.kom, Bit 0 =1 bedeutet "keine Fehlerwiederholung"
                         C      ; - Floppy-Treiber auch fuer Variante K5120/22 generierbar
                         C      ; 06.07.88
                         C      ; - Motor-Start-Wait von 254 auf 252 veraendert (2.5 Umdrehungen)
                         C      ;   (ist bei einigen Laufwerken wegen PreReady notwendig)
                         C      ; 03.11.22
                         C      ; - Variante K5122 eingefuegt
                         C      ; 25.09.89
                         C      ; - bei MFS 1.2 bei Mehr-Sektor-Transfer "Fault reset" zwischen den Sektoren
                         C      ;*********************************************************
                         C      
                         C      ; Aufruf:
                         C      ; -------
                         C      ; Bereitstellung der Parameter auf den Bytes:
                         C      
                         C      ;       ft.kom:	db	0	; bit0 - =1 ohne Fehlerwiederholung
                         C      ;				     1 - =1 lesen ft.len von beliebigem Sektor
                         C      ;				     2 - =0 lesen ; =1 schreiben Sektor(en)
                         C      ;				     3 - =0-FM; =1-MFM   (5"FM nur bei PC1715)
                         C      ;				     4 - =0-8"; =1-5"
                         C      ;				     5 - =0- 40-Spur-Laufwerk; =1- 80-Spur-LW
                         C      ;				     6 - =1 bei verify nach schreiben
                         C      ;				     7 - =0 Vorderseite, =1 Rueckseite
                         C      ;	ft.adr: dw	0	; Transferadresse
                         C      ;	ft.lwn: db	0	; 0..3 phys. Laufwerksnummer
                         C      ;	ft.trk: db	0	; 0..  track
                         C      ;	ft.sid: db	0	; 0..ff side (side=0 auf Rueckseite moeglich!)
                         C      ;	ft.sec: db	0	; 0..  sector (beliebig bei SektId lesen)
                         C      ;	ft.len: db	0	; 0..3 Sektorlaenge (auch 0..3 bei SektId les.)
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-80


                         C      ;	ft.anz: db	0	; 0..9 Anzahl der zu uebertragenden Sektoren
                         C      ;				;      =0: nur Positionieren
                         C      ;				;      (<>0 bei SektId lesen)
                         C      ;       ft.stp: db	0	;      Anzahl der Stepimpulse von Spur zu Spur
                         C      ;	ft.sti: db	0	;      Schrittzeit von Spur zu Spur
                         C      ;				;      in 0,1ms Einheiten
                         C      ;
                         C      ;	call	floppy
                         C      ;       ...			; in A steht Ergebniskode
                         C      ;				; alle Register (auch IX) undef.
                         C      ;
                         C      ; Ergebniskode (in Reg. A):
                         C      ;	00h kein Fehler (Z-Flag nicht von floppy gesetzt)
                         C      ;	'C' CRC-Fehler
                         C      ;	'D' LW nicht existent
                         C      ;	'R' Geraet nicht bereit, aber existent
                         C      ;	'L' unzulaessige Transferlaenge
                         C      ;	'S' Sektor nicht gefunden
                         C      ;	'T' Spurnummer zu gross
                         C      ;	'U' keine Marke gefunden
                         C      ;	'W' Diskette schreibgeschuetzt
                         C      
                         C      ; Paramfeld wird an folgenden Stellen veraendert:
                         C      ;  Komm. "Lesen Sekt,Id.":	ft.trk .. ft.len gestellt
                         C      ;  Komm. "Schreiben mit Verify":ft.kom, bit 2 geloescht
                         C      ;**************************************************
                         C      
  0004                   C      maxlw	equ	4		; Anzahl der Laufwerke (1..4)
                         C      
                         C      ; Adressen der Floppy-Karte
                         C      ;==========================
                         C      
                         C       IF (fdc eq k5120) or (fdc eq k5122)
                         C      ;Steuer-PIO
  0010                   C      flcoad    equ  10h  ;PORT A
  0011                   C      flcoac    equ  11h
  0012                   C      flcobd    equ  12h  ;PORT B
  0013                   C      flcobc    equ  13h
                         C      
                         C      ;Daten-PIO
  0014                   C      fldaad    equ  14h  ;Port A Schreib-Daten
  0015                   C      fldaac    equ  15h
  0016                   C      fldabd    equ  16h  ;Port B Lese-Daten
  0017                   C      fldabc    equ  17h
                         C      
                         C      ;Select-Latch
  0018                   C      flsel     equ  18h  ;Bit 7..4 /Sel LW3..0;Bit 3..0  /LCK  LW 3..0
                         C      ;
                         C       ENDIF
                         C      
                         C       IF (fdc eq f1715)
                         C       ENDIF
                         C      
                         C      ;; Legende AMF:
                         C      ;;   Port A
                         C      ;;  | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |
                         C      ;;    |   |   |   |   |   |   |   |__ A  /WE  0-Schreiben ein
                         C      ;;    |   |   |   |   |   |   |______ A   MK  lesen  0-MFM-A1 Erkennung
                         C      ;;    |   |   |   |   |   |                          1-FM-Mark., MFM-C2 Erkenn.
                         C      ;;    |   |   |   |   |   |               schreiben  0-Takt fuer MFM
                         C      ;;    |   |   |   |   |   |                          1-Marken FM und A1 MFM
                         C      ;;    |   |   |   |   |   |__________ A  /SIDE 0-Kopf Seite 1; 1-Kopf Seite 0
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-81


                         C      ;;    |   |   |   |   |        oder   A  /FR   0-Fault reset;  1-kein FR
                         C      ;;    |   |   |   |   |______________ A  /STR 0-AMF aktiv
                         C      ;;    |   |   |   |                           1-AMF ausgeschaltet
                         C      ;;    |   |   |   |__________________ A   MK1 lesen  0-Informationen einlesen
                         C      ;;    |   |   |                                      1-nur 1 einlesen
                         C      ;;    |   |   |                           schreiben  0-FM-Daten schreiben
                         C      ;;    |   |   |                                      1-MFM und FM-Marken schr.
                         C      ;;    |   |   |______________________ A   MR, SD     0-steppen Richtung aussen
                         C      ;;    |   |                                          1-Marke-erkannt loeschen
                         C      ;;    |   |                                            steppen Richtung innen
                         C      ;;    |   |__________________________ A  /HL         0-Kopf geladen
                         C      ;;    |                                              1-Kopf entladen
                         C      ;;    |______________________________ A  /ST         0-Stepsignal an LW ein
                         C      ;;                                                   1-Stepsignal an LW aus
                         C      ;;
                         C      ;;  Port B
                         C      ;;  | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |
                         C      ;;    |   |   |   |   |   |   |   |__ E  /RDY  0-Laufwerk bereit
                         C      ;;    |   |   |   |   |   |   |                1-Laufwerk nicht bereit
                         C      ;;    |   |   |   |   |   |   |______ E  /MKE  0-Marke erkannt
                         C      ;;    |   |   |   |   |   |                    1-Marke noch nicht erkannt
                         C      ;;    |   |   |   |   |	 oder PC1715  E   MKE  1-Marke erkannt
                         C      ;;    |   |   |   |   |   | u.K5122            0-Marke noch nicht erkannt
                         C      ;;    |   |   |   |   |   |__________ E  /SYN  ???? (K5120)
                         C      ;;    |   |   |   |   |  oder K5122   A  /HF   0-Takt fuer 8" MFM
                         C      ;;    |   |   |   |   |                        1-Takt fuer 5" MFM und 8" FM
                         C      ;;    |   |   |   |   |  oder PC1715: A   MFM  0-FM-Aufzeichnung
                         C      ;;    |   |   |   |   |                        1-MFM-Aufzeichnung
                         C      ;;    |   |   |   |   |______________ A   PRE  0-schreiben ohne Prekompensation
                         C      ;;    |   |   |   |                            1-schreiben mit         "
                         C      ;;    |   |   |   |__________________ E  /FA   0-Fehler in der AMF aufgetreten
                         C      ;;    |   |   |                                1-kein Fehler aufgetreten
                         C      ;;    |   |   |          oder PC1715: A   FO   0-5"-Disketten
                         C      ;;    |   |   |                                1-8"-Disketten
                         C      ;;    |   |   |______________________ E  /WP   0-Schreibschutz ist ein
                         C      ;;    |   |                                    1-kein Schreibschutz
                         C      ;;    |   |__________________________ E  /FW   0-Laufwerk meldete Schreibfehler
                         C      ;;    |                                        1-Laufwerk meldete keinen Fehler
                         C      ;;    |______________________________ E  /T0   0-Kopf steht auf Spur 0
                         C      ;;                                             1-Kopf steht nicht auf Spur 0
                         C      
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                         C      ;	FLOPPY-Treiber
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
  E1BC                   C      floppy:
                         C      
                         C      ; Anfangswerte stellen
  E1BC    3A E4AD        C      	ld	a,(ft.kom)
  E1BF    E6 01          C      	and	1		;Fehlerwiederholung?
  E1C1    20 02          C      	jr	nz,setecr	;nein, A=0+1 (keine Wiederholung)
  E1C3    3E 10          C      	ld	a,15+1
  E1C5    32 E4D3        C      setecr:	ld	(crerc),a	; Fehlerzaehler fuer CRC-Fehlerwiederholungen
  E1C8    20 02          C      	jr	nz,setesp
  E1CA    3E 05          C      	ld	a,4+1		; Fehlerzaehler fuer Spurfindewiederholungen
  E1CC    32 E4D4        C      setesp:	ld	(sperc),a
                         C      
                         C      ; Laufwerksnummer pruefen
  E1CF    3A E4B0        C      	ld	a,(ft.lwn)	; LW
                         C      ;	cp	maxlw		; LW < groesster LW-Nr.?
                         C      ;	jr	nc,nolw		; -> nein, Fehler: LW nicht existent
  E1D2    4F             C      	ld	c,a		; merken LW fuer Motor-an-Test
  E1D3    47             C      	ld	b,a		; fuer djnz
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-82


  E1D4    B7             C      	or	a		; LW=0?
  E1D5    3A E4D6        C      	ld	a,(lwexis)
  E1D8    28 04          C      	jr	z,drv0		; ->ja
  E1DA    0F             C      sp13: 	rrca
  E1DB    0F             C      	rrca
  E1DC    10 FC          C      	djnz	sp13
  E1DE    E6 03          C      drv0: 	and	3
  E1E0    20 05          C      	jr	nz,drv0a
                         C      
  E1E2    3E 44          C      nolw: 	ld	a,'D'		; LW nicht existent
  E1E4    C3 E3A9        C      	jp	fehret		; -> Fehler
                         C      
  E1E7                   C      drv0a:
                         C      ; LW selektieren und Motor einschalten
  E1E7    AF             C      	xor	a
  E1E8    32 E47E        C      	ld	(pretx+1),a	;Motorabschaltung verhindern
  E1EB    3D             C      	dec	a		;A:=255
  E1EC    CD E465        C      	call	fl.sto		;Index-Ueberwachung ein
  E1EF    CB D9          C      	set	3,c		; Motor-an-Bit setzen
  E1F1    21 E4D7        C      	ld	hl,alwnr
  E1F4    7E             C      	ld	a,(hl)
  E1F5    B9             C      	cp	c		; ist es das richtige LW und Motor an?
  E1F6    3E 6A          C      	ld	a,+pvrw2-(xpvrw+2) ; jr z,pvrw2 (keine Vertikalstab.)
  E1F8    28 42          C      	jr	z,dskmon	; ->ja, Kopf ist noch aufgesetzt
                         C      ; falsches LW oder Motor des LW aus
  E1FA    CD E498        C      	call	flres		; alte Spurnr. merken
                         C      
                         C      ; neues LW anwaehlen, Motor einschalten und alte Spurnr. holen
  E1FD    71             C      	ld	(hl),c		; neues LW, Motor-an-Bit
  E1FE    EB             C      	ex	de,hl		;merken ^alwnr
  E1FF    CB 99          C      	res	3,c		; alte Spurnr. holen
  E201    06 00          C      	ld	b,0
  E203    21 E4D9        C      	ld	hl,spnrl
  E206    09             C      	add	hl,bc
  E207    7E             C      	ld	a,(hl)
  E208    32 E4D8        C      	ld	(aspnr),a
  E20B    41             C      	ld	b,c
  E20C    04             C      	inc	b
  E20D    3E 77          C      	ld	a,077h		; LW-Anwahlbyte bilden (mit Lock)
  E20F    07             C      nfdei2: rlca
  E210    10 FD          C      	djnz	nfdei2
  E212    D3 18          C      	out	(flsel),a	; Laufwerk selektieren (und evtl. Motor ein)
                         C       IF fdc eq f1715
                         C       ENDIF
  E214    3E A9          C      	ld	a,10101001b	; Kopf laden, Fault reset
  E216    D3 10          C      	out	(flcoad),a
                         C      
                         C      ; Motor-Start
  E218    2E FD          C      	ld	l,252+1		;von 255 auf 252, d.h. mind 2 Umdrehungen?
  E21A    3A E4AD        C      	ld	a,(ft.kom)
  E21D    CB 67          C      	bit	4,a		;5"?
  E21F    28 06          C      	jr	z,dskmo1	;nein
  E221    CB 6F          C      	bit	5,a		;5" 40 Spur?
  E223    20 02          C      	jr	nz,dskmo1	;nein
  E225    2E FB          C      	ld	l,250+1		;von 255 auf 250,
                         C      				; d.h. mind. 4 volle Umdrehungen?
                         C      				;(bei MFS 1.2 kommt evtl. ready zu frueh)
  E227                   C      dskmo1:
  E227    3A E476        C      dskdaw:	ld	a,(fl.zto)	;Index-Interrupt-Zaehler
  E22A    BD             C      	cp	l		;entprechend viele Umdrehungen vorbei?
  E22B    38 0D          C      	jr	c,dskda		;ja
  E22D    0D             C      	dec	c		; warten, bis Diskette eingeschoben
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-83


  E22E    20 F7          C      	jr	nz,dskdaw
  E230    10 F5          C      	djnz	dskdaw
  E232    EB             C      	ex	de,hl
  E233    CB 9E          C      	res	3,(hl)		;loeschen Motor an Bit
  E235    3E 52          C      	ld	a,'R'		;LW nicht bereit
  E237    C3 E3A9        C      	jp	fehret
  E23A    3E 61          C      dskda:	ld	a,+pvrw1-(xpvrw+2) ; jr z,pvrw1 (mit Vertikal-Stabil.)
  E23C                   C      dskmon:
  E23C    32 E29D        C      	ld	(xpvrw+1),a	; Vertikal-Stabilisierung ein/aus
                         C      
                         C      
                         C       IF dsk8fm+dsk8mf+dsk5fm; Standard ist 5"MFM
                         C      ; modifizieren FM/MFM und 8"/5"
                         C      
  E23F    21 E4F2        C      	ld	hl,mdmfm8
  E242    01 000A        C      	ld	bc,mdtbl	;BC:=(Anzahl der Bytes)
  E245    3A E4AD        C      	ld	a,(ft.kom)
  E248    CB 5F          C      	bit	3,a		;MFM?
  E24A    20 02          C      	jr	nz,modfl1	;ja
  E24C    09             C      	add	hl,bc
  E24D    09             C      	add	hl,bc
  E24E    CB 67          C      modfl1:	bit	4,a		;8"?
  E250    28 01          C      	jr	z,modfl2	;ja
  E252    09             C      	add	hl,bc
  E253    EB             C      modfl2:	ex	de,hl
  E254    21 E4DD        C      	ld	hl,mdtbad
  E257    CD E406        C      	call	flmodf		;Modifizierung
                         C       ENDIF
                         C       if dsk80
  E25A    3A E4AD        C      	ld	a,(ft.kom)
                         C       if dsk8fm+dsk8mf
  E25D    CB 67          C      	bit	4,a		;5" LW?
  E25F    28 0B          C      	jr	z,dprecn	;nein
                         C       endif
  E261    CB 6F          C      	bit	5,a		;80-Spur-LW?
  E263    3E 19          C      	ld	a,25		;Spur, ab der mit Praekomp.
  E265    28 02          C      	jr	z,dprec2	;nein
  E267    3E 29          C      	ld	a,41
  E269    32 E323        C      dprec2:	ld	(dpretr),a
  E26C                   C      dprecn:
                         C       endif
                         C      
                         C      ; modifizieren entspr. phys. Sektorlaenge
  E26C    3A E4B4        C      	ld	a,(ft.len)
  E26F    32 E5BA        C      	ld	(sidlen),a
  E272    21 E51A        C      	ld	hl,dsln0-dslnl
  E275    47             C      	ld	b,a
  E276    04             C      	inc	b
  E277    11 0009        C      	ld	de,dslnl
  E27A    19             C      dtrsll:	add	hl,de
  E27B    10 FD          C      	djnz	dtrsll
  E27D    EB             C      	ex	de,hl
  E27E    21 E510        C      	ld	hl,dslnmt	;Tabelle der Modif.adr.
  E281    CD E406        C      	call	flmodf
                         C      
                         C      ; Kopf positionieren
  E284    21 E4B1        C      	ld	hl,ft.trk	; gewuenschte Spur
  E287    7E             C      	ld	a,(hl)
  E288    B7             C      	or	a		;Spur 0?
  E289    20 0D          C      	jr	nz,npost0	;nein
  E28B    3A E4B5        C      	ld	a,(ft.anz)	;Sektorzahl
  E28E    B7             C      	or	a		;nur positionieren auf Spur 0 (FORMAT-Progr.)
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-84


  E28F    28 4F          C      	jr	z,trk0		;ja, Spur 0 immer ueber Recalibrate
  E291    3A E4AD        C      	ld	a,(ft.kom)
  E294    CB 4F          C      	bit	1,a		;Lesen Sekt.id Spur 0?
  E296    20 53          C      	jr	nz,trk0s	;ja, Lesen Sektid Spur 0 ueber Recalibrate
  E298    3A E4D8        C      npost0:	ld	a,(aspnr)	; stimmt Spur?
  E29B    BE             C      	cp	(hl)
  E29C    28 61          C      xpvrw:	jr	z,pvrw1		; -> ja, Kopf evtl. vertikal stabilisieren
                         C      				; auf jr z,pvrw2, wenn Kopf noch aufgesetzt
  E29E                   C      spprty:				;Wiederholung bei fehlerhafter Spur
                         C      ; Positionierung auf ft.trk
  E29E    3A E4B1        C      spe: 	ld	a,(ft.trk)
  E2A1    06 8F          C      	ld	b,08fh		; stepout-Befehl
  E2A3    21 E4D8        C      	ld	hl,aspnr
  E2A6    BE             C      	cp	(hl)		; auf richtiger Spur angekommen?
  E2A7    28 56          C      	jr	z,phrw		; -> ja, Kopf horizontal stabilisieren
  E2A9    38 0D          C      	jr	c,spre		; -> stepout
  E2AB    FE 55          C      xmaxtr: cp	85		; Spur zu gross?
  E2AD    38 05          C      	jr	c,spve		; -> nein, stepin
  E2AF    3E 54          C      	ld	a,'T'		; Fehler: Spurnr. zu gross
  E2B1    C3 E3A9        C      	jp	fehret
                         C      
                         C      ; stepin
  E2B4    06 AF          C      spve:	ld	b,0afh		; stepin-Befehl
  E2B6    34             C      	inc	(hl)		; alte Spurnr. erhoehen
  E2B7    34             C      	inc	(hl)		; wegen stepout-dec
                         C      
                         C      ; stepout
  E2B8    35             C      spre: 	dec	(hl)		; alte Spurnr. verringern
  E2B9    CD E2BE        C      	call	step
  E2BC    18 E0          C      	jr	spe
                         C      
                         C      ; steppen
  E2BE    3A E4B6        C      step: 	ld	a,(ft.stp)	; Anzahl der Stepimpulse pro Step
  E2C1    0E 10          C      step0: 	ld	c,flcoad
  E2C3    ED 41          C      	out	(c),b		; select direction
                         C      ;;;	push	bc
                         C      ;;;	ld	b,0
                         C      ;;;step1: 	djnz	step1		; 1,3ms warten
                         C      ;;;	pop	bc
  E2C5    C5             C      step2: 	push	bc
  E2C6    CB B8          C      	res	7,b
  E2C8    F3             C      	di			;verhindern Unterbrechung
  E2C9    ED 41          C      	out	(c),b
  E2CB    CB F8          C      	set	7,b
  E2CD    ED 41          C      	out	(c),b		; step
  E2CF    FB             C      	ei
  E2D0    ED 4B E4B7     C      	ld	bc,(ft.sti)	; 13,2 / 11,6 / 3,0 ms Schrittzeit
  E2D4    06 13          C      stepw1: ld	b,19		;(19*13)/(256*9600)=0.0001
  E2D6    10 FE          C      stepw: 	djnz	stepw		;0.1 ms warten
  E2D8    0D             C      	dec	c
  E2D9    20 F9          C      	jr	nz,stepw1
  E2DB    C1             C      	pop	bc
  E2DC    3D             C      	dec	a
  E2DD    20 E6          C      	jr	nz,step2
  E2DF    C9             C      	ret
                         C      
                         C      ; Spur 0 anfahren (Recalibrate)
  E2E0    06 02          C      trk0:	ld	b,2		; nach innen, falls auf Spur -1
  E2E2    C5             C      trk0i:	push	bc
  E2E3    06 AF          C      	ld	b,0afh	 	; stepin
  E2E5    CD E2BE        C      	call	step
  E2E8    C1             C      	pop	bc
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-85


  E2E9    10 F7          C      	djnz	trk0i
  E2EB    DB 12          C      trk0s:	in	a,(flcobd)
  E2ED    07             C      	rlca			; Spur 0 erreicht?
  E2EE    30 09          C      	jr	nc,trk0f	; -> ja
  E2F0    06 8F          C      	ld	b,08fh		; stepout-Befehl
  E2F2    3E 01          C      	ld	a,1		; in phys. Schritten
  E2F4    CD E2C1        C      	call	step0
  E2F7    18 F2          C      	jr	trk0s
  E2F9    AF             C      trk0f: 	xor	a
  E2FA    32 E4D8        C      	ld	(aspnr),a	; aktuelle Spurnr ist 0
  E2FD    18 9F          C      	jr	spprty
                         C      
                         C      
                         C      ; Kopf stabilisieren (horizontal und vertikal)
  E2FF                   C      pvrw1:	; Kopf vertikal stabilisieren
  E2FF                   C      phrw:	; Kopf horizontal (und evtl. auch vertikal) stabilisieren
  E2FF    3E 32          C      	ld	a,50		; 50 ms (fuer alle Laufwerkstypen)
  E301    06 BD          C      phrww1: ld	b,189		; (189*13)/(256*9600)=0.001
  E303    10 FE          C      phrww: 	djnz	phrww		; 1 ms warten
  E305    3D             C      	dec	a
  E306    20 F9          C      	jr	nz,phrww1
  E308                   C      pvrw2:	; Kopf war aufgesetzt und Spur stimmte auch - keine Stabilis.
                         C      
  E308                   C      rdwr:
                         C      ; Anfangswerte fuer Transfer der physischen Sektoren
  E308    3A E4B5        C      	ld	a,(ft.anz)	; Anzahl der zu uebertragenden phys. Sektoren
  E30B    32 E5AF        C      	ld	(secan1),a
  E30E    32 E418        C      	ld	(secanz),a	; fuer CRC-Berechnung
                         C      
  E311    3A E4B1        C      	ld	a,(ft.trk)	; Spur
  E314    32 E5B6        C      	ld	(sidtr),a
  E317    21 E4B6        C      	ld	hl,ft.stp
  E31A    CB 46          C      	bit	0,(hl)		;Doppelschritte?
  E31C    28 01          C      	jr	z,dprec1	;nein
  E31E    87             C      	add	a,a		;sonst phys. Spur verdoppeln
  E31F                   C      dprec1:
                         C      ; evtl. Precompensation einschalten
  E31F    01 0412        C      	ld	bc,00000100b*256+flcobd
  E321                   C      dfrcod	equ	$-1		; Frequenzcode
  E322    FE 19          C      	cp	25		; Spur ab der mit writeprecomp.
  E323                   C      dpretr	equ	$-1
  E324    38 02          C      	jr	c,prec		; <, ohne Precompensation
  E326    CB D8          C      	set	3,b		; >= , mit
  E328    ED 41          C      prec: 	out	(c),b
                         C      
  E32A    3A E4B3        C      	ld	a,(ft.sec)	; erste zu uebertr. Sektornr.
  E32D    32 E5B9        C      	ld	(sidsec),a
  E330    3A E4B2        C      	ld	a,(ft.sid)
  E333    32 E5B7        C      	ld	(sidsid),a
                         C      
                         C       IF dskds ; double sided
                         C      ; evtl. side 1 anwaehlen vorbereiten
  E336    3A E4AD        C      	ld	a,(ft.kom)
  E339    21 E547        C      	ld	hl,dsidmt
  E33C    46             C      	ld	b,(hl)
  E33D    23             C      dsidmz:	inc	hl
  E33E    5E             C      	ld	e,(hl)
  E33F    23             C      	inc	hl
  E340    56             C      	ld	d,(hl)
  E341    EB             C      	ex	de,hl
  E342    CB 7F          C      	bit	7,a		; side 0?
  E344    28 04          C      	jr	z,pside0	; ja
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-86


  E346    CB 96          C      	res	2,(hl)		; side 1 einstellen
  E348    18 02          C      	jr 	pside1
  E34A    CB D6          C      pside0:	set	2,(hl)
  E34C    EB             C      pside1:	ex	de,hl
  E34D    10 EE          C      	djnz	dsidmz
  E34F    CB 6F          C      	bit	5,a		;40-Spur LW?
  E351    20 03          C      	jr	nz,pside2	;nein
  E353    EB             C      	ex	de,hl		;diom11
  E354    CB 96          C      	res	2,(hl)		;fault reset zwischen den Sektoren
  E356                   C      pside2:
                         C       ENDIF
                         C      
                         C      ; evtl. nur Lesen Sektor-Id.
  E356    3A E4AD        C      	ld	a,(ft.kom)
  E359    CB 4F          C      	bit	1,a		; Lesen Sekt.Id?
  E35B    21 E5A7        C      	ld	hl,dio
  E35E    28 03          C      	jr	z,srdsid	; -> nein
  E360    21 E60D        C      	ld	hl,diotsr
  E363    22 E567        C      srdsid:	ld	(diortn),hl
                         C      
                         C       IF @write
  E366    3A E4AD        C      	ld	a,(ft.kom)	; Schreiben?
  E369    CB 57          C      	bit	2,a
  E36B    20 08          C      	jr	nz,writpt	; -> ja, Schreibroutine steht auf dioop
                         C       ENDIF
  E36D    21 E662        C      	ld	hl,diord
  E370    22 E60B        C      	ld	(dioop),hl	; read einstellen
                         C      
                         C       IF @write
  E373    18 22          C      	jr	dtrdyt
  E375                   C      writpt:		; pruefen, ob Schreiben erlaubt ist
  E375    DB 12          C      	in	a,(flcobd)
  E377    CB 6F          C      	bit	5,a		; /WP
  E379    3E 57          C      	ld	a,'W'		; Fehler: write protected
  E37B    CA E3A9        C      	jp	z,fehret
                         C      
                         C      ; CRC-Zeichen der zu schreibenden Daten berechnen und in crcber ablegen
  E37E    2A E4AE        C      	ld	hl,(ft.adr)
  E381    DD 21 E4B8     C      	ld	ix,crcber	; Pointer auf 1. Daten-CRC stellen
  E385    DD 36 00 FB    C      crcbes: ld	(ix),0fbh	; Datenbeginn
  E389    CD E428        C      	call	crcbd		; CRC eines phys. Sektors berechnen
  E38C    DD 72 00       C      	ld	(ix+0),d
  E38F    DD 73 01       C      	ld	(ix+1),e	; ... und ablegen
  E392    CD E413        C      	call	crcnb		; weiterer phys. Sektor?
  E395    20 EE          C      	jr	nz,crcbes	; -> ja
                         C       ENDIF ;@write
                         C      
                         C      
                         C      ; Disk inzwischen ready?
                         C      
  E397                   C      dtrdyt:
  E397    DB 12          C      dtrdyz:	IN	A,(flcobd)
  E399    1F             C      	RRA			;ready-bit =0?
  E39A    38 FB          C      dtrdyw:	JR	C,dtrdyz	;nein, 5" Disk not ready
                         C      				;auf jr c,$+2 modif bei 8"
                         C      
  E39C    3E 05          C      	ld	a,5
  E39E    CD E465        C      	call	fl.sto		;bei evtl. Fehlerwiederholung
                         C      				; timeout-Wert wieder hochstellen
                         C      				; fuer Ueberwachung auf fehlende Marke
  E3A1    3A E4B5        C      	ld	a,(ft.anz)	;Sektorzahl
  E3A4    B7             C      	or	a		; nur positionieren?
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-87


  E3A5    C2 E560        C      	jp	nz,diorun	; -> nein, Start des Transfers
                         C      
                         C      ; kein Fehler aufgetreten
  E3A8    AF             C      noerr:	xor	a
                         C      
                         C      ; Fertigmelden, Ergebnis in A
  E3A9    F5             C      fehret:	push	af
  E3AA    21 E47E        C      	ld	hl,pretx+1	;Motorabschaltung ueber Index-Interrupt
  E3AD    36 0B          C      	ld	(hl),pret3-pret4;jr pret4
  E3AF    3E 14          C      	ld	a,20		;nach 20*200ms = 4 sec
  E3B1    CD E465        C      	call	fl.sto
  E3B4    F1             C      	pop	af
  E3B5    C9             C      	ret
                         C      
                         C      ; normale Beendigung
                         C      ;===================
                         C      
                         C      ; Schreiben
  E3B6    21 E4AD        C      dtrwre:	ld	hl,ft.kom
  E3B9    CB 76          C      	bit	6,(hl)		;Kontrollesen?
  E3BB    28 EB          C      	jr	z,noerr		;nein, fertig
  E3BD    CB 96          C      	res	2,(hl)		;sonst schreiben loeschen (d.h. auf lesen)
  E3BF    C3 E308        C      	jp	rdwr		;und auf gleichen Puffer zuruecklesen
                         C      
                         C      ; Lesen
  E3C2    2A E4AE        C      dtrrde:	ld	hl,(ft.adr)
  E3C5    DD 21 E4B8     C      	ld	ix,crcber
  E3C9    CD E428        C      crcbel:	call	crcbd		;CRC bilden
  E3CC    CD E41E        C      	call	crcvgl		; und vergleichen
  E3CF    20 07          C      	jr	nz,crcerx	; -> Fehler
  E3D1    CD E413        C      	call	crcnb		;noch ein Sektor?
  E3D4    20 F3          C      	jr	nz,crcbel	;ja
  E3D6    18 D0          C      	jr	noerr
                         C      
                         C      ; Fehlerbehandlung
                         C      ;=================
                         C      ; blieb weiterer Versuch, Sektor CRC-richtig reinzubekommen?
  E3D8    21 E4D3        C      crcerx: ld	hl,crerc
  E3DB    35             C      	dec	(hl)
  E3DC    C2 E308        C      	jp	nz,rdwr		; -> ja, alles noch mal
  E3DF    3E 43          C      	ld	a,'C'		; Fehler: CRC-Zeichen falsch
  E3E1    18 C6          C      	jr	fehret
                         C      
                         C      ; Sektor nicht gefunden, evtl. falsche Spur
  E3E3                   C      serrx:
                         C      ; blieb weiterer Versuch, die richtige Spur zu finden?
  E3E3    21 E4D4        C      	ld	hl,sperc
  E3E6    35             C      	dec	(hl)
  E3E7    28 15          C      	jr	z,sperr2	; Wiederhlg. abgelaufen
  E3E9    3E 02          C      	ld	a,2
  E3EB    BE             C      	cp	(hl)		;> 2 Wiederhlg?
  E3EC    DA E2E0        C      	jp	c,trk0		;ja, Spur neu anfahren
  E3EF    06 8F          C      	ld	b,08fh		;stepout
  E3F1    28 05          C      	jr	z,sperr4	;=2 Wiederhlg., stepout
  E3F3    06 AF          C      	ld	b,0afh		;stepin
  E3F5    CD E2BE        C      	call	step		;2 mal (zuvor war stepout)
  E3F8    CD E2BE        C      sperr4:	call	step
  E3FB    C3 E2FF        C      	jp	phrw		;Wiederholung
                         C      
  E3FE    3E 53          C      sperr2:	ld	a,'S'		; Fehler: Sektor ist nicht zu finden
  E400    18 A7          C      	jr	fehret
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-88


                         C      
  E402                   C      fl.to1: ; keine Sektor-Marke gefunden
  E402    3E 55          C      	ld	a,'U'		; time-out (undefind)
  E404    18 A3          C      	jr	fehret
                         C      
                         C      ; Modifizierung entsprechend Steuertabelle
                         C      ;=========================================
                         C      ; i HL	Tabelle der Modifizierungsadressen (wohin)
                         C      ; i DE	Tabelle der Modifizierungsbytes    (was)
  E406    46             C      flmodf:	ld	b,(hl)		;Anzahl der Adressen
  E407    23             C      dslnmz:	inc	hl
  E408    C5             C      	push	bc
  E409    4E             C      	ld	c,(hl)
  E40A    23             C      	inc	hl
  E40B    46             C      	ld	b,(hl)		;bc:=wohin
  E40C    1A             C      	ld	a,(de)		;a:=was
  E40D    13             C      	inc	de
  E40E    02             C      	ld	(bc),a
  E40F    C1             C      	pop	bc
  E410    10 F5          C      	djnz	dslnmz
  E412    C9             C      	ret
                         C      
                         C      ; CRC-Berechnung
                         C      ;===============
                         C      
                         C      ; von weiterem Sektor CRC-Zeichen berechnen?
                         C      ; IX wird weitergestellt
  E413    DD 23          C      crcnb: 	inc	ix		; CRC-Pointer erhoehen
  E415    DD 23          C      	inc	ix
  E417    3E FF          C      	ld	a,0ffh
  E418                   C      secanz	equ	$-1
  E419    3D             C      	dec	a
  E41A    32 E418        C      	ld	(secanz),a
  E41D    C9             C      	ret
                         C      
                         C      ; CRC-Vergleich DE mit (IX)
  E41E    DD 7E 00       C      crcvgl: ld	a,(ix+0)
  E421    BA             C      	cp	d
  E422    C0             C      	ret	nz
  E423    DD 7E 01       C      	ld	a,(ix+1)
  E426    BB             C      	cp	e
  E427    C9             C      	ret
                         C      
                         C      ; von einem phys. Sektor ab HL die CRC-Zeichen berechnen
                         C      ; HL wird weitergestellt
  E428    11 CDB4        C      crcbd:	ld	de,0cdb4h	;CRC Anfangswert
  E429                   C      crcbeg	equ	$-2
  E42B    DD E5          C      	push	ix
  E42D    E3             C      	ex	(sp),hl		;hl:= ^Datenbeginn-Byte
  E42E    06 01          C      	ld	b,1
  E430    CD E442        C      	call	bercrc		;CRC ueber Datenbeginn-Byte
  E433    E3             C      	ex	(sp),hl
  E434    DD E1          C      	pop	ix
  E436    06 01          C      	ld	b,1
  E437                   C      fl.tsb	equ	$-1		; Zahl der 128er Bloecke
  E438    C5             C      sp74: 	push	bc
  E439    06 80          C      	ld	b,128
  E43B    CD E442        C      	call	bercrc
  E43E    C1             C      	pop	bc
  E43F    10 F7          C      	djnz	sp74
  E441    C9             C      	ret
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-89


                         C      ; von HL an B Zeichen auf DE als CRC-Polynom draufrechnen
  E442    7E             C      bercrc: ld	a,(hl)
  E443    AA             C      	xor	d
  E444    57             C      	ld	d,a
  E445    0F             C      	rrca
  E446    0F             C      	rrca
  E447    0F             C      	rrca
  E448    0F             C      	rrca
  E449    E6 0F          C      	and	0fh
  E44B    AA             C      	xor	d
  E44C    57             C      	ld	d,a
  E44D    0F             C      	rrca
  E44E    0F             C      	rrca
  E44F    0F             C      	rrca
  E450    4F             C      	ld	c,a
  E451    E6 1F          C      	and	1fh
  E453    AB             C      	xor	e
  E454    5F             C      	ld	e,a
  E455    79             C      	ld	a,c
  E456    0F             C      	rrca
  E457    E6 F0          C      	and	0f0h
  E459    AB             C      	xor	e
  E45A    5F             C      	ld	e,a
  E45B    79             C      	ld	a,c
  E45C    E6 E0          C      	and	0e0h
  E45E    AA             C      	xor	d
  E45F    53             C      	ld	d,e
  E460    5F             C      	ld	e,a
  E461    23             C      	inc	hl
  E462    10 DE          C      	djnz	bercrc
  E464    C9             C      	ret
                         C      
                         C      ; Aktivieren Indexpunktueberwachung
                         C      ; i A	Zaehler (wird bis 0 runtergezaehlt)
                         C      ; nur Reg. A zerstoert
                         C      
  E465    32 E476        C      fl.sto:	ld	(fl.zto),a	;Setzen Zaehler fuer Indexpunkte
  E468    3E 83          C      	ld	a,83h		;zulassen Indexinterrupt
  E46A    D3 11          C      	out	(flcoac),a
  E46C    C9             C      	ret
                         C      
                         C      ; Interruptbehandlungsroutine: time-out-Zeit abgelaufen
                         C      ; ausgeloest durch Index-Interrupt
  E46D    ED 73 E758     C      itimeo: ld	(intsp),sp
  E471    31 F217        C      	ld	sp,intstk
  E474    F5             C      	push	af
  E475    3E 00          C      	ld	a,0		; Zaehler fuer time-out Takte
  E476                   C      fl.zto	equ	$-1
  E477    3D             C      	dec	a		; time-out -1
  E478    32 E476        C      	ld	(fl.zto),a
  E47B    20 10          C      	jr	nz,pret1	;-> nicht abgelaufen
  E47D    18 0B          C      pretx:	jr	pret3		;modif. auf "jr pret4" waehrend Transfer
  E47F                   C      pret4:
                         C       IF cpu eq k2526
  E47F    3E A9          C      	ld	a,10101001b	;Time out waehrend Transfer
  E481    D3 10          C      	out	(flcoad),a	;CPU 2 stoppen
  E483    3E 00          C      	ld	a,dtrtor-dtrwjr
  E485    32 E597        C      	ld	(dtrret),a	;Reaktionsroutine "keine Marke gefunden"
                         C       ENDIF
  E488    18 03          C      	jr	pret1
  E48A    CD E490        C      pret3:	call	headup
  E48D    C3 E756        C      pret1: 	jp	intraf		; allg. Ausgang Interruptroutinen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-90


                         C      
                         C      ; Motor-Abschaltung von aussen her
                         C      ; nur Reg. AF zerstoert
  E490    3E 03          C      headup:	ld	a,3		; Indexinterrupt sperren
  E492    D3 11          C      	out	(flcoac),a
  E494    3E FF          C      	ld	a,0ffh		; Motor aus
  E496    D3 18          C      	out	(flsel),a
                         C       IF fdc eq f1715
                         C       ENDIF
                         C      ; Motor aus und alte Spurnummer merken
  E498    E5             C      flres: 	push	hl
  E499    C5             C      	push	bc
  E49A    21 E4D7        C      	ld	hl,alwnr
  E49D    CB 9E          C      	res	3,(hl)		; Motor aus vermerken
  E49F    4E             C      	ld	c,(hl)
  E4A0    06 00          C      	ld	b,0
  E4A2    21 E4D9        C      	ld	hl,spnrl	; alte Spurnr. in Tabelle merken
  E4A5    09             C      	add	hl,bc
  E4A6    3A E4D8        C       	ld	a,(aspnr)
  E4A9    77             C      	ld	(hl),a
  E4AA    C1             C      	pop	bc
  E4AB    E1             C      	pop	hl
  E4AC    C9             C      	ret
                         C      
                         C      
                         C      ;*****************************************************
                         C      ;	Arbeitsbereiche phys. Floppy-Treiber
                         C      ;*****************************************************
                         C      
                         C      ; Parameterfeld
                         C      ;==============
  E4AD    00             C      ft.kom: db	0	; Kommando
  E4AE    0000           C      ft.adr: dw	0	; Transferadresse
  E4B0    00             C      ft.lwn: db	0	; Laufwerksnummer 0..3
  E4B1    00             C      ft.trk: db	0	; Spurnummer   0..
  E4B2    00             C      ft.sid: db	0	; side-Nr.     0..1
  E4B3    00             C      ft.sec: db	0	; Sektornummer
  E4B4    00             C      ft.len: db	0	; Sektorlaenge 0..3
  E4B5    00             C      ft.anz: db	0	; Anz. phys. Sektoren
  E4B6    00             C      ft.stp: db	0	; Anzahl der Stepimpulse pro Spur
  E4B7    00             C      ft.sti: db	0	; Schrittzeit von Spur zu Spur
                         C      
  E4B8                   C      crcber: ds	3*9,0ffh; Ber. zum Ablegen der gelesenen/zu schreibenden CRC-Z.
                         C      			; reicht fuer 9 physische Sektoren pro Transfer
                         C      ; Fehler-Wiederholungszaehler
  E4D3    00             C      crerc: 	db	0	; CRC-Fehler
  E4D4    00             C      sperc: 	db	0	; Spur nicht gefunden
  E4D5    00             C      seerc: 	db	0	; Sektor nicht gefunden
  E4D6    00             C      lwexis: db	0	; Anzeigebyte fuer vorhandene Laufwerke
                         C      			; bit 0 = 1 LW 0 vorhanden
                         C      			; bit 2 = 1 LW 1 vorhanden
                         C      			; bit 4 = 1 LW 2 vorhanden
                         C      			; bit 6 = 1 LW 3 vorhanden
                         C      
  E4D7    00             C      alwnr: 	db	0	; alte Laufwerksnummer vom vergangenen Zugriff
                         C      			; bit 0-2 LW-Nr., bit 3 = 1 Motor laeuft noch
                         C      
  E4D8    00             C      aspnr:	db	0	; aktuelle Spur des durch alwnr bezeichneten LW
  E4D9    00 00 00 00    C      spnrl: 	db	0,0,0,0	; Tabelle der alten Spurnummern
                         C      
                         C       IF dsk8fm+dsk8mf+dsk5fm
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-91


                         C      ; Modifizierungstaelle entspr. LW-Typ und Aufzeichnungsverfahren
                         C      ; standardmaessig ist 5" MFM, Seite 0 eingestellt
                         C      
  E4DD    0A             C      mdtbad:	db	mdtbl
  E4DE    E5D8           C      	dw	diom01		;Lesen Marke auf Seite 0 ein
  E4E0    E603           C      	dw	diomd2		;Gap-Rest Sektor/Daten
  E4E2    E429           C      	dw	crcbeg		;CRC-Anfangswert
  E4E4    E42A           C      	dw	crcbeg+1
  E4E6    E321           C      	dw	dfrcod		;Taktfrequenzcode
  E4E8    E323           C      	dw	dpretr		;Precomp. Spur
  E4EA    E39B           C      	dw	dtrdyw+1	;ready Wartezyklus
                         C       IF cpu eq k2526
                         C       ENDIF
                         C       if @write
  E4EC    E60B           C      	dw	dioop		;Schreibroutine
  E4EE    E60C           C      	dw	dioop+1
                         C        IF cpu eq k2526
                         C        ENDIF
                         C        if dsk8fm+dsk8mf
  E4F0    E70A           C      	dw	diowm1+1	;Zahl der Null-Bytes nach Datenschreiben
                         C        endif
                         C       endif
  000A                   C      mdtbl	equ	($-mdtbad-1)/2
                         C      
                         C      ; MFM
                         C      ;====
  E4F2    85             C      mdmfm8:	db	10000101b
                         C       IF cpu eq k2526
  E4F3    11             C      	db	17
                         C       ENDIF
  E4F4    CDB4           C      	dw	0cdb4h
                         C       IF fdc eq f1715
                         C       ENDIF
                         C       IF fdc eq k5120
                         C       ENDIF
                         C       IF fdc eq k5122
  E4F6    00             C      	db	00000000b
                         C       ENDIF
  E4F7    FF             C      	db	255
  E4F8    00             C      	db	0
                         C       IF cpu eq k2526
                         C       ENDIF
                         C       if @write
  E4F9    E6CC           C      	dw	diwmfm
                         C        IF cpu eq k2526
                         C        ENDIF
                         C        if dsk8fm+dsk8mf
  E4FB    02             C      	db	2
                         C        endif
                         C       endif
                         C      
  E4FC    85             C      mdmfm5:	db	10000101b
                         C       IF cpu eq k2526
  E4FD    11             C      	db	17
                         C       ENDIF
  E4FE    CDB4           C      	dw	0cdb4h
                         C       IF fdc eq f1715
                         C       ENDIF
                         C       IF fdc eq k5120
                         C       ENDIF
                         C       IF fdc eq k5122
  E500    04             C      	db	00000100b
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-92


                         C       ENDIF
  E501    19             C      	db	25
  E502    FB             C      	db	dtrdyz-(dtrdyw+2)
                         C       IF cpu eq k2526
                         C       ENDIF
                         C       if @write
  E503    E6CC           C      	dw	diwmfm
                         C        IF cpu eq k2526
                         C        ENDIF
                         C        if dsk8fm+dsk8mf
  E505    1C             C      	db	28
                         C        endif
                         C       endif
                         C      
                         C      ; FM
                         C      ;===
                         C       IF dsk8mf+dsk8fm+dsk5fm ; dsk8fm-Platz immer freihalten wenn danach 5" FM
  E506    87             C      mdfm8:	db	10000111b
                         C       IF cpu eq k2526
  E507    06             C      	db	6
                         C       ENDIF
  E508    FFFF           C      	dw	0ffffh
                         C       IF fdc eq f1715
                         C       ENDIF
                         C       IF fdc eq k5120
                         C       ENDIF
                         C       IF fdc eq k5122
  E50A    04             C      	db	00000100b
                         C       ENDIF
  E50B    FF             C      	db	255
  E50C    00             C      	db	0
                         C       IF cpu eq k2526
                         C       ENDIF
                         C       if @write
  E50D    E6A6           C      	dw	diowfm
                         C        IF cpu eq k2526
                         C        ENDIF
                         C        if dsk8fm+dsk8mf
  E50F    02             C      	db	2
                         C        endif
                         C       endif
                         C       ENDIF
                         C      
                         C       IF dsk5fm ; kann K5120, K5122 nicht, nur PC1715
                         C       ENDIF
                         C      
                         C       ENDIF ;nicht nur 5" MFM
                         C      
                         C      ; Modifizierungstabelle entspr. Sektorlaenge
                         C      
  E510    09             C      dslnmt:	db	dslnl		;Tabellenlaenge
  E511    E437           C      	dw	fl.tsb		;Anzahl der 128er Bloecke
  E513    E673           C      	dw	diosl1		;Laenge erstes INIR
                         C       IF cpu eq k2526
  E515    E67F           C      	dw	dini1+1		;INI oder INIR
  E517    E682           C      	dw	dini2+1
  E519    E685           C      	dw	dini3+1
                         C       ENDIF
                         C       if @write
  E51B    E6F9           C      	dw	diosl2		;Laenge erstes OTIR
                         C        IF cpu eq k2526
  E51D    E6FC           C      	dw	doti1+1		;OUTI oder OTIR
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-93


  E51F    E6FE           C      	dw	doti2+1
  E521    E700           C      	dw	doti3+1
                         C        ENDIF
                         C       endif
  0009                   C      dslnl	equ	($-dslnmt-1)/2	;Tabellenlaenge
                         C      
                         C      ; 128
  E523    01             C      dsln0:	db	1
                         C       IF cpu eq k2526
  E524    80 A2 A2 A2    C      	db	128,0a2h,0a2h,0a2h
                         C       ENDIF
                         C       if @write
                         C        IF cpu eq k2526
  E528    80 A3 A3 A3    C      	db	128,0a3h,0a3h,0a3h
                         C        ENDIF
                         C       endif
                         C      
                         C      ; 256
  E52C    02             C      dsln1:	db	2
                         C       IF cpu eq k2526
  E52D    00 A2 A2 A2    C      	db	0,0a2h,0a2h,0a2h
                         C       ENDIF
                         C       if @write
                         C        IF cpu eq k2526
  E531    00 A3 A3 A3    C      	db	0,0a3h,0a3h,0a3h
                         C        ENDIF
                         C       endif
                         C      
                         C      ; 512
  E535    04             C      dsln2:	db	4
                         C       IF cpu eq k2526
  E536    00 A2 A2 B2    C      	db	0,0a2h,0a2h,0b2h
                         C       ENDIF
                         C       if @write
                         C        IF cpu eq k2526
  E53A    00 A3 A3 B3    C      	db	0,0a3h,0a3h,0b3h
                         C        ENDIF
                         C       endif
                         C      
                         C      ; 1024
  E53E    08             C      dsln3:	db	8
                         C       IF cpu eq k2526
  E53F    00 B2 B2 B2    C      	db	0,0b2h,0b2h,0b2h
                         C       ENDIF
                         C       if @write
                         C        IF cpu eq k2526
  E543    00 B3 B3 B3    C      	db	0,0b3h,0b3h,0b3h
                         C        ENDIF
                         C       endif
                         C      
                         C       IF dskds
                         C      ; Modifizierungsadressen fuer Seitenauswahl
  E547    0C             C      dsidmt:	db	dsidtl		; MFM		 FM
  E548    E5D8           C      	dw	diom01		;85/81		87/83
                         C       IF cpu eq k2526
  E54A    E584           C      	dw	diom02		;a5/a1		a5/a1
  E54C    E5D4           C       	dw	diom03		;b5/b1		b5/b1
  E54E    E5C4           C      	dw	diom13		;bd/b9		bd/b9
                         C       ENDIF
                         C       if @write
                         C        IF dsk8fm+dsk5fm
  E550    E6AD           C      	dw	diom04		; -		a4/a0
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-94


  E552    E6BF           C      	dw	diom05		; -		b6/b2
  E554    E6C5           C      	dw	diom06		; -		a4/a0
                         C        ENDIF
  E556    E6D2           C      	dw	diom07		;b4/b0		 -
  E558    E6E4           C      	dw	diom08		;b6/b2		 -
  E55A    E6EE           C      	dw	diom09		;b4/b0		 -
                         C       endif
  E55C    E66B           C      	dw	diom10		;b5/b1		b5/b1
                         C      ;;diom11 muss letztes Byte in der Tabelle sein
  E55E    E710           C      	dw	diom11		;b5/b1		b5/b1
  000C                   C      dsidtl	equ	($-dsidmt-1)/2
                         C       ENDIF
                         C      	include BIOSDSKP
                         C      ;****************************************************************
                         C      ; Treiber fuer Ansteuerung K5120/K5122 ueber K2526 (mit Hilfsprozessor)
                         C      ; 04.06.87
                         C      ; - Fehlerkorrektur 8" MFM (Taktzeiten)
                         C      ; 25.09.89
                         C      ; - wegen MFS 1.2 nach Transfer b1 (= fault reset) als Standardwert
                         C      ;****************************************************************
                         C      
  E560                   C      diorun:
  E560    2A E4AE        C      	ld	hl,(ft.adr)
  E563    22 E5AC        C      	ld	(diodma),hl
                         C      
                         C      ; physischen Transfer ueber CPU 2 starten
                         C      
  E566    21 E5A7        C      	ld	hl,dio
  E567                   C      diortn	equ	$-2
  E569    ED 4B 0001     C      	ld	bc,(1)		;retten HS 1
  E56D    22 0001        C      	ld	(1),hl		;CPU 2 -Routine
  E570    3E FE          C      	ld	a,0feh
  E572    32 E597        C      	ld	(dtrret),a	;stellen Warte-Reaktion
  E575    AF             C      	XOR	A
  E576    D3 14          C      	OUT	(fldaad),A
  E578    D3 04          C      	OUT	(04H),A		;reset CPU 2
  E57A    3D             C      	dec	a		;Mode 3 (Bit E/A)
  E57B    D3 17          C      	OUT	(fldabc),A
  E57D    D3 17          C      	OUT	(fldabc),A	;alles Input
  E57F    3E B9          C      	ld	a,10111001b	;AMF aus, Fault reset
  E581    D3 10          C      	out	(flcoad),a
  E583    3E A5          C      	LD	A,10100101b	;Seite einstellen, Mark reset, AMF aktiv
  E584                   C      diom02	equ	$-1		;a5/a1
  E585    D3 10          C      	OUT	(flcoad),A
  E587    3E 7F          C      	LD	A,7FH		;Mode 1
  E589    D3 17          C      	OUT	(fldabc),A
  E58B    DB 16          C      	IN	A,(fldabd)	;CPU2 starten (ueber BUSRQ)
                         C      ; durch die Anfangsinitialisierung der CPU2 vergehen die notwendigen
                         C      ; 100 Mikrosek. fuer Seitenumschaltung
  E58D    ED 43 0001     C      	ld	(1),bc		;HS 1 wiederherst.
  E591    3A E5D8        C      	LD	A,(diom01)	;Lesen Marke
  E594    D3 10          C      	OUT	(flcoad),A	;weiter bei CPU2 nach Anfangsinit.
                         C      ; Achtung!! Zur Synchronisation CPU1 und CPU2 keine 2-Byte-Werte
                         C      ; (Adressen) verwenden, da dazwischen BUSRQ auftreten kann und dann
                         C      ; nur ein Byte gesetzt wurde!!
  E596    18 FE          C      	jr	$		;auf CPU 2 Ende warten
  E597                   C      dtrret	equ	$-1
  E598                   C      dtrwjr:
  E598    C3 E402        C      dtrtor:	jp	fl.to1		;time out
  E59B    C3 E3A8        C      dtrner:	jp	noerr		;fehlerfrei (Sekt.id)
  E59E    C3 E3E3        C      dtrnsr:	jp	serrx		;Sektor nicht gefunden
  E5A1    C3 E3C2        C      dtrrdr:	jp	dtrrde		;Read Ende
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-95


  E5A4    C3 E3B6        C      dtrwrr:	jp	dtrwre		;Write Ende
                         C      ;--------------------------
                         C      
                         C      
                         C      ; Code CPU 2 fuer phys. Diskettentransfer
                         C      ;========================================
                         C      ; Zeitbedingungen fuer 8" MFM:
                         C      ; 6 Umdrehungen pro Sec bei 2*5208 Bytes pro Spur bedeutet
                         C      ; 1/(6*2*5208), d.h. 16 Mikrosec pro Byte!!
                         C      ; Bei einer Taktfrequenz von (9600*256)=2457600 Hz sind das
                         C      ; (9600*256)/(6*2*5208) Takte, d.h. max. 39 Takte pro Byte!!
                         C      ; Wegen BUSRQ/BUSAK muss davon der laengste Maschinenzyklus
                         C      ; der CPU 1 abgezogen werden, d.h. 6 Takte (Interruptannahme),
                         C      ; weiterhin je ein Takt fuer BUSRQ/BUSAK-Umschaltung,
                         C      ; es verbleiben 31 Takte zwischen den E/A-Maschinenzyklen!!
                         C      
                         C      ; normaler Entry in phys. Diskettentransfer
                         C      ;==========================================
  E5A7                   C      dio:	
  E5A7    AF             C      	xor	a		;wiederherstellen 'jr diokl'
  E5A8    32 E5E0        C      	ld	(diomd1+1),a
  E5AB    21 0000        C      	ld	hl,0
  E5AC                   C      diodma	equ	$-2		;Transferadresse
  E5AE    3E 00          C      	ld	a,0
  E5AF                   C      secan1	equ	$-1		;a':=Zahl zu transfer. phys. Sekt.
  E5B0    08             C      	ex	af,af'
  E5B1    11 E4B8        C      	ld	de,crcber	;auf Beginn Datenbyte-/CRC-Vektor
  E5B4    D9             C      dio2:	exx
  E5B5    01 00FF        C      	ld	bc,000ffh	;bc':= Spur, Seite
  E5B6                   C      sidtr	equ	$-2
  E5B7                   C      sidsid	equ	$-1
  E5B8    21 FFFF        C      	ld	hl,0ffffh	;hl':= Sektor, Sektlngflag
  E5B9                   C      sidsec	equ	$-2
  E5BA                   C      sidlen	equ	$-1
  E5BB    11 FEA1        C      	ld	de,0fea1h	;de':= Sektorid-Byte, Kluftbyte
  E5BE    3E 3C          C      	ld	a,60		;Wiederholungszaehler falscher Sektid.
  E5C0    32 E4D5        C      	ld	(seerc),a	;fuer ersten Sektor stellen
  E5C3    3E BD          C      diostp:	ld	a,10111101b	;bd/b9, AMF aus, Seite bleibt (>=100 Mikros.)
  E5C4                   C      diom13	equ	$-1
  E5C5    D3 10          C      	out	(flcoad),a	;Ende CPU2
  E5C7    18 12          C      	jr	diogo		;Fortsetzung nach Anfangsinit
                         C      
  E5C9                   C      dionss:
  E5C9    3E 3C          C      	ld	a,60		;Wiederholungszaehler falscher Sektid.
  E5CB    32 E4D5        C      	ld	(seerc),a	;fuer naechsten Sektor setzen
  E5CE                   C      diomr:
  E5CE    3E 05          C      	ld	a,5		;verhindern unendl. Schleife
  E5D0    32 E476        C      	ld	(fl.zto),a	;bei fehlender Sektor-Marke
  E5D3    3E B5          C      diomrk:	ld	a,10110101b	;b5/b1 MFM; b5/b1 FM
  E5D4                   C      diom03	equ	$-1		;Mark reset, lesen 1
  E5D5    D3 10          C      	out	(flcoad),a
  E5D7    3E 85          C      	ld	a,10000101b	;85/81 MFM; 87/83 FM
  E5D8                   C      diom01	equ	$-1		;Lesen Marke entspr. Aufzverf.
  E5D9    D3 10          C      	out	(flcoad),a
  E5DB    DB 16          C      diogo:	in	a,(fldabd)
  E5DD    D3 14          C      	out	(fldaad),a
  E5DF    18 00          C      diomd1:	jr	diomd1+2	;wird modifiziert mit 'jr diotrr',
                         C      				;wenn Sektorid zu lesen
  E5E1    DB 16          C      diokl:	in	a,(fldabd)
  E5E3    BB             C      	cp	e		;'A1', d.h. noch in Kluft?
  E5E4    28 FB          C      	jr	z,diokl		;ja
  E5E6    BA             C      	cp	d		;'FE', d.h. Sektorbeginn?
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-96


  E5E7    DB 16          C      	in	a,(fldabd)
  E5E9    20 E8          C      	jr	nz,diomrk	;nein, weitersuchen
  E5EB    B9             C      	cp	c		;Spur ok?
  E5EC    DB 16          C      	in	a,(fldabd)
  E5EE    20 5D          C      	jr	nz,serr		;nein, falscher Sektid.
  E5F0    B8             C      	cp	b		;Seite ok?
  E5F1    DB 16          C      	in	a,(fldabd)
  E5F3    20 58          C      	jr	nz,serr		;nein, falscher Sektid.
  E5F5    BD             C      	cp	l		;Sektor ok?
  E5F6    DB 16          C      	in	a,(fldabd)
  E5F8    20 53          C      	jr	nz,serr		;nein, falscher Sektid.
  E5FA    BC             C      	cp	h		;Sekt-Laengencode?
  E5FB    DB 16          C      	in	a,(fldabd)	;**ignorieren CRC Sektid**
  E5FD    20 4E          C      	jr	nz,serr		;nein, falscher Sektid.
  E5FF    D9             C      	exx
  E600    DB 16          C      	in	a,(fldabd)	;**ignorieren CRC Sektid**
  E602    06 11          C      	ld	b,17		;Zahl zu uebergeh. Bytes
  E603                   C      diomd2	equ	$-1		;bei DD auf 17, bei SD auf 6
  E604    DB 16          C      diosyn:	in	a,(fldabd)	;Bytes ignorieren
  E606    10 FC          C      	djnz	diosyn
  E608    DB 16          C      	in	a,(fldabd)
  E60A    C3 E662        C      	jp	diord
  E60B                   C      dioop	equ	$-2		;wird modifiziert entspr. Oper.
                         C      ;				 mit diord, diwmfm, diowfm
                         C      
                         C      ; Entry fuer phys. Treiber zum Lesen Sekt.-Id. auf akt. Spur
                         C      ;===========================================================
  E60D    3E 39          C      diotsr:	ld	a,diotrr-(diomd1+2)	;jr diotrr
  E60F    32 E5E0        C      	ld	(diomd1+1),a	;modifizieren
  E612    01 0316        C      	ld	bc,3*256+fldabd	;Lesen 3 Bytes Sektorid
  E615    21 E4B2        C      	ld	hl,ft.trk+1	;dorthin Sektorid hinterlegen
  E618    18 9A          C      	jr	dio2		;Einsprung in phys. Treiber
  E61A                   C      diotrr:
  E61A    DB 16          C      diotr0:	in	a,(fldabd)
  E61C    BB             C      	cp	e		;'A1', d.h. noch in Kluft?
  E61D    28 FB          C      	jr	z,diotr0	;ja
  E61F    BA             C      	cp	d		;'FE', d.h. Sektorbeginn?
  E620    DB 16          C      	in	a,(fldabd)	;wenn ja, so ist das die Spur
  E622    20 AF          C      	jr	nz,diomrk	;nein, weitersuchen
  E624    D9             C      	exx
  E625    ED B2          C      	inir			;Sektorid lesen
  E627    D9             C      	exx
  E628    6F             C      	ld	l,a		;Spur retten
  E629    3A E5D4        C      	ld	a,(diom03)
  E62C    D3 10          C      	out	(flcoad),a	;Lesen 1
  E62E    7D             C      	ld	a,l
  E62F    B9             C      	cp	c		;richtige Spur?
  E630    28 09          C      	jr	z,diotr1	;ja
  E632    3A E4B2        C      	ld	a,(ft.sid)
  E635    90             C      	sub	b		;stimmt side?
  E636    20 0B          C      	jr	nz,diotre	;nein, dies ist kein Sektid.
  E638    B9             C      	cp	c		;war Spur 0 gefordert?
  E639    28 23          C      	jr	z,serr2		;ja, nachjustieren (ft.trk steht noch)
  E63B    7D             C      diotr1:	ld	a,l
  E63C    32 E4B1        C      	ld	(ft.trk),a	;(tatsaechliche) Spur aus Sekt.Id.
  E63F    3E 03          C      	ld	a,dtrner-dtrwjr	;Reaktionsroutine
  E641    18 5D          C      	jr	dioend		;Abschlussbehandlung
  E643    D9             C      diotre:	exx
  E644    01 0316        C      	ld	bc,3*256+fldabd	;Lesen 3 Bytes Sektorid
  E647    21 E4B2        C      	ld	hl,ft.trk+1	;dorthin Sektorid hinterlegen
  E64A    D9             C      	exx
  E64B    18 07          C      	jr	serr1
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-97


                         C      ;---------------------------
                         C      
                         C      ; Fehlerausgaenge
                         C      ;----------------
                         C      ; falscher Sektorid.
  E64D    DB 16          C      serr:	in	a,(fldabd)
  E64F    3A E5D4        C      	ld	a,(diom03)	;Lesen 1
  E652    D3 10          C      	out	(flcoad),a
  E654    3A E4D5        C      serr1:	ld	a,(seerc)
  E657    3D             C      	dec	a		;blieb weiterer Versuch?
  E658    32 E4D5        C      	ld	(seerc),a
  E65B    C2 E5CE        C      	jp	nz,diomr	;ja
  E65E    3E 06          C      serr2:	ld	a,dtrnsr-dtrwjr	;Sektor nicht gefunden
  E660    18 3E          C      	jr	dioend
                         C      
                         C      ; Lesen
                         C      ;-------
  E662    DB 16          C      diord:	in	a,(fldabd)
  E664    06 06          C      	ld	b,6
  E666    DB 16          C      diords:	in	a,(fldabd)	;uebergehen Synchron-Bytes
  E668    10 FC          C      	djnz	diords
  E66A    3E B5          C      	ld	a,10110101b	;b5/b1
  E66B                   C      diom10	equ	$-1
  E66C    D3 10          C      	out	(flcoad),a	;Lesen 1
  E66E    3A E5D8        C      	ld	a,(diom01)	;85/81 MFM; 87/83 FM
  E671    01 8016        C      	ld	bc,128*256+fldabd ;b:=inir-Laenge
  E673                   C      diosl1	equ	$-1		  ;   128 bei Sektl 128, sonst =0
  E674    D3 10          C      	out	(flcoad),a	;Lesen Marke
  E676    DB 16          C      	in	a,(fldabd)	;ignorieren evtl. anstehenden Muell
  E678    DB 16          C      diorkl:	in	a,(fldabd)
  E67A    FE A1          C      	cp	0a1h		;noch in Kluft?
  E67C    28 FA          C      	jr	z,diorkl	;ja
  E67E    ED A2          C      dini1:	ini			;Daten lesen
  E680    12             C      	ld	(de),a		;Datenbeginn-Byte hinterlegen
  E681    ED A2          C      dini2:	ini
  E683    13             C      	inc	de
  E684    ED A2          C      dini3:	ini
  E686    ED B2          C      	inir
  E688    EB             C      	ex	de,hl
  E689    ED A2          C      	ini			;CRC Daten
  E68B    ED A2          C      	ini
  E68D    3A E710        C      	ld	a,(diom11)	;b1 fuer MFS 1.2 Fault reset, sonst b5/b1
  E690    D3 10          C      	out	(flcoad),a	;Lesen 1
  E692    EB             C      	ex	de,hl
  E693    3E 09          C      	ld	a,dtrrdr-dtrwjr	;Reaktionsroutine Read Ende
                         C      
                         C      ; naechsten Sektor behandeln
                         C      ;---------------------------
  E695    08             C      dions:	ex	af,af'		;Zahl zu uebertr. Sektoren
  E696    3D             C      	dec	a
  E697    28 06          C      	jr	z,dionse	;=0, fertig
  E699    08             C      	ex	af,af'
  E69A    D9             C      	exx
  E69B    2C             C      	inc	l		;Sektor+1
  E69C    C3 E5C9        C      	jp	dionss
  E69F    08             C      dionse:	ex	af,af'
                         C      
                         C      ; Abschlussbehandlung
                         C      ;--------------------
  E6A0                   C      dioend:
  E6A0    32 E597        C      	ld	(dtrret),a	;Reaktionsroutine hinterlegen
  E6A3    C3 E5C3        C      	jp	diostp		;Stop CPU2
