  DECB    CD E99F        C      	call	dgetpb		;ix:=dpb(c)
  DECE    DD 46 10       C      	ld	b,(ix+dpbslc)
  DED1    21 E19E        C      	ld	hl,dbslc
  DED4    70             C      	ld	(hl),b
  DED5    DD 7E 11       C      	ld	a,(ix+dpbbfm)	;Zahl der 128er Sektoren -1
  DED8    3C             C      	inc	a
  DED9    87             C      	add	a,a		;CY:=0
  DEDA    04             C      	inc	b		;fuer djnz, falls dpbslc=0
  DEDB    0F             C      dbsnbz:	rrca			;Zahl der phys. Sekt. im Puff.
  DEDC    10 FD          C      	djnz	dbsnbz
  DEDE    57             C      	ld	d,a		;merken
  DEDF    AF             C      	xor	a
  DEE0    C1             C      	pop	bc		;b:=geforderte Puffernr.
  DEE1    C5             C      	push	bc
  DEE2    21 E1B0        C      	ld	hl,dbnb
  DEE5    70             C      	ld	(hl),b
  DEE6    04             C      	inc	b
  DEE7    05             C      	dec	b		;Puffernr. 0?
  DEE8    28 03          C      	jr	z,dbsec0	;ja
  DEEA    82             C      dbsecz:	add	a,d		;0. phys. Sekt. im Puffer
  DEEB    10 FD          C      	djnz	dbsecz		;=dbsnb.*Puffernr.
  DEED    5F             C      dbsec0:	ld	e,a		;merken Pufferanf.-Sektor
  DEEE    DD 46 10       C      	ld	b,(ix+dpbslc)
