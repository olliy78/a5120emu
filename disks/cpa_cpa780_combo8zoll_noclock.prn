                         C      	include BIOSNUC
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                         C      ; Zentrale BIOS-Kompenenten
                         C      ; - rst 38h fuehrt bei Monitor zu seinem Aufruf, sonst Warmstart
                         C      ; - Nachladen CCP aus RAM-Floppy vereinheitlicht (unabh. von RAM-Floppy)
                         C      ; - synflg hinter BIOS-Sprungvektor fuer Modifizierung von aussen
                         C      ; - Verwendung der Interruptsaeule in Generierungsteil verlagert
                         C      ; 25.09.88
                         C      ; - Streichen des Tastaturpuffers in Tastaturstatus
                         C      ; 09.10.88
                         C      ; - Pflege der Statuszeile nur bei stzaus=0
                         C      ; 11.01.89
                         C      ; - Variante wbootv=4 (@CCP.COM) eingefuehrt
                         C      ; 17.05.89
                         C      ; - Generierung ohne LW A moeglich
                         C      ; 05.06.89
                         C      ; - Unterstuetzung NANOS-RAF
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                         C      
                         C       IF iobvar
                         C      ;Verteiler fuer die 1-Zeichen-Kanaele entsprechend IOBYTE:
                         C      ;=========================================================
                         C      
  E797                   C      const:			; iobyte  00 00 00 xx
  E797    CD E7F7        C      	call	iodisp
  E79A    07             C      	db	7
  E79B    D369           C      	dw	kbdst		;0 kbd:
  E79D    D369           C      	dw	kbdst		;1 kbd:
  E79F    E7BB           C      	dw	reades		;2 rdr:
  E7A1    DAAC           C      	dw	uc1st		;3 uc1: (liefert, ob Z. da)
                         C      
  E7A3                   C      conin:			; iobyte:  00 00 00 xx
  E7A3    CD E7F7        C      	call	iodisp
  E7A6    07             C      	db	7
  E7A7    D401           C      	dw	kbdi		;0 kbd:
  E7A9    D401           C      	dw	kbdi		;1 kbd:
  E7AB    E7C7           C      	dw	reader		;2 rdr:
  E7AD    DADB           C      	dw	uc1i		;3 uc1: (wartet, bis Z. da)
                         C      
  E7AF                   C      conout:			; iobyte:  00 00 00 xx
  E7AF    CD E7F7        C      	call	iodisp
  E7B2    07             C      	db	7
  E7B3    D66E           C      	dw	crto		;0 crt:
  E7B5    D34C           C      	dw	dumo		;1 dum:
  E7B7    E7D3           C      	dw	punch		;2 pun:
  E7B9    D905           C      	dw	uc1o		;3 uc1: (wartet, bis frei)
                         C      
  E7BB                   C      reades:			; iobyte:   00 00 xx 00
  E7BB    CD E7F7        C      	call	iodisp
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-103


  E7BE    01             C      	db	1
  E7BF    D369           C      	dw	kbdst		;0 kbd:
  E7C1    D346           C      	dw	dumst		;1 dum:
  E7C3    D346           C      	dw	dumst		;2 dum:
  E7C5    DAAC           C      	dw	uc1st		;3 uc1: (liefert, ob Z. da)
                         C      
  E7C7                   C      reader:			; iobyte:   00 00 xx 00
  E7C7    CD E7F7        C      	call	iodisp
  E7CA    01             C      	db	1
