  D3B5    C9             C      	ret
                         C      
  D3B6                   C      kbdnst:
                         C       IF stpvar
                         C       IF chdvar
  D3B6    FE D9          C      	cp	SyLc		;Drucker Synchronisieren?
  D3B8    20 03          C      	jr	nz,kbdnsy	;nein
  D3BA    CB DE          C      	set	synlrq,(hl)	;sonst vermerken
  D3BC    C9             C      	ret
  D3BD                   C      kbdnsy:
  D3BD    FE DA          C      	cp	HrLc		;Hardcopy ein/aus ?
  D3BF    20 0C          C      	jr	nz,kbdnhc
  D3C1    21 D20C        C      	ld	hl,conol
  D3C4    7E             C      	ld	a,(hl)
  D3C5    EE 0E          C      	xor	0cdh xor 0c3h	;CALL aus JP u.umgekehrt
  D3C7    77             C      	ld	(hl),a
  D3C8    3E 80          C      	ld	a,1 shl lmphcp	;Hardcopy-Lampe
  D3CA    C3 D4C5        C      	jp	kbdslm
  D3CD                   C      kbdnhc:
                         C       ENDIF
                         C       ENDIF	;stpvar
                         C      
                         C       IF monitor
                         C       ENDIF
                         C      
  D3CD    FE D1          C      	cp	Sel0		;Selector 0?
  D3CF    38 09          C      	jr	c,kbdnsl	;nein
  D3D1    FE D9          C      	cp	Sel3+1		;Selector 0..3?
  D3D3    30 05          C      	jr	nc,kbdnsl	;nein
  D3D5    E6 0F          C      	and	0fh		;Bit 0..3
  D3D7    C3 D4C5        C      	jp	kbdslm
  D3DA                   C      kbdnsl:
  D3DA    B7             C      	or	a		;Taste zu ignorieren?
  D3DB    F8             C      	ret	m		;ja
                         C      
                         C      ; Zeichen im Puffer ablegen
                         C      ;--------------------------
  D3DC                   C      kbdput:
                         C       IF cpastz
                         C       ENDIF
  D3DC    21 FFFF        C      	ld	hl,0ffffh	;Pufferadresse
  D3DD                   C      crtm35	equ	$-2
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-25


  D3DF    01 0014        C      	ld	bc,kbdbl	;Pufferlaenge
  D3E2    5F             C      	ld	e,a		;A retten
  D3E3    AF             C      	xor	a		;Pufferende-Kennzeichen
  D3E4    ED B1          C      	cpir
  D3E6    20 08          C      	jr	nz,kbdpt1	;Puffer voll
  D3E8    77             C      	ld	(hl),a		;neues Pufferende anzeigen
  D3E9    7B             C      	ld	a,e		;A wiederherstellen
  D3EA    2B             C      	dec	hl
  D3EB    77             C      	ld	(hl),a		;Zeichen puffern
                         C      ;um bei Arbeit mit Anzeige des Tastaturpuffers in Statuszeile
                         C      ;Bildschirmflimmern zu vermeiden hinterlegen des gepufferten Zeichens
                         C      ;ausserhalb des Bildschirmbereichs fuer Test, ob ueberhaupt etwas im Puffer
