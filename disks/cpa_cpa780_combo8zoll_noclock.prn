  E928    3E F7          C+     	LD	A,high(intvr)
  E92A    ED 47          C+     	LD	I,A
  E92C    ED 5E          C+     	im	2
  E92E    3E C3          C+     	LD	A,0C3H
  E930    32 0000        C+     	LD	(REBOOT),A
  E933    21 0003'       C+     	LD	HL,BIOS+3
  E936    22 0001        C+     	LD	(REBOOT+1),HL
  E939    32 0005        C+     	LD	(BDOSJP),A
  E93C    21 C406        C+     	LD	HL,BDOS+6
  E93F    22 0006        C+     	LD	(BDOSJP+1),HL
  E942    32 0038        C+     	ld	(38h),a		;Breakpoint
  E945    21 0000        C+     	ld	hl,0		;ohne Monitor wie Warmstart
  E948    22 0039        C+     	ld	(38h+1),hl
  E94B    21 D23D        C+     	ld	hl,synflg
  E94E    36 00          C+     	ld	(hl),0
  E950    23             C+     	inc	hl
  E951    36 00          C+     	ld	(hl),0		;synsem:=0
  E953    21 E71F        C+     	ld	hl,ret
  E956    22 004A        C+     	ld	(kritbg),hl	;leere Routine fuer Beginn kritischer BIOS-Teil
  E959    22 004C        C+     	ld	(kriten),hl
  E95C    21 E71F        C+     	ld	hl,ret
  E95F    22 0045        C+     	ld	(tim1rt),hl
  E962    CD E719        C+     	call	tim5on
  E965    CD E724        C+     	call	tim1on
  E968    AF             C+     	xor	a
  E969    32 D6AC        C+     	ld	(desc),a	;evtl. ESCAPE-Modus beenden
  E96C    0E 82          C+     	ld	c,82h		;Kursor sichtbar machen
  E96E    CD D66E        C+     	call	crto
  E971    3A 0040        C+     	ld	a,(lampbf)
  E974    E6 B3          C+      and (1 shl lmphcp)+(1 shl lmpb2r)+(1 shl lmpb2b)+(1 shl kbdcpb)+(1 shl kbdcal)
  E976    32 0040        C+     	ld	(lampbf),a	;ruecksetzen Lampen
  E979    21 D59B        C+     	ld	hl,kbdsts	;Standard-Stringtabelle wiederherstellen
  E97C    22 D23B        C+     	ld	(kbdsst),hl
  E97F    3E FF          C+     	ld	a,0ffh
  E981    32 E19A        C+     	ld	(dbdev),a
  E984    FB             C+     	EI
  E985    21 0004        C+     setcld: ld	hl,defaul
  E988    4E             C+     	ld	c,(hl)
  E989    C5             C+     	push	bc
  E98A    79             C+     	ld	a,c
  E98B    E6 0F          C+     	and	0fh
  E98D    4F             C+     	ld	c,a
  E98E    AE             C+     	xor	(hl)
  E98F    F6 00          C+     	or	0
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-110


  E991    77             C+     	ld	(hl),a
  E992    CD E99F        C+     	call	dgetpb
  E995    C1             C+     	pop	bc
  E996    28 ED          C+     	jr	z,setcld
  E998    C9             C+     	ret
                         C       ENDIF	;wbootv ne 1
                         C      
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                         C      ;	Steuertabellen fuer Massenspeicher
                         C      ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                         C       if1
                         C       endif
                         C      
                         C      ; Tabelle der Adressen der DPH's
                         C      ;===============================
                         C      
                         C      ;===============================================
  0003                   C      @din	aset	dphnb
  E999                   C      dphatb: IRP	di,<A,B,C,D,E,F,G,H,I,J,K,L,M,N,O,P>
                         C      	if	@din eq 0
                         C      	EXITM
                         C      	endif
                         C      @din	aset	@din-1
                         C       IF dpha&di ; Laufwerk A auf erstes definiertes Geraet legen
                         C      dphaA	aset	dpha&di
                         C       ENDIF
                         C      	dw	dpha&di
                         C      	ENDM
  E999    D23F           C+     	dw	dpha&A
  E99B    D24F           C+     	dw	dpha&B
  E99D    D25F           C+     	dw	dpha&C
                         C      
                         C      ; Ermitteln DPH und DPB von (c) nach HL bzw. IX
                         C      ; ret z		DPH existiert nicht, HL=0
                         C      ; ret nz	ok, HL auf DPH, IX auf DPB
                         C      ; BC, DE bleiben erhalten
                         C      ;=====================================================
  E99F    D5             C      dgetpb: push	de
  E9A0    21 0000        C      	ld	hl,0
  E9A3    79             C      	ld	a,c
  E9A4    FE 03          C      	cp	dphnb		;DPH definiert?
  E9A6    30 16          C      	jr	nc,dgetp0	;nein
  E9A8    EB             C      	ex	de,hl
  E9A9    21 E999        C      	ld	hl,dphatb	;Adresstabelle fuer DPH's
  E9AC    59             C      	ld	e,c
  E9AD    19             C      	add	hl,de
  E9AE    19             C      	add	hl,de
  E9AF    7E             C      	ld	a,(hl)
  E9B0    23             C      	inc	hl
  E9B1    66             C      	ld	h,(hl)
  E9B2    6F             C      	ld	l,a		;hl:=^DPH
  E9B3    E5             C      	push	hl
  E9B4    1E 0A          C      	ld	e,10
  E9B6    19             C      	add	hl,de
  E9B7    5E             C      	ld	e,(hl)
  E9B8    23             C      	inc	hl
  E9B9    56             C      	ld	d,(hl)		;de:=^dpb
  E9BA    D5             C      	push	de
  E9BB    DD E1          C      	pop	ix		;ix:=^dpb
  E9BD    E1             C      	pop	hl
  E9BE    D1             C      dgetp0: pop	de
  E9BF    7C             C      	ld	a,h
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-111


  E9C0    B5             C      	or	l		;ret z bei hl=0
  E9C1    C9             C      	ret
                         C      
                         C      
                         C      ;**************************************************
                         C      ;	Arbeits-Felder (ab hier keine Konstanten!!)
                         C      ;	Arbeits-Felder werden benutzt fuer Kaltstart-Routinen
                         C      ;**************************************************
  E9C2                   C      biosds	equ	$
  E9C2                   C      @dsad	aset	biosds
                         C      
                         C      ; ===========allgemeine BIOS-Funktionen=============
                         C      
  0800                   C      ccpkpl	equ	ccpln		;Laenge CCP+ BDOS-Anfang
  0011                   C      bdskpl	equ	11h		;BDOS-Anfang
                         C      
                         C      	if	wbootv eq 0	;CCP-Kopie im BIOS
  E9C2                   C      ccpkop	equ	@dsad
  F1D3                   C      ccpkpe	equ	ccpkop+ccpkpl+bdskpl
  F1D3                   C      @dsad	aset	ccpkpe	;Ende CCP-Kopie
                         C      	endif
                         C      
                         C      	if	(wbootv eq 2) or (wbootv eq 3)
                         C      	endif
                         C      
                         C       IF stpvar
  F1FF                   C      @dsad	aset	@dsad+2*22	;Stack fuer asynchrone Routinen
  F1FF                   C      stpstk	equ	@dsad
                         C       ENDIF
  F217                   C      @dsad	aset	@dsad+2*12	;Stack fuer Interrupt-Routinen
  F217                   C      intstk	equ	@dsad
                         C      
                         C      ;=============Disketten-Arbeit============
                         C      
  F217                   C      dirbuf	equ	@dsad	;Directory-Puffer fuer alle Laufwerke
  F297                   C      @dsad	aset	@dsad+128
                         C      	IRP	di,<A,B,C,D>
                         C       IF disk&di
                         C      alv&di	equ	@dsad		;;Allocation-Vector Disk.
                         C      	IF	((disk&di mod 1000)/100) eq 5	;;5" 
                         C      	if	((disk&di mod 10000)/1000)	;;DS
                         C      @dsad	aset	@dsad+(400+7)/8 ;;reicht fuer 400k (1K Bloecke)
                         C      				;;	bzw. 800K (2K Bloecke)
                         C      	else					;;SS
                         C      @dsad	aset	@dsad+(200+7)/8 ;;reicht fuer 200k (1K Bloecke)
                         C      				;;	bzw. 400K (2K Bloecke)
                         C      	endif
                         C      	ELSE					;;8" 
                         C      	if	(disk&di ge 10000)		;;MFM
                         C      @dsad	aset	@dsad+(352+7)/8 ;;reicht fuer 704 2K Bloecke
                         C      	else					;;FM
                         C      @dsad	aset	@dsad+(250+7)/8 ;;reicht fuer 250K (1K Bloecke)
                         C      				;;	bzw. 500K (2K-Bloecke)
                         C      	endif
                         C      	ENDIF
                         C      csv&di	equ	@dsad		;;Check Sum
                         C      	IF	(disk&di mod 100) gt 40 ;;8",77 oder 5",80 Track
                         C      	if	((disk&di mod 10000)/1000)	;;DS
                         C      @dsad	aset	@dsad+256/4	;;reicht fuer 256 Dir.eintraege
                         C      	else					;;SS
                         C      @dsad	aset	@dsad+128/4	;;reicht fuer 128 Dir.eintraege
                         C      	endif
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-112


                         C      	ELSE				;;5" 40 Track
                         C      	if	((disk&di mod 10000)/1000)	;;DS
                         C      @dsad	aset	@dsad+128/4	;;reicht fuer 128 Dir.eintraege
                         C      	else
                         C      @dsad	aset	@dsad+64/4	;;reicht fuer 64 Dir.eintraege
                         C      	endif
