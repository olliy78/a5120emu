  E915    31 0080        C      WARMST: LD	SP,tpa-80h
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-109


                         C         if	wbootv eq 0		;;CCP-Kopie im BIOS
  E918    21 E9C2        C      	ld	hl,ccpkop	;;CCP von Kopie wiederherst.
  E91B    11 BC00        C      	ld	de,CCP
  E91E    01 0811        C      	ld	bc,ccpkpl+bdskpl
  E921    ED B0          C      	ldir
                         C         endif
