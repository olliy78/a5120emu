  DF0B    CB 96          C      	res	dfbwr,(hl)
                         C       if @write
  DF0D    CB 46          C      	bit	dfbprr,(hl)	;muss neuer Puffer gel. werden?
  DF0F    20 14          C      	jr	nz,dbprr	;ja
                         C      ; nur dann kein preread, wenn Rest BDOS-Block >= phys. Puff.
                         C      ; und Rest BDOS-Block auf Pufferanfang beginnt
  DF11    3A E1AB        C      	ld	a,(unacnt)
  DF14    DD BE 11       C      	cp	(ix+dpbbfm)	;Restzahl-1 >= Puffergr.-1 ?
  DF17    38 0C          C      	jr	c,dbprr		;nein, preread
  DF19    3A E1A6        C      	ld	a,(dsectr)	;Sektornr.
  DF1C    3D             C      	dec	a		;ab 0 zaehlen
  DF1D    DD A6 11       C      	and	(ix+dpbbfm)	;rel. Sekt.nr. des
                         C      ;				BDOS-Blocks zum Pufferanfang
  DF20    20 03          C      	jr	nz,dbprr
  DF22    32 E1B2        C      	ld	(dberrf),a	;fehlerfrei gel. anzeigen
  DF25    C4 DF66        C      dbprr:	call	nz,dbtran	;Puffer lesen
                         C       endif
  DF28                   C      dbmat:	
                         C      
                         C      ; Sektor in/aus Puffer holen
                         C      ;===========================
  DF28    F1             C      	pop	af		;Puffernr. in Spur wegschm.
  DF29    F1             C      	pop	af		;128-er Index im Puffer
  DF2A    F5             C      	push	af
  DF2B    1F             C      	rra			;Sektornb*128 berechnen
  DF2C    47             C      	ld	b,a
