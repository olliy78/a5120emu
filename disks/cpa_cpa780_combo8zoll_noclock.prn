                                ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                                ;	Beginn BIOS-Treiber
                                ;$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
                                
                                ; Dummy-Treiber
  D346                          dumst:
  D346    AF                    	xor	a
  D347    3D                    	dec	a		;Status immer FF (bereit)
                                 IF iobvar
                                 ENDIF
  D348    C9                    	ret			;Status immer FF (bereit)
                                
                                 IF iobvar
  D349    3E 1A                 dumi:	ld	a,1ah		;Eingabe-Zeichen immer EOF
  D34B    C9                    	ret
  D34C    79                    dumo:	ld	a,c
  D34D    11 D359               	ld	de,dumoh
  D350    CD E8F3               	call	mrecoa		;Zeichen hex aufbereiten
  D353    0E 28                 	ld	c,'('
  D355    CD D66E               	call	crto
  D358    01 0000               	ld	bc,0
  D359                          dumoh	equ	$-2
  D35B    C5                    	push	bc
  D35C    CD D66E               	call	crto
  D35F    C1                    	pop	bc
  D360    48                    	ld	c,b
  D361    CD D66E               	call	crto
  D364    0E 29                 	ld	c,')'
  D366    C3 D66E               	jp	crto
                                 ENDIF
                                
                         C      	include BIOSKBD
                         C      ;****************************************************
                         C      ;	Tastatur-Eingabe
                         C      ; - Unterstuetzung weiterer Steckplaetze fuer IFSS-Tastatur
                         C      ;   (z.B. Digitalisier-AP)
                         C      ; - freie Belegbarkeit Kursor- und rechter Ziffernblock
                         C      ; 17.07.88
                         C      ; - uebersichtlichere Darstellung phys. -> virtueller Tastencode
                         C      ; 24.09.88
                         C      ; - Anpassung Tastaturpuffer in Statuszeile an umschaltbaren Bildschirmpuffer
                         C      ; 25.09.88
                         C      ; - Fehler in Stop-Tasten-Behandlung korrigiert
                         C      ; 07.11.88
                         C      ; - Erweiterung des virtuellen Tastaturcodes um K7634-spezifische Tasten
                         C      ; 23.12.88
                         C      ; - saemtliche Sondertasten c0..ff liefern mit Control oder Shift einen
                         C      ;   virtuellen Zwischencode 80..bf
                         C      ; 14.01.89
                         C      ; - Variante K7633 (kbdotp eq 3) eingefuehrt
                         C      ; - wenn Tastatur nach RESET gross schreibt, so caps-lock-Test invertiert
                         C      ; 20.01.89
                         C      ; - Abtesten auf ^Q-Prefix ueber virtuellen Tastencode
                         C      ; 22.03.89
                         C      ; - Control-Flag gilt genau fuer das naechste Zeichen
                         C      ; 31.03.89
                         C      ; - Sondertasten >=80h ignoriert, wenn nicht in Tastatur-Tabelle
                         C      ; 25.09.89
                         C      ; - Fehlerkorrektur K7637: CTRL-Ersatztaste brachte kein ^Q-Prefix
                         C      ;****************************************************
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-23


                         C      
                         C       if1
                         C       endif	;if1
                         C      
                         C      ; Tastatur-Status
                         C      ;================
  D369                   C      kbdst:
                         C      ; vor Pufferabfrage anstehende Zeichen lesen (falls 5ms Takt aus)
  D369    F3             C      	di			;parallele Abfrage ueber 5ms verhindern
                         C       IF cpastz
                         C       ENDIF
  D36A    CD D371        C      	call	kbdsti		;interner Aufruf
  D36D    FB             C      	ei
                         C       IF stpvar or monitor
  D36E    C3 E82B        C      	jp	chksp		;Test auf Spezialfunktionen
                         C       ENDIF
                         C      
  D371                   C      kbdsti:				;kbdst-Aufruf intern
  D371    CD D44D        C      kbdstz:	call	kbdst1		;Taste neu gedrueckt ?
  D374    28 05          C      	jr	z,kbdsnt	;nein
  D376    CD D382        C      	call	kbdrdt		;Taste in Puffer ablegen
                         C       IF stpvar
                         C       ENDIF
  D379    18 F6          C      	jr	kbdstz		;auf neuen Tastendruck testen
                         C      
  D37B    3E 00          C      kbdsnt:	ld	a,0		;erstes Pufferzeichen
  D37C                   C      kbdbfe	equ	$-1
  D37D    B7             C      	or	a		;Puffer leer?
  D37E    C8             C      	ret	z		;ja
  D37F    3E FF          C      	ld	a,0ffh
  D381    C9             C      	ret
                         C      
                         C      ;------------------------------------------------------------
                         C      
                         C      
                         C      ; Taste umkodieren und im Puffer ablegen
                         C      ;=======================================
                         C      ; Achtung!! Dieses UP wird aus Interruptroutine aufgmrufen
  D382    CD D46D        C      kbdrdt:	call	kbdrch		;Zeichen evtl. umkodieren
  D385    21 D23D        C      	ld	hl,synflg
                         C      
  D388    FE DF          C      	cp	ctlc		;Ersatz-Control-Taste ?
  D38A    20 05          C      	jr	nz,kbdnct	;nein
  D38C    7E             C      	ld	a,(hl)
  D38D    EE 01          C      	xor	1 shl ctrlst	;CTRL-Status umkehren
  D38F    77             C      	ld	(hl),a
  D390    C9             C      	ret			;und Zeichen ignorieren
  D391                   C      kbdnct:
                         C      
                         C       IF stpvar
  D391    CB 7E          C      	bit	phyact,(hl)	;Taste physisch in Puffer?
  D393    C2 D3DC        C      	jp	nz,kbdput	;ja, direkt ablegen
                         C       ENDIF
                         C       IF costu
                         C       ENDIF
  D396    2A D23B        C      	ld	hl,(kbdsst)	;Adresse der Standardstringtabelle
  D399    CD D4B3        C      	call	costr		;Standardstring?
  D39C    28 07          C      	jr	z,kbdnco	;nein
  D39E    1D             C      kbdco:	dec	e		;String der Laenge 0?
  D39F    C8             C      	ret	z		;ja, zu ignorierende Taste
  D3A0    1D             C      	dec	e		;String exakt ein Zeichen lang?
  D3A1    C2 D3F3        C      	jp	nz,kbdco1	;nein, kann keine Sondertaste sein
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-24


  D3A4    7E             C      	ld	a,(hl)		;holen erstes Stringzeichen
  D3A5    21 D23D        C      kbdnco:	ld	hl,synflg
                         C      
                         C      ; Auswertung Sondertasten, die nicht im Puffer abgelegt werden
                         C      ;-------------------------------------------------------------
                         C      
  D3A8    FE DE          C      	cp	stpc		;STOP ?
  D3AA    20 0A          C      	jr	nz,kbdnst
  D3AC    CB E6          C      	set	stoprq,(hl)	;Stop-Request vermerken
                         C      
                         C      ; Rest des Konsolpuffers streichen
                         C      ;---------------------------------
  D3AE    AF             C      kbdbcl:	xor	a
                         C       IF cpastz
