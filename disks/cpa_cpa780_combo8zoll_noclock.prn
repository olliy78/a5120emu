                         C      	include BIOSKBDC
                         C      ; Kaltstart-Initialisierung Tastatur
                         C      ;===================================
                         C      ;14.07.88:
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-120


                         C      ; - Einbau Typcode 80h fuer K7634.54 (meldet sich wie K7636, ist aber anders!)
                         C      ; 07.11.88
                         C      ; - Erweiterung um K7634-spezifische Tasten
                         C      ;14.01.89
                         C      ; - Einbau K7633
                         C      ;16.02.89
                         C      ; - Ueberwachung der Tabellenlaenge zur Modifizierung der Tastaturcodes
                         C      ;22.03.89
                         C      ; - INSLINE -> spcins  bei K7634 in Umkodierungstabelle aufgenommen
                         C      ; - bei K7633 war KORR und ABBR vertauscht
                         C      ;07.08.89
                         C      ; - Fehlerkorrektur K7637: CTRL-Ersatztaste brachte kein ^Q-Prefix
                         C      
  03A1    AF             C      	xor	a
  03A2    32 FFFF        C      	ld	(0ffffh),a	;;Tastaturpuffer leeren
  03A3                   C      crtm43	equ	$-2
                         C      
                         C       IF costu
                         C       ENDIF
                         C      
                         C      ;;automatische Tastaturerkennung
                         C      ;;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                         C       IF kbdpin
                         C       ENDIF
  03A5    06 03          C       	ld	b,3
  03A7    11 0400        C      ciini1:	ld	de,400h
  03AA    1B             C      ciini2:	dec	de
  03AB    DB 06          C      	in	a,(kbdpci)	;;ueberlesen Tastaturzeichen
  03AD    7A             C      	ld	a,d
  03AE    B3             C      	or	e
  03AF    20 F9          C      	jr	nz,ciini2
  03B1    10 F4          C      	djnz	ciini1
                         C      
  03B3    DB 01          C      	in	a,(kbdpcs)	;;Status einer leeren Tastatur
  03B5    E6 08          C      	and	8		;;ist Taste gedrueckt?
  03B7    20 06          C      	jr	nz,ciini3	;;nein
  03B9    32 04C0        C      	ld	(coistc),a	;;sonst cpl -> nop
  03BC    32 D44F        C      	ld	(kbdstc),a
  03BF                   C      ciini3:
                         C      
  03BF                   C      ciisrt:		;;Eingang fuer Wiederholen Tastatur-Abfrage
  03BF    AF             C      	xor	a
  03C0    D3 03          C      	out	(kbdp3o),a	;;ruecksetzen K7634/36
                         C       IF kbdotp eq 3
                         C       ENDIF
  03C2    ED 4B 04C2     C      	ld	bc,(kbdsmt)
  03C6    06 05          C      	ld	b,00000101b	;;di/zeitg/vt16/neg.fl/strt/zk
  03C8    ED 41          C      	out	(c),b		;;Zeitgeber fuer IFSS-Tastatur
  03CA    06 01          C      	ld	b,1		;;Zeitkonstante 9600bd
  03CC    ED 41          C      	out	(c),b
  03CE    ED 4B 04C4     C      	ld	bc,(kbdsms)
  03D2    06 0A          C      	ld	b,k37prl	;;ruecksetzen K7637
  03D4    21 04C6        C      	ld	hl,k37par
  03D7    ED B3          C      	otir			;;SIO initialisieren
  03D9    ED 4B 04C3     C      	ld	bc,(kbdsmi)
  03DD    AF             C      	xor	a		;;reset an Tastatur
  03DE    ED 79          C      	out	(c),a
                         C      ;; Bediensicherung nach RESET wird als unzulaessiges Zeichen
                         C      ;; bei der normalen Tastatureingabe ignoriert
  03E0    21 04D0        C      	ld	hl,kmodif	;;Standard-Ausgang
  03E3    E5             C      	push	hl		;;als Return-Adresse
  03E4    11 0600        C      	ld	de,6*256+0	;;Warten auf Typ-Code K7634/36/37
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-121


  03E7    CD 04BE        C      coityp:	call	coistp
  03EA    CB 5F          C      	bit	3,a		;;Zeichen da?
  03EC    28 2A          C      	jr	z,coitn1	;;nein
  03EE    CB 57          C      	bit	2,a		;;CNTL-Status ohne gedrueckte CNTL-Taste?
  03F0    28 05          C      	jr	z,coicnp	;;nein
  03F2    3E 18          C      	ld	a,18h		;;sonst jr-Befehl,
  03F4    32 D459        C      	ld	(kbdstm),a	;;zum Ignorieren des CNTL-Status
  03F7    DB 06          C      coicnp:	in	a,(kbdpci)
  03F9    E6 F0          C      	and	0f0h
  03FB    FE 10          C      	cp	typc3s		;;Typ-Code Sondertastatur
  03FD    21 0541        C      	ld	hl,km3s
  0400    C8             C      	ret	z		;;ja
  0401    FE A0          C      	cp	typc34		;;Typ-Code K7634?
  0403    20 0D          C      	jr	nz,coin34	;;nein
  0405    CD 04BE        C      	call	coistp		;;ctrl-Taste vorhanden?
  0408    CB 57          C      	bit	2,a
  040A    21 0517        C      	ld	hl,km3458
  040D    C8             C      	ret	z		;;ja, nicht K7634.54
  040E    21 04FB        C      	ld	hl,km3454
  0411    C9             C      	ret
                         C      ;;;Typcode 80h
  0412    FE 80          C      coin34:	cp	80h		;;Typcode 80h?
                         C       if typ80 eq 3454
                         C       else
  0414    21 0533        C      	ld	hl,km36		;;  Modifizierung fuer K7636
                         C      endif
  0417    C8             C      	ret	z		;;ja
                         C      ;;;Ende Typcode 80h
                         C      
  0418    ED 4B 04C4     C      coitn1:	ld	bc,(kbdsms)
  041C    ED 78          C      	in	a,(c)
  041E    CB 47          C      	bit	0,a		;;Zeichen da?
  0420    28 31          C      	jr	z,coitn2	;;nein
  0422    ED 4B 04C3     C      	ld	bc,(kbdsmi)
  0426    ED 78          C      	in	a,(c)
  0428    E6 F0          C      	and	0f0h
  042A    FE 80          C      	cp	typc37
  042C    21 04ED        C      	ld	hl,km37
  042F    20 22          C      	jr	nz,coitn2	;;nicht Typcode K7637
  0431    3A 04C4        C      	ld	a,(kbdsms)	;;Portadressen aendern
  0434    32 05E2        C      	ld	(k37dm1),a
  0437    3A 04C3        C      	ld	a,(kbdsmi)
  043A    32 0550        C      	ld	(k37dm2),a
  043D    32 D4DE        C      	ld	(k37dm3),a
  0440    32 D4F1        C      	ld	(k37dm4),a
  0443    32 D4FD        C      	ld	(k37dm5),a
  0446    32 D509        C      	ld	(k37dm6),a
  0449    32 D526        C      	ld	(k37dm7),a
  044C    32 D52D        C      	ld	(k37dm8),a
  044F    21 04ED        C      	ld	hl,km37
  0452    C9             C      	ret			;;K7637
  0453                   C      coitn2:
  0453    1D             C      	dec	e
  0454    20 91          C      	jr	nz,coityp
  0456    15             C      	dec	d
  0457    20 8E          C      	jr	nz,coityp	;;verhindern unendl.Schleife
                         C      ;;				 fuer Tastaturen ohne Typcode
  0459    21 04C5        C       	ld	hl,kbdsnr	;;laufende SIO-Tastatur-Nr
  045C    7E             C      	ld	a,(hl)
  045D    34             C       	inc	(hl)		;;+1
                         C       if kbds2i+kbds2s+kbds2t
  045E    FE 02          C      	cp	2		;;war schon 2?
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-122


  0460    30 13          C      	jr	nc,coits2	;;ja
  0462    3E 52          C      	ld	a,kbds2i
  0464    32 04C3        C      	ld	(kbdsmi),a
  0467    3E 53          C      	ld	a,kbds2s
  0469    32 04C4        C      	ld	(kbdsms),a
  046C    3E 59          C      	ld	a,kbds2t
  046E    32 04C2        C      	ld	(kbdsmt),a
  0471    E1             C      	pop	hl		;;return-Adresse vergessen
