  D5B0    C8 01 18       C+     	db	kcurdw,1,'X' and 1fh
  D5B3    E0 01 02       C+     	db	pf0c,1,'B' and 1fh
  D5B6    E1 01 07       C+     	db	pf1c,1,'G' and 1fh
  D5B9    E2 01 19       C+     	db	pf2c,1,'Y' and 1fh
  D5BC    E3 01 14       C+     	db	pf3c,1,'T' and 1fh
  D5BF    E4 01 16       C+     	db	pf4c,1,'V' and 1fh
