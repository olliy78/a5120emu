                         C      ;-----------------------------
  D7DF    CD D763        C      crtdll:	call	crtcr		;Delete Line
  D7E2    E5             C      	push	hl
  D7E3    11 FF30        C      	ld	de,bsend2-bssp2+1	;Anfang letzte Zeile
  D7E4                   C      crtm47	equ	$-2
  D7E6    EB             C      	ex	de,hl
  D7E7    B7             C      	or	a
  D7E8    ED 52          C      	sbc	hl,de		;Laenge
  D7EA    28 08          C      	jr	z,crtdl1	;letzte Zeile
  D7EC    E3             C      	ex	(sp),hl
  D7ED    54             C      	ld	d,h
  D7EE    5D             C      	ld	e,l		;de auf Ziel (Zeilenanfang)
  D7EF    09             C      	add	hl,bc		;hl auf Quelle
  D7F0    C1             C      	pop	bc
  D7F1    D5             C      	push	de
                         C      	setbs
  D7F2    ED B0          C      	ldir			;eine Zeile nach oben schieben
                         C      	setram
  D7F4    21 FF30        C      crtdl1:	ld	hl,bsend2-bssp2+1
  D7F5                   C      crtm48	equ	$-2
  D7F7    54             C      	ld	d,h
  D7F8    5D             C      	ld	e,l
  D7F9    CD D7B4        C      	call	crtzlr		;letzte Zeile loeschen
  D7FC    E1             C      	pop	hl
  D7FD    C9             C      	ret
                         C      ;-----------------------------
                         C       ENDIF	;inslin
  D7FE    3E 02          C      crtesc:	ld	a,2		;escape flag setzen
  D800    32 D6AC        C      	ld	(desc),a
                         C      
                         C      	if	costu or adm3a
                         C      	endif
                         C      
  D803    C9             C      	ret
                         C      ;-----------------------------
  D804    3E 80          C      crtcrt:	ld	a,80h		;cursor an
  D806    18 01          C      	jr	crto14
                         C      ;-----------------------------
  D808    AF             C      crtcof:	xor	a		;cursor aus
  D809    32 D680        C      crto14:	ld	(dcurs),a
  D80C    C9             C      	ret
                         C      ;-----------------------------
                         C      ; Realisierung 07h
                         C      ; Achtung! Diese Routine wird aus Interruptroutine aufgerufen!
  D80D    CD D810        C      crtclk:	call	crtcl1		;Fehlerlampe umschalten
                         C      
  D810    06 19          C      crtcl1:	ld	b,25		;0.25 sec warten
  D812    CD E8E4        C      	call	wait10
                         C      				;Fehlerlampe wieder zurueck
                         C      ; Fehlerlampe umschalten
                         C      ; Reg. A, HL bleiben erhalten
  D815    F5             C      swilmp:	push	af
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-41


  D816    E5             C      	push	hl
  D817    21 0040        C      	ld	hl,lampbf
  D81A    7E             C      	ld	a,(hl)
  D81B    EE 40          C      	xor	1 shl lmperr
  D81D    77             C      	ld	(hl),a
  D81E    CD D4CA        C      	call	lampen
  D821    E1             C      	pop	hl
  D822    F1             C      	pop	af
  D823    C9             C      	ret
                         C      ;-----------------------------
                         C       IF umlaut
                         C      ; Umschalten auf 2. Zeichensatz
  D824    E5             C      crt2zs:	push	hl
  D825    21 D23D        C      	ld	hl,synflg
  D828    CB D6          C      	set	umlflg,(hl)
  D82A    E1             C      	pop	hl
  D82B    C9             C      	ret
                         C      ; Umschalten auf 1. Zeichensatz
  D82C    E5             C      crt1zs:	push	hl
  D82D    21 D23D        C      	ld	hl,synflg
  D830    CB 96          C      	res	umlflg,(hl)
  D832    E1             C      	pop	hl
  D833    C9             C      	ret
                         C       ENDIF
                         C      ;-----------------------------
                         C      
                         C       IF stpvar
                         C       IF chdvar
                         C      ;Hardcopy Bildschirm -> LST
  D834    E5             C      crthrd:	push	hl
  D835    21 FC00        C      	ld	hl,bsanf1
  D836                   C      crtm22	equ	$-2
  D838    0E 11          C      	ld	c,bszl1+1
  D839                   C      crtm23	equ	$-1
  D83A    18 30          C      	jr	crthd3		;zu Beginn neue Zeile
  D83C    06 40          C      crthd1:	ld	b,bssp1
  D83D                   C      crtm24	equ	$-1
  D83E    C5             C      crthd2:	push	bc
                         C      	setbs
  D83F    7E             C      	ld	a,(hl)
                         C      	setram
  D840    23             C      	inc	hl
  D841    E5             C      	push	hl
  D842    E6 7F          C      	and	7fh
  D844    FE 20          C      	cp	20h		;BS-Steuerzeichen?
  D846    30 1C          C      	jr	nc,crthd4	;nein
                         C       IF umlaut
  D848    21 D23D        C      	ld	hl,synflg	;Schalterbyte 
  D84B    CB 56          C      	bit	umlflg,(hl)	;Umlaute anzeigen ?
  D84D    28 13          C      	jr	z,cnuml1	;nein!
  D84F    21 D8A5        C      	ld	hl,umltb2	;Umlautcodierung ?
  D852    01 000B        C      	ld	bc,umllen
  D855    ED B1          C      	cpir
  D857    20 09          C      	jr	nz,cnuml1	;nein !
  D859    01 000C        C      	ld	bc,umllen+1	;sonst rueckkodieren
  D85C    B7             C      	or	a
  D85D    ED 42          C      	sbc	hl,bc
  D85F    7E             C      	ld	a,(hl)		;rueckkodiertes Zeichen
  D860    18 02          C      	jr	crthd4
  D862                   C      cnuml1:
                         C       ENDIF
  D862    3E 5E          C      	ld	a,'^'		;sonst Sonderzeichen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-42


  D864    4F             C      crthd4:	ld	c,a
  D865    CD D20F        C      	call	BIOS0F		;LIST
  D868    E1             C      	pop	hl
  D869    C1             C      	pop	bc
  D86A    10 D2          C      	djnz	crthd2		;bis Zeilenende
  D86C    C5             C      crthd3:	push	bc
  D86D    E5             C      	push	hl
  D86E    0E 0D          C      	ld	c,0dh
  D870    CD D20F        C      	call	BIOS0F
  D873    0E 0A          C      	ld	c,0ah
  D875    CD D20F        C      	call	BIOS0F
  D878    E1             C      	pop	hl
  D879    C1             C      	pop	bc
  D87A    0D             C      	dec	c		;Bildschirmende?
  D87B    20 BF          C      	jr	nz,crthd1	;nein
  D87D    E1             C      	pop	hl
  D87E    C9             C      	ret
                         C       ENDIF
                         C       ENDIF	;stpvar
                         C      
                         C       IF umlaut
                         C      ; Umlaute umcodieren fuer Anzeige auf BAB1/BAB2 (Sonder-PROM)
  D87F                   C      crtuml:	
  D87F    E5             C      	push 	hl		;retten wegen evtl. ext. Verwendung
  D880    C5             C      	push 	bc
  D881    21 D23D        C      	ld	hl,synflg	;Schalterbyte
  D884    CB 56          C      	bit	umlflg,(hl)	;Umlaute anzeigen ?
  D886    28 0F          C      	jr	z,umlcn1	;nein !
  D888    21 D89A        C      	ld 	hl,umltb1
  D88B    01 000B        C      	ld 	bc,umllen
  D88E    ED B1          C      	cpir			;in Tabelle suchen
  D890    20 05          C      	jr	nz,umlcn1	;nicht gefunden
  D892    01 000A        C      	ld	bc,umllen-1	;wegen cpir
  D895    09             C      	add 	hl,bc
  D896    7E             C      	ld	a,(hl)		;umcodieren
  D897    C1             C      umlcn1:	pop	bc
  D898    E1             C      	pop	hl
  D899    C9             C      	ret
                         C      
                         C      ;------------------------------
                         C      ; Umcodiertabelle fuer Umlautumcodierung
                         C       IF zsuml ;auf freie 7023/24-Steuerzeichen (IH Mittweida, Koll. Geiler)
                         C      ;		Ae  Oe  Ue  ae  oe  ue  sz  **2 **3 Par my
  D89A    5B 5C 5D 7B    C      umltb1:db	5bh,5ch,5dh,7bh,7ch,7dh,7eh,3ch,3eh,40h,5eh
  D89E    7C 7D 7E 3C    C      
  D8A2    3E 40 5E       C      
  D8A5    15 16 17 1C    C      umltb2:db	15h,16h,17h,1ch,1dh,1eh,1fh,10h,12h,14h,18h
  D8A9    1D 1E 1F 10    C      
  D8AD    12 14 18       C      
  000B                   C      umllen	equ	umltb2-umltb1
                         C       ENDIF
                         C       IF zsibm ;auf 00..1f erweiterter IBM-Zeichensatz
                         C       ENDIF	
                         C       ENDIF	
                         C      
                         C      ; Arbeitszellen
                         C      ;==============
                         C      
  D8B0    00             C      crtcch:	db	0		;direkt auszugebendes BS-Zeichen
                         C       if crt eq dsy5
                         C       endif
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-43


                         C      ; Tabelle der Sonderzeichen, SCP kompatibel!
                         C      ;==========================================
                         C      
  D8B1                   C      dszta:	
  D8B1    00             C      	db	00h	;nop
  D8B2    01             C      	db	01h	;home
  D8B3    02             C      	db	02h	;(auch 82h) cursor an
  D8B4    03             C      	db	03h	;(auch 83h) cursor aus
  D8B5    04             C      	db	04h	;(auch 84h) normal, nicht inv.
  D8B6    05             C      	db	05h	;(auch 85h) normal,       inv.
  D8B7    06             C      	db	06h	;(auch 86h) hell  , nicht inv.
                         C      ;			 (nur  87h) hell  ,       inv.
  D8B8    07             C      	db	07h	;bell (akustisches zeichen)
  D8B9    08             C      	db	08h	;cursor zurueck
  D8BA    0A             C      	db	0ah	;LF
  D8BB    0C             C      	db	0ch	;bs loeschen, cursor links oben
  D8BC    0D             C      	db	0dh	;CR
                         C       if umlaut
  D8BD    0E             C      	db	0eh	;umschalten auf 2. Zeichensatz
  D8BE    0F             C      	db	0fh	;umschalten auf 1. Zeichensatz
                         C       endif
  D8BF    14             C      	db	14h	;rest bs loeschen
  D8C0    15             C      	db	15h	;cursor vorwaerts
  D8C1    16             C      	db	16h	;rest der zeile loeschen
                         C       IF inslin
  D8C2    17             C      	db	17h	;Insert Line
                         C       ENDIF
  D8C3    18             C      	db	18h	;zeile loeschen, cursor an zeilanf.
                         C       IF inslin
  D8C4    19             C      	db	19h	;Delete Line
                         C       ENDIF
  D8C5    1A             C      	db	1ah	;eine zeile hoch
                         C      			;bei ADM3a wie 0ch
  D8C6    1B             C      	db	1bh	;escape
                         C      ;		1b zeile+80h spalte+80h		Kursor posit. SCP
                         C      ;		1b zeile+00h spalte+00h		geht auch bei CP/A
                         C      ;		1b '='/'Y' zeile+20h spalte+20h	Kursor posit. bei ADM3A
                         C      ;		1b 5e xx	Feldattribut setzen (SCP1715 fuer 8275-Contr.)
                         C      ;			mit xx= 01urggbh
                         C      ;				  u		unterstreichen,
                         C      ;				   r		invers,
                         C      ;				    gg		Zeichengenerator-Umschaltung,
                         C      ;				      b		blinken,
                         C      ;				       h	heller 
                         C      ;		1b 5f xx	Spezialzeichen setzen (SCP1715 fuer 8275)
                         C      ;			mit xx= 01ssssbh
                         C      ;				  ssss		Zeichencode (1100 Sonderfkt)
                         C      ;				      b		blinken des Sonderzeichens
                         C      ;				       h	heller des Sonderzeichens
                         C      	if	adm3a
                         C      	endif
                         C       if crt eq dsy5
                         C       endif
  D8C7    7F             C      	db	7fh	;delete
  D8C8    87             C      	db	87h	;(nicht 07h) hell  ,      inv.
  0018                   C       dsztal	equ	$-dszta	;Tabellenlaenge
                         C      
                         C      ; Reaktionsroutinen fuer Sonderzeichen
                         C      
  D8C9    D711           C      	dw	crtnop	;00
  D8CB    D7A0           C      	dw	crthom	;01
  D8CD    D804           C      	dw	crtcrt	;02/82
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-44


  D8CF    D808           C      	dw	crtcof	;03/83
  D8D1    D6EA           C      	dw	crto84	;04/84
  D8D3    D6EA           C      	dw	crto85	;05/85
  D8D5    D6EA           C      	dw	crto86	;06/86
  D8D7    D80D           C      	dw	crtclk	;07
  D8D9    D782           C      	dw	crtcl	;08
  D8DB    D774           C      	dw	crtlf	;0A
  D8DD    D78B           C      	dw	crtbsl	;0C
  D8DF    D763           C      	dw	crtcr	;0D
                         C       if umlaut
  D8E1    D824           C      	dw	crt2zs	;0E
  D8E3    D82C           C      	dw	crt1zs	;0F
                         C       endif
  D8E5    D78E           C      	dw	crtbsr	;14
  D8E7    D6C7           C      	dw	crtcur	;15
  D8E9    D7B4           C      	dw	crtzlr	;16
                         C       IF inslin
  D8EB    D7C3           C      	dw	crtinl	;17
                         C       ENDIF
  D8ED    D7B0           C      	dw	crtzl	;18
                         C       IF inslin
