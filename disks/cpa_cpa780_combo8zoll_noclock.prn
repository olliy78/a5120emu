                         C       ENDIF
                         C       IF (cpu eq k2526) or (cpu eq c1715)
  E909    CD E720        C      	call	tim5of		;totlegen aller Interruptquellen
                         C        IF cpu eq k2526
  E90C    CD E72B        C      	call	tim1of
                         C        ENDIF
                         C        IF cpu eq c1715
                         C        ENDIF
  E90F    F3             C      	di
                         C        IF cpu eq k2526
  E910    3E F7          C      	ld	a,0f7h
  E912    D3 0A          C      	out	(0ah),a		;Lade-ROM zuschalten
                         C        ENDIF
                         C        IF cpu eq c1715
                         C        ENDIF
  E914    C7             C      	rst	0		;RESET
                         C       ENDIF
