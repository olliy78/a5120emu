  E78A    30 01          C      	jr	nc,t1nmo2	;ja
  E78C    AF             C      	xor	a
  E78D    32 E476        C      t1nmo2:	ld	(fl.zto),a
  E790    CC E490        C      	call	z,headup	;Ueberw.zeit abgelaufen -> Motor aus
  E793                   C      t1nmo1:
