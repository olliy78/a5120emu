  D8F1    D7A4           C      	dw	crtcup	;1A
  D8F3    D7FE           C      	dw	crtesc	;1B
                         C      	if	adm3a
                         C      	endif
                         C       if crt eq dsy5
                         C       endif
  D8F5    D781           C      	dw	crtdel	;7F
  D8F7    D6EA           C      	dw	crto87	;87
  D8F9                   C      dswe 	equ	$	;tabellenende
                         C      
                                
                                 IF chdvar
                         C      	include BIOSCHD
                         C      ;**************************************************************
                         C      ;	zeichenorientierte Geraete
                         C      ; Aenderungen:
                         C      ; Fehlerkorrektur UC1:-Treiber
                         C      ; - getrennter Status Sender/Empf.
                         C      ; - Verwaltung des DTR-Bits auf Empf.seite
                         C      ; - UC1: arbeitet empfangsseitig interruptgetrieben
                         C      ; - Einfuehrung eines UC1:-Puffers als Verlaengerung des SIO-Puffers
                         C      ; - bei E/A-Fehler (Drucker nicht bereit) warten auf Bestaetigung,
                         C      ;   moegliche Reaktion ^C, I(gnore device) oder R(etry)
                         C      ; 29.09.88
                         C      ; - beide Bahnen parallel wird zurueckgesetzt, wenn linke oder rechte
                         C      ;   Bahn ausgewaehlt wird
                         C      ; 04.04.89
                         C      ; - zeichenweise Geraete werden bei Warmstart nicht neu initialisiert,
                         C      ;   nur beim Betaetigen der Taste "Synchronisieren"
                         C      ; 06.07.89
                         C      ; - bei DTR mit/ohne Warten auf Senderegister leer
                         C      ; 15.09.89
                         C      ; - wegen Drucker 1152.257 TimeOut auf nicht-Bereitschaft von 30 s auf 2 min
                         C      ;**************************************************************
                         C      
                         C       if1
                         C       endif ; if1
                         C      
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-45


                         C      ; Ausgabe
                         C      ;~~~~~~~~
                         C      ; TTY:
                         C      ;=====
                         C       if	iobtty
  D8F9    DD 21 D997     C      ttyo:	ld	ix,lsttty
  D8FD    18 0C          C      	jr	lsto
                         C       endif
                         C      
                         C      ; LPT:
                         C      ;=====
                         C       if	ioblpt
  D8FF    DD 21 D9B4     C      lpto:	ld	ix,lstlpt
  D903    18 06          C      	jr	lsto
                         C       endif
                         C      
                         C      ; UC1:
                         C      ;=====
                         C       if	iobuc1
  D905    DD 21 D9D1     C      uc1o:	ld	ix,lstuc1
  D909    18 00          C      	jr	lstoch		;nicht 2 Bahn Zeichen interpr.
                         C       endif
                         C      
  D90B                   C      lsto:
  D90B                   C      listi:	;interner Aufruf lsto mit gestelltem IX
                         C       IF l2bahn
                         C       ENDIF
                         C      
                         C      ; Einzelzeichenausgabe Reg. C
                         C      ;-----------------------------
  D90B                   C      lstoch:
  D90B    DD CB 00 4E    C      	bit	1,(ix+ltpst)	;senderseitig blockiert?
  D90F    C0             C      	ret	nz		;ja, Ausgabe ignorieren
  D910    C5             C      	push	bc		;retten Zeichen in C
  D911    0E 78          C      loutws:	ld	c,120		;max. Wartezeit in Sek. auf ready
  D913    06 64          C      loutw1:	ld	b,100		;100*10ms warten
  D915    C5             C      loutwt:	push	bc
  D916    CD D97B        C      	CALL	lststi		;Status holen
  D919    20 16          C      	jr	nz,loutwf	;ist frei
  D91B    06 01          C      	ld	b,1
  D91D    CD E8E4        C      	call	wait10		;Warten 10 ms
  D920    C1             C      	pop	bc
  D921    10 F2          C      	djnz	loutwt		;weiter warten?
  D923    0D             C      	dec	c		;weitere Sekunde warten?
  D924    20 ED          C      	jr	nz,loutw1	;ja
                         C       IF errvar
  D926    CD D93B        C      	call	spioer		;Fehlermeldung
  D929    20 E6          C      	jr	nz,loutws	;Wiederholung
                         C       ENDIF
  D92B    C1             C      	pop	bc
  D92C    DD CB 00 CE    C      	set	1,(ix+ltpst)	;Sender blockiert
  D930    C9             C      	ret			;folgende Ausgaben werden ignor.
  D931    C1             C      loutwf:	pop	bc
  D932    C1             C      	pop	bc
  D933    79             C      	ld	a,c		;auszugebendes Zeichen nach A
  D934    DD 6E 04       C      	ld	l,(ix+ltpo)
  D937    DD 66 05       C      	ld	h,(ix+ltpo+1)
  D93A    E9             C      	jp	(hl)
                         C      
                         C       IF errvar
  D93B    DD 7E 02       C      spioer:	ld	a,(ix+ltpsd)	;Daten-Port-Adresse
  D93E    11 D95C        C      	ld	de,louttp
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-46


  D941    CD E8F3        C      	call	mrecoa		;in Text
  D944    21 D95A        C      	ld	hl,loutto
  D947    CD E8D8        C      	call	biosms
  D94A    CD D3AE        C      	call	kbdbcl
  D94D    CD E7A3        C      	call	conin
  D950    CB AF          C      	res	5,a
  D952    FE 03          C      	cp	'C' and 1fh	;^C ?
  D954    CA 0000        C      	jp	z,0		;ja, Abbruch
  D957    FE 49          C      	cp	'I'		;ret z: 'I'; ret nz: 'R'
  D959    C9             C      	ret
                         C      
  D95A                   C      loutto:
                         C       IF cpastz
                         C       ELSE
  D95A    0D 0A          C      	db	0dh,0ah
                         C       ENDIF
  D95C    58 58 68 20    C      louttp:	db	'XXh Fehler ^C/I/R'
  D960    46 65 68 6C    C      
  D964    65 72 20 5E    C      
  D968    43 2F 49 2F    C      
  D96C    52             C      
                         C       IF cpastz
                         C       ELSE
  D96D    07 00          C      	db	07h,0
                         C       ENDIF
                         C       ENDIF	;errvar
                         C      
                         C      ;-----------------------
                         C      
                         C      
                         C      ; Status
                         C      ;-------
                         C      ; o A=0, ret z	: Ausgabe besetzt
                         C      ; o A=ff,ret nz	: Ausgabe frei
                         C      
                         C      ; TTY:
                         C      ;=====
                         C       if	iobtty
  D96F    DD 21 D997     C      ttyst:	ld	ix,lsttty
  D973    18 06          C      	jr	lstst
                         C       endif
                         C      
                         C      ; LPT
                         C      ;====
                         C       if	ioblpt
  D975    DD 21 D9B4     C      lptst:	ld	ix,lstlpt
  D979    18 00          C      	jr	lstst
                         C       endif
                         C      
                         C       if iobuc1
                         C       endif
                         C      
  D97B                   C      lstst:
  D97B                   C      lststi:	;interner Aufruf Sender-Status mit gestelltem IX
                         C      ; ret nz, A=FF fuer frei
                         C      ; ret z , A=00 fuer besetzt
                         C      
  D97B    DD 6E 08       C      	ld	l,(ix+ltps)
  D97E    DD 66 09       C      	ld	h,(ix+ltps+1)
  D981    E9             C      	jp	(hl)
                         C      
                         C      ;-----------------------------
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-47


                         C      
                         C      ; Zeichenempfang
                         C      ;---------------
                         C      
  D349                   C      ttyi	equ	dumi
  D349                   C      lpti	equ	dumi
                         C       if iobuc1
                         C       endif
                         C      
                         C      ;-------------------------------
                         C      
                         C      ; Alle zeichenweisen Geraete neu synchronisieren
                         C      ;-----------------------------------------------
  D982                   C      lsynch:	
  D982    AF             C      	xor	a
                         C      	if	iobtty
  D983    32 D997        C      	ld	(lsttty+ltpst),a
                         C      	endif
                         C      	if	ioblpt
  D986    32 D9B4        C      	ld	(lstlpt+ltpst),a
                         C      	endif
                         C      	if	iobuc1
  D989    32 D9D1        C      	ld	(lstuc1+ltpst),a
                         C      	endif
  D98C    C9             C      	ret
                         C      
                         C      ; Portprogrammierung
                         C      ;===================
                         C      ; i HL	^Steuertabelle, Laenge+1, Port, Bytes,...,1
  D98D                   C      portpr:
  D98D    46             C      portpz:	ld	b,(hl)		;Stringlaenge +1
  D98E    23             C      	inc	hl
  D98F    05             C      	dec	b		;Ende?
  D990    C8             C      	ret	z		;ja
  D991    4E             C      	ld	c,(hl)		;Port
  D992    23             C      	inc	hl
  D993    ED B3          C      	otir
  D995    18 F6          C      	jr	portpz
                         C      
                         C      ;Steuertabellen fuer zeichenweise arbeitende Geraete
                         C      ;===================================================
                         C      
                         C      ;Struktur:
                         C      ; fester Teil
  0000                   C      ltpst	equ	0	;Status
                         C      			;Bit  7-4 Empf.,3-0 Sender  Bedeutung, wenn =1
                         C      			;	4	0 Empfseite init./ Senderseite init.
                         C      			;	5	1      -	 / Sender blockiert
                         C      			;	7	3 Sender gestoppt/ Sender hat frei gem.
  0001                   C      ltpdc	equ	1	;DC1/DC3: zuletzt empf. Zeichen (i.a. DCx)
                         C      			;DTR:	Statusmaske (Bit 5 Kanal A, Bit 3 Kanal B),
                         C      			;	Bit 7 =1 wenn kein Wait auf Senderegister leer
  0002                   C      ltpsd	equ	2	;Portadr. Daten
  0003                   C      ltpsc	equ	3	;Portadr. Kommando/Status (noch mal in ltpini!)
                         C      
  0004                   C      ltpo	equ	4	;Adresse der Senderoutine
  0006                   C      ltpi	equ	6	;Adresse der Empfangsroutine
  0008                   C      ltps	equ	8	;Adresse der Empfangsstatus-Routine
                         C      
                         C      ; Der folgende Teil existiert nur fuer SIO-Treiber
  000A                   C      ltpw5	equ	10	;WR5:
                         C      			;DTR/RTS Bit 7,1: 11 DTR; 00 DC1/DC3
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-48


                         C      			;Bitanzahl/Byte Bit 6,5: 00 5;01 7;10 6;11 8
                         C      			;Bit 3 = 1 (Senderfreigabe)
                         C      			;Bit 0,2,4 = 0
                         C      ; Port-Initialisierung (fuer alle Treiber)
  000B                   C      ltpini	equ	11	;jeweils Byteanzahl+1; Port; Bytefolge
                         C      			;variabel lang
                         C      
                         C      			;fuer SIO-Treiber einige Erlaeuterungen:
  000C                   C      ltpcs	equ	12	;Port CTC-Sendetakt
                         C      			;Vorteiler (37h Vorteiler 256, 17h Vorteiler 16)
                         C      			;Baudrate (1=9600,2=4800,..64=150,96=100,128=75)
                         C      			;evtl. nochmal fuer Port CTC-Empf.takt
                         C      			;WR4:
                         C      			;Paritaet  in Bit 1,0: 00 ohne, 01 unger., 11 ger.
                         C      			;Stop-Bits in Bit 3,2: 01 1; 10 1,5; 11 2
                         C      			;Reserve   in Bit 5,4: 00 immer (nur fuer Synchr.mode)
                         C      			;Takt      in Bit 7,6: 00 *1, 01 *16, 10 *32, 11 *64
                         C      			;WR1:
                         C      			;Interrvektormod. in Bit 2: 0=keine Modifizierung
                         C      			;in Kanal B!! setzen
                         C      			;Empf.interr.mode Bit4,3: 00 kein Interrupt
                         C      			;			  01 bei erstem Zeichen
                         C      			;			  10 bei jedem mit Mod.
                         C      			;			  11 bei jedem ohne Mod.
                         C      			;WR3:
                         C      			;Empf.freigabe in Bit 0: 0=Empf. gesperrt; 1=Empf. frei
                         C      			;Bit 1-5:00000
                         C      			;Bitanzahl/Byte Bit 7,6:00 5;01 7;10 6;11 8
                         C      
                                 IF iobtty
  0713                          @lt	aset	iobtty
  0050                          @ld	aset	ttydat
  0051                          @ls	aset	ttysta
  000C                          @lcs	aset	ttycts
  000C                          @lcr	aset	ttyctr
  0000                          @wr1	aset	00000000b ;WR1: kein Interruptbetrieb
  0000                          @wsre	aset	00000000b ;Bit 7=0: Warten auf Senderegister leer
  D997                   C      lsttty: include BIOSCPB
                         C      ;; 07.04.89
                         C      ;; 06.07.89
                         C      ;; - Einfuehrung Bit 7 in Statusmaske DTR - =1 kein Warten Senderegister leer
  D997    00             C      	db	00H	;Status
                         C       IF ((@lt mod 10) eq 1) or ((@lt mod 10) eq 3)
                         C        IF (@lt mod 10) eq 1; DTR, Treiber 1
  0008                   C      @l	aset	@wsre xor 08h	;Statusmaske DTR-Abfrage ueber DCD im Kanal B
                         C        ENDIF
                         C        IF (@lt mod 10) eq 3; DTR, Treiber 3
                         C        ENDIF
  D998    08             C      	db	@l	;DTR-Abfrage-Maske, Bit 7 Wait_Senderegister_leer-Flag
                         C       ENDIF
  D999    50             C      	db	@ld	;Port fuer Daten
  D99A    51             C      	DB	@ls	;Port fuer Status/Kommando
                         C       IF (@lt mod 10) lt 5	;;SIO ###########################################
                         C       if ((@lt mod 10) eq 0) or ((@lt mod 10) eq 1) or ((@lt mod 10) eq 3)
  D99B    D9EE           C      	dw	cdsioo	;;Senden
  D99D    D349           C      	dw	cdsioi	;;Empfang
  D99F    D9F4           C      	dw	cdsios	;;Empf.Status
                         C       endif
                         C       if (@lt mod 10) eq 2
                         C       endif
  0008                   C      @l	aset	00001000b	;;DC1/3, 5 Bit
                         C       if ((@lt mod 10) eq 1) or ((@lt mod 10) eq 3)
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-49


  008A                   C      @l	aset	@l xor 10000010b	;;DTR
                         C       endif
                         C       if ((@lt mod 1000)/100) eq 6
                         C       endif
                         C       if ((@lt mod 1000)/100) eq 7
                         C       endif
                         C       if ((@lt mod 1000)/100) eq 8
  00EA                   C      @l	aset	@l xor 01100000b
                         C       endif
  D9A1    EA             C      	db	@l	;WR5
                         C      			;**Portinitialisierung**
                         C      ; CTC Sendetakt
  D9A2    03             C       	db	2+1
  D9A3    0C             C      	db	@lcs		;CTC Senden
                         C       IF (cpu eq c1715) and (@ld eq kbdsci)	;;PC1715, SIO durch Tastatur init.!!
                         C       ELSE
  D9A4    17             C      	db	17h		;Vorteiler 16
                         C       ENDIF
  0001                   C      @l	aset	1 shl (((@lt mod 100)/10)-1)
                         C        if ((@lt mod 100)/10) eq 8
                         C        endif
                         C        if ((@lt mod 100)/10) eq 9
                         C        endif
  D9A5    01             C      	db	@l		;Baudrate senden
                         C       IF (cpu eq c1715) and (@ld eq kbdsci)	;;PC1715, SIO durch Tastatur init.!!
                         C       ELSE
                         C      ;;; zum nachtraeglichen Patchen immer CTC Empf. generieren
                         C      ;;; auch wenn '@cls eq @clr'
                         C      ; CTC Empfangstakt
  D9A6    03             C      	db	2+1
  D9A7    0C             C      	db	@lcr		;CTC Empf.
  D9A8    17             C      	db	17h		;Vorteiler 16
  D9A9    01             C      	db	@l		;Baudrate empf.
                         C      ; SIO-Initialisierung
  D9AA    08             C      	db	7+1
  D9AB    51             C      	db	@ls		;SIO-Komm.
  D9AC    18             C      	db	18h		;WR0
  0044                   C      @l	aset	01000100b	;;Takt*16, ohne P., 1 Stbit, DTR
                         C       if (@lt mod 10) eq 2
                         C       endif
                         C        if @lt ge 10000
                         C        endif
                         C        if @lt ge 20000
                         C        endif
                         C        if ((@lt mod 10000)/1000) eq 2
                         C        endif
                         C        if ((@lt mod 10000)/1000) eq 3
                         C        endif
  D9AD    04 44          C      	db	4,@l		;WR4
  D9AF    01 00          C      	db	1,@wr1		;WR1
  0001                   C      @l	aset	00000001b	;;5 Bit, Empf.freigabe
                         C        if ((@lt mod 1000)/100) eq 6
                         C        endif
                         C        if ((@lt mod 1000)/100) eq 7
                         C        endif
                         C        if ((@lt mod 1000)/100) eq 8
  00C1                   C      @l	aset	@l xor 11000000b
                         C        endif
  D9B1    03 C1          C      	db	3,@l		;WR3
                         C        ENDIF	;;(cpu ne c1715) or (@ld ne kbdsci)
  D9B3    01             C      	db	1	;**Ende SIO-Initialisierung** 
                         C       ENDIF
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-50


                         C      
                                 ENDIF
                                
