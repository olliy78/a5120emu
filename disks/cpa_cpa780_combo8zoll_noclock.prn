  D40F    C5             C      kbdwa:	push	bc
  D410    06 01          C      	ld	b,1		;0,01 sec warten
  D412    CD E8E4        C      	call	wait10
  D415    C1             C      	pop	bc
  D416    CD D44D        C      kbdwst:	call	kbdst1		;taste neu gedrueckt?
  D419    20 13          C      	jr	nz,kbdwb	;ja, abholen ueber kbdst
  D41B    DB 06          C      	in	a,(kbdpci)	;taste noch gedrueckt?
  D41D    B7             C      	or	a		;(funktioniert nur bei K760X!)
  D41E    28 0E          C      	jr	z,kbdwb		;nein; warten
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-26


  D420    10 ED          C      	djnz	kbdwa		;abwarten, wie lange
                         C      
