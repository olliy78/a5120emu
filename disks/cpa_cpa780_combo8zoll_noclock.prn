                         C      
  04D0                   C      kmodif:
  04D0    11 08D9        C      	ld	de,kbdtyp
  04D3    01 0002        C      	ld	bc,2
  04D6    ED B0          C      	ldir
  04D8    06 06          C      	ld	b,kmodl		;;Anzahl der Adressen
  04DA    C5             C      kmodi1:	push	bc
  04DB    5E             C      	ld	e,(hl)
  04DC    23             C      	inc	hl
  04DD    56             C      	ld	d,(hl)
  04DE    23             C      	inc	hl
  04DF    E5             C      	push	hl
  04E0    21 04E6        C      	ld	hl,kmodi2
  04E3    E5             C      	push	hl		;;ret-Adr.
  04E4    D5             C      	push	de		;;Modif.routine
  04E5    C9             C      coidum:	ret			;;abarbeiten
  04E6    E1             C      kmodi2:	pop	hl
  04E7    C1             C      	pop	bc
  04E8    10 F0          C      	djnz	kmodi1
                         C      ;; Ende Kaltstart-Modifizierungen
  04EA    C3 07CD        C      	jp	coinie
