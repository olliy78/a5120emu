                         C      
  D401    CD D369        C      kbdwin:	call	kbdst		;Taste im Puffer?
  D404    20 32          C      	jr	nz,kbdinn	;ja
  D406    21 D40A        C      	ld	hl,kbdwt	;wartefaktor
  D409    06 64          C      	ld	b,100		;fuer dauerfunktion
  D40A                   C      kbdwt	equ	$-1
  D40B    36 0A          C      	ld	(hl),10		;auf 10*0,01sec fuer
                         C      				;gleiche taste
