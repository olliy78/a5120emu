  DF35    ED 5B E1A9     C      	ld	de,(ddma)	;Nutzer-DMA
  DF39    3A E1A2        C      	ld	a,(dflg)
  DF3C    CB 57          C      	bit	dfwr,a		;Schreiben?
  DF3E    28 09          C      	jr	z,dsmove	;nein
  DF40    3A E199        C      	ld	a,(dbflg)
  DF43    CB D7          C      	set	dfbwr,a		;anzeigen Puffer beschrieben
  DF45    32 E199        C      	ld	(dbflg),a
  DF48    EB             C      	ex	de,hl
