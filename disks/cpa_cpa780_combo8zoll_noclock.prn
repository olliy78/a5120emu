                         C      
                         C      ; 5ms/25ms an
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-100


  E719                   C      tim5on:
                         C       IF cpu eq c1715
                         C       ENDIF
  E719    3E B1          C      	ld	a,10110001b
                         C      	;int./zeitg./vort.256/pos.flanke/naechst.zykl./keine zk/weiter/1
  E71B    F3             C      tim5ot:	DI
  E71C    D3 0E          C      	out	(sysctc+tim5ct),a
  E71E    FB             C      	EI
  E71F    C9             C      ret:	ret
                         C      
                         C      ; 5ms/25ms aus
  E720                   C      tim5of:
                         C       IF cpu eq c1715
                         C       ENDIF
  E720    3E 31          C      	ld	a,00110001b	;kein int./...
  E722    18 F7          C      	jr	tim5ot
                         C      
                         C       IF cpu eq c1715
                         C       ELSE
                         C      ; 1s an
  E724    3E D1          C      tim1on:	ld	a,11010001b
                         C      	;int./zaehler//pos.flanke//keine zk/weiter/1
  E726    F3             C      tim1ot:	DI
  E727    D3 0F          C      	out	(sysctc+tim1ct),a
  E729    FB             C      	EI
  E72A    C9             C      	ret
                         C      ; 1s aus
  E72B    3E 51          C      tim1of:	ld	a,01010001b	;kein int./...
  E72D    18 F7          C      	jr	tim1ot
                         C       ENDIF
                         C      
                         C      ; Interr.routine 5ms/25ms
  E72F                   C      tim5it:
                         C       IF stpvar or monitor
  E72F    22 E737        C      	ld	(t5ihl),hl	;retten hl
  E732    21 E82B        C      	ld	hl,chksp	;Test auf haengende Spezialfktnen
  E735    E5             C      	push	hl		;nach const-Aufruf in CTC-Interrupt
  E736    21 0000        C      	ld	hl,0		;wiederherstellen hl
  E737                   C      t5ihl	equ	$-2
                         C       ENDIF
  E739    ED 73 E758     C      	ld	(intsp),sp
  E73D    31 F217        C      	ld	sp,intstk
  E740    F5             C      	push	af
  E741    E5             C      	push	hl
  E742    D5             C      	push	de
  E743    C5             C      	push	bc
  E744    2A 0041        C      	ld	hl,(tim5cn)
  E747    23             C      	inc	hl
  E748    22 0041        C      	ld	(tim5cn),hl
                         C       IF cpu eq c1715
                         C       ENDIF
  E74B    3A D23D        C      	ld	a,(synflg)
  E74E    CB 77          C      	bit	stzaus,a	;Zugriff zur Statuszeile erlaubt?
  E750    CC D371        C      intkbd:	call	z,kbdsti	;ja, Tastatur abfragen und puffern
                         C      				;auf 'ld hl,.. .' waehrend Lampen-Ausgabe
  E753                   C      intrbc:				;allg. Interr.-ausgang
  E753    C1             C      	pop	bc
  E754    D1             C      	pop	de
  E755                   C      intrhl:				;allg. Interr.-ausgang
  E755    E1             C      	pop	hl
  E756                   C      intraf:				;allg. Interr.-ausgang
  E756    F1             C      	pop	af
