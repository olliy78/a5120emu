                                  IF cdtdc1 or cdtdtr
                         C      	include BIOSCSIO
                         C      ;===================================================================
                         C      ; SIO-Treiber, DTR- und DC1/DC3-Protokoll
                         C      ;===================================================================
                         C      ;
                         C      ; Aenderungen:
                         C      ; - Statusabfrage jedesmal, auch wenn zuvor frei gemeldet
                         C      ; - Pufferueberlauf bei UC1-Puffer kontrolliert
                         C      ; - bei DC1/DC3 nach Initialisierung 7fh an Drucker und max. 30 sec auf
                         C      ;  Antwort gewartet (sonst Fehler am SD1157, wenn zu frueh gesendet wird)
                         C      ; 29.6.88:
                         C      ; - bei DC1/3 Protokoll wird neu initialisiert, wenn DC4 vom Drucker kommt
                         C      ;  (Probleme bei K6314)
                         C      ; 20.09.88
                         C      ; - Neben DTR-Statusabfrage ueber Kanal B, Bit 3 (Treiber 1, Standard)
                         C      ;  auch DTR-Statusabfrage ueber Kanal A, Bit 5 (Treiber 3) unterstuetzt
                         C      ; 23.03.89
                         C      ; - CTS-Zusammenspiel bei K6311 u.ae. funktioniert nur, wenn bis zum
                         C      ;   Verlassen aller Bits aus dem Sender gewartet wird und nicht nur auf
                         C      ;   das Freiwerden des Sendepuffers - sonst Zeichenverlust!
                         C      ; - wenn UC1 am Kanal A wird WR1 Bit2 und WR2 im Kanal B gesetzt
                         C       IF cpu eq c1715
                         C       ENDIF
                         C      ; 04.04.89
                         C      ; - nach Drucker-Init 'set 0,(ix+ltpst)' statt 'ld (ix+ltpst),11h'
                         C      ; 06.07.89
                         C      ; - wegen K6314-Problemen wird nach Initialisierung DC1 angenommen
                         C      ; - bei UC1-Kopplung ueber DTR ohne Warten auf Senderegister leer,
                         C      ;   nur Warten auf Sendepuffer leer
                         C      ;   (Aenderung 23.03.89 daher nur fuer Drucker wirksam, sonst zu langsam)
                         C      ; 15.09.89
                         C      ; - bei UC1-Kopplung ueber DC1/DC3 nicht 7fh zu Beginn gesendet, sondern DC1
                         C      ;**************************************************************************
                         C      
  D349                   C      cdsioi	equ	dumi		;keine Zeicheneingabe unterstuetzt
                         C      
                         C      ; Einzelzeichenausgabe Reg. A
  D9EE    DD 4E 02       C      cdsioo:	ld	c,(ix+ltpsd)	;Datenport
  D9F1    ED 79          C      	out	(c),a
  D9F3    C9             C      	ret
                         C      
                         C      ;------------------------------------
                         C      
                         C      ; Statusabfrage
  D9F4    DD 7E 00       C      cdsios:	ld	a,(ix+ltpst)	;Status
  D9F7    CB 4F          C      	bit	1,a		;senderseitig blockiert?
  D9F9    20 3F          C      	jr	nz,lstsr	;ja, frei rueckmelden
  D9FB    B7             C      	or	a		;initialisiert?
  D9FC    CC DA61        C      	call	z,cdsins	;nein
  D9FF    DD CB 0A 7E    C      	bit	7,(ix+ltpw5)	;Prozedur DTR?
  DA03    28 3A          C      	JR	Z,lstsdc	;nein
  DA05    DD 4E 03       C      	ld	c,(ix+ltpsc)	;SIO Kommando
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-54


                         C       IF iobuc1
  DA08    DD CB 01 7E    C      	bit	7,(ix+ltpdc)	;Warten auf Senderegister leer?
  DA0C    28 0C          C      	jr	z,lstse0	;ja
  DA0E    3E 10          C      	ld	a,00010000b	;Reset Ext/Status-Interrupt, Lesereg. 0
  DA10    ED 79          C      	out	(c),a		;Status abspeichern
  DA12    ED 78          C      	in	a,(c)		;Lesereg. 0
  DA14    CB 57          C      	bit	2,a		;Sendepuffer leer?
  DA16    20 0C          C      	jr	nz,lstse1	;ja
  DA18    18 20          C      	jr	lstsr		;nein, Drucker besetzt
  DA1A                   C      lstse0:
                         C       ENDIF
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  DA1A    3E 11          C      	LD	a,00010001b	;Reset Ext/Status-Interrupt, Lesereg. 1
  DA1C    ED 79          C      	OUT	(C),a		;Status abspeichern
  DA1E    ED 78          C      	IN	a,(C)		;Leseregister 1
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  DA20    CB 47          C      	bit	0,a		;alle Bits gesendet?
                         C      				; Sendepuffer frei reicht nicht, da
                         C      				; K6311 u.ae. nicht korrekt arbeiten
  DA22    28 16          C      	jr	z,lstsr		;nein, Drucker besetzt
  DA24    DD CB 01 5E    C      lstse1:	bit	3,(ix+ltpdc)	;Abfrage DTR ueber DCD im Kanal B?
  DA28    20 06          C      	jr	nz,lstsb3	;ja
  DA2A    ED 78          C      	in	a,(c)		;Leseregister 0
  DA2C    CB 6F          C      	bit	5,a		;CTS?
  DA2E    18 0A          C      	jr	lstsr		;nz bei ja
  DA30    0C             C      lstsb3:	inc	c
  DA31    0C             C      	inc	c		;auf Kanal B
  DA32    3E 10          C      	LD	a,00010000b	;Reset Ext/Status-Interrupt, Lesereg. 0
  DA34    ED 79          C      	out	(c),a		;DCD in RR0 Kanal B abspeichern
  DA36    ED 78          C      	in	a,(c)		;Leseregister 0 des Kanal B
  DA38    CB 5F          C      	bit	3,a		;DCD im Kanal B (ist DTR-Bit vom Kanal A)
                         C      ; Ausgang Senderstatus
  DA3A                   C      lstsr:
  DA3A    3E FF          C      lstsr1:	ld	a,0ffh
  DA3C    C0             C      	ret	nz		;senderseitig frei
  DA3D    3C             C      	inc	a		;A=00, ret z
  DA3E    C9             C      	RET			;senderseitig besetzt
                         C      ;-----------------------
                         C      ; DC1/DC3 und XON/XOFF
  DA3F    DD 4E 02       C      lstsdc:	LD	C,(ix+ltpsd)	;SIO Daten
  DA42    ED 78          C      	IN	A,(C)		;Status lesen (SIO speichert letzten Status)
  DA44    DD 77 01       C      	LD	(ix+ltpdc),A	;zuletzt empf. Zeichen fuer Fehlersuche merken
  DA47    E6 7F          C      	and	7fh		;evtl. Paritaet ignorieren
  DA49    FE 13          C      	cp	13h		;DC3?
  DA4B    28 12          C      	jr	z,lstsd2	;ja, besetzt
  DA4D    FE 14          C      	cp	14h		;DC4 (Status)?
  DA4F    20 05          C      	jr	nz,lstsd1	;nein (DC1 angenommen)
  DA51    CD DA95        C      	call	cdsini		;statt Status abzuholen neu initialisieren
  DA54    18 E9          C      	jr	lstsdc		;und Status neu abfragen
  DA56    DD 4E 03       C      lstsd1:	ld	c,(ix+ltpsc)	;SIO Kommando
  DA59    ED 78          C      	in	a,(c)
  DA5B    CB 57          C      	bit	2,a		;Sendepuffer leer? (nz bei ja)
  DA5D    18 DB          C      	jr	lstsr
  DA5F    AF             C      lstsd2:	xor	a		;A=00, ret z
  DA60    C9             C      	ret			;senderseitig besetzt
                         C      
                         C      ;-----------------------
                         C      
                         C      ; (Re-)Initialisierung
                         C      ; IX auf Steuertabelle
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-55


                         C      ; ret: C zeigt auf Kommandoport
                         C      
                         C      ; Sender initialisieren
  DA61                   C      cdsins:
  DA61    DD CB 00 C6    C      	set	0,(ix+ltpst)	;Sender ist initialisiert
  DA65    CD DA95        C      	call	cdsini
  DA68    DD CB 0A 7E    C      	bit	7,(ix+ltpw5)	;Prozedur DC1/DC3?
  DA6C    C0             C      	ret	nz		;nein
  DA6D    41             C      	ld	b,c
  DA6E    DD 4E 02       C      	ld	c,(ix+ltpsd)	;Datenport
                         C       IF iobuc1
  DA71    DD CB 01 7E    C       	bit	7,(ix+ltpdc)	;Warten auf Senderegister leer?
  DA75    28 06          C      	jr	z,cdsind	;ja, Drucker
  DA77    3E 11          C      	ld	a,11h		;bei UC1: mit DC1/DC3-Protokoll DC1 senden
  DA79    ED 79          C      	out	(c),a
  DA7B    48             C      	ld	c,b
  DA7C    C9             C      	ret
                         C       ENDIF
  DA7D    3E 7F          C      cdsind:	ld	a,7fh		;nach Initialisierung RESET senden
  DA7F    ED 79          C      	out	(c),a
  DA81    48             C      	ld	c,b
  DA82    11 0BB8        C      	ld	de,30*100	;max. Wartezeit ca. 30 sec (SD1157!)
  DA85    ED 78          C      cdsinw:	in	a,(c)
  DA87    CB 47          C      	bit	0,a		;Antwort da?
  DA89    C0             C      	ret	nz		;ja
  DA8A    06 01          C      	ld	b,1
  DA8C    CD E8E4        C      	call	wait10		;10ms warten
  DA8F    1B             C      	dec	de
  DA90    7A             C      	ld	a,d
  DA91    B3             C      	or	e		;max. Wartezeit abgelaufen?
  DA92    20 F1          C      	jr	nz,cdsinw	;nein
  DA94    C9             C      	ret			;sonst Drucker wohl nicht bereit
                         C      
                         C      
                         C      ; gem. UP fuer Sender und Empf. initialisieren
  DA95                   C      cdsini:
  DA95    DD E5          C      	push	ix
  DA97    E1             C      	pop	hl
  DA98    01 000B        C      	ld	bc,ltpini
  DA9B    09             C      	add	hl,bc
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  DA9C    CD D98D        C      	call	portpr		;CTC, WR0, WR4, WR1, WR3
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  DA9F    DD 5E 0A       C      ltpow5:	LD	e,(ix+ltpw5)	;Prozedurtyp/Bitanzahl
                         C      ; Stellen Schreibregister 5
                         C      ; Reg. B,HL bleiben erhalten
  DAA2    3E 05          C      ltpot5:	ld	a,5
  DAA4    DD 4E 03       C      	ld	c,(ix+ltpsc)
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  DAA7    ED 79          C      	OUT	(C),A
  DAA9    ED 59          C      	OUT	(C),e
                         C       IF cpu eq c1715 ;wegen evtl. parallelem Tastaturpolling am gleichen SIO-Kanal
                         C       ENDIF
  DAAB    C9             C      	RET
                         C      
                         C      ;-------------------------------------
                         C       if iobuc1
                         C      
                         C      ; UC1-Routinen (ausser Senden)
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-56


                         C      
                         C      ; UC1: Empf.-Status
                         C      ;==================
                         C      ; o A=0, ret z	: kein Zeichen empfangen
                         C      ; o A=ff,ret nz	: Zeichen da
  DAAC    DD 21 D9D1     C      uc1st:	ld	ix,lstuc1	;Stellen IX auf Steuertabelle
  DAB0                   C      uc1si:	;interner Aufruf mit gestelltem IX
  DAB0    DD CB 00 66    C      	bit	4,(ix+ltpst)	;initialisiert?
  DAB4    20 19          C      	jr	nz,uc1si1	;ja
  DAB6    AF             C      	xor	a
  DAB7    32 DB7D        C      	ld	(uc1bfp),a	;Puffer leeren
  DABA    CD DA95        C      	call	cdsini		;Initialisierung
  DABD    DD CB 00 E6    C      	set	4,(ix+ltpst)	;Empfaenger ist initialisiert
  DAC1    F3             C      	di
                         C       IF (uc1dat xor uc1sta) eq 01b	;Kanal-Nr ist Bit 1 (bei Buerocomp und OEM)
                         C        IF (uc1sta and 10b) eq 00b	;UC1 ist an Kanal A
  DAC2    CB C9          C      	set	1,c		;Kanal B erzwingen
                         C        ENDIF
                         C       ENDIF
  DAC4    21 DAD7        C      	ld	hl,uc1i2	;WR1,WR2 programmieren
  DAC7    06 04          C       	ld	b,uc1il
  DAC9    ED B3          C      	otir
  DACB    FB             C      	ei
  DACC    CD DB06        C      	call	uc1ird		;DTR bzw. DC1 senden
  DACF    3A DB7D        C      uc1si1:	ld	a,(uc1bfp)	;Zeichen im Empfpuffer?
  DAD2    B7             C      	or	a
  DAD3    C8             C      	ret	z		;nein
  DAD4    3E FF          C      	ld	a,0ffh
  DAD6    C9             C      	ret
                         C      
  DAD7                   C      uc1i2: ;zusaetzliche Initialisierung fuer WR1/Bit2 und WR2 (beide nur Kanal B)
                         C       IF (uc1dat xor uc1sta) eq 01b	;Kanal-Nr ist Bit 1 (bei Buerocomp und OEM)
                         C        IF (uc1sta and 10b) eq 00b	;UC1 ist an Kanal A
  DAD7    01 04          C      	db	1,00000100b	;WR1, Kanal B: Intv.modif. setzen
                         C        ENDIF
                         C       ENDIF
  DAD9    02 D0          C      	db	2,ivsio0	;WR2, Kanal B: Interruptvektor
  0004                   C      uc1il	equ	$-uc1i2
                         C      ; UC1: empf. Zeichen an Nutzer
                         C      ;=============================
                         C      ; o A:	aeltestes empf. Zeichen
                         C      
  DADB    DD 21 D9D1     C      uc1i:	ld	ix,lstuc1	;Stellen IX auf Steuertabelle
                         C      
  DADF                   C      uc1ii:	;interner Aufruf mit gestelltem IX
  DADF    FB             C      uc1iw:	ei			;UC1:-Interrupt zulassen
  DAE0    CD DAB0        C      	call	uc1si		;Zeichen da?
  DAE3    28 FA          C      	jr	z,uc1iw		;nein ***keine Zeitueberwachung!***
  DAE5    21 DB7D        C      	ld	hl,uc1bfp
  DAE8    F3             C      	di
  DAE9    4E             C      	ld	c,(hl)
  DAEA    35             C      	dec	(hl)		;Pufferlaenge -1
  DAEB    06 00          C      	ld	b,0
  DAED    23             C      	inc	hl		;^(aeltestes Pufferzeichen)
  DAEE    7E             C      	ld	a,(hl)		;Zeichen nach A
  DAEF    11 DB7F        C      	ld	de,uc1buf+1
  DAF2    EB             C      	ex	de,hl
  DAF3    ED B0          C      	ldir			;Puffer aufschieben
  DAF5    FB             C      	ei
  DAF6    DD CB 00 7E    C      	bit	7,(ix+ltpst)	;war Stopaufforderung?
  DAFA    C8             C      	ret	z		;nein
  DAFB    F5             C      	push	af		;retten Zeichen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-57


  DAFC    3A DB7D        C      	ld	a,(uc1bfp)	;Pufferbelegung
  DAFF    FE 06          C      	cp	1*uc1bfl/3	;unter dem Limit?
  DB01    DC DB06        C      	call	c,uc1ird	;ja, Senden wieder erlauben
  DB04    F1             C      	pop	af
  DB05    C9             C      	ret
                         C      
                         C      ; Empfangsbereitschaft anzeigen
  DB06    DD CB 00 BE    C      uc1ird:	res	7,(ix+ltpst)
  DB0A    DD CB 0A 7E    C      	bit	7,(ix+ltpw5)	;Prozedur DC1/DC3?
  DB0E    C2 DA9F        C      	jp	nz,ltpow5	;nein, DTR wieder setzen
  DB11    3E 11          C      	ld	a,11h		;DC1 (Senden wieder erlauben)
  DB13    DD 4E 02       C      	LD	C,(ix+ltpsd)	;SIO Daten
  DB16    ED 79          C      	OUT	(C),A
  DB18    C9             C      	ret
                         C      
                         C      ; UC1: Empf.-Interrupt
                         C      ;=====================
  DB19    ED 73 E758     C      uc1rin:	ld	(intsp),sp
  DB1D    31 F217        C      	ld	sp,intstk
  DB20    F5             C      	push	af
  DB21    E5             C      	push	hl
  DB22    D5             C      	push	de
  DB23    C5             C      	push	bc
  DB24    DD E5          C      	push	ix
  DB26    21 DB46        C      	ld	hl,uc1rir
  DB29    E5             C      	push	hl
  DB2A    DD 21 D9D1     C      	ld	ix,lstuc1	;Stellen IX auf Steuertabelle
  DB2E    DD 4E 02       C      	ld	c,(ix+ltpsd)	;SIO Daten
  DB31    ED 40          C      	in	b,(c)		;Zeichen lesen
  DB33    21 DB7D        C      	ld	hl,uc1bfp	;Pufferzeiger zum zuletzt empf. Zeichen
  DB36    7E             C      	ld	a,(hl)
  DB37    FE 14          C      	cp	uc1bfl		;Puffer voll?
  DB39    D0             C      	ret	nc		;ja, Zeichen ignorieren
  DB3A    FE 0D          C      	cp	2*uc1bfl/3	;Puffer fast voll (SIO-Empf.puffer 3 Byte!)?
  DB3C    D4 DB4B        C      	call	nc,uc1ri1	;ja, DC3 senden bzw. DTR wegnehmen
  DB3F    34             C      	inc	(hl)		;+1
  DB40    5E             C      	ld	e,(hl)
  DB41    16 00          C      	ld	d,0
  DB43    19             C      	add	hl,de		;naechste freie Stelle
  DB44    70             C      	ld	(hl),b		;Zeichen in Puffer
  DB45    C9             C      	ret
  DB46    DD E1          C      uc1rir:	pop	ix
  DB48    C3 E753        C      	jp	intrbc		;fertig
                         C      
                         C      ; Stopaufforderung senden
                         C      ; B,HL bleibt erhalten
  DB4B    DD CB 00 FE    C      uc1ri1:	set	7,(ix+ltpst)	;merken Stopaufforderung
  DB4F    DD 5E 0A       C      	ld	e,(ix+ltpw5)
  DB52    CB 7B          C      	bit	7,e		;Prozedur DC1/DC3?
  DB54    28 05          C      	jr	z,uc1ri2	;ja
  DB56    CB BB          C      	res	7,e		;DTR loeschen
  DB58    C3 DAA2        C      	jp	ltpot5
  DB5B    3E 13          C      uc1ri2:	ld	a,13h		;DC3 an Partner (Senden stopppen)
  DB5D    DD 4E 02       C      	LD	C,(ix+ltpsd)	;SIO Daten
  DB60    ED 79          C      	OUT	(C),A
  DB62    C9             C      	ret
                         C      
                         C      ; UC1: Interrupt Empf.-Fehler (Parit., Ueberlauf, Rahmenfehler)
                         C      ;============================
  DB63    ED 73 E758     C      uc1err:	ld	(intsp),sp
  DB67    31 F217        C      	ld	sp,intstk
  DB6A    F5             C      	push	af
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-58


  DB6B    E5             C      	push	hl
  DB6C    D5             C      	push	de
  DB6D    C5             C      	push	bc
  DB6E    DD E5          C      	push	ix
  DB70    DD 21 D9D1     C      	ld	ix,lstuc1	;Stellen IX auf Steuertabelle
  DB74    DD 4E 03       C      	ld	c,(ix+ltpsc)	;SIO Kommando
  DB77    16 30          C      	ld	d,00110000b	;Reset Fehler-Interrupt
  DB79    ED 51          C      	out	(c),d
                         C      				;keine Fehlermeldung, da bei
                         C      				;Empf.ueberlauf alles noch
                         C      				;mehr verzoegert wird
  DB7B    18 C9          C      	jr	uc1rir
                         C      
                         C      ; UC1: Empfangspuffer
                         C      ;====================
  DB7D    00             C      uc1bfp:	db	0
  DB7E                   C      uc1buf:	ds	uc1bfl,0
                         C      
                         C       endif	;uc1
                         C      
                                  ENDIF
                                  IF cdtsib
                                  ENDIF
                                  IF cdtpio
                                  ENDIF
                                  IF cdtp54
                                  ENDIF
                                  IF cdth54
                                  ENDIF
                                  IF cdtn56 or cdtp56
                                  ENDIF
                                 ENDIF
                                
                         C      	include BIOSDSK
                         C      
                         C      ;****************************************************
                         C      ;	Diskettentreiber; Umkleidung des phys. Transfers
                         C      ;	Version 04.11.88
                         C      ; Aenderungen:
                         C      ; - Jeder Fehler in Spur 0, Sektor 1 fuehrt zur Annahme von Systemspuren
                         C      ;   (A7100-System mit 5" FM und 8272-Hardware mit 128er Sektorlaenge)
                         C      ; - !!Schnittstelle fuer diskio-Aufruf neu!! (Flags neu, side zusaetzlich)
                         C      ; - Verify nach Schreiben kann laufwerksspezifisch gewaehlt werden
                         C      ; - Laufwerkskapazitaet nach phys. LW-Nr in Statuszeile
                         C      ; - Fehlerkorrektur bei KAYPRO IV fuer C128
                         C      ; 12.06.88
                         C      ; - bei stzaus in synflg keine Pflege der Statuszeile
                         C      ; 06.07.88:
                         C      ; - Spurnummer generell auf 16 bit erweitert
                         C      ; 14.10.88
                         C      ; - Generierung ohne Floppy-Laufwerke moeglich
                         C      ; 26.10.88
                         C      ; - Test der Laufwerksbereitschaft bei Select
                         C      ; 04.11.88
                         C      ; - bei 5" und 512 Sektorlaenge Dir-Groesse 0
                         C      ; 12.03.89
                         C      ; - 'ibmfrm' gestrichen, phys. Formaterkennung fuer SIOS erfolgt immer
                         C      ;****************************************************
                         C      
                         C       if1
                         C       endif
                         C      
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-59


                         C      ; Laufwerksauswahl
                         C      ;=================
                         C      ; i C: Laufw. (0=A:, 1=B: ...)
                         C      ; i E: Bit 0 ist LOGIN-Bit von BDOS (=0, wenn LOGIN)
                         C      
  DB92    CD E99F        C      seldsk:	call	dgetpb		;HL auf DPH stellen, IX auf DPB
  DB95    C8             C      	ret	z		;Geraet ex. nicht
  DB96    79             C      	ld	a,c
  DB97    32 E1A3        C      	ld	(ddrive),a	;Laufwerk merken
  DB9A    CB 43          C      	bit	0,e		;LOGIN von BDOS?
  DB9C    C0             C      	ret	nz		;nein
                         C       if ramfl
                         C       endif
  DB9D    E5             C      	push	hl		;^DPH merken
                         C      
                         C      	IF	dbufsz gt 7
  DB9E    21 E19A        C      	ld	hl,dbdev
  DBA1    BE             C      	cp	(hl)		;LOGIN fuer gepuffertes Device?
  DBA2    20 07          C      	jr	nz,dselnb	;nein
  DBA4    36 FF          C      	ld	(hl),0ffh	;Puffer ist ungueltig
  DBA6    21 E199        C      	ld	hl,dbflg
  DBA9    CB 96          C      	res	dfbwr,(hl)	;kein veraend. Puffer auszug.!
  DBAB                   C      dselnb:
                         C      	ENDIF
                         C      
                         C       IF format
  DBAB    DD CB 0F 76    C      	bit	dpbfrm,(ix+dpbflg);Formaterkennung unterdr.?
  DBAF    28 1A          C      	jr	z,drdfrm	;nein
                         C       ENDIF
                         C      
                         C      ; Test der Laufwerks-Bereitschaft; nur dann Select Disk ok
                         C      ;---------------------------------------------------------
  DBB1    32 E18C        C      	ld	(drddev),a	;log. LW
  DBB4    DD 6E 0D       C      	ld	l,(ix+dpbofs)
  DBB7    DD 66 0E       C      	ld	h,(ix+dpbofs+1)
  DBBA    22 E18D        C      	ld	(drdtrk),hl	;auf Beginn des Verzeichnisses
  DBBD    21 E18B        C      	ld	hl,drdcdb	;Positionieren ohne Fehlerbehandlung
  DBC0    CD DF93        C      	call	dsktra
  DBC3    CA DDC0        C      	jp	z,selext	;ok
  DBC6    E1             C      	pop	hl		;^DPH wegschmeissen
  DBC7    21 0000        C      	ld	hl,0		;Select Fehler
  DBCA    C9             C      	ret
  DBCB                   C      drdfrm:
                         C      
                         C      	IF	format
                         C      ;++++++++++Automatische Format-Erkennung++++++++++
                         C      ; Reg. C zeigt auf Laufwerk
                         C      
                         C      	IF	dbufsz gt 7
  DBCB    CD DF60        C       	call	dbtrw		;Puffer freimachen
                         C      				;und auf Lesen schalten
  DBCE    21 E1B0        C      	ld	hl,dbnb
  DBD1    36 FF          C      	ld	(hl),0ffh	;Puffernummer ist ungueltig, obwohl evtl.
                         C      				;alle anderen Pufferparameter stimmen
                         C      				;(da nur 128 Bytes vom Puffer belegt sind)
                         C      	ENDIF
                         C      
  DBD3    79             C      	ld	a,c
  DBD4    32 E193        C      	ld	(dfrmdv),a
  DBD7    32 E19A        C      	ld	(dbdev),a
                         C      
  DBDA    AF             C      	xor	a
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-60


  DBDB    DD 77 0F       C      	ld	(ix+dpbflg),a	;ruecksetzen alle Flags
  DBDE    DD 77 13       C      	ld	(ix+dpbsn0),a	;keine Weiter-Numm. auf Ruecks.
  DBE1    DD 77 0D       C      	ld	(ix+dpbofs),a	;keine Systemspuren
                         C      
  DBE4    32 E194        C      	ld	(dfrmtr),a	;Spur 0
  DBE7    32 E19B        C      	ld	(dbtrk),a
  DBEA    32 E19C        C      	ld	(dbtrk+1),a
  DBED    3C             C      	inc	a
  DBEE    32 E19D        C      	ld	(dbsec),a	;Sektor 1
  DBF1    32 E19F        C      	ld	(dbsnb),a	;1 phys. Sektor lesen
                         C      
                         C      ; Stellen  Sektor-Translate-Tabelle 1,2,3,...
  DBF4    DD E5          C      	push	ix
  DBF6    06 1A          C      	ld	b,26		;max. Laenge der Tabelle
                         C       IF dsk8mf
  DBF8    DD CB 18 7E    C      	bit	dpbt52,(ix+dpbtyp)	;Tabelle max 52 lang?
  DBFC    28 02          C      	jr	z,nd8mf		;nein
  DBFE    06 34          C      	ld	b,52
  DC00                   C      nd8mf:
                         C       ENDIF
  DC00    DD 77 19       C      selstz:	ld	(ix+dpbstr),a
  DC03    DD 23          C      	inc	ix
  DC05    3C             C      	inc	a
  DC06    10 F8          C      	djnz	selstz
  DC08    DD E1          C      	pop	ix
                         C      
                         C      ; Positionieren auf Spur 0 und analysieren Systemspuren
  DC0A    CD DF78        C      	call	dsidtr		;beliebigen Sekt.Id lesen
  DC0D    20 49          C      	jr	nz,selsys	;Fehler beim Lesen; Systemsp. annehmen
                         C      ;				 (z.B. SCP1700 mit 5"FM in Spur 0!!)
  DC0F    7C             C      	ld	a,h
  DC10    32 E19E        C      	ld	(dbslc),a	;setzen Spurformat fuer Sp. 0
                         C      	IF	dbufsz le 7
                         C      	ENDIF
  DC13    21 E199        C      	ld	hl,dbflg
                         C       IF dsk8mf
  DC16    CB 9E          C      	res	dioffm,(hl)
  DC18    3A E192        C      	ld	a,(dfrflg)	;Flag zum Lesen des Sektid.
  DC1B    CB 5F          C      	bit	dioffm,a	;war dazu temporaer FM notwendig?
  DC1D    28 02          C      	jr	z,nfrtfm	;nein
  DC1F    CB DE          C      	set	dioffm,(hl)	;sonst fuer Datenlesen uebernehmen
  DC21                   C      nfrtfm:
                         C       ENDIF
  DC21    46             C      	ld	b,(hl)		;merken Fehlerprotokoll-Bit
  DC22    CB E6          C      	set	dfbtr,(hl)	;kein Fehlerprotokoll
  DC24    E5             C      	push	hl
  DC25    CD DF66        C      	call	dbtran		;Lesen Spur 0, Sektor 1
  DC28    E1             C      	pop	hl
  DC29    70             C      	ld	(hl),b		;setzen Standard fuer Fehlerprotokoll-Bit
  DC2A    20 2C          C      	jr	nz,selsys	;Fehler, Systemspuren annehmen
  DC2C    FD E5          C      	push	iy
  DC2E    FD 2A E1A0     C      	ld	iy,(dbdma)
  DC32    FD 7E 00       C      	ld	a,(iy+0)	;Format-Loeschbyte
  DC35    FE E5          C      	cp	0e5h		;leere Diskette/geloeschter Eintrag?
  DC37    20 0A          C      	jr	nz,selsy2	;nein, weder/noch
  DC39    FD BE 01       C      	cp	(iy+1)		;auch danach 0e5h?
  DC3C    20 15          C      	jr	nz,selsy0	;nein, geloeschter Dir-Eintrag
  DC3E    DD 35 0D       C      	dec	(ix+dpbofs)	;Flag: leere Disk oder leere Systemsp.
  DC41    18 10          C      	jr	selsy0		;dpbofs auf 254
  DC43                   C      selsy2:
  DC43    FE 40          C      	cp	40h		;IBM-Format (SIOS-Daten-Diskette)?
  DC45    28 0F          C      	jr	z,selsy1	;ja, 0 Systemspuren annehmen
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-61


  DC47    FE 20          C      	cp	20h		;<=31 ? ("S"YL ist groesser!)
  DC49    30 0B          C      	jr	nc,selsy1	;nein, kann kein Directory sein; 0 Systemsp.
                         C      ;Systemlader fuer PC1715 beginnt mit 02 oder 03
  DC4B    FD 7E 20       C      	ld	a,(iy+20h)	;bei SCP1715-Systemdiskette dort 00h
                         C      				;bei MicroDos dort 10h
  DC4E    FD B6 21       C      	or	(iy+21h)	;bei SCP1715-Systemdiskette dort 00h
                         C      				;bei CP/A dort Dir-Eintrag (E5 oder Filename)
  DC51    28 03          C      	jr	z,selsy1	;beides 00h, kein Directory; 0 Systemsp.
  DC53    DD 35 0D       C      selsy0:	dec	(ix+dpbofs)	;=255, wenn Directory; =254 wenn vorn leer
  DC56                   C      selsy1:
  DC56    FD E1          C      	pop	iy
  DC58                   C      selsys:
                         C      
                         C      ; Analysieren Datenspur
                         C      
                         C      ; SS/DS-Analyse
  DC58    DD 36 12 02    C      	ld	(ix+dpbstp),2	;Doppel-Step-Impulse
  DC5C    3E 03          C      	ld	a,dlgint	;auf LOGIN-Spur
  DC5E    CD DF75        C      	call	dsidtt		;belieb. SektId Vorderseite lesen
  DC61    20 3B          C      	jr	nz,seldle	;Fehler, unsicheres Format
  DC63    54             C      	ld	d,h		;d:=Sektorlcode, e:=Spur
                         C       IF dsk8mf
  DC64    21 E192        C      	ld	hl,dfrcdb
  DC67    CB 5E          C      	bit	dioffm,(hl)	;musste FM erzwungen werden?
  DC69    28 04          C      	jr	z,selnfm	;nein
  DC6B    DD CB 0F D6    C      	set	dpbffm,(ix+dpbflg)	;sonst ist alles FM
  DC6F    21 E199        C      selnfm:	ld	hl,dbflg
  DC72    CB 9E          C      	res	dioffm,(hl)	;loeschen fuer normalen Transfer
                         C      
                         C       ENDIF
                         C       IF dskds
  DC74    DD CB 18 46    C      	bit	dpbtds,(ix+dpbtyp)	;ist es ein DS-Laufwerk?
  DC78    28 14          C      	jr	z,selss		;nein, SS
  DC7A    D5             C      	push	de		;merken Sektorlaengencode und Spur
  DC7B    DD CB 0F EE    C      	set	dpbfds,(ix+dpbflg)
  DC7F    3E 07          C      	ld	a,1+(dlgint*2)	;Rueckseite der Spur,
                         C      				;ab der Format bei SS konstant
  DC81    CD DF75        C      	call	dsidtt		;beliebigen Sekt.Id Ruecks. lesen
  DC84    7A             C      	ld	a,d		;merken side Ruecks.
  DC85    6B             C      	ld	l,e		;h:=Sektorlcode, l:=Spur Rueckseite
  DC86    D1             C      	pop	de		;wiederherstellen Vorderseite
  DC87    20 05          C      	jr	nz,selss	;Fehler beim Lesen, SS
  DC89    B7             C      	or	a
  DC8A    ED 52          C      	sbc	hl,de		;Vorder- gleich Rueckseite?
  DC8C    28 04          C      	jr	z,sel48		;ja; 40 Tr/ 80 Tr unterscheiden
  DC8E    DD CB 0F AE    C      selss:	res	dpbfds,(ix+dpbflg)
                         C       ENDIF
                         C      
                         C      ; 40/80 Track Analyse
  DC92    7B             C      sel48:	ld	a,e		;trk
  DC93    D6 03          C      	sub	dlgint		;waren 2 Steps richtig? 
  DC95    28 12          C      	jr	z,seldl1	;ja
  DC97    DD 35 12       C      	dec	(ix+dpbstp)	;Einzelstep-Impulse
  DC9A    D6 03          C      	sub	dlgint		;waere 1 Step richtig?
  DC9C    28 0B          C      	jr	z,seldl1	;ja
                         C      				;nein, unsicher
  DC9E    DD 36 10 FF    C      seldle:	ld	(ix+dpbslc),0ffh;provozieren 'BAD SECTOR'
  DCA2    21 0000        C      	ld	hl,0		;erzeugen 'SELECT' Error
  DCA5    E3             C      	ex	(sp),hl
  DCA6    C3 DDC0        C      	jp	selext
                         C      
                         C      ; DS/SS und 40/80 ist unterschieden, es fehlt Sektorlaenge
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-62


  DCA9    7A             C      seldl1:	ld	a,d
  DCAA    DD 77 10       C      	ld	(ix+dpbslc),a	;definieren Sektorlaengencode
                         C       IF	dbufsz le 7
                         C       ELSE
                         C      	IF	dbufsz lt 10	;Test, ob Disk-Puffer ausreicht
                         C      	ENDIF
  DCAD    B7             C      	or	a		;Sektorlaenge 128?
  DCAE    20 1B          C      	jr	nz,seldxl	;nein, normale Sektorfolge
                         C       ENDIF	;dbufsz gt 7
                         C       IF dsk8mf
  DCB0    DD CB 18 7E    C      	bit	dpbt52,(ix+dpbtyp)	;8" MFM?
  DCB4    28 06          C      	jr	z,seldsv	;nein
  DCB6    DD CB 0F 56    C      	bit	dpbffm,(ix+dpbflg)	;als MFM betreiben?
  DCBA    28 0F          C      	jr	z,seldxl	;ja, kein Sektorversatz
                         C       ENDIF
  DCBC                   C      seldsv:
                         C      ; Stellen Sektor-Translate-Tabelle 1,7,13,..
  DCBC    DD E5          C      	push	ix
  DCBE    E1             C      	pop	hl
  DCBF    01 0019        C      	ld	bc,dpbstr
  DCC2    09             C      	add	hl,bc
  DCC3    EB             C      	ex	de,hl
  DCC4    21 E15C        C      	ld	hl,xlt
  DCC7    0E 1A          C      	ld	c,26
  DCC9    ED B0          C      	ldir
  DCCB                   C      seldxl:
                         C      
  DCCB    CD E0C6        C      	call	dtrsla		;stellen hl entspr. Sektorlaenge
  DCCE    20 CE          C      	jr	nz,seldle	;unzulaessig
  DCD0    01 0005        C      	ld	bc,dsll		;Laenge eines Eintrags
                         C       IF disk8
  DCD3    DD CB 18 66    C      	bit	dpbt5z,(ix+dpbtyp)	;8"-LW?
  DCD7    20 13          C      	jr	nz,sel5zl	;nein
  DCD9    09             C      	add	hl,bc		;5" uebergehen
  DCDA    09             C      	add	hl,bc
  DCDB    09             C      	add	hl,bc
  DCDC    09             C      	add	hl,bc
                         C        IF dsk8mf
  DCDD    DD CB 18 5E    C      	bit	dpbtdd,(ix+dpbtyp)	;MFM-Laufwerk?
  DCE1    28 1F          C      	jr	z,selset	;nein
  DCE3    DD CB 0F 56    C      	bit	dpbffm,(ix+dpbflg) ;als FM zu betreiben?
  DCE7    20 19          C      	jr	nz,selset	;ja
  DCE9    09             C      	add	hl,bc		;sonst auf 8" MFM Muster
                         C        ENDIF
  DCEA    18 16          C      	jr	selset		;Format-Werte setzen
  DCEC                   C      sel5zl:
                         C       ENDIF
  DCEC    DD CB 12 4E    C      	bit	1,(ix+dpbstp)	;40 Tr. auf 80er LW?
  DCF0    20 08          C      	jr	nz,seld40	;ja
  DCF2    DD 7E 16       C      	ld	a,(ix+dpbptr)	;40er LW?
  DCF5    FE 29          C      	cp	40+1
  DCF7    38 01          C      	jr	c,seld40	;ja, 40 Tr. auf 40er LW
  DCF9    09             C      	add	hl,bc		;auf 80er Format stellen
  DCFA    DD CB 0F 6E    C      seld40:	bit	dpbfds,(ix+dpbflg)	;DS?
  DCFE    28 02          C      	jr	z,seldss	;nein
  DD00    09             C      	add	hl,bc		;auf DS Format
  DD01    09             C      	add	hl,bc
  DD02                   C      seldss:
  DD02                   C      selset:
                         C      ; DPB modifizieren entsprechend erkanntem Format
  DD02    4E             C      	ld	c,(hl)		;Zahl der benutzten Spuren
  DD03    DD 71 14       C      	ld	(ix+dpbtrk),c
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-63


  DD06    23             C      	inc	hl
  DD07    4E             C      	ld	c,(hl)		;Anzahl 128er Sektoren pro Spur
  DD08    DD 71 00       C      	ld	(ix+dpbspt),c
  DD0B    23             C      	inc	hl
  DD0C    4E             C      	ld	c,(hl)		;Anzahl der Dir-Eintraege -1
  DD0D    23             C      	inc	hl
  DD0E    7E             C      	ld	a,(hl)		;Anzahl der Systemspuren
  DD0F    CB 3F          C      	srl	a		;feste Anzahl erzwungen?
  DD11    38 28          C      	jr	c,seldof	;ja
  DD13    DD CB 0D 7E    C      	bit	7,(ix+dpbofs)	;kann Spur 0 Directory sein?
  DD17    28 22          C      	jr	z,seldof	;nein, Standardanzahl setzen
  DD19    DD 34 0D       C      	inc	(ix+dpbofs)	;evtl. leere Systemspur?
  DD1C    28 1C          C      	jr	z,seldo0	;nein, 0 Systemspuren
  DD1E    47             C      	ld	b,a		;retten Anzahl Systemspuren
  DD1F    32 E19B        C      	ld	(dbtrk),a	;einlesen evtl. moeglicher Datenbeginn
  DD22    E5             C      	push	hl
  DD23    CD DF66        C      	call	dbtran		; dauert bei falscher Spur etwas laenger
  DD26    E1             C      	pop	hl
  DD27    78             C      	ld	a,b
  DD28    20 11          C      	jr	nz,seldof	;Fehler, mit Systemspuren annehmen
  DD2A    FD E5          C      	push	iy
  DD2C    FD 2A E1A0     C      	ld	iy,(dbdma)
  DD30    FD 7E 0E       C      	ld	a,(iy+14)	;falls dort Dir, so Byte 14 von Dir =0
  DD33    FE E5          C      	cp	0e5h		;Daten auch leer?
  DD35    FD E1          C      	pop	iy
  DD37    78             C      	ld	a,b
  DD38    20 01          C      	jr	nz,seldof	;nein, vorn liegen nichtbelegte Systemspuren
  DD3A    AF             C      seldo0:	xor	a		;sonst ohne Systemspuren
  DD3B    DD 77 0D       C      seldof:	ld	(ix+dpbofs),a
  DD3E    B7             C      	or	a		;0 Systemspuren?
  DD3F    28 07          C      	jr	z,selddr	;ja
  DD41    79             C      	ld	a,c		;Anzahl Dir-Eintraege -1
  DD42    FE BF          C      	cp	192-1		;>=192 Dir-Eintraege ?
  DD44    38 02          C      	jr	c,selddr	;nein
  DD46    0E 7F          C      	ld	c,128-1		;780k hat 128 Dir-Eintraege
  DD48    DD 71 07       C      selddr:	ld	(ix+dpbdir),c
  DD4B    23             C      	inc	hl
  DD4C    4E             C      	ld	c,(hl)		;Abstand der Blockgroessentab.
  DD4D    06 00          C      	ld	b,0
  DD4F    09             C      	add	hl,bc		;auf Blockgroessentabelle
  DD50    4E             C      	ld	c,(hl)
  DD51    DD 71 02       C      	ld	(ix+dpbbls),c
  DD54    23             C      	inc	hl
  DD55    4E             C      	ld	c,(hl)
  DD56    DD 71 03       C      	ld	(ix+dpbblm),c
  DD59    23             C      	inc	hl
  DD5A    4E             C      	ld	c,(hl)
  DD5B    DD 71 04       C      	ld	(ix+dpbexm),c
                         C      
                         C      ; Bestimmen Zahl der abweichenden 128er-Sektoren ab Spur 0
                         C      
  DD5E    AF             C      	xor	a
  DD5F    32 E194        C      	ld	(dfrmtr),a	;ab Spur 0
                         C      		;(gleichz. Spurkorr. bei falschen Doppelstepimpulsen)
  DD62    CD DF78        C      sf128z:	call	dsidtr		;beliebigen SektId lesen
  DD65    20 18          C      	jr	nz,sf128e	;Fehler
  DD67    7C             C      	ld	a,h		;Sektorlaenge
  DD68    DD BE 10       C      	cp	(ix+dpbslc)	;gleich Disketten-Rest?
  DD6B    28 12          C      	jr	z,sf128e	;ja
  DD6D    DD 7E 0F       C      	ld	a,(ix+dpbflg)
  DD70    E6 03          C      	and	dpbfsm		;bisherige Anzahl abweichender Spuren
  DD72    FE 03          C      	cp	dpbfsm		;Zaehler voll?
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-64


  DD74    28 09          C      	jr	z,sf128e	;ja
  DD76    DD 34 0F       C      	inc	(ix+dpbflg)	;erhoehen abweich. Spurzahl
  DD79    21 E194        C      	ld	hl,dfrmtr	;naechste (logische!) Spur
  DD7C    34             C      	inc	(hl)
  DD7D    18 E3          C      	jr	sf128z
  DD7F                   C      sf128e:
                         C      
                         C      ; Setzen Anzahl der logischen 128er Rekords im Puffer -1
                         C      ; Es wird immer das Maximum gesetzt, dies setzt eine dichte
                         C      ; Sektorfolge beim Transfer voraus! (so in dpbstr)
                         C      
                         C      	IF	dbufsz gt 7
  DD7F    DD 36 11 07    C      	ld	(ix+dpbbfm),+(1 shl (dbufsz-7))-1
                         C      	ENDIF
                         C      
                         C      ; Berechnen Speicherkapazitaet-1 in BDOS-Bloecken aus
                         C      ; ((Tracks-dpbofs)*dpbspt/(2**dpbbls))-1
  DD83    DD 6E 14       C      	ld	l,(ix+dpbtrk)
  DD86    AF             C      	xor	a
  DD87    67             C      	ld	h,a		;hl:=log. Spurzahl
  DD88    DD 5E 0D       C      	ld	e,(ix+dpbofs)
  DD8B    57             C      	ld	d,a		;de:=log. offset-Spurzahl
  DD8C    ED 52          C      	sbc	hl,de
  DD8E    EB             C      	ex	de,hl		;de:=log. Daten-Spurzahl
  DD8F    6F             C      	ld	l,a		;hl:=0
  DD90    DD 46 00       C      	ld	b,(ix+dpbspt)
  DD93    19             C      dsizmz:	add	hl,de
  DD94    10 FD          C      	djnz	dsizmz		;hl:=(tracks-dpbofs)*dpbspt
  DD96    DD 46 02       C      dsizme:	ld	b,(ix+dpbbls)
  DD99    CB 3C          C      dsizdz:	srl	h
  DD9B    CB 1D          C      	rr	l
  DD9D    10 FA          C      	djnz	dsizdz
  DD9F    2B             C      	dec	hl
  DDA0    DD 75 05       C      	ld	(ix+dpbsiz),l
  DDA3    DD 74 06       C      	ld	(ix+dpbsiz+1),h
  DDA6    DD 7E 07       C      	ld	a,(ix+dpbdir)	;Dir-Groesse
  DDA9    3C             C      	inc	a
  DDAA    E6 FC          C      	and	0fch		;abrunden auf durch 4 teilbare Dir-Groesse
  DDAC    0F             C      	rrca
  DDAD    0F             C      	rrca			;div 4, da 4 Dir-Eintr. /Sekt.
  DDAE    DD 77 0B       C      	ld	(ix+dpbchk),a	;ist Sektorzahl = Check size
  DDB1    DD 46 02       C      	ld	b,(ix+dpbbls)	;block shift
  DDB4    0F             C      seldla:	rrca			;BDOS-Bloecke fuer Dir.
  DDB5    10 FD          C      	djnz	seldla
  DDB7    47             C      	ld	b,a
  DDB8    AF             C      	xor	a
  DDB9    37             C      seldal:	scf			;Allocation-Bits fuer Dir.
  DDBA    1F             C      	rra
  DDBB    10 FC          C      	djnz	seldal
  DDBD    DD 77 09       C      	ld	(ix+dpbalc),a
                         C      ;+++++++++++Ende automatische Formaterkennung+++++++++++++
                         C      	ENDIF	;format
                         C      
  DDC0                   C      selext:
                         C       IF cpastz
                         C       ENDIF
                         C      
  DDC0    E1             C      selexx:	pop	hl		;hl auf DPH
  DDC1    C9             C      	ret			;Return Seldsk
                         C      
                         C       IF cpastz
                         C       ENDIF
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-65


                         C      
                         C      
                         C      ; auf Spur 0 zurueck (vor jedem Dir-Zugriff)
                         C      ;===================
  DDC2                   C      home:
                         C      	IF	dbufsz gt 7
  DDC2    21 E199        C      	ld	hl,dbflg
  DDC5    CB 56          C      	bit	dfbwr,(hl)	;veraenderter Puffer?
  DDC7    20 05          C      	jr	nz,home1	;ja, nicht freigeben
  DDC9    3E FF          C      	ld	a,0ffh		;sonst Diskwechsel erlauben
  DDCB    32 E19A        C      	ld	(dbdev),a	;Puffer ist nicht aktiv
                         C      	ENDIF
  DDCE    01 0000        C      home1:	ld	bc,0
                         C      ;-----------------------
                         C      
                         C      ; Einstellen Spur in Reg. BC
                         C      ;================
  DDD1                   C      settrk:
  DDD1    ED 43 E1A4     C      	ld	(dtrack),bc	;Spur merken
  DDD5    C9             C      	ret
                         C      ;-----------------------
                         C      
                         C      ; Einstellen Sektor in Reg. C
                         C      ;==================
  DDD6    79             C      setsec:	LD	A,C
  DDD7    32 E1A6        C      	LD	(dsectr),A
  DDDA    C9             C      	RET
                         C      ;-----------------------
                         C      
                         C      ; Einstellen DMA in Reg. BC
                         C      ;===============
  DDDB    ED 43 E1A9     C      setdma:	LD	(ddma),BC
  DDDF    C9             C      	RET
                         C      ;-----------------------
                         C      
                         C      ; Uebersetzung Sektornummer 
                         C      ;==========================
                         C      ; Translate-Tab-Adr. in DE, Eingangs-Sektornummer in BC,
                         C      ;			    Ausgangs-Sektornummer in HL
                         C      ; Es wird keine Translate-Tabelle benutzt, da die Sektor-
                         C      ; nummernverwaltung verallgemeinert im nicht-Standard-DPB 
                         C      ; enthalten ist (auch fuer physische Sektorlaenge <>128)
                         C      
  DDE0                   C      sectran:
  DDE0    60             C      	LD	H,B
  DDE1    69             C      	LD	L,C
  DDE2    23             C      	inc	hl		;Sektoren zaehlen in CP/A ab 1
  DDE3    C9             C      	RET
                         C      ;-----------------------
                         C      
                         C      ; Schreiben Sektor
                         C      ;=================
                         C      ; Register C (vom BDOS gestellt):
                         C      ;	=0, wenn normales write
                         C      ;	=1, wenn directory-write (sofort ausgeben)
                         C      ;	=2, wenn Beginn eines neuen Datenblocks (kein preread)
                         C      
  DDE4                   C      write:
                         C       IF @write
  DDE4    59             C      	ld	e,c		;retten Reg. C
  DDE5    3A E1A3        C      	ld	a,(ddrive)
  DDE8    4F             C      	ld	c,a
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-66


  DDE9    CD E99F        C      	call	dgetpb		;ix:=dpb(ddrive)
  DDEC    28 64          C      	jr	z,drwerr	;Geraet ex. nicht
                         C       if ramfl
                         C       endif
  DDEE    21 E1A2        C      	ld	hl,dflg
  DDF1    CB D6          C      	set	dfwr,(hl)	;Write-Flag setzen
                         C      
                         C      	IF	dbufsz gt 7	;gepufferte Disk E/A
  DDF3    21 E199        C      	ld	hl,dbflg
  DDF6    CB C6          C      	set	dfbprr,(hl)	;Annahme preread notwendig
  DDF8    7B             C      	ld	a,e		;A:= Write-Typ
  DDF9    32 E1B1        C      	ld	(dwrtyp),a	;merken Write-Typ
  DDFC    FE 02          C      	cp	2		;write to unallocated?
  DDFE    20 17          C      	jr	nz,chkuna	;nein
  DE00    DD 7E 03       C      	ld	a,(ix+dpbblm)	;Zahl der 128-Sekt. im Block -1
  DE03    3C             C      	inc	a
  DE04    32 E1AB        C      	ld	(unacnt),a	;fuer diese Sekt. kein preread
  DE07    21 E1AC        C      	ld	hl,unadev
  DE0A    71             C      	ld	(hl),c
  DE0B    2A E1A4        C      	ld	hl,(dtrack)
  DE0E    22 E1AD        C      	ld	(unatrk),hl
  DE11    3A E1A6        C      	ld	a,(dsectr)
  DE14    32 E1AF        C      	ld	(unasec),a
  DE17    21 E1AB        C      chkuna:	ld	hl,unacnt
  DE1A    7E             C      	ld	a,(hl)
  DE1B    B7             C      	or	a		;noch nicht geschr. Sekt. da?
  DE1C    28 4F          C      	jr	z,alloc		;nein
