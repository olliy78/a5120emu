  E7D6    03             C      	db	3
  E7D7    D66E           C      	dw	crto		;0 crt:
  E7D9    D34C           C      	dw	dumo		;1 dum:
  E7DB    E7EB           C      	dw	list		;2 lst:
  E7DD    D905           C      	dw	uc1o		;3 uc1: (wartet, bis frei)
                         C      
                         C      
  E7DF                   C      listst:			; iobyte:  xx 00 00 00
  E7DF    CD E7F7        C      	call	iodisp
  E7E2    05             C      	db	5
  E7E3    D96F           C      	dw	ttyst		;0 tty:
  E7E5    D346           C      	dw	crtst		;1 crt:
  E7E7    D975           C      	dw	lptst		;2 lpt:
  E7E9    D346           C      	dw	dumst		;3 dum:
                         C      
  E7EB                   C      list:			; iobyte:  xx 00 00 00
  E7EB    CD E7F7        C      	call	iodisp
  E7EE    05             C      	db	5
  E7EF    D8F9           C      	dw	ttyo		;0 tty:
  E7F1    D66E           C      	dw	crto		;1 crt:
  E7F3    D8FF           C      	dw	lpto		;2 lpt:
  E7F5    D34C           C      	dw	dumo		;3 dum:
                         C      
                         C      
                         C      ; IOBYTE-Auswertung - Verteilung auf die physischen Geraete
                         C      ; ---------------------------------------------------------
                         C      ; A,HL werden zerstoert
                         C      ; Anwender-IX wird gerettet, darf von Treiber-Routine zerstoert werden
                         C      ; damit kann Treiber auch aus Interrupt-Routine aufgerufen werden
                         C      
  E7F7                   C      iodisp:
  E7F7    E1             C      	pop	hl
  E7F8    C5             C      	push	bc
  E7F9    46             C      	ld	b,(hl)
  E7FA    23             C      	inc	hl
  E7FB    3A 0003        C      	ld	a,(iobyte)
  E7FE    0F             C      iodis1: rrca
  E7FF    10 FD          C      	djnz	iodis1
  E801    E6 06          C      	and	6
  E803    4F             C      	ld	c,a
  E804    09             C      	add	hl,bc
  E805    7E             C      	ld	a,(hl)
  E806    23             C      	inc	hl
  E807    66             C      	ld	h,(hl)
  E808    6F             C      	ld	l,a
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-104


  E809    C1             C      	pop	bc
  E80A    DD E5          C      	push	ix		;retten Anwender-IX
  E80C    CD E8D7        C      	call	callhl
  E80F    DD E1          C      	pop	ix		;wiederherstellen Anwender-IX
  E811    C9             C      	ret
                         C      
                         C       ENDIF
                         C      
                         C      ;************************************************************
                         C      ;	Spezialroutinen
                         C      ;************************************************************
                         C      
                         C      	IF	monitor
                         C      	ENDIF
                         C      
                         C      
                         C      ; Arbeit mit asynchronen Sonderaktionen
                         C      ;======================================
                         C      ; Die folgenden beiden Routinen werden vom BIOS immer dann aufgerufen,
                         C      ; wenn wegen zeitkritischer (z.B. Floppy-Bedienung) oder anderer
                         C      ; BIOS-Arbeit (z.B. Bildschirmrollen) keine parallelen Sonderaktionen
                         C      ; erlaubt sind.
                         C      
                         C      ; Reg A bleibt erhalten
  E812    F5             C      delsps: push	af
  E813    2A 004A        C      	ld	hl,(kritbg)	;evtl. Nutzerroutine fuer Beginn krit. BIOS
  E816    CD E8D7        C      	call	callhl		;aufrufen
  E819    F1             C      	pop	af
  E81A    21 D23E        C      	ld	hl,synsem	;Verzoegern Sonderaktionen
  E81D    34             C      	inc	(hl)
  E81E    C9             C      	ret
                         C      
                         C      ; Reg A bleibt erhalten
  E81F    F5             C      delspr: push	af
  E820    2A 004C        C      	ld	hl,(kriten)	;evtl. Nutzerroutine fuer Ende krit. BIOS
  E823    CD E8D7        C      	call	callhl		;aufrufen
  E826    F1             C      	pop	af
  E827    21 D23E        C      	ld	hl,synsem	;Zulassen Sonderaktionen
  E82A    35             C      	dec	(hl)
                         C      
                         C       IF stpvar or monitor
                         C      
                         C      ; Test auf zwischenzeitliche Anforderung von Sonderroutinen
                         C      ;----------------------------------------------------------
                         C      
                         C      ; Diese Routine wird nach dem Lesen eines Tastaturzeichens
                         C      ; als "Ohr" eingeschoben, bevor zur eigentlichen Interrupt-
                         C      ; adresse zurueckgekehrt wird. Sie wird nicht innerhalb der
                         C      ; Interruptroutine ausgefuehrt, um mit offenen Interrupts
                         C      ; arbeiten zu koennen.
                         C      ; maximale Stackbelastung nach RETI von Interruptroutinen:
                         C      ; -	Return-Adresse zum Nutzer
                         C      ; -	AF
  E82B    F3             C      chksp:	di
  E82C    F5             C      	push	af		;A und F Reg retten
  E82D    3A D23E        C      	ld	a,(synsem)
  E830    B7             C      	or	a		;asynchr. Routinen zugelassen?
  E831    C2 E848        C      	jp	nz,chkspx	;nein
  E834    3C             C      	inc	a		;weiteren Eintritt verhindern
  E835    32 D23E        C      	ld	(synsem),a
  E838    FB             C      chkspn: ei
  E839    3A D23D        C      	ld	a,(synflg)	;inzw. (neue) Anforderung?
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-105


  0000                   C      rqmask	aset	0
                         C       IF monitor
                         C       ENDIF
                         C       IF stpvar
  0010                   C      rqmask	aset	rqmask+(1 shl stoprq)
                         C       IF chdvar
  0018                   C      rqmask	aset	rqmask+(1 shl synlrq)
                         C       ENDIF
                         C       ENDIF
  E83C    E6 18          C      	and	rqmask
  E83E    C2 E84B        C      	jp	nz,chkspd	;ja, ausfuehren
  E841    3A D23E        C      	ld	a,(synsem)
  E844    3D             C      	dec	a
  E845    32 D23E        C      	ld	(synsem),a
  E848    F1             C      chkspx: pop	af
  E849    FB             C      	ei
  E84A    C9             C      	ret
                         C      
                         C      ; asynchrone Aktionen ausfuehren
  E84B                   C      chkspd:
                         C       IF monitor
                         C       ENDIF
                         C      
                         C       IF stpvar
  E84B    3A D23D        C      	ld	a,(synflg)
  E84E    CB 67          C      	bit	stoprq,a	;inzwischen Stop-Forderung?
  E850    28 10          C      	jr	z,nstpsp	;nein
  E852    CB A7          C      	res	stoprq,a
  E854    32 D23D        C      	ld	(synflg),a
  E857    F1             C      	pop	af		;Nutzer-Stackbelastung verringern
  E858    22 E890        C      	ld	(asynhl),hl	;HL freimachen
  E85B    21 E893        C      	ld	hl,stoprt	;Routine
  E85E    CD E87C        C      	call	asynrt		;aufrufen mit eigenem Stack
  E861    F5             C      	push	af
  E862                   C      nstpsp:
                         C      
                         C       IF chdvar
  E862    3A D23D        C      	ld	a,(synflg)
  E865    CB 5F          C      	bit	synlrq,a	;inzwischen LST:-Synchr.?
  E867    28 10          C      	jr	z,nsynlr	;nein
  E869    CB 9F          C      	res	synlrq,a
  E86B    32 D23D        C      	ld	(synflg),a
  E86E    F1             C      	pop	af
  E86F    22 E890        C      	ld	(asynhl),hl
  E872    21 D982        C      	ld	hl,lsynch
  E875    CD E87C        C      	call	asynrt
  E878    F5             C      	push	af
  E879                   C      nsynlr:
                         C       ENDIF
                         C       ENDIF	;stpvar
                         C      
  E879    C3 E838        C      	jp	chkspn		;Test auf neue Requests
                         C      
                         C       IF stpvar or chdvar
                         C      ; Asynchrone Routine (HL) mit eigenem Stack aufrufen
                         C      ;---------------------------------------------------
                         C      
  E87C    ED 73 E88D     C      asynrt: ld	(asynsv),sp	;asynchr. Routinen haben
  E880    31 F1FF        C      	ld	sp,stpstk	;ein eigenes Stack
  E883    F5             C      	push	af
  E884    D5             C      	push	de
  E885    C5             C      	push	bc
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-106


  E886    CD E8D7        C      	call	callhl		;Routine aufrufen
  E889    C1             C      	pop	bc
  E88A    D1             C      	pop	de
  E88B    F1             C      	pop	af
  E88C    31 0000        C      	ld	sp,0		;SP wiederherstellen
  E88D                   C      asynsv	equ	$-2
  E88F    21 0000        C      	ld	hl,0		;gerettetes hl wiederherst.
  E890                   C      asynhl	equ	$-2
  E892    C9             C      	ret
                         C       ENDIF
                         C      
                         C       IF stpvar
                         C      ; Asynchrone Stop-Routine
                         C      ;------------------------
  E893                   C      stoprt:
                         C       IF disknb ne 0
  E893    CD E490        C      	call	headup		;Disk-Kopf abheben
                         C       ENDIF
  E896    CD E8C1        C      stopz:	call	stpchp		;holen naechste phys. Taste
                         C      
                         C       IF umlaut
  E899    FE 75          C      	cp	'u'		;Umlaut-Modus umschalten ?
  E89B    28 04          C      	jr	z,stopzu
  E89D    FE 55          C      	cp	'U'
  E89F    20 08          C      	jr	nz,stopnu	;Nein !
  E8A1    21 D23D        C      stopzu: ld	hl,synflg	;Umlaute-Flag im Flagbyte
  E8A4    7E             C      	ld	a,(hl)
  E8A5    EE 04          C      	xor	1 shl umlflg	;umschalten
  E8A7    77             C      	ld	(hl),a
  E8A8    C9             C      	ret
  E8A9                   C      stopnu:
                         C       ENDIF
                         C      
                         C       IF chdvar
  E8A9    FE FB          C      	cp	zblmin		;"- im Ziffernblock": Hardcopy BS -> LIST?
  E8AB    CA D834        C      	jp	z,crthrd	;ja, ausfuehren
  E8AE    FE CD          C      	cp	spcins		;"INS": I/O-Byte im LST:Kanal weiterschalten?
  E8B0    20 08          C      	jr	nz,stopz2	;nein
  E8B2    21 0003        C      	ld	hl,iobyte
  E8B5    7E             C      	ld	a,(hl)
  E8B6    C6 40          C      	add	a,40h		;Ueberlauf wird ignoriert
  E8B8    77             C      	ld	(hl),a
  E8B9    C9             C      	ret
  E8BA                   C      stopz2:
                         C      
                         C       IF l2bahn
                         C       ENDIF
                         C       ENDIF
                         C      
                         C       IF cpastz or uhrvar
                         C       ENDIF
                         C      
                         C       IF costu
                         C       ENDIF
                         C      
  E8BA    D6 C7          C      	sub	kcurpd		;"Page down": ^C ?
  E8BC    C0             C      	ret	nz		;nein, Stop-Ende
  E8BD    32 D23E        C      	ld	(synsem),a	;falls rst 0 nicht in BIOS fuehrt
  E8C0    C7             C      	rst	0		;sonst Warmstart
                         C      
                         C      ; Holen naechste Taste physisch
  E8C1    21 D23D        C      stpchp: ld	hl,synflg
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-107


  E8C4    CB FE          C      	set	phyact,(hl)	;naechste Taste physisch
  E8C6    E5             C      	push	hl
  E8C7    CD E8CE        C      	call	stopch		;holen naechstes Tastaturz.
  E8CA    E1             C      	pop	hl
  E8CB    CB BE          C      	res	phyact,(hl)	;physisches Lesen beendet
  E8CD    C9             C      	ret
                         C      
                         C      ; Holen naechste Taste im Stopzustand
  E8CE    CD D815        C      stopch: call	swilmp		;Stop-Lampe an
  E8D1    CD D401        C      	call	kbdi		;Warten auf naechstes Zeichen
  E8D4    C3 D815        C      	jp	swilmp		;danach Stop-Lampe aus
                         C      
                         C       ENDIF ;stpvar
                         C       ENDIF ;asynchr. Routinen
                         C      
                         C      ;***************************************************
                         C      ;	Allgemeine BIOS-Hilfsprogramme
                         C      ;***************************************************
                         C      
                         C      ; Aufruf der Routine (HL)
  E8D7    E9             C      callhl: jp	(hl)
                         C      
                         C      ; Ausgabe Text ab (HL) bis 00h auf CON: und evtl. LST:
  E8D8    7E             C      putmes: LD	A,(HL)
  E8D9    B7             C      	OR	A
  E8DA    C8             C      	RET	Z
  E8DB    E5             C      	PUSH	HL
  E8DC    4F             C      	LD	C,A
  E8DD    CD D20C        C      	CALL	conol
  E8E0    E1             C      	POP	HL
  E8E1    23             C      	INC	HL
  E8E2    18 F4          C      	JR	putmes
                         C      
                         C      ; Ausgabe Text ab (HL) mit exakter Laenge "stzbl" in Statuszeile
                         C       IF cpastz
                         C       ELSE
  E8D8                   C      biosms	equ	putmes	;0dh,0ah,...,07h,00h im Text ergaenzen!!
                         C       ENDIF
                         C      
                         C      ;	Wait 0.01 sec * (B)
                         C      ; Reg HL bleibt erhalten
  E8E4    C5             C      wait10: push	bc
  E8E5    0E 0A          C      	ld	c,10		;10* 1ms warten
  E8E7    06 BD          C      wait2z: ld	b,189		;(189*13)/(256*9600)=0.001
  E8E9    10 FE          C      wait1z: djnz	wait1z		;1ms warten
  E8EB    0D             C      	dec	c
  E8EC    20 F9          C      	jr	nz,wait2z
  E8EE    C1             C      	pop	bc
  E8EF    10 F3          C      	djnz	wait10
  E8F1    C9             C      	ret
                         C      
                         C      ;************************************************************
                         C      ;	zentral verwendete Rueckkonvertierungsroutinen
                         C      ;************************************************************
                         C      
                         C       IF monitor or errvar or iobvar or uhrvar or mprot
                         C      
                         C      ; Rueckkonvertieren Byte ab (HL) nach (DE)
                         C      ; RET: 2 Zeichen ab (DE), DE zeigt auf naechstes freies Byte
  E8F2    7E             C      mbreco: ld	a,(hl)
                         C      
                         C      ; Rueckkonvertieren Byte in A nach (DE)
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-108


                         C      ; RET: 2 Zeichen ab (DE), DE zeigt auf naechstes freies Byte
  E8F3    CD E8F6        C      mrecoa: call	mreca
                         C      
                         C      ; Rueckkonvertieren A in HEX-Ziffern nach (DE)
                         C      ; RET: A um 4 bits nach rechts rotiert
                         C      ;      DE zeigt auf naechstes Byte
  E8F6                   C      mrecol:
  E8F6    0F             C      mreca:	rrca			;linkes Halbbyte
  E8F7    0F             C      	rrca
  E8F8    0F             C      	rrca
  E8F9    0F             C      	rrca
  E8FA                   C      mrecor:				;rechtes Halbbyte
  E8FA    F5             C      	push	af		;fuer 2. mreca-Aufruf retten
  E8FB    E6 0F          C      	and	0fh
  E8FD    D6 0A          C      	sub	9+1
  E8FF    38 02          C      	jr	c,mrecod	;0..9
  E901    C6 07          C      	add	a,7		;A..F
  E903    C6 3A          C      mrecod: add	a,'0'+10
  E905    12             C      	ld	(de),a
  E906    13             C      	inc	de
  E907    F1             C      	pop	af
  E908    C9             C      	ret
                         C      
                         C       ENDIF
                         C      
                         C       IF monitor or cpastz
                         C       ENDIF
