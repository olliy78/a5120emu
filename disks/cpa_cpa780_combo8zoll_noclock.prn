                         C       IF kbdotp eq 3	;;K7633 annehmen
                         C       ENDIF
  04BD    C9             C      	ret
                         C      
                         C      ;;Lesen Statusregister fuer PIO-Tastatur
BIOS CP/A, Buerocomputer (A5120/30 u. ae.)	MACRO-80 V3.50	25-Oct-85	Page	1-123


                         C      ; Bit 3	=1, wenn Taste gedrueckt
                         C      ; Bit 2	=1, wenn CNTL-Taste gedrueckt
  04BE    DB 01          C      coistp:	in	a,(kbdpcs)
  04C0    2F             C      coistc:	cpl			;;auf NOP, wenn Status negiert
  04C1    C9             C      	ret
                         C      
                         C      ;; Initialisierung Tastatur K7637
  04C2    58             C      kbdsmt:	db	kbdsct	;;CTC
  04C3    5C             C      kbdsmi:	db	kbdsci	;;Zeichen E/A
  04C4    5D             C      kbdsms:	db	kbdscs	;;Status
  04C5    01             C      kbdsnr:	db	1	;;Laufende Nr. fuer Tastaturvarianten
  04C6    00 18          C      k37par:	db	0,18h	;;Kanal-Reset
  04C8    04 44          C      	db	4,44h	;;clock*16  / 1 stoppbit / unger. Par.
  04CA    01 00          C      	db	1,0
  04CC    05 68          C      	db	5,68h	;;Send. ein / 8 bit pro Zeichen
  04CE    03 C1          C      	db	3,0c1h	;;Empf. ein / 8 bit pro Zeichen
  000A                   C      k37prl	equ	$-k37par
                         C      
                         C      
